const title = 'محامي طلاق في أم القيوين: استشارة وتمثيل قانوني';
const description =
  'هل تبحث عن محامي طلاق في أم القيوين؟ كيف تتعامل محكمة أم القيوين الابتدائية مع قضايا الأسرة، متى يتقدم المقيمون في عجمان أو الشارقة بدلاً من ذلك، وما تحتاج معرفته عن الطلاق في أصغر إمارات الدولة.';

const canonical = 'https://divorceu.ae/ar/محامي-طلاق-أم-القيوين/';

const hreflang = {
