---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الطلاق للمغتربين الأجانب في الإمارات — دليل شامل ٢٠٢٥';
const description =
  'دليل الطلاق للمغتربين الأجانب في الإمارات ٢٠٢٥: أي قانون يسري عليك، المسلمون وغير المسلمين، خيار المحكمة، التكاليف، مصير إقامتك، وحضانة الأطفال. معلومات دقيقة لمن يقيم في دبي وأبوظبي وسائر الإمارات.';

const canonical = 'https://divorceu.ae/ar/الطلاق-للمغتربين-في-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-for-expats-in-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الطلاق للمغتربين في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل يسري قانون الأحوال الشخصية الإماراتي على المغتربين المسلمين من جنسيات أجنبية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. المرسوم بقانون اتحادي رقم 41 لسنة 2024 (الذي دخل حيز التنفيذ في 15 أبريل 2025) يسري على جميع المسلمين المقيمين في الإمارات بصرف النظر عن جنسياتهم، سواء كانوا إماراتيين أو مصريين أو لبنانيين أو باكستانيين أو غيرهم. لا يُجيز هذا القانون اختيار قانون البلد الأصلي بديلاً عنه.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن للمغترب غير المسلم اختيار تطبيق قانون بلده عند الطلاق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. المادة الأولى من المرسوم بقانون اتحادي رقم 41 لسنة 2022 تتيح لأي مغترب غير مسلم الاختيار صراحةً عند تقديم الدعوى: تطبيق القانون الإماراتي أو قانون بلده الأصلي. هذا الاختيار يحدد نتيجة تقسيم الأصول والنفقة تحديداً جذرياً، لذلك يجب اتخاذه بعد استشارة قانونية متخصصة.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الفرق بين محكمة أبوظبي المدنية للأسرة ومحاكم دبي في قضايا طلاق المغتربين؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'محكمة أبوظبي المدنية للأسرة: مخصصة لغير المسلمين، تضم قضاة متخصصين، وتنجز الطلاق غير المتنازع عليه في أقل من شهر في كثير من الأحيان. محاكم دبي: تعمل عبر الجناح المدني لمحكمة الأحوال الشخصية، مع جدول زمني يبلغ نحو ثلاثة أشهر للقضايا غير المتنازع عليها. كلا الخيارين يطبقان قانون ٢٠٢٢ بالكامل.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا يحدث لإقامتي في الإمارات بعد الطلاق إذا كنت على فيزا الزوج؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'عند صدور حكم الطلاق تنتهي فيزا الزوجة التابعة. تُمنح المرأة تصريح إقامة "مطلقة" لمدة عام واحد قابل للتجديد مرة واحدة. يجب التقدم بطلب رسمي لدى هيئة الهوية والجنسية والجمارك وأمن المنافذ، ولا يُمنح تلقائياً.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يعترف القانون الهندي بحكم الطلاق الإماراتي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الأمر يتوقف على الديانة. الهندوس والسيخ والجاينيون والبوذيون المتزوجون بموجب قانون الزواج الهندوسي لعام 1955 لا يمكنهم حل الرابطة الزوجية إلا أمام المحاكم الهندية؛ حكم الطلاق الإماراتي وحده غير كافٍ قانونياً في الهند. المسلمون الهنود يمكنهم الاعتراف بالطلاق الإماراتي بعد التصديق الرسمي.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يُطبَّق نظام تقسيم الأصول المتساوي في الإمارات على المغتربين؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. القانون الإماراتي يعتمد مبدأ الملكية المنفصلة: كل طرف يحتفظ بما هو مسجَّل باسمه. لا يوجد مفهوم "الثروة الزوجية المشتركة". المغترب الراغب في تقسيم عادل للأصول يمكنه إما اختيار قانون بلده (إذا كان غير مسلم) أو التفاوض على تسوية قبل صدور الحكم.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يحق للمغترب البريطاني رفع دعوى طلاق في إنجلترا أثناء إقامته في دبي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم إذا احتفظ بموطنه القانوني الإنجليزي. الموطن القانوني يختلف عن الإقامة الفعلية؛ كثير من البريطانيين المقيمين في دبي لا يزالون يحملون موطناً إنجليزياً. رفع الدعوى في إنجلترا يتيح إمكانية إعادة توزيع الأصول والمعاشات وفق القانون الإنجليزي. السبق في تقديم الدعوى يحدد الاختصاص القضائي في الغالب.',
      },
    },
    {
      '@type': 'Question',
      name: 'كم تكلفة الطلاق للمغتربين في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الطلاق غير المتنازع عليه لغير المسلمين في أبوظبي: 8,000–12,000 درهم إجمالاً (رسوم محكمة 2,000–3,000، محامٍ 5,000–8,000، ترجمة 500–1,000). في دبي: 9,000–15,000 درهم. القضايا الخلافية: 27,000–55,000 درهم أو أكثر وتستغرق 9–18 شهراً. الطلاق للمسلمين غير المتنازع عليه: 12,000–22,000 درهم عادةً.',
      },
    },
  ],
};

const regimes = [
  {
    title: 'المرسوم بقانون رقم 41/2022 — غير المسلمين',
    applies: 'جميع المغتربين غير المسلمين في الإمارات',
    features: [
      'طلاق بدون إثبات ذنب (no-fault)',
      'الحضانة المشتركة المتساوية هي الوضع الافتراضي',
      'خيار تطبيق قانون بلد المنشأ للطرفين',
      'لا يوجد نظام عدة أو انتظار إلزامي',
      'النفقة تقديرية ومحدودة (حتى عام واحد)',
    ],
    timeline: 'أقل من شهر (أبوظبي) / 3 أشهر (دبي) غير متنازع عليه',
  },
  {
    title: 'المرسوم بقانون رقم 41/2024 — المسلمون',
    applies: 'جميع المسلمين المقيمين في الإمارات من أي جنسية',
    features: [
      'إلزامية المرور بمركز الإرشاد الأسري أولاً',
      'المادة 122: للطفل البالغ 15 سنة حق اختيار أحد الوالدين',
      'تسجيل الطلاق الخارجي خلال 15 يوماً (المادة 58)',
      'الطلاق والخلع وفسخ النكاح كلها مُقنَّنة',
      'عدة المرأة 3 أشهر بعد الحكم',
    ],
    timeline: '3–6 أشهر (غير متنازع) / 9–18 شهراً (متنازع)',
  },
];

const faqItems = [
  {
    question: 'كيف أختار بين تطبيق القانون الإماراتي أو قانون بلدي عند الطلاق؟',
    answer: 'القرار يتوقف على أين توجد أصولك وما هو مبدأ تقسيمها. القانون الإماراتي: كل طرف يحتفظ بما في اسمه، والنفقة محدودة حتى عام. قانون بلدك (إذا اخترته): قد يتيح إعادة توزيع الأصول بالكامل بما فيها المعاش والممتلكات المشتركة. الزوج الأكثر ثروةً أو الذي يحتفظ بأصول باسمه عادةً يفضّل القانون الإماراتي؛ الزوج الأضعف مالياً عادةً يستفيد من قانون بلده. استشر محامياً في كلا الاختصاصين قبل تقديم أي أوراق.',
  },
  {
    question: 'هل أحتاج إلى محامٍ إماراتي وإن كانت القضية غير متنازع عليها؟',
    answer: 'لغير المسلمين في أبوظبي: الطلاق بالتراضي ممكن أمام محكمة الأسرة المدنية بدون تمثيل قانوني إلزامي، لكنه موصى به بشدة لضمان صياغة بنود الأصول والحضانة بشكل ملزم. للمسلمين: التمثيل القانوني أمر شبه ضروري نظراً لإلزامية جلسات الإرشاد الأسري والمتطلبات الإجرائية.',
  },
  {
    question: 'هل يمكن إتمام الطلاق وأنا خارج الإمارات؟',
    answer: 'لا يمكن تقديم الدعوى الابتدائية إلكترونياً من الخارج بشكل كامل. يتطلب النظام الحضور أو تفويض محامٍ ببعض الإجراءات. في الحالات غير المتنازع عليها تماماً، يمكن للمحامي تمثيل أحد الطرفين بوكالة رسمية، لكن حضور المدعي عادةً ما يُطلب في جلسة واحدة على الأقل.',
  },
  {
    question: 'ماذا يحدث للإقامة إذا كان الأطفال على فيزا الزوج؟',
    answer: 'الأطفال المرفقون بفيزا الزوج عادةً ما يُضمَّنون في تصريح الإقامة المؤقت للمطلقة لمدة عام. بعد انتهاء هذه المدة، يمكن تحويل رعاية الأطفال إلى فيزا الوالد الحاضن. إذا كانت الحضانة مشتركة، يتفق الطرفان على من يكفل الأطفال ضمن التسوية.',
  },
  {
    question: 'هل تستطيع الأم غير الإماراتية الحصول على حضانة أطفالها في الإمارات؟',
    answer: 'نعم. لا يتوقف حق الحضانة على الجنسية في الإمارات. بالنسبة لغير المسلمين (قانون 2022)، الحضانة المشتركة المتساوية هي الأصل. بالنسبة للمسلمين (قانون 2024)، تُعطى الأم الحضانة الفعلية للأطفال الصغار بصرف النظر عن جنسيتها. المعيار الأساسي في كلا الحالتين هو مصلحة الطفل الفضلى.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">دليل الطلاق · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        84% من سكان الإمارات مغتربون أجانب. معظمهم لا يعرفون القرار الأهم في قضية طلاقهم: أين يطلبون الطلاق، وبأي قانون. هذا الدليل يوضح أي نظام قانوني يسري عليك، وما الفرق بين المحاكم الإماراتية ومحاكم بلدك الأصلي، وكيف تحمي مصالحك المالية وحقوق أطفالك.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="answer-box">
        <h2>حقائق أساسية في لمحة</h2>
        <ul>
          <li><strong>ثلاثة أنظمة قانونية موازية:</strong> غير المسلمين (قانون 2022)، والمسلمين (قانون 2024)، وإمارة أبوظبي بإطارها المدني المنفصل.</li>
          <li><strong>مبدأ الملكية المنفصلة:</strong> لا يوجد تقسيم تلقائي للأصول — كل طرف يحتفظ بما هو باسمه.</li>
          <li><strong>حق اختيار قانون آخر:</strong> متاح فقط لغير المسلمين عند تقديم الدعوى.</li>
          <li><strong>الإمارات لم توقّع على اتفاقية لاهاي 1980</strong> لاختطاف الأطفال — خطر حقيقي في النزاعات العابرة للحدود.</li>
          <li><strong>التكاليف:</strong> 8,000–15,000 درهم للطلاق غير المتنازع عليه لغير المسلمين؛ ما يزيد على 27,000 درهم للقضايا الخلافية.</li>
        </ul>
      </div>

      <section class="content-section">
        <h2>أي قانون ينطبق عليك؟</h2>

        <p>
          الخطوة الأولى في أي طلاق بالإمارات هي تحديد النظام القانوني المنطبق. المعيار الرئيسي هو الديانة وليس الجنسية.
        </p>

        <div class="regimes-list">
          {regimes.map(r => (
            <div class="regime-card">
              <h3>{r.title}</h3>
              <p class="regime-applies"><strong>ينطبق على:</strong> {r.applies}</p>
              <ul class="regime-features">
                {r.features.map(f => <li>{f}</li>)}
              </ul>
              <p class="regime-timeline"><strong>المدة الزمنية:</strong> {r.timeline}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="content-section">
        <h2>خيار تطبيق قانون البلد الأصلي — أهم قرار لغير المسلمين</h2>

        <p>
          المادة الأولى من المرسوم بقانون اتحادي رقم 41 لسنة 2022 تتيح لكل مغترب غير مسلم أن يختار تطبيق قانون بلده بدلاً من القانون الإماراتي على جميع مسائل الأسرة بما فيها الطلاق. هذا الاختيار يجب الإفصاح عنه لدى تقديم الدعوى، ولا يمكن التراجع عنه بعد بدء الإجراءات.
        </p>

        <h3>أثر الاختيار على الأصول</h3>
        <div class="factors-list">
          <div class="factor-item">
            <h3>القانون الإماراتي (الوضع الافتراضي)</h3>
            <p>كل طرف يحتفظ بما هو مسجَّل باسمه. الشقة في دبي باسم الزوج؟ تبقى له كاملاً. المدخرات في حساب منفرد؟ لا تُمسّ. النفقة محدودة بحد أقصى عام واحد كـ"تعويض معنوي". هذا النظام يحمي الطرف الأكثر ثروةً أو الذي يملك أصولاً باسمه.</p>
          </div>
          <div class="factor-item">
            <h3>قانون إنجلترا وويلز</h3>
            <p>إعادة توزيع كاملة للثروة الزوجية بما فيها المعاش والممتلكات وحتى الأصول السابقة للزواج في بعض الحالات. الزوج الأضعف مالياً عادةً يستفيد استفادةً جوهرية. على شقة بقيمة 2 مليون درهم، قد تحصل الزوجة على 40–50% من إجمالي الثروة الزوجية.</p>
          </div>
          <div class="factor-item">
            <h3>القانون الفرنسي</h3>
            <p>نظام الأسرة المعيارية: تقسيم الأصول المكتسبة خلال الزواج مع الاحتفاظ بالأصول المنفصلة. التعويض التكميلي (prestation compensatoire) متاح للزوج الأضعف مالياً في صورة مبلغ مقطوع أو راتب دوري.</p>
          </div>
          <div class="factor-item">
            <h3>القانون الهندي (قانون الزواج الهندوسي 1955)</h3>
            <p>استثناء مهم: قانون 2022 يتيح الاختيار، لكن المحاكم الهندية لا تعترف بالطلاق الإماراتي لمن تزوجوا بموجب قانون الزواج الهندوسي. قد تحتاج إلى إجراءات موازية أمام المحاكم الهندية.</p>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2>مقارنة المحاكم: أبوظبي مقابل دبي</h2>

        <div class="compare-table">
          <div class="compare-header">
            <div>المعيار</div>
            <div>محكمة الأسرة المدنية بأبوظبي</div>
            <div>محكمة الأحوال الشخصية بدبي</div>
          </div>
          {[
            { f: 'المدة (غير متنازع)', adh: 'أقل من شهر', dxb: 'نحو 3 أشهر' },
            { f: 'القضاة', adh: 'قضاة متخصصون لغير المسلمين', dxb: 'جناح مدني في محكمة الأحوال' },
            { f: 'تسجيل الزواج المدني', adh: 'متاح وحل في المحكمة ذاتها', dxb: 'لا يسجّل زواجاً مدنياً' },
            { f: 'الأوامر المالية', adh: 'تُقدَّم بشكل مستقل بعد الحكم', dxb: 'يمكن إدراجها في دعوى الطلاق' },
            { f: 'خيار محاكم DIFC', adh: 'غير متاح', dxb: 'متاح للقضايا المعقدة' },
          ].map((row, i) => (
            <div class={`compare-row${i % 2 === 1 ? ' alt' : ''}`}>
              <div class="compare-factor">{row.f}</div>
              <div>{row.adh}</div>
              <div>{row.dxb}</div>
            </div>
          ))}
        </div>

        <div class="info-box">
          <p><strong>نصيحة عملية:</strong> إذا كنت مقيماً في أبوظبي وكان الطلاق بالتراضي، فأنت تملك أسرع نظام طلاق لغير المسلمين في المنطقة. الانتقال المصطنع إلى أبوظبي لأغراض الطلاق فقط لا يُنصح به ويمكن اعتباره احتيالاً على صلاحية المحكمة.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>حضانة الأطفال للمغتربين</h2>

        <p>
          الحضانة من أكثر المسائل تعقيداً في الطلاق العابر للحدود. التشريعات الإماراتية تُفرِّق بحسم بين المسلمين وغير المسلمين.
        </p>

        <h3>لغير المسلمين (قانون 2022)</h3>
        <p>
          الحضانة المشتركة المتساوية هي الأصل القانوني. كلا الوالدين يحتفظان بحقوق وواجبات متساوية في التعليم والرعاية الصحية والسفر. لا يجوز لأي منهما الانتقال بالطفل إلى خارج الإمارات دون موافقة الآخر أو أمر قضائي. عند بلوغ الطفل 15 عاماً، يحق له اختيار أحد الوالدين وفق المادة 122 من قانون 2024.
        </p>

        <h3>للمسلمين (قانون 2024)</h3>
        <p>
          الحضانة الفعلية للأطفال الصغار تكون للأم وفق الأصل الفقهي. الولاية القانونية (القرارات المصيرية) تُحتفظ بها للأب. الطفل البالغ 15 عاماً يحق له اختيار أحد الوالدين. المصلحة الفضلى للطفل هي المعيار التقديري الأعلى.
        </p>

        <h3>خطر الاختطاف الدولي للأطفال</h3>
        <p>
          الإمارات لم تنضم إلى اتفاقية لاهاي لعام 1980 الخاصة بالاختطاف الدولي للأطفال. هذا يعني أنه لا توجد آلية معاهدة تلقائية لإعادة طفل أُخذ من الإمارات أو أُحضر إليها بدون وجه حق. إذا أخذ أحد الوالدين الطفل إلى دولة موقِّعة على الاتفاقية (بريطانيا، فرنسا، أستراليا) يمكن تقديم طلب إعادة هناك. إلى دولة خليجية أو عربية؟ الأمر أصعب بكثير. قدِّم طلب حظر سفر فور وجود أي خطر جدي.
        </p>
      </section>

