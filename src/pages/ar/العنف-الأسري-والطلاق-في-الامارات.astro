---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'العنف الأسري والطلاق في الإمارات: الحماية وأوامر الطوارئ';
const description =
  'القانون الاتحادي رقم ١٠ لسنة ٢٠٢٤ بشأن الحماية من العنف الأسري يجرّم الإيذاء النفسي والاقتصادي والجسدي. دليل عن أوامر الحماية الطارئة ومركز دبي لإيواء النساء والأطفال وحقوق الإقامة وأثر العنف الموثّق على الحضانة والنفقة.';

const canonical = 'https://divorceu.ae/ar/العنف-الأسري-والطلاق-في-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/domestic-violence-divorce-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'العنف الأسري والطلاق في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'ما هي إجراءات الحصول على أمر حماية في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'قدّمي بلاغاً في أي مركز شرطة في الإمارات أو توجّهي إلى النيابة العامة مباشرة. تراجع النيابة العامة الطلب ويمكنها إصدار أمر حماية طارئ خلال ٢٤ إلى ٧٢ ساعة دون إشعار مسبق للطرف الآخر. يسري الأمر عادةً لمدة ثلاثين يوماً وهو قابل للتجديد. يمكن أن يمنع الأمر الاتصال وأن يُبعد المعتدي عن المسكن المشترك وأن يتضمن حماية حضانة الأطفال. لست بحاجة إلى محامٍ لبدء الإجراء، لكن المساعدة القانونية تسرّع إجراءات الطلاق اللاحقة.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن لزوجي إلغاء تأشيرتي إذا بلّغت عنه بسبب العنف؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نظرياً يستطيع الزوج الكفيل طلب إلغاء التأشيرة في أي وقت، لكن بمجرد أن تصبح دعوى الطلاق قائمة يمكن لمحاكم الإمارات إصدار أوامر وقتية تمنع إلغاء التأشيرة أثناء سير القضية. مغادرة المسكن المشترك هرباً من العنف لا تُلغي تأشيرتك تلقائياً. إذا كنت قد رفعت دعوى الطلاق أو على وشك رفعها، اطلبي من محاميك التقدم فوراً بطلب أمر وقتي يحمي وضع إقامتك. ويمكن لمؤسسة دبي لرعاية النساء والأطفال (الخط الساخن ٨٠٠ ٧٢٨٣) أن تقدّم المشورة بشأن الإيواء ودعم الإقامة.',
      },
    },
    {
      '@type': 'Question',
      name: 'أين يمكنني الذهاب في دبي إذا احتجت إلى الهرب من زوجي فوراً؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تُدير مؤسسة دبي لرعاية النساء والأطفال أكبر مركز إيواء لضحايا العنف الأسري في الإمارات. اتصلي بالخط الساخن السري المتاح على مدار الساعة: ٨٠٠ ٧٢٨٣. المركز مفتوح لكل الجنسيات بما في ذلك المقيمون دون أوراق نظامية. تقدّم المؤسسة إيواءً طارئاً وإرشاداً قانونياً وخدمات للأطفال ومساعدة في إجراءات الشرطة والمحاكم اللاحقة. لست بحاجة إلى بلاغ شرطة قبل الاتصال.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يؤثر العنف الأسري على حضانة الأطفال في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم وبشكل كبير. بموجب المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ والقانون الاتحادي رقم ٣ لسنة ٢٠١٦ (قانون وديمة)، تُعدّ مصلحة الطفل الفضلى المعيار الأسمى. يُعامَل العنف الأسري الموثّق من أحد الوالدين باعتباره دليلاً على أنه يمثّل خطراً على الطفل. والوالد الذي صدر بحقه حكم جزائي أو أمر حماية ساري المفعول من المستبعد جداً أن تُسند إليه الحضانة الأصلية، وقد تُقيّد زياراته أو تُجعَل تحت إشراف. وتأخذ المحاكم الأذى النفسي بعين الاعتبار كما تأخذ الأذى الجسدي.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن استخدام رسائل واتساب كدليل على العنف أمام محاكم الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. تقبل محاكم الإمارات الأدلة الرقمية بما فيها رسائل واتساب والملاحظات الصوتية وسجلات المكالمات. لإعطاء الرسائل أعلى قيمة إثباتية، صدّقيها لدى الكاتب العدل في الإمارات (نسخة مطبوعة يُصادق الكاتب العدل على محتواها). لقطات الشاشة وحدها مقبولة لكنها أسهل في الطعن. والملاحظات الصوتية مؤثرة بشكل خاص لأنها تحمل نبرة الصوت والكلمات الفعلية. احفظي كل الرسائل الأصلية على الجهاز ولا تحذفي أو تعدّلي أي محادثة.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يعني رفع قضية عنف أسري أن زوجي سيُرحَّل؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ليس تلقائياً. الحكم الجزائي في جريمة العنف الأسري بموجب القانون الاتحادي رقم ١٠ لسنة ٢٠٢٤ لا يستوجب الترحيل تلقائياً، لكن للمحكمة سلطة تقديرية في التوصية بالترحيل ضمن العقوبة، خصوصاً في حالات التكرار أو الحالات الجسيمة. وتبقى قرارات الترحيل بيد سلطات الهجرة. والنتائج الأساسية للقضية الجزائية هي الغرامات والحبس وأوامر الحماية. وتسير القضية الجزائية ودعوى الطلاق المدنية كلٌّ بمعزل عن الأخرى.',
      },
    },
    {
      '@type': 'Question',
      name: 'كيف يؤثر العنف الأسري الموثّق على النفقة في الطلاق الإماراتي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'يدعم الإيذاء الموثّق طلب الطلاق للضرر (التطليق للضرر) بموجب المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤. والزوجة التي تطلّق للضرر تستحق كامل المهر ونفقة العدة ونفقة الأطفال وقد تحصل على متعة الطلاق التعويضية. وقد تقضي المحاكم بنفقة أكثر سخاءً حين تكون الزوجة قد تركت الزواج بسبب عنف موثّق. أما للمغتربين غير المسلمين بموجب المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢، فإن تاريخ العنف يؤثر مباشرة في التسوية المالية.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يشمل قانون العنف الأسري الإماراتي الإيذاء النفسي والاقتصادي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. يجرّم القانون الاتحادي رقم ١٠ لسنة ٢٠٢٤ صراحةً الإيذاء النفسي (الإهانة والتهديد والترهيب المتكرر) والإيذاء الجنسي داخل الزواج والإيذاء الاقتصادي (التحكم في الوصول إلى المال وإتلاف الممتلكات ومنع الضحية من العمل). وهو تعريف واسع يتجاوز العنف الجسدي. لست بحاجة إلى إصابات ظاهرة لتقديم شكوى. التهديد عبر الرسائل والإهانة المتكررة ومنع الزوج من الوصول إلى الأموال المشتركة كلها أفعال يمكن المساءلة عنها.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكنني استصدار أمر حماية ضد زوج يقيم في إمارة أخرى؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. يسري القانون الاتحادي رقم ١٠ لسنة ٢٠٢٤ في الإمارات السبع جميعها. يمكنك التقديم في أي مركز شرطة أو مكتب نيابة عامة في الإمارة التي تتواجدين فيها. ويكون أمر الحماية نافذاً في جميع أنحاء الدولة بمجرد صدوره. وإذا انتقل المعتدي بين الإمارات يبقى الأمر ساري المفعول.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا يحدث للمسكن المشترك إذا غادرته هرباً من العنف؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'مغادرة المسكن المشترك بسبب العنف الأسري لا تُعدّ هجراً ولا تُسقط حقك في النفقة أو السكن. ويمكن لأمر الحماية أن يُلزم المعتدي قانوناً بإخلاء المسكن المشترك حتى لو كان هو المستأجر أو المالك، فتبقين أنت في المسكن. وإذا كان المعتدي مالكاً للمسكن، فقد تأمره المحكمة مع ذلك بالخروج والاستمرار في دفع تكاليف السكن أثناء العدة. وثّقي مغادرتك ببلاغ شرطة أو إحالة إلى مركز إيواء لحماية نفسك من أي ادعاء لاحق بالهجر الطوعي.',
      },
    },
  ],
};

const faqItems = faqSchema.mainEntity.map((q) => ({
  question: q.name,
  answer: q.acceptedAnswer.text,
}));
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} lang="ar" />
  </div>

  <!-- Hero -->
  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">العنف الأسري والطلاق · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        قانون الحماية من العنف الأسري في الإمارات يتجاوز الاعتداء الجسدي بكثير. فهو يجرّم التهديد النفسي والتحكم الاقتصادي والإيذاء الجنسي داخل الزواج. إذا كنت في علاقة مسيئة في الإمارات، فلديك من الأدوات القانونية أكثر مما يدركه معظم الناس: من أوامر الحماية الطارئة التي تصدر في اليوم نفسه، إلى خدمات الإيواء لكل الجنسيات، إلى حماية الإقامة أثناء سير الدعوى.
      </p>
      <p class="hero-author">بقلم <strong>أليكسي سوننين</strong> · مستشار قانوني ومغترب في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <!-- Key facts box -->
      <div class="answer-box">
        <h2>ستة أمور يجب معرفتها قبل المتابعة</h2>
        <ul class="key-facts">
          <li><strong>أوامر الحماية تصدر دون حضور الطرف الآخر.</strong> يمكن للنيابة العامة إصدار أمر طارئ خلال ٢٤ إلى ٧٢ ساعة دون إخبار المعتدي أولاً.</li>
          <li><strong>العنف ليس جسدياً فقط.</strong> يجرّم القانون الاتحادي رقم ١٠ لسنة ٢٠٢٤ الإيذاء النفسي والاقتصادي والجنسي داخل الزواج.</li>
          <li><strong>مغادرة المنزل لا تُلغي تأشيرتك.</strong> ترك المسكن المشترك هرباً من العنف لا يُسقط حقك في إقامة الإمارات.</li>
          <li><strong>رسائل واتساب دليل صحيح.</strong> السجلات الرقمية المصدّقة مقبولة لدى محاكم الإمارات.</li>
          <li><strong>مركز دبي للإيواء يخدم كل الجنسيات</strong> بما في ذلك المقيمون دون أوراق نظامية. خط ساخن على مدار الساعة: ٨٠٠ ٧٢٨٣.</li>
          <li><strong>القضية الجزائية والطلاق يسيران بشكل مستقل.</strong> طلب أمر حماية لا يوقف دعوى طلاقك ولا يضرّ بها.</li>
        </ul>
      </div>

      <!-- Section 1: The Law -->
      <section class="content-section">
        <h2>قانون الحماية من العنف الأسري: ماذا يغطّي فعلاً</h2>
        <p>
          أرسى المشرّع الإماراتي إطاراً قانونياً مستقلاً للحماية من العنف الأسري عبر القانون الاتحادي رقم ١٠ لسنة ٢٠٢٤، الذي حلّ محلّ الأحكام السابقة بشأن العنف الأسري. ويسري القانون على جميع المقيمين في الإمارات بصرف النظر عن الجنسية أو الديانة أو نوع التأشيرة. ونطاقه أوسع من معظم التشريعات المماثلة في المنطقة.
        </p>
        <p>
          يعرّف القانون العنف الأسري بأنه كل فعل يسبّب أو يهدّد بإحداث أذى جسدي أو نفسي أو جنسي أو مالي يرتكبه أحد أفراد الأسرة بحق آخر. ويشمل تعبير «فرد الأسرة» الأزواج والمطلّقين والأبناء والآباء والإخوة وأي شخص يشارك في المسكن. والأهم أن الجريمة لا تستلزم تلامساً جسدياً. وتشكّل الأفعال التالية جميعها عنفاً أسرياً بموجب القانون:
        </p>
        <ul>
          <li>الاعتداء الجسدي بما فيه الضرب أو الدفع أو الحبس</li>
          <li>الإيذاء النفسي: الإهانة المستمرة والتهديد اللفظي والترهيب ومراقبة التحركات وعزل الضحية عن الأهل والأصدقاء</li>
          <li>الإيذاء الجنسي بما في ذلك إجبار الزوج على أفعال جنسية</li>
          <li>الإيذاء الاقتصادي: حجب المال المستحق للزوج وإتلاف الممتلكات ومنع الزوج من العمل والتحكم الكامل في الوصول المالي</li>
          <li>التهديد بأيٍّ مما سبق</li>
        </ul>
        <p>
          تتدرّج العقوبات في القانون من الغرامة إلى الحبس. ويواجه أصحاب التكرار عقوبات أشد. وللمحاكم كذلك سلطة تقديرية في التوصية بترحيل الجناة من غير المواطنين، وإن لم يكن ذلك تلقائياً.
        </p>

        <div class="info-box info-box--warning">
          <h3>الإيذاء الاقتصادي كثيراً ما يُغفَل</h3>
          <p>كثير من الأزواج الذين يتعرّضون للتحكم الاقتصادي، زوج يرفض الإنفاق أو يتحكم في كل وصول إلى الحساب البنكي أو أتلف وثائق الزوجة أو هاتفها، لا يدركون أن هذا جريمة جزائية بموجب القانون الإماراتي وليس مجرد نزاع مدني. فإذا قطع زوجك وصولك إلى أموال الأسرة أو صادر جواز سفرك (وهو أيضاً غير قانوني بموجب قانون الإمارات) أو منعك من العمل، فهذه أفعال يمكن المساءلة عنها بموجب القانون الاتحادي رقم ١٠ لسنة ٢٠٢٤ إلى جانب أي دعوى طلاق.</p>
        </div>
      </section>

      <!-- Section 2: Protection Orders -->
      <section class="content-section">
        <h2>أوامر الحماية الطارئة: كيف تعمل</h2>
        <p>
          أمر الحماية تعليمات قانونية تصدرها الجهة المختصة وتأمر المعتدي بالكفّ عن سلوك محدّد. وفي الإمارات تصدر أوامر الحماية الطارئة عن النيابة العامة لا عن محكمة الأسرة. وهذا تمييز مهم: لست بحاجة إلى انتظار جلسة في محكمة الأسرة.
        </p>

        <h3>إجراء الإصدار دون حضور الطرف الآخر</h3>
        <p>
          تُمنَح أوامر الحماية الطارئة دون حضور الطرف الآخر، بمعنى أن المُبلَّغ عنه (المعتدي المزعوم) لا يتلقى إشعاراً مسبقاً ولا تتاح له فرصة المثول قبل صدور الأمر. تراجع النيابة العامة الطلب والأدلة المؤيدة ويمكنها إصدار الأمر خلال ٢٤ إلى ٧٢ ساعة. والسرعة مقصودة: يدرك القانون أن إخطار المعتدي مسبقاً بطلب أمر الحماية يخلق خطراً أمنياً مباشراً.
        </p>

        <h3>المدة والتجديد</h3>
        <p>
          تسري الأوامر الطارئة عادةً لمدة ثلاثين يوماً. ويمكن للنيابة العامة تجديدها بناءً على طلب. ويمكن الحصول على أوامر أطول أمداً عبر محكمة الأسرة ضمن دعاوى الطلاق أو الحضانة الجارية.
        </p>

        <h3>ما الذي يستطيع أمر الحماية فعله</h3>
        <div class="steps-list">
          <div class="step-card">
            <div class="step-num">٠١</div>
            <div class="step-body">
              <h3>منع الاتصال والاقتراب</h3>
              <p>يُمنع المعتدي من الاتصال بك بأي وسيلة، الهاتف أو الرسائل أو وسائل التواصل أو عبر أطراف ثالثة، ومن الاقتراب إلى مسافة محددة من مسكنك أو مكان عملك أو مدرسة أطفالك.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٢</div>
            <div class="step-body">
              <h3>الإبعاد عن المسكن المشترك</h3>
              <p>حتى لو كان المعتدي هو المستأجر المسمّى أو مالك العقار، يمكن لأمر الحماية أن يُلزمه بإخلاء المسكن المشترك. وتبقى الضحية في المسكن. وهذه من أقوى الأدوات في القانون.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٣</div>
            <div class="step-body">
              <h3>حماية حضانة الأطفال</h3>
              <p>يمكن للأمر أن يمنح مقدّم الطلب الحضانة الفعلية المؤقتة للأطفال وأن يقيّد أو يُخضِع لإشراف اتصال المُبلَّغ عنه بالأطفال خلال مدة الأمر.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٤</div>
            <div class="step-body">
              <h3>الحظر التام للتواصل</h3>
              <p>يُمنع كل تواصل مباشر وغير مباشر من جانب المُبلَّغ عنه. وتُعدّ مخالفة أمر الحماية جريمة جزائية مستقلة تترتب عليها نتائج اعتقال فوري.</p>
            </div>
          </div>
        </div>

        <h3>كيفية التقديم</h3>
        <p>
          قدّمي بلاغ شرطة في أي مركز شرطة في الإمارات. ستحيل الشرطة الأمر إلى النيابة العامة. أو توجّهي إلى النيابة العامة مباشرة، أو إلى قسم التوجيه الأسري والإصلاح الملحق بالمحكمة المحلية. إذا كنت في خطر مباشر فاتصلي بالرقم ٩٩٩. وإذا احتجت إلى إيواء قبل اتخاذ الخطوات القانونية، فاتصلي بالخط الساخن لمؤسسة دبي (٨٠٠ ٧٢٨٣). ويمكنك أيضاً الاطلاع على دليلنا حول <a href="/ar/أوامر-الطوارئ-الطلاق-الامارات/">أوامر الطوارئ في الطلاق</a> لفهم الأوامر الوقتية الأخرى.
        </p>
        <p>
          لست بحاجة إلى محامٍ لبدء طلب أمر حماية. فالإجراء مصمَّم ليكون في متناول الضحايا دون تمثيل قانوني. غير أنه إذا كنت تتابعين دعوى طلاق في الوقت نفسه، فإن وجود محامٍ ينسّق بين طلب أمر الحماية ورفع دعوى الطلاق أمر يُنصَح به بقوة.
        </p>
      </section>

      <!-- Section 3: Shelter and Support -->
      <section class="content-section">
        <h2>مؤسسة دبي لرعاية النساء والأطفال</h2>
        <p>
          مؤسسة دبي لرعاية النساء والأطفال أكبر مركز إيواء ودعم لضحايا العنف الأسري في الإمارات. تعمل تحت مظلة حكومة دبي وتقدّم خدماتها لكل الجنسيات بما في ذلك المقيمون دون تأشيرات إمارات سارية.
        </p>

        <div class="callout-box callout-box--gold">
          <h3>مؤسسة دبي لرعاية النساء والأطفال</h3>
          <div class="contact-grid">
            <div class="contact-item">
              <div class="contact-label">خط ساخن على مدار الساعة</div>
              <div class="contact-value">٨٠٠ ٧٢٨٣</div>
            </div>
            <div class="contact-item">
              <div class="contact-label">متاح لـ</div>
              <div class="contact-value">جميع الجنسيات، بمن فيهم المقيمون دون أوراق نظامية</div>
            </div>
            <div class="contact-item">
              <div class="contact-label">سرّي</div>
              <div class="contact-value">لا يُكشف عن الهوية ولا الموقع للمعتدي</div>
            </div>
            <div class="contact-item">
              <div class="contact-label">الخدمات</div>
              <div class="contact-value">إيواء طارئ، إرشاد قانوني، دعم للأطفال، مرافقة إلى المحاكم</div>
            </div>
          </div>
        </div>

        <p>
          توفّر المؤسسة إيواءً طارئاً وتربط المقيمين بالمساعدة القانونية وترافق الضحايا إلى مراكز الشرطة وجلسات المحاكم وتقدّم الدعم النفسي وتساعد في تسجيل الأطفال في المدارس. وإذا منعك وضعك من الاتصال، يمكنك الحضور مباشرة إلى مركزها في دبي.
        </p>
        <p>
          ولأبوظبي خدمة موازية عبر هيئة رعاية الأسرة. وتدير الشارقة دائرة الخدمات الاجتماعية. وتملك الإمارات السبع جميعها أنظمة إحالة رسمية من الشرطة إلى خدمات الدعم.
        </p>

        <div class="info-box info-box--info">
          <h3>ماذا عن المقيمين دون تأشيرات سارية؟</h3>
          <p>تخدم مؤسسة دبي صراحةً المقيمين دون أوراق نظامية. ولا تبلّغ المؤسسة السلطات عن الوضع الإقامي. وللحكومة الإماراتية سياسة محددة بعدم ترحيل ضحايا العنف الأسري أثناء القضايا القائمة. فإذا كان وضع التأشيرة قد منعك من طلب المساعدة، فإن هذا الحاجز يزول فعلياً حين تتواصلين مع المؤسسة.</p>
        </div>
      </section>

      <!-- Section 4: Evidence -->
      <section class="content-section">
        <h2>الأدلة التي تقبلها محاكم الإمارات</h2>
        <p>
          تتوقف قوة قضية العنف الأسري إلى حدّ كبير على الأدلة التي يمكنك تقديمها. وتقبل محاكم الإمارات طائفة من أنواع الأدلة في مسائل الحماية من العنف الأسري. وجمع هذه الأدلة مبكراً، قبل أن تتحول الإجراءات إلى نزاع، هو أهم خطوة عملية يمكنك اتخاذها.
        </p>

