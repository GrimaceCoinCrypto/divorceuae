---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'أين تتقدم بطلب الطلاق: الإمارات أم بلدك الأم؟';
const description =
  'بالنسبة للمغتربين في الإمارات، اختيار الولاية القضائية هو أهم قرار مالي في الطلاق. الإمارات تُبقي الأصول باسم مالكها، وإنجلترا تعيد توزيع كل شيء. دليل المقارنة بين خمس ولايات وسباق التقديم أولاً.';

const canonical = 'https://divorceu.ae/ar/أين-تتقدم-بطلب-الطلاق-الإمارات-أم-بلدك/';

const hreflang = {
  en: 'https://divorceu.ae/en/where-to-divorce-uae-or-home-country/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'أين تتقدم بطلب الطلاق: الإمارات أم بلدك' },
];

const faqSchema = {
  '@context': 'https://schema.org',
