---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'استئناف حكم الطلاق في الإمارات — مهلة ٣٠ يوماً والأسباب المقبولة ٢٠٢٥';
const description =
  'كيف تطعن في حكم الطلاق أمام محكمة الاستئناف في الإمارات: مهلة ٣٠ يوماً، الأسباب المقبولة وغير المقبولة، الفرق بين الاستئناف وتعديل الحكم، وتكلفة الإجراءات.';

const canonical = 'https://divorceu.ae/ar/استئناف-الطلاق-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-appeal-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'استئناف حكم الطلاق في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'كم المهلة المتاحة لاستئناف حكم الطلاق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'ثلاثون يوماً من تاريخ استلام الحكم المكتوب. هذه المهلة مطلقة — فواتها يُغلق باب الاستئناف في الغالب. ساعة الصفر تبدأ من استلامك الحكم المكتوب لا من صدوره شفهياً في الجلسة. إذا لم تستلم الحكم بعد فاطلب من محاميك المطالبة به فوراً كتابةً.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يتوقف تنفيذ حكم الطلاق خلال فترة الاستئناف؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الحكم الابتدائي يبقى نافذاً أثناء الاستئناف ما لم تنجح في استصدار أمر وقف التنفيذ. الوقف يستلزم طلباً مستقلاً لمحكمة الاستئناف مع إثبات أن تنفيذ الحكم خلال فترة الاستئناف سيُلحق بك ضرراً جسيماً لا يمكن إصلاحه. لا تُمنح أوامر الوقف تلقائياً، بل تُوازن المحكمة بين أضرار الطرفين.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل تنظر محكمة الاستئناف في أدلة جديدة؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'بوجه عام لا. محكمة الاستئناف هيئة مراجعة قانونية لا محاكمة من جديد. تفحص ما إذا كانت المحكمة الابتدائية قد طبّقت القانون تطبيقاً صحيحاً على الأدلة المعروضة أمامها. الأدلة الجديدة لا تُقبل عادةً في مرحلة الاستئناف. إذا كانت لديك أدلة جديدة حقيقية لم تكن موجودة وقت الحكم الابتدائي، فقد يكون طلب مراجعة الحكم (التماس إعادة النظر) هو الآلية المناسبة.',
      },
    },
  ],
};

const grounds = [
  { ground: 'خطأ قانوني', detail: 'أخطأت المحكمة في تطبيق القانون الإماراتي أو أحكام الشريعة الإسلامية أو تفسيرها في الحكم. هذا أقوى أسباب الاستئناف.' },
  { ground: 'إخلال إجرائي جوهري', detail: 'انتُهكت قاعدة إجرائية جوهرية خلال الجلسات الابتدائية، كعدم إخطارك على النحو الصحيح، أو استبعاد دليل أساسي دون مسوّغ، أو إغفال المحكمة خطوةً إلزامية.' },
  { ground: 'دليل جديد لم يكن بالإمكان كشفه', detail: 'دليل لم يكن موجوداً أو لم يكن بالإمكان اكتشافه قبل صدور الحكم الابتدائي. ملاحظة: محاكم الاستئناف لا تقبل أدلةً جديدةً في الغالب، وهذا الأمر يستلزم طلباً مستقلاً عادةً.' },
  { ground: 'ظلم صارخ', detail: 'النتيجة مجحفةٌ لدرجة لا يمكن لأي محكمة تطبق القانون تطبيقاً صحيحاً أن تبلغها. معيارٌ رفيع يستلزم توثيقاً واضحاً.' },
];

const appealSteps = [
  { n: 1, title: 'استلام الحكم المكتوب ومراجعته', body: 'مهلة الثلاثين يوماً تبدأ من استلامك الحكم المكتوب لا من صدوره الشفهي. اطلب من محاميك المطالبة بأسباب الحكم فوراً إذا لم تُسلَّم تلقائياً.' },
  { n: 2, title: 'تعيين محامٍ استئنافي', body: 'الاستئناف يتطلب مهارات مختلفة عن المحاكمة الابتدائية. محاميك الاستئنافي يراجع محضر الجلسة والأدلة والمسوّغات القانونية. وكّله في أقرب وقت لأن المهلة مطلقة.' },
  { n: 3, title: 'تقديم عريضة الاستئناف', body: 'يُودع محاميك عريضة الاستئناف لدى محكمة الاستئناف في الإمارة المختصة. تُسدَّد رسوم الإيداع (٥٠٠-٢٠٠٠ درهم حسب الإمارة ونوع الطلب).' },
  { n: 4, title: 'تقديم مذكرة الأسباب', body: 'مذكرة قانونية تفصيلية تُحدد أسباب الاستئناف بالرجوع إلى سجل المحاكمة الابتدائية. الطرف الآخر يُقدم مذكرة رد. تبادل المذكرات يستغرق عادةً ٤-٨ أسابيع.' },
  { n: 5, title: 'حضور الجلسة الشفهية', body: 'تُحدد محكمة الاستئناف موعداً لجلسة الاستماع. يُقدم كلا المحاميين حججهما. قد تطرح المحكمة أسئلةً على المحامين. الإجراءات تُجرى باللغة العربية ولا تُستدعى شهود عادةً في مرحلة الاستئناف.' },
  { n: 6, title: 'صدور الحكم', body: 'تُصدر محكمة الاستئناف حكمها عادةً في غضون ٦٠-٩٠ يوماً من الجلسة. تستطيع المحكمة: تأييد الحكم الابتدائي، أو تعديله جزئياً، أو إلغاؤه كلياً. الإلغاء الكلي يُحيل القضية إلى محكمة أول درجة أو تُفصل مباشرةً.' },
];

const comparisonRows = [
  { aspect: 'الغرض', appeal: 'الطعن في خطأ قانوني أو إخلال إجرائي في الحكم الصادر', modification: 'تعديل حكم قائم بسبب تغيّر الظروف بعد صدوره' },
  { aspect: 'السبب', appeal: 'الاستياء من النتيجة مع وجود خطأ قانوني أو إجرائي محدد', modification: 'فقدان العمل، السفر للخارج، تغيّر الحالة الصحية، بلوغ الطفل سناً مختلفة' },
  { aspect: 'المهلة', appeal: '٣٠ يوماً من استلام الحكم المكتوب', modification: 'لا مهلة محددة؛ يمكن التقديم في أي وقت تتغيّر فيه الظروف' },
  { aspect: 'المحكمة', appeal: 'محكمة الاستئناف (الدرجة الثانية)', modification: 'المحكمة الابتدائية ذاتها التي أصدرت الحكم الأصلي' },
  { aspect: 'النتيجة', appeal: 'تأييد الحكم أو تعديله أو إلغاؤه', modification: 'تعديل الحكم القائم بأثر مستقبلي' },
];

const faqItems = [
  {
    question: 'هل يمكن استئناف حكم الحضانة إذا كانت الأم تعزم السفر للخارج مع الأطفال؟',
    answer: 'نعم، وقد تستطيعين أيضاً التقدم بطلب عاجل لمنع السفر بأمر وقتي ريثما يُفصَل في الاستئناف. نقل الأطفال للخارج أحد أسباب الطعن الاستئنافي العاجل. إذا لم يتناول الحكم الابتدائي خطر النقل فهذا مسوّغ قوي للاستئناف. السرعة حاسمة: متى غادر الأطفال الإمارات يصعب التنفيذ ويُطوّل الأمد. وكّل محامياً فور علمك بنية الطرف الآخر في السفر.',
  },
  {
    question: 'هل يمكن استئناف مقدار نفقة الأطفال أو المرأة؟',
    answer: 'نعم. الطعن في مقدار النفقة مقبول في محاكم الاستئناف. الأسباب الشائعة: اعتمدت المحكمة رقماً خاطئاً للدخل، لم تُراعِ قدرة الزوجة على الكسب، أو طبّقت مدةً خاطئة. محاكم الاستئناف تُعدّل مقادير النفقة بصورة شائعة، وهو من أكثر حالات التعديل الجزئي شيوعاً. أما إذا تغيّرت الظروف فعلاً بعد صدور الحكم فالآلية الصحيحة هي طلب تعديل الحكم لا الاستئناف.',
  },
  {
    question: 'متى لا ينبغي رفع استئناف حكم الطلاق؟',
    answer: 'لا ينبغي رفع الاستئناف في الحالات التالية: إذا لم يستطع محاميك تحديد خطأ قانوني واضح، إذا كان الاستياء من وقائع لا من تطبيق القانون، إذا كانت تكلفة الاستئناف تفوق ما قد تسترديه عند النجاح، إذا كنت تُريدين الاستئناف بسبب تغيّر الظروف بعد صدور الحكم (فالتعديل هو الأنسب)، وإذا كان مواصلة التقاضي يُلحق ضرراً نفسياً وعملياً بالأطفال.',
  },
  {
    question: 'هل هناك طعن آخر بعد محكمة الاستئناف؟',
    answer: 'نعم. محكمة التمييز (المحكمة الاتحادية العليا) تنظر في الطعون المحدودة على مسائل قانونية بحتة، لا على الوقائع. هذا يعني أن المحكمة تفحص هل طبّقت محكمة الاستئناف القانون تطبيقاً صحيحاً، لا هل توصلت إلى النتيجة الصحيحة من حيث الوقائع. قضايا الأسرة نادراً ما تصل إلى التمييز في الممارسة؛ الحاجز مرتفع والإجراءات تُضيف تكلفةً ووقتاً إضافيَّين. يُقدّر محاميك ما إذا كان التمييز جديراً بالمسعى في قضيتك.',
  },
  {
    question: 'هل يمكن الاستئناف باللغة العربية والإنجليزية معاً؟',
    answer: 'جميع إجراءات المحاكم الإماراتية تُجرى باللغة العربية. يُقدم محاميك عريضة الاستئناف والمذكرات ووثائق المحكمة بالعربية. إذا أردت المشاركة مباشرةً يُترجم لك محاميك. لا توجد إجراءات إنجليزية في المحاكم الاتحادية أو محاكم الأحوال الشخصية. محاكم DIFC استثناء: تُجرى إجراءاتها بالإنجليزية ولها آليات استئناف مستقلة.',
  },
  {
    question: 'ما الفرق بين استئناف حكم الحضانة وطلب تعديله؟',
    answer: 'الاستئناف: طعن في الحكم الأصلي خلال ٣٠ يوماً بدعوى وجود خطأ في تطبيق القانون وقت صدور الحكم. التعديل: تغيير حكم قائم بسبب تغيّر ظروف جوهرية بعد صدوره (انتقال للخارج، زواج جديد، تغيّر الظروف الصحية أو الاقتصادية). إذا مرّت مهلة الثلاثين يوماً دون استئناف لكن ثمة تغيّر في الظروف فالآلية الصحيحة هي طلب التعديل لا الاستئناف.',
  },
  {
    question: 'كيف تعرف إذا كانت قضيتك مناسبة للاستئناف؟',
    answer: 'القضايا المناسبة للاستئناف تتسم بما يلي: وجود خطأ قانوني محدد في الحكم (كتطبيق المادة القانونية الخاطئة أو سوء تفسير نص القانون)، أو إخلال إجرائي جوهري، أو نتيجة شاذة لا تتوافق مع الأحكام المعتادة في قضايا مماثلة. مجرد عدم الرضا عن الحكم ليس أساساً كافياً. ابدأ باستشارة محامٍ استئنافي قبل اتخاذ أي قرار.',
  },
  {
    question: 'ما تكلفة الاستئناف الواقعية في الإمارات؟',
    answer: 'رسوم إيداع المحكمة: ٥٠٠-٢٠٠٠ درهم حسب الإمارة. أتعاب المحامي: ٨٠٠٠-٢٠٠٠٠ درهم (إعداد مذكرة الاستئناف والحضور والمراسلات). الميزانية الإجمالية الواقعية: ١٠٠٠٠-٢٥٠٠٠ درهم. نسبة الإلغاء الكلي للأحكام الابتدائية: ١٥-٢٥٪، والتعديل الجزئي يحدث في ٤٠-٦٠٪ من قضايا الاستئناف. محامٌ صادق سيُقيّم أسباب قضيتك قبل أن ينصحك بالمضي.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">استئناف أحكام الطلاق · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        حكم الطلاق ليس بالضرورة الكلمة الفصل. منظومة الطعن في المحاكم الإماراتية متاحة لكن النافذة ضيّقة والأسباب المقبولة محددة. يشرح هذا الدليل مهلة الثلاثين يوماً، وما تقبله المحاكم من أسباب وما ترفضه، والفرق الجوهري بين الاستئناف وطلب تعديل الحكم — وهو فارق كثيراً ما يُقرّر مآل قضيتك.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="summary-box">
        <h2>أرقام رئيسية</h2>
        <div class="summary-grid">
          <div class="summary-card">
            <p class="summary-label">مهلة الاستئناف</p>
            <p class="summary-value">٣٠ يوماً</p>
            <p class="summary-note">من استلام الحكم المكتوب</p>
          </div>
          <div class="summary-card">
            <p class="summary-label">التكلفة الإجمالية</p>
            <p class="summary-value">١٠٠٠٠-٢٥٠٠٠ درهم</p>
            <p class="summary-note">أتعاب المحامي ورسوم المحكمة</p>
          </div>
          <div class="summary-card">
            <p class="summary-label">نسبة الإلغاء الكلي</p>
            <p class="summary-value">١٥-٢٥٪</p>
            <p class="summary-note">التعديل الجزئي أكثر شيوعاً</p>
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>هل يمكن الطعن في حكم الطلاق بالإمارات؟</h2>
        <p>
          نعم. جميع أحكام الطلاق الابتدائية في الإمارات، سواء صدرت من محاكم الأحوال الشخصية أو محاكم الأسرة أو الأقسام المدنية، قابلة للطعن أمام محكمة الاستئناف. هذه المحكمة مختصة بمراجعة حكم الدرجة الأولى بحثاً عن أخطاء قانونية وإخلالات إجرائية وظلم صارخ.
        </p>
        <p>
          المهلة الحاسمة هي <strong>ثلاثون يوماً من استلام الحكم المكتوب</strong>. فواتها يُغلق باب الاستئناف في الغالب، فالمحاكم الإماراتية نادراً ما تمنح تمديداً لهذه المهلة لأنها مسألة نظام عام. المهلة تبدأ من استلام الحكم المكتوب لا من صدوره شفهياً في الجلسة.
        </p>
        <p>
          لقضايا الحضانة مسار استئناف معجَّل: تُنظر الاستئنافات في غضون ٦٠-٩٠ يوماً عادةً نظراً لأن التأخر يُلحق الضرر مباشرةً بالأطفال. تولي المحاكم هذه القضايا الأولوية في التحديد.
        </p>
        <div class="info-box info-box--warning">
          <h3>لا تتأخر عن مهلة الثلاثين يوماً</h3>
          <p>إذا اعتقدت أن لديك أسباباً للاستئناف وكّل محامياً فور استلامك الحكم المكتوب. الانتظار لمعرفة ما إذا يمكن التسوية ودياً يُضيّع وقتاً لا تستطيع استرداده. حتى لو كانت مفاوضات جارية قدِّم عريضة الاستئناف في المهلة للحفاظ على حقك.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>الأسباب المقبولة للاستئناف في المحاكم الإماراتية</h2>
        <p>
          الاستئناف ليس فرصة ثانية للتجادل بالوقائع ذاتها. محكمة الاستئناف تراجع الحكم الابتدائي بحثاً عن أنواع بعينها من الأخطاء. يجب عليك تحديد سبب قانوني معترف به لأن مجرد عدم الرضا عن النتيجة لا يكفي.
        </p>
        <div class="grounds-list">
          {grounds.map((item) => (
            <div class="ground-card">
              <h3>{item.ground}</h3>
              <p>{item.detail}</p>
            </div>
          ))}
        </div>
        <p>
          أكثر أسباب الاستئناف نجاحاً في قضايا الأسرة هو <strong>الخطأ في تطبيق القانون</strong>، كأن تُحسب المحكمة مدة العدة خطأً أو تُطبق قواعد النفقة بشكل مغلوط أو تُغفل معيار الحضانة الصحيح. الخلاف الوقائعي البحت أصعب بكثير في الاستئناف ما لم تكن النتيجة الوقائعية شاذةً تماماً.
        </p>
      </section>

      <section class="content-section">
        <h2>استئناف أحكام الحضانة والنفقة</h2>
        <h3>استئناف أحكام الحضانة</h3>
        <p>
          تتعامل المحاكم الإماراتية مع استئنافات الحضانة بأولوية قصوى لأن التأخير يُلحق ضرراً مباشراً بالأطفال. المسار المعجَّل ٦٠-٩٠ يوماً ينطبق على النزاعات التي تُتنازع فيها الحضانة مع قاصر. إذا كان الحكم الابتدائي يُعرّض الطفل للخطر يمكنك طلب أمر وقتي عاجل أثناء الاستئناف.
        </p>
        <p>
