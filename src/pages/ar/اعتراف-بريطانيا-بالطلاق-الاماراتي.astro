const title = 'هل تعترف بريطانيا بالطلاق الإماراتي؟ دليل كامل';
const description =
  'هل يُعترف بطلاقك الإماراتي في إنجلترا وويلز؟ شرح قانون الأسرة لعام ١٩٨٦، مسألة الطلاق بالإرادة المنفردة، الأوامر المالية، قاعدة اسكتلندا، وقضية SA v FA وخطوات التصديق.';

const canonical = 'https://divorceu.ae/ar/اعتراف-بريطانيا-بالطلاق-الاماراتي/';

