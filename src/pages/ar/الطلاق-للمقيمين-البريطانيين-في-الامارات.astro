---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الطلاق للمقيمين البريطانيين في الإمارات — القانون الإماراتي مقابل القانون الإنجليزي';
const description =
  'دليل شامل للمواطنين البريطانيين المقيمين في الإمارات: الإطار القانوني المقارن، قضية SA v FA 2022، الاعتراف البريطاني بأحكام الطلاق الإماراتية، وخيار المطالبة المالية في إنجلترا بعد الطلاق الإماراتي بموجب المادة الثالثة من قانون 1984.';

const canonical = 'https://divorceu.ae/ar/الطلاق-للمقيمين-البريطانيين-في-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/british-expat-divorce-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الطلاق للمقيمين البريطانيين في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل تعترف إنجلترا بحكم الطلاق الصادر من محاكم الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم، بشكل عام. أكّدت قضية SA v FA [2022] EWFC 115 أن محكمة الأسرة المدنية بأبوظبي تُشكِّل منتدى قانونياً مشروعاً يُحقِّق عدالة جوهرية مقارنة بالمعايير الإنجليزية. يُعترف بأحكام الطلاق الإماراتية في إنجلترا بعد التصديق عبر وزارة العدل الإماراتية ووزارة الخارجية (الأبوستيل). الاعتراف لا يعني إنهاء المطالبات المالية تلقائياً.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما هي قضية SA v FA [2022] وما أثرها على المواطنين البريطانيين في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'SA v FA هي قضية أمام المحكمة العائلية الإنجليزية تضمَّنت زوجَين بريطانيَّين أقاما في أبوظبي أكثر من 14 عاماً. رفع كلاهما دعوى طلاق متزامنة في الإمارات وإنجلترا. أقرَّت المحكمة الإنجليزية بأن محكمة الأسرة المدنية بأبوظبي مؤهَّلة وعادلة، وأوقفت الإجراءات الإنجليزية لصالح الإجراءات الإماراتية. هذه القضية مرجع أساسي لكل بريطاني يواجه مسألة الاختيار بين القضاءَين.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن للزوج البريطاني الطلاق في إنجلترا وهو مقيم في دبي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم، إذا كان يحتفظ بموطنه القانوني الإنجليزي. الموطن القانوني يختلف عن الإقامة الفعلية؛ كثير من البريطانيين المقيمين في دبي لا يزالون يحملون موطناً إنجليزياً لأصل. قانون الموطن والإجراءات الزوجية لعام 1973 يُخوِّل المحاكم الإنجليزية الاختصاص إذا كان أحد الطرفين مُقيِّداً في إنجلترا. السبق في تقديم الدعوى مهم — أيُّ المحكمتَين تتلقى الدعوى أولاً قد تكون حاسمةً.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما هي المادة الثالثة من قانون الإجراءات الزوجية والعائلية لعام 1984 (الجزء الثالث MFPA)؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'هي آلية تتيح لأحد الزوجين — بعد الحصول على طلاق في دولة أجنبية — اللجوء إلى المحاكم الإنجليزية للحصول على تسوية مالية إضافية. تشترط صلةً بإنجلترا: إما الموطن القانوني، أو سنة إقامة اعتيادية في إنجلترا، أو ملكية عقار في إنجلترا. ليست إعادة محاكمة كاملة — بل شبكة أمان لمنع الظلم المالي الصارخ.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل حكم الطلاق الإماراتي يُنهي حق الزوجة البريطانية في المطالبة بالمعاش في إنجلترا؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا بالضرورة. الطلاق الإماراتي لا يُصدر أوامر مشاركة في المعاش (القانون الإماراتي لا يعرف هذه الآلية). الزوجة البريطانية التي تمتلك صلةً بإنجلترا (موطن أو إقامة) يمكنها تقديم طلب بموجب الجزء الثالث MFPA للمطالبة بنصيب من معاش الزوج في إنجلترا حتى بعد صدور حكم الطلاق الإماراتي.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الفرق الجوهري بين تقسيم الأصول وفق القانونَين الإماراتي والإنجليزي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'القانون الإماراتي: مبدأ الملكية المنفصلة — كل طرف يحتفظ بما هو مسجَّل باسمه، بصرف النظر عن مدة الزواج أو من كان يعمل. القانون الإنجليزي: إعادة توزيع كاملة للثروة الزوجية بما فيها الأصول المكتسبة قبل الزواج في بعض الحالات، والمعاشات، وحقوق الاستحقاق المستقبلية. على شقة دبي بقيمة 3 ملايين درهم باسم الزوج: في الإمارات = تبقى للزوج؛ في إنجلترا = يُعيَّن فيها وفق مبدأ التوزيع العادل.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل الشريك البريطاني الذي كان يتقاضى راتباً في دبي ملزم بإفصاح مالي كامل أمام المحاكم الإنجليزية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. المحاكم الإنجليزية تتطلب إفصاحاً مالياً كاملاً من كلا الطرفين بصرف النظر عن مكان دخل الطرف الآخر أو مكان أصوله. الإخفاء المتعمد للأصول أمام المحاكم الإنجليزية يُشكِّل احتقاراً للمحكمة ويمكن أن يُفضي إلى عقوبات صارمة.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا يعني الموطن القانوني الإنجليزي وكيف أتحقق من أن لديّ موطناً إنجليزياً؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الموطن القانوني يختلف عن الجنسية أو الإقامة. البريطاني الذي وُلد في إنجلترا يحمل "موطن الأصل" الإنجليزي حتى يتخلى عنه صراحةً باتخاذ إجراءات محددة: الانتقال إلى دولة أخرى بنية الاستيطان الدائم واتخاذها وطناً دائماً. الإقامة في الإمارات لأغراض العمل دون نية التوطين الدائم لا تُسقط الموطن الإنجليزي في الغالب. تحقق من وضعك مع محامٍ بريطاني متخصص قبل اتخاذ أي قرار.',
      },
    },
  ],
};

const compareTable = [
  { aspect: 'تقسيم الأصول', uae: 'الملكية المنفصلة — ما باسمك لك', england: 'إعادة توزيع كاملة للثروة الزوجية' },
  { aspect: 'المعاش', uae: 'لا يُقسَّم — لا توجد أوامر مشاركة في المعاش', england: 'أوامر مشاركة أو تخصيص في المعاش متاحة' },
  { aspect: 'النفقة المستمرة', uae: 'محدودة بعام واحد (تعويض معنوي لغير المسلمين)', england: 'نفقة دورية قد تستمر لسنوات أو إلى أجل غير مسمى' },
  { aspect: 'مدة الطلاق غير المتنازع عليه', uae: 'أقل من شهر (أبوظبي) / 3 أشهر (دبي)', england: 'حد أدنى 26 أسبوعاً (طلاق بدون ذنب)' },
  { aspect: 'العقار المملوك للزوج فقط', uae: 'يبقى للزوج المالك بالكامل', england: 'قابل للتقاسم بحسب المساهمة ومصلحة الأطفال' },
  { aspect: 'اعتبار مساهمة رعاية المنزل', uae: 'لا تُحتسب مساهمة اقتصادية في الأصول', england: 'تُحتسب بالتساوي مع المساهمة المالية' },
];

const faqItems = [
  {
    question: 'متى يُفضَّل للبريطاني المقيم في الإمارات اختيار الطلاق الإماراتي؟',
    answer: 'الطرف الأكثر ثروةً أو الذي يحتفظ بالأصول باسمه يستفيد في الغالب من الطلاق الإماراتي. المميزات: أسرع بكثير (أسابيع بدلاً من أشهر)، أقل تكلفةً، ومبدأ الملكية المنفصلة يُبقي أصوله سليمة. إذا كان دخلك الأعلى وعقارات دبي باسمك والمدخرات في حسابك المنفرد — الطلاق الإماراتي يحمي وضعك المالي.',
  },
  {
    question: 'متى يُفضَّل للبريطاني المقيم في الإمارات اختيار الطلاق الإنجليزي؟',
    answer: 'الزوج الأضعف مالياً — من أخذ إجازة من العمل لتربية الأطفال، أو الذي دخله أقل بكثير، أو الذي لا يملك شيئاً باسمه — يستفيد من القانون الإنجليزي. مثال: زوجة بريطانية لم تعمل لمدة 10 سنوات لتربية الأطفال وزوجها يملك شقة بقيمة 4 ملايين درهم: تحت القانون الإماراتي لا تحصل على حصة في العقار؛ في إنجلترا قد تحصل على 40–50% من إجمالي الثروة الزوجية.',
  },
  {
    question: 'ما الذي تعنيه نتيجة قضية SA v FA عملياً للبريطانيين في الإمارات؟',
    answer: 'تعني: (1) المحاكم الإنجليزية ستوقف الإجراءات إذا كانت الدعوى قُدِّمت في أبوظبي أولاً؛ (2) الحكم الإماراتي سيُعترف به في إنجلترا بعد التصديق؛ (3) لا يزال الباب مفتوحاً للزوج الأضعف مالياً للتقدم بموجب الجزء الثالث MFPA إذا كانت التسوية الإماراتية قاصرةً جداً. العبرة: السبق في تقديم الدعوى يُحدِّد الاتجاه.',
  },
  {
    question: 'كيف يُؤثر توقيت نقل العقارات على الطلاق البريطاني الإماراتي؟',
    answer: 'هذا جانب تقني مالي بالغ الأهمية. نقل الملكية في دائرة الأراضي والأملاك بين الزوجَين أثناء سريان الزواج: رسوم 0.125% (سعر الأقارب من الدرجة الأولى). بعد صدور حكم الطلاق: رسوم 4%. على شقة بقيمة 2 مليون درهم: الفرق بين 2,500 درهم و80,000 درهم. نفِّذ نقل الملكية ضمن اتفاقية التسوية قبل صدور الحكم النهائي.',
  },
  {
    question: 'هل تحتاج إلى محامٍ بريطاني ومحامٍ إماراتي في آنٍ واحد؟',
    answer: 'في معظم القضايا التي تنطوي على أصول كبيرة أو موطن قانوني إنجليزي أو أطفال يحملون جنسية بريطانية: نعم، يُوصى بتوكيل محامٍ في كل اختصاص. المحامي الإماراتي يتولى الإجراءات المحلية والتسوية والتنفيذ. المحامي البريطاني يُقيِّم مسألة الموطن وإمكانية المطالبة بموجب الجزء الثالث MFPA، ويقدم المشورة حول تنفيذ أي أحكام في المملكة المتحدة.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">دليل الطلاق · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        أكثر من 100,000 بريطاني يقيمون في الإمارات. حين يواجه أحدهم الطلاق يقف أمام قراراً استراتيجياً حاسماً: هل يتقدم للمحاكم الإماراتية أم للمحاكم الإنجليزية؟ الإجابة تُحدِّد بالأرقام ما الذي سيحمله معه في نهاية المطاف.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="answer-box">
        <h2>نقاط الاستراتيجية الأساسية</h2>
        <ul>
          <li><strong>من يملك أصولاً باسمه</strong> يستفيد من القانون الإماراتي (ملكية منفصلة).</li>
          <li><strong>من هو أضعف مالياً</strong> يستفيد من القانون الإنجليزي (إعادة توزيع كاملة + معاش).</li>
          <li><strong>قضية SA v FA 2022</strong> أكّدت اعتراف إنجلترا بمحاكم أبوظبي — لكن الباب الإنجليزي لم يُغلَق تماماً.</li>
          <li><strong>السبق في تقديم الدعوى</strong> يُحدِّد القضاء المختص في الغالب.</li>
          <li><strong>توقيت نقل العقار</strong> يُوفِّر أو يُكلِّف عشرات الآلاف من الدراهم.</li>
        </ul>
      </div>

      <section class="content-section">
        <h2>الإطار القانوني المقارن: الإمارات مقابل إنجلترا</h2>

        <div class="compare-table" style="overflow-x: auto; margin-bottom: 1rem;">
          <table style="width:100%; border-collapse: collapse; font-size: 0.875rem;">
            <thead>
              <tr style="background: #0a1628; color: white;">
                <th style="padding: 0.75rem; text-align: right;">الجانب</th>
                <th style="padding: 0.75rem; text-align: right;">قانون الإمارات</th>
                <th style="padding: 0.75rem; text-align: right;">القانون الإنجليزي</th>
              </tr>
            </thead>
            <tbody>
              {compareTable.map((row, i) => (
                <tr style={`background: ${i % 2 === 0 ? '#f9fafb' : 'white'};`}>
                  <td style="padding: 0.6rem 0.75rem; font-weight: 600;">{row.aspect}</td>
                  <td style="padding: 0.6rem 0.75rem;">{row.uae}</td>
                  <td style="padding: 0.6rem 0.75rem;">{row.england}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p>
          الفارق الأكبر: عقار دبي بقيمة 3 ملايين درهم مسجَّل باسم الزوج — تحت القانون الإماراتي لا تملك الزوجة حصةً فيه مهما بلغت مدة الزواج. تحت القانون الإنجليزي يدخل في حساب الثروة الزوجية ويُعاد توزيعه.
        </p>
      </section>

      <section class="content-section">
        <h2>قضية SA v FA [2022] EWFC 115 — التفاصيل والأثر</h2>

        <p>
          في عام 2022، نظرت المحكمة العائلية الإنجليزية في قضية زوجَين بريطانيَّين أقاما في أبوظبي منذ عام 2008. حين بدأت إجراءات الطلاق، تقدَّم كلاهما بدعوى متزامنة: هو في أبوظبي، هي في إنجلترا.
        </p>
        <p>
          قرَّرت القاضية أن محكمة الأسرة المدنية في أبوظبي "تبدو متوافقةً بشكل عام مع المحاكم في إنجلترا والدول غير المسلمة"، وأنه "سيكون خطأً الاستنتاج بأن النظام الإنجليزي وحده يُحقِّق العدالة الجوهرية." وعليه أوقفت الإجراءات الإنجليزية لصالح أبوظبي.
        </p>
        <p>
          لكن القاضية نوَّهت صراحةً: حكم الطلاق الإماراتي لا يُغلق باب المطالبات المالية في إنجلترا إغلاقاً نهائياً. إذا جاءت التسوية الإماراتية قاصرةً بصورة صارخة عما اعتبره قانون إنجلترا عادلاً، يُمكن للزوج الأضعف مالياً التقدم بطلب وفق الجزء الثالث من قانون MFPA 1984.
        </p>

        <div class="info-box">
          <p><strong>الدرس العملي من SA v FA:</strong> الزوج الذي يتصرف أولاً ويُقدِّم دعواه في أبوظبي يُرسِّخ اختصاص المحاكم الإماراتية ويحوز على حكم أسرع بكثير. لكن الطرف الأضعف ماليًا يظل يملك خياراً احتياطياً إنجليزياً إذا كانت صلته بإنجلترا قائمة. المفتاح: التصرف قبل الطرف الآخر وليس بعده.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>الجزء الثالث من قانون MFPA 1984 — شبكة الأمان الإنجليزية</h2>

        <h3>ما هو الجزء الثالث؟</h3>
        <p>
          قانون الإجراءات الزوجية والعائلية لعام 1984 — الجزء الثالث يُتيح للزوج الذي طُلِّق خارج إنجلترا التقدم إلى المحاكم الإنجليزية للمطالبة بتسوية مالية إضافية. هذا الطريق مفتوح بعد الحصول على الطلاق في الإمارات.
        </p>

        <h3>شروط قبول الطلب</h3>
        <p>يجب توافر إحدى الصلات الثلاث بإنجلترا:</p>
        <div class="factors-list">
          <div class="factor-item">
            <h3>الموطن القانوني الإنجليزي</h3>
            <p>أحد الزوجَين يحمل موطناً إنجليزياً (أصلياً أو مكتسباً). البريطاني المقيم في الإمارات للعمل دون نية التوطين الدائم يحتفظ عادةً بموطنه الإنجليزي.</p>
          </div>
          <div class="factor-item">
            <h3>سنة إقامة اعتيادية في إنجلترا</h3>
            <p>إذا قضى الزوج المتقدم سنةً كاملة معيشاً في إنجلترا قبل تقديم الطلب، ولو بعد الطلاق الإماراتي وعودته إلى إنجلترا.</p>
          </div>
          <div class="factor-item">
            <h3>ملكية عقار في إنجلترا</h3>
            <p>إذا كان لأحد الزوجَين مصلحة انتفاعية في عقار يقع في إنجلترا مستخدَم أو كان يُستخدَم كمسكن زوجي.</p>
          </div>
        </div>

        <h3>ما الذي يحصل عليه المتقدم؟</h3>
        <p>
          الجزء الثالث ليس إعادة محاكمة كاملة. المحكمة الإنجليزية تطبق مبدأ الاحتياج والعدالة لمنع "الضرر الحقيقي والظلم الجسيم" (مبدأ Agbaje v Agbaje [2010]). قد تُصدر أوامر مشاركة في المعاش، أو نقل ملكية عقار إنجليزي، أو دفع مبلغ مقطوع.
        </p>
      </section>

      <section class="content-section">
        <h2>الموطن القانوني — السؤال الأهم للبريطاني في الإمارات</h2>

        <p>
          الموطن القانوني مفهوم قانوني ليس له مقابل مباشر في القانون العربي. البريطاني الذي وُلد في إنجلترا يحمل "موطن الأصل" الإنجليزي حتى يثبت قانوناً تركه. الانتقال إلى الإمارات للعمل لا يُسقط الموطن الإنجليزي بمجرده.
        </p>
        <p>
          الإسقاط يتطلب: الانتقال إلى دولة أخرى بنية الإقامة الدائمة فيها بوصفها وطناً، مع التخلي عن نية العودة إلى إنجلترا. معظم البريطانيين في دبي يُبقون هذه النية مفتوحة ولو بشكل ضمني — وبالتالي يحتفظون بموطنهم الإنجليزي.
        </p>

        <div class="info-box">
          <p><strong>توصية عملية:</strong> لا تفترض وضعك القانوني من تلقاء نفسك. استشر محامياً إنجليزياً متخصصاً في قانون الأسرة لتحديد موطنك القانوني قبل أي إجراء. هذا التحديد يُحدِّد خياراتك الاستراتيجية كاملاً.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>توقيت نقل العقارات — تفصيل الأرقام</h2>

        <p>
          إذا كنتما تمتلكان عقاراً مشتركاً في دبي ويُريد أحدكما الاستحواذ على حصة الآخر كجزء من التسوية، فالتوقيت حاسم مالياً.
        </p>

        <div class="types-list">
          <div class="type-card">
            <div class="type-header">
              <span class="type-icon">✅</span>
              <div>
                <h3 class="type-name">نقل الملكية قبل حكم الطلاق</h3>
              </div>
            </div>
            <p class="type-detail">رسوم دائرة الأراضي والأملاك: 0.125% من قيمة العقار (نسبة الأقارب من الدرجة الأولى). على عقار بقيمة 2,000,000 درهم: 2,500 درهم فقط. يتطلب تنسيقاً دقيقاً: توقيع اتفاقية التسوية أولاً، ثم نقل الملكية قبل التوقيع على وثيقة الطلاق.</p>
          </div>
          <div class="type-card">
            <div class="type-header">
              <span class="type-icon">⚠️</span>
              <div>
                <h3 class="type-name">نقل الملكية بعد حكم الطلاق</h3>
              </div>
            </div>
            <p class="type-detail">رسوم دائرة الأراضي والأملاك: 4% من قيمة العقار (نسبة الأطراف الأجنبية). على عقار بقيمة 2,000,000 درهم: 80,000 درهم. الفارق: 77,500 درهم. هذا رقم يستحق تصحيح التوقيت.</p>
          </div>
        </div>
