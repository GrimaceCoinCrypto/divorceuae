---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الطلاق بالوساطة والتراضي في الإمارات — أسرع طريق وأقله تكلفة ٢٠٢٥';
const description =
  'وساطة الطلاق في الإمارات قد تُنهي قضيتك في شهرين إلى أربعة أشهر بتكلفة تبدأ من 3,000 درهم بدلاً من سنوات أمام المحكمة. دليل شامل يشرح الفرق بين الإرشاد الأسري الإلزامي والوساطة الخاصة وخطوات كل مسار.';

const canonical = 'https://divorceu.ae/ar/الطلاق-بالوساطة-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/mediated-divorce-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الطلاق بالوساطة في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل الاتفاق المُبرم عبر الوساطة ملزم قانونياً في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الاتفاق المُبرم عبر الوساطة في حد ذاته ليس ملزماً تلقائياً. يجب تقديمه إلى محكمة الأحوال الشخصية للمصادقة عليه ليصبح أمراً قضائياً. بعد المصادقة يكون ملزماً كأي حكم قضائي آخر ويُنفَّذ بالآليات ذاتها.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن إجبار أحد الزوجين على الخضوع للوساطة في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. الوساطة الخاصة طوعية تماماً. جلسات الإرشاد الأسري في دائرة الإرشاد والتوافق الأسري إلزامية لكنها مختلفة. إذا رفض أحد الطرفين الوساطة الخاصة يُلجأ مباشرةً إلى المحكمة. لا تستطيع المحاكم إجبار أحد الطرفين على الوساطة الخاصة.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الفرق بين الإرشاد الأسري الإجباري والوساطة الخاصة في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الإرشاد الأسري جزء من إجراءات المحكمة تُشرف عليه دائرة الإرشاد والتوافق الأسري بهدف المصالحة أو إثبات استحالتها. الوساطة الخاصة مستقلة تماماً عن المحكمة وطوعية وسرية بالكامل والهدف منها الوصول إلى تسوية عملية لا إنقاذ الزواج.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل تعكس الوساطة الطلاق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. الوساطة في سياق الطلاق هدفها الوصول إلى شروط تسوية عملية لا إنقاذ الزواج. هي منفصلة عن جلسات الإرشاد التي تهدف إلى المصالحة. إذا كنت قد قررت الطلاق، الوساطة تُسرّع الوصول إلى شروط عادلة.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يجوز للطرفين الخضوع للوساطة عبر الفيديو إذا كان أحدهما خارج الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم في حالات كثيرة. بعض جلسات الوساطة تُعقد عبر مكالمة فيديو إذا كان أحد الطرفين في الخارج. يستلزم ذلك موافقة الطرفين والوسيط. المطلوب اتصال إنترنت جيد وترتيب مسبق للأوقات عبر المناطق الزمنية.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الموضوعات التي يمكن معالجتها في وساطة الطلاق بالإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تقسيم الأصول، مبالغ النفقة ومدتها، جداول الحضانة، نفقة الأطفال، ترتيبات الرسوم الدراسية، بيع العقارات أو نقل ملكيتها، التعامل مع الحصص التجارية، المسؤولية عن الديون. كل ما يمكن للمحكمة الحكم به يمكن التوسط فيه.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا يحدث إذا فشلت الوساطة في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا تضر قضيتك القانونية في شيء. سرية الوساطة راسخة: لا يُشار إلى أي شيء قيل في الجلسات ولا يُستخدم دليلاً في إجراءات المحكمة اللاحقة. في كثير من الأحيان تُنتج حتى "الوساطات الفاشلة" اتفاقيات جزئية تُقلّص نطاق الخلاف أمام المحكمة.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يجب على الوسيط أن يكون مرخّصاً لتسوية طلاق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا يوجد سجل إلزامي موحّد للوسطاء في النزاعات الأسرية بالإمارات حالياً. يُستحسن البحث عن وسيط حاصل على تدريب وشهادة معتمدة، ولديه خبرة في النزاعات الأسرية تحديداً ومعرفة بقانون الأحوال الشخصية الإماراتي. مراكز التحكيم المعتمدة (DIAC) توفر قوائم بوسطاء مؤهلين.',
      },
    },
  ],
};

const comparisonRows = [
  { item: 'الأتعاب المهنية', mediation: '١,٠٠٠ - ٣,٠٠٠ درهم للجلسة (٣-٦ جلسات عادةً)', court: '١٥,٠٠٠ - ٦٠,٠٠٠ درهم لكل طرف' },
  { item: 'مصادقة المحكمة', mediation: '٣٠٠ - ٦٠٠ درهم لتوثيق الاتفاق', court: '١,٠٠٠ - ٣,٠٠٠ درهم رسوم ومصاريف' },
  { item: 'المدة الزمنية', mediation: '٢ - ٤ أشهر', court: '٦ - ٢٤ شهراً' },
  { item: 'التكلفة العاطفية', mediation: 'أقل بكثير - إجراء تعاوني', court: 'مرتفعة - إجراء تنافسي' },
  { item: 'المجموع التقديري', mediation: '٣,٠٠٠ - ١٥,٠٠٠ درهم', court: '٢٠,٠٠٠ - ٨٠,٠٠٠+ درهم' },
];

const steps = [
  { n: 1, title: 'الجلسة الافتتاحية المشتركة', body: 'يلتقي الطرفان بالوسيط معاً لتحديد قواعد الجلسة (السرية، والاحترام، وعدم المقاطعة) ورسم خريطة المسائل الخلافية. لكل طرف فرصة لعرض موقفه باختصار.' },
  { n: 2, title: 'الجلسات الفردية الخاصة', body: 'يلتقي الوسيط بكل طرف على حدة في جلسات خاصة. يتيح هذا المجال للحديث بصراحة عن المخاوف الحقيقية والأولويات والتنازلات الممكنة. لا يُفصح الوسيط عن مضمون هذه الجلسات دون إذن.' },
  { n: 3, title: 'جلسات التفاوض', body: 'يجتمع الطرفان مجدداً والوسيط يُدير النقاش مسألةً مسألة. الأصول أولاً ثم الحضانة وترتيبات الأطفال ثم الدعم المالي. المحامون قد يحضرون هذه الجلسات للاستشارة الآنية.' },
  { n: 4, title: 'صياغة محضر الاتفاق', body: 'بعد التوصل إلى شروط يُصاغ وثيقة تتضمن جميع البنود المتفق عليها بلغة واضحة ودقيقة. يراجعها الطرفان ويوقعانها. هذا المحضر هو الأساس غير الملزم الذي يُقدَّم للمحكمة.' },
  { n: 5, title: 'المصادقة القضائية', body: 'يُقدَّم الاتفاق الموقّع إلى محكمة الأحوال الشخصية للمصادقة. تراجع المحكمة البنود للتأكد من عدم مخالفتها للقانون أو مصلحة الأطفال. بعد المصادقة يصبح أمراً قضائياً قابلاً للتنفيذ بالقوة القانونية ذاتها للأحكام القضائية.' },
];

const faqItems = [
  {
    question: 'هل الاتفاق المُبرم عبر الوساطة ملزم قانونياً في الإمارات؟',
    answer: 'ليس ملزماً تلقائياً. يجب تقديمه للمحكمة للمصادقة عليه ليصبح أمراً قضائياً. بعد المصادقة يُنفَّذ بالآليات ذاتها لأي حكم قضائي.',
  },
  {
    question: 'هل يمكن إجبار أحد الزوجين على الخضوع للوساطة في الإمارات؟',
    answer: 'لا. الوساطة الخاصة طوعية تماماً. إذا رفض أحد الطرفين يُلجأ للمحكمة مباشرةً. جلسات الإرشاد الأسري في دائرة الإرشاد والتوافق إلزامية لكنها مختلفة.',
  },
  {
    question: 'ما الفرق بين الإرشاد الأسري الإجباري والوساطة الخاصة في الإمارات؟',
    answer: 'الإرشاد الأسري جزء من إجراءات المحكمة هدفه المصالحة. الوساطة الخاصة مستقلة وطوعية وسرية وهدفها الوصول إلى تسوية لا إنقاذ الزواج.',
  },
  {
    question: 'هل تعكس الوساطة الطلاق في الإمارات؟',
    answer: 'لا. الوساطة في الطلاق تهدف إلى شروط تسوية عملية لا إنقاذ الزواج. هي منفصلة عن جلسات الإرشاد.',
  },
  {
    question: 'هل يجوز للطرفين الخضوع للوساطة عبر الفيديو؟',
    answer: 'نعم في حالات كثيرة بشرط موافقة الطرفين والوسيط وترتيب مسبق للأوقات عبر المناطق الزمنية.',
  },
  {
    question: 'ما الموضوعات التي يمكن معالجتها في وساطة الطلاق؟',
    answer: 'تقسيم الأصول والنفقة والحضانة ونفقة الأطفال والرسوم الدراسية والعقارات والحصص التجارية والديون. كل ما يمكن للمحكمة الحكم به يمكن التوسط فيه.',
  },
  {
    question: 'ماذا يحدث إذا فشلت الوساطة؟',
    answer: 'لا تضر قضيتك القانونية. سرية الوساطة راسخة. كثيراً ما تُنتج حتى الوساطات الفاشلة اتفاقيات جزئية تُقلّص نطاق الخلاف أمام المحكمة.',
  },
  {
    question: 'هل يجب على الوسيط أن يكون مرخّصاً لتسوية طلاق في الإمارات؟',
    answer: 'لا يوجد سجل إلزامي موحّد حالياً. يُستحسن البحث عن وسيط حاصل على تدريب معتمد وخبرة في النزاعات الأسرية. مراكز DIAC توفر قوائم بوسطاء مؤهلين.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">الطلاق بالتراضي والوساطة · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        الطلاق عبر المحاكم في الإمارات قد يستغرق ستة أشهر إلى سنتين ويكلف 20,000 إلى 80,000 درهم أو أكثر في أتعاب المحامين وحدها. الوساطة الخاصة تقدم بديلاً منظماً: وسيط محايد يساعدك وزوجك على التوصل إلى اتفاق ملزم في شهرين إلى أربعة أشهر بجزء بسيط من التكلفة.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="summary-grid-wrap">
        <div class="summary-card">
          <p class="s-label">تكلفة الوساطة</p>
          <p class="s-value">٣,٠٠٠ - ١٥,٠٠٠ درهم</p>
          <p class="s-note">مقابل ٢٠,٠٠٠ - ٨٠,٠٠٠+ أمام المحكمة</p>
        </div>
        <div class="summary-card">
          <p class="s-label">المدة الزمنية</p>
          <p class="s-value">٢ - ٤ أشهر</p>
          <p class="s-note">مقابل ٦ - ٢٤ شهراً في المحكمة</p>
        </div>
        <div class="summary-card">
          <p class="s-label">نسبة النجاح</p>
          <p class="s-value">٦٠ - ٧٠٪</p>
          <p class="s-note">حين يتعاون الطرفان بجدية</p>
        </div>
      </div>

      <div class="answer-box">
        <h2>ما الوساطة في الطلاق وكيف تعمل في الإمارات؟</h2>
        <p>
          وساطة الطلاق إجراء تفاوضي طوعي ومنظّم يُساعد فيه وسيط محايد الزوجَين على التوصل إلى اتفاق في المسائل العملية التي يُفرزها الانفصال. الوسيط لا يتخذ قرارات ولا يعمل حكماً؛ دوره تيسير التواصل ومساعدة كل طرف على فهم موقف الآخر والتوجيه نحو التسوية.
        </p>
        <p>
          ميزة أساسية هي السرية التامة. ما يُقال في الوساطة من تنازلات ومقترحات لا يجوز الاستناد إليه دليلاً أمام المحكمة إذا فشلت الوساطة. هذه الحماية تُشجع على النقاش المفتوح والتسوية الصادقة.
        </p>
      </div>

      <section class="content-section">
        <h2>الإرشاد الأسري الإجباري مقابل الوساطة الخاصة: الفرق الجوهري</h2>
        <p>
          أكثر نقاط الالتباس شيوعاً لدى من يسلكون طريق الطلاق في الإمارات هو الخلط بين جلسات الإرشاد الأسري المقرّرة قانونياً والوساطة الخاصة الاختيارية. هما شيئان مختلفان كلياً.
        </p>

        <h3>الإرشاد والتوافق الأسري (إلزامي)</h3>
        <p>
          قبل أن تُصدر المحاكم الإماراتية حكماً في دعوى طلاق متنازع عليها، يُلزَم الطرفان بحضور جلسات في دائرة الإرشاد والتوافق الأسري. يُديرها أخصائيون اجتماعيون ومرشدون بهدف المصالحة وإعادة اللمّ. إذا تعذّرت المصالحة بعد جلسة إلى أربع جلسات يُصدر مرسوم إحالة وتستمر الدعوى القضائية.
        </p>
        <p>
          هذه الجلسات ليست سرية بالمعنى المطلق للوساطة الخاصة، إذ قد يُرفع تقرير منها إلى المحكمة. المشاركة إلزامية وهي جزء من مسار المحكمة وليست بديلاً عن الوساطة الخاصة.
        </p>

        <h3>الوساطة الخاصة (اختيارية)</h3>
        <p>
          الوساطة الخاصة مستقلة تماماً عن مسار المحكمة. يُجريها وسيط مهني مستقل وهي سرية بالكامل وتُدخل إليها طوعاً من الطرفين. يمكن إجراؤها قبل رفع أي دعوى أو بالتوازي معها أو بعد الانتهاء من جلسات الإرشاد دون تحقيق مصالحة.
        </p>
        <p>
          هدف الوساطة الخاصة في سياق الطلاق ليس إنقاذ الزواج بل الوصول إلى شروط تسوية عملية قابلة لتقديمها للمحكمة للمصادقة عليها.
        </p>
      </section>

      <section class="content-section">
        <h2>متى تنجح الوساطة ومتى لا تنجح</h2>

        <h3>الوساطة تنجح حين:</h3>
        <ul class="checklist">
          <li>يرغب الطرفان في التفاعل والتفاوض بحسن نية</li>
          <li>التواصل بينهما صعب لكن ليس مقطوعاً كلياً</li>
          <li>مصلحة الأطفال أولوية لكليهما ويريدان علاقة تعاونية في التربية</li>
          <li>ثمة شراكة تجارية أو مالية كبيرة يودّ كلاهما حلّها بعقلانية</li>
          <li>كلاهما يريد تجنب التقاضي التنافسي العلني المرهق</li>
          <li>التكلفة والسرعة مهمتان وكلاهما لا يريد قضاء سنوات في المحكمة</li>
        </ul>

        <h3>الوساطة لا تصلح في هذه الحالات:</h3>
        <ul class="checklist">
          <li>وجود عنف أسري أو إساءة: الوساطة تتطلب أمناً وتوازناً في القوى لا يتوفران في العلاقات المسيئة</li>
          <li>اختلال حاد في موازين القوى يجعل أحد الطرفين عاجزاً عن الدفاع عن نفسه</li>
          <li>إخفاء أصول أو رفض الإفصاح المالي من أحد الطرفين</li>
          <li>عداوة حادة تجعل الجلسات المشتركة غير قابلة للعمل</li>
          <li>استخدام الوساطة كتكتيك لكسب الوقت أثناء نقل الأصول</li>
        </ul>

        <div class="info-box info-box--warning">
          <h3>في حالة وجود عنف أسري: لا للوساطة</h3>
          <p>الوساطة تفترض التفاوض بين نِدَّين. إذا تعرّضتِ للعنف الأسري اتجهي مباشرةً إلى المحكمة. تمتلك محاكم الإمارات آليات حماية وإجراءات قضائية تنافسية توفر ضمانات لا تستطيع الوساطة توفيرها.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>مقارنة التكلفة: الوساطة مقابل التقاضي الكامل</h2>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>البند</th>
                <th>مسار الوساطة</th>
                <th>التقاضي الكامل</th>
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr>
                  <td class="td-highlight">{row.item}</td>
                  <td>{row.mediation}</td>
                  <td>{row.court}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          حتى لو فشلت الوساطة لا تُهدر الوقت والمال المُنفقَين. كثيراً ما تُحدث الوساطات اتفاقيات جزئية وتُضيّق دائرة الخلاف وتُقلّص نطاق ما يُعرض لاحقاً على المحكمة.
        </p>
      </section>

