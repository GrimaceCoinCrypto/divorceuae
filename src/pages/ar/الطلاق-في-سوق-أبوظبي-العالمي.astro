---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الطلاق في سوق أبوظبي العالمي ADGM: أين تُرفع الدعوى فعلاً؟';
const description =
  'محاكم سوق أبوظبي العالمي ADGM مدنية وتجارية ولا تنظر الطلاق أو الحضانة أو النفقة. تعرّف على المحكمة المختصة بطلاق غير المسلمين في أبوظبي ومصير حصصك في شركات ADGM.';

const canonical = 'https://divorceu.ae/ar/الطلاق-في-سوق-أبوظبي-العالمي/';

const hreflang = {
  en: 'https://divorceu.ae/en/adgm-divorce-abu-dhabi/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الطلاق في سوق أبوظبي العالمي' },
];

const comparisonData = [
  { factor: 'طلاق غير المسلمين المقيمين في أبوظبي', adgm: 'لا تختص', adcfc: 'محكمة الأسرة المدنية في أبوظبي (دائرة القضاء)' },
  { factor: 'طلاق الزوجين المسلمين', adgm: 'لا تختص', adcfc: 'محكمة الأحوال الشخصية في أبوظبي' },
  { factor: 'الحضانة والرؤية', adgm: 'لا تختص', adcfc: 'المحكمة التي تنظر الطلاق' },
  { factor: 'النفقة والتعويض والطلبات المالية بين الزوجين', adgm: 'لا تختص', adcfc: 'المحكمة التي تنظر الطلاق' },
  { factor: 'حصة أحد الزوجين في شركة مسجلة في ADGM', adgm: 'لا تختص بتقسيم أصول الزوجين', adcfc: 'محكمة الأسرة، ضمن الطلبات المالية' },
  { factor: 'نزاع تجاري بين الشركاء أو مع الشركة نفسها', adgm: 'تختص متى توافر أساس اختصاصها', adcfc: 'محاكم ADGM، في دعوى مستقلة عن الطلاق' },
  { factor: 'تسجيل وصية لغير المسلم', adgm: 'تختص، عبر سجل وصايا ADGM', adcfc: 'محاكم ADGM (تخطيط تركات لا طلاق)' },
  { factor: 'إثبات الوصية المسجلة بعد الوفاة', adgm: 'تختص', adcfc: 'محاكم ADGM' },
];

const steps = [
  {
    num: '١',
    title: 'حدّد المحكمة المختصة فعلاً',
    desc: 'غير المسلمين المقيمون في إمارة أبوظبي: محكمة الأسرة المدنية. الزوجان المسلمان: محكمة الأحوال الشخصية. المقيمون في دبي أو إمارة أخرى: المحكمة المختصة هناك. وعملك في ADGM أو ملكيتك لشركة فيه لا يغيّر ذلك.',
  },
  {
    num: '٢',
    title: 'اجمع صورة مالية كاملة',
    desc: 'جهّز كشوف الرواتب والمكافآت، وشهادات الحصص وعقود التأسيس لأي شركة مسجلة في ADGM، والحسابات البنكية والاستثمارية، والعقارات داخل الدولة وخارجها. هذه الأصول تنظرها محكمة الأسرة ضمن الطلبات المالية.',
  },
  {
    num: '٣',
    title: 'اطلب الحماية المؤقتة من محكمة الأسرة عند الحاجة',
    desc: 'إذا خشيت تحويل الأموال أو بيع الحصص، فاطلب الحجز التحفظي من المحكمة التي تنظر النزاع الأسري. لا يوجد طريق أسري لطلب أوامر تجميد من محاكم ADGM.',
  },
  {
    num: '٤',
    title: 'جهّز مستنداتك الشخصية',
    desc: 'عقد الزواج مصدقاً، وجوازات السفر، وبطاقات الهوية الإماراتية، وشهادات ميلاد الأطفال، وأي اتفاق مكتوب بين الزوجين. واسأل محاميك عن متطلبات التصديق والترجمة لكل مستند قبل التقديم.',
  },
  {
    num: '٥',
    title: 'راجع وصيتك',
    desc: 'إن كانت لديك وصية مسجلة في سجل وصايا ADGM أو لدى مركز دبي المالي العالمي، فقد تسمّي زوجك وريثاً أو منفذاً أو وصياً على الأطفال. حدّثها بعد الطلاق، أو سجّل وصية جديدة إن لم تكن لديك واحدة.',
  },
  {
    num: '٦',
    title: 'وكّل محامياً يمثّلك أمام محاكم أبوظبي',
    desc: 'التسجيل لدى محاكم ADGM وحده لا يمنح المحامي حق الترافع أمام محكمة الأسرة المدنية أو محكمة الأحوال الشخصية. اختر محامياً مرخصاً للمثول أمام محاكم أبوظبي، وله خبرة في قضايا غير المسلمين.',
  },
];

const faqItems = [
  {
    question: 'هل يمكنني رفع دعوى طلاق أمام محاكم سوق أبوظبي العالمي ADGM؟',
    answer: 'لا. محاكم سوق أبوظبي العالمي محاكم مدنية وتجارية تعمل بالإنجليزية وفق القانون الإنجليزي العام، ولا تملك اختصاصاً بالطلاق أو الحضانة أو النفقة أو القسمة المالية بين الزوجين. يتطلق غير المسلمين المقيمون في إمارة أبوظبي أمام محكمة الأسرة المدنية التابعة لدائرة القضاء في أبوظبي، ويتطلق الزوجان المسلمان أمام محكمة الأحوال الشخصية.',
  },
  {
    question: 'ما المحكمة التي تنظر طلاق غير المسلمين في أبوظبي؟',
    answer: 'محكمة الأسرة المدنية في أبوظبي، وتسمّيها دائرة القضاء أيضاً محكمة الأسرة لغير المسلمين. تطبّق قانون أبوظبي رقم ١٤ لسنة ٢٠٢١ بشأن الزواج المدني وآثاره، وتعمل بالعربية والإنجليزية، ويجوز فيها لأي من الزوجين طلب الطلاق دون إثبات ضرر أو خطأ. وكثيراً ما تُحسم القضية غير المتنازع عليها في جلسة واحدة.',
  },
  {
    question: 'أعمل لدى شركة مسجلة في ADGM، فهل يجعل ذلك محاكم ADGM مختصة بطلاقي؟',
    answer: 'لا. مكان عملك لا يحدد المحكمة المختصة بالطلاق. العبرة بإقامتك وديانتك وقواعد الاختصاص في قوانين الأسرة. فالموظف غير المسلم المقيم في أبوظبي يتقدم إلى محكمة الأسرة المدنية، والمقيم في دبي يتقدم إلى محكمة الأحوال الشخصية في محاكم دبي، حتى لو كان عمله كله داخل ADGM.',
  },
  {
    question: 'ماذا يحدث لحصتي في شركة مسجلة في ADGM عند الطلاق؟',
    answer: 'تنظرها محكمة الأسرة التي تنظر الطلاق، ضمن الطلبات المالية، كما تنظر أي أصل آخر. تستطيع المحكمة الأمر بالإفصاح عن سجلات الشركة وحساباتها، والاستعانة بخبير لتقييم الحصة، والأمر بالحجز التحفظي وفق الإجراءات المعتادة. وتسجيل الشركة في ADGM لا يُخرجها من هذه الطلبات، ولا ينقل النزاع إلى محاكم ADGM.',
  },
  {
    question: 'هل تستطيع محاكم ADGM إصدار أمر تجميد ضد أموال زوجي في قضية طلاق؟',
    answer: 'لا يوجد مسار أسري لذلك أمام محاكم ADGM، فأوامر التجميد التي تصدرها تخص النزاعات المدنية والتجارية. في النزاع الأسري يُطلب الحجز التحفظي أو منع السفر من محكمة الأسرة المختصة، وهي تنظر هذه الطلبات على وجه الاستعجال عند توافر شروطها.',
  },
  {
    question: 'هل إجراءات محكمة الأسرة المدنية في أبوظبي بالإنجليزية؟',
    answer: 'نعم، فهي محكمة ثنائية اللغة تعمل بالعربية والإنجليزية، وقد أُنشئت لخدمة غير المسلمين في الإمارة. أما محكمة الأحوال الشخصية في دبي فتسير إجراءاتها بالعربية وتحتاج المستندات فيها إلى ترجمة قانونية.',
  },
  {
    question: 'ما علاقة وصايا ADGM بالطلاق؟',
    answer: 'وصايا ADGM أداة لتخطيط التركات، لا للطلاق. يسجّل غير المسلم وصيته في سجل وصايا ADGM لتنتقل أصوله وفق الوصية بدلاً من قواعد الإرث الافتراضية، وتتولى محاكم ADGM إثباتها بعد الوفاة. وبعد الطلاق يحسن مراجعة أي وصية قائمة، لأنها قد تسمّي الزوج السابق وريثاً أو منفذاً أو وصياً على الأطفال.',
  },
  {
    question: 'هل ينطبق الأمر نفسه على محاكم مركز دبي المالي العالمي DIFC؟',
    answer: 'نعم. محاكم مركز دبي المالي العالمي مثل محاكم ADGM: محاكم مدنية وتجارية تعمل بالإنجليزية، وقانون دبي رقم ٢ لسنة ٢٠٢٥ بشأن محاكمها لم يمنحها اختصاصاً بالطلاق أو الحضانة أو النفقة. غير المسلمين المقيمون في دبي يتطلقون أمام محكمة الأحوال الشخصية في محاكم دبي وفق المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} lang="ar" />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">دليل الطلاق في أبوظبي · ADGM ومحكمة الأسرة المدنية</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        يبحث كثير من المقيمين الأجانب في أبوظبي عن «طلاق ADGM»، ظناً أن محاكم سوق أبوظبي العالمي على جزيرة المارية تنظر قضايا الأسرة لأنها تعمل بالإنجليزية وفق القانون الإنجليزي العام. هي لا تنظرها: اختصاصها مدني وتجاري، ولا يشمل الطلاق أو الحضانة أو النفقة. يشرح هذا الدليل ما تختص به هذه المحاكم فعلاً، والمحكمة التي تنظر طلاق غير المسلمين في أبوظبي، وكيف تُعامَل حصتك في شركة مسجلة في ADGM، وأين تفيدك وصايا ADGM.
      </p>
      <p class="hero-author">بقلم <strong>أليكسي سوننين</strong> · مستشار قانوني ومغترب في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="answer-box">
        <h2>الجواب المختصر</h2>
        <p>
          <strong>لا يمكن رفع دعوى طلاق أمام محاكم سوق أبوظبي العالمي (ADGM).</strong>
          اختصاصها مدني وتجاري، إضافة إلى تسجيل وصايا غير المسلمين وإثباتها.
          يتطلق غير المسلمين المقيمون في إمارة أبوظبي أمام <strong>محكمة الأسرة المدنية في أبوظبي</strong> التابعة لدائرة القضاء، وفق <strong>قانون أبوظبي رقم ١٤ لسنة ٢٠٢١ بشأن الزواج المدني وآثاره</strong>:
          إجراءات بالعربية والإنجليزية، وطلاق دون إثبات خطأ، وكثيراً ما تُحسم القضية غير المتنازع عليها في جلسة واحدة.
          ويتطلق الزوجان المسلمان أمام محكمة الأحوال الشخصية.
          أما حصصك في شركات مسجلة في ADGM فتنظرها <strong>محكمة الأسرة</strong> ضمن الطلبات المالية، لا محاكم ADGM.
        </p>
      </div>

      <section class="content-section">
        <h2>لماذا يظن كثيرون أن محاكم ADGM تنظر الطلاق؟</h2>
        <p>
          لأن ظاهرها يوحي بذلك. محاكم سوق أبوظبي العالمي تعمل بالإنجليزية، ويجلس فيها قضاة من دول القانون العام، وتطبّق القانون الإنجليزي العام بموجب لوائح تطبيق القانون الإنجليزي لسنة ٢٠١٥. فتبدو للمغترب القادم من بريطانيا أو أستراليا المكان الطبيعي لطلاقه. وزاد الالتباس أن أبوظبي أنشأت عام ٢٠٢١ إطاراً مدنياً للأسرة لغير المسلمين يعمل بالإنجليزية أيضاً، وأن ADGM يدير سجلاً لوصايا غير المسلمين يُفهم أحياناً على أنه اختصاص أسري.
        </p>
        <p>
          لكن الإطار المدني للأسرة في أبوظبي لم يُسند إلى ADGM، بل إلى محكمة مستقلة داخل دائرة القضاء في أبوظبي هي محكمة الأسرة المدنية. ومحاكم ADGM لا تنظر الطلاق ولا الحضانة ولا النفقة ولا القسمة المالية بين الزوجين، مهما كانت صلة الزوجين بالسوق ومهما بلغت قيمة أصولهما.
        </p>
        <div class="info-box info-box--info">
          <h3>الصلة بـ ADGM لا تنشئ اختصاصاً أسرياً</h3>
          <p>العمل لدى جهة مسجلة في السوق، أو امتلاك شركة فيه، أو الاحتفاظ بحسابات استثمارية عبره، لا يفتح باب محاكمه لقضايا الأسرة. وقد تجد على الإنترنت حديثاً عن «صلة حقيقية وجوهرية بـ ADGM» تكفي لرفع دعوى طلاق، أو عن أوامر تجميد وتفتيش إنجليزية في قضايا طلاق أمام ADGM. هذه معلومات غير صحيحة، والاعتماد عليها قد يضيّع عليك وقتاً ومالاً ويؤخر حماية حقوقك.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>ما الذي تختص به محاكم سوق أبوظبي العالمي فعلاً؟</h2>
        <p>
          محاكم ADGM هي الجهاز القضائي لسوق أبوظبي العالمي، المنطقة الحرة المالية التي أُنشئت بموجب قانون أبوظبي رقم ٤ لسنة ٢٠١٣ والمرسوم الاتحادي رقم ١٥ لسنة ٢٠١٣، ومقرها جزيرة المارية. تتكون من محكمة ابتدائية ومحكمة استئناف، وتسير إجراءاتها بالإنجليزية. ويتركز اختصاصها في:
        </p>
        <ul>
          <li>الدعاوى المدنية والتجارية المرتبطة بالسوق، مثل العقود ونزاعات الشركات والمساهمين والخدمات المالية</li>
          <li>نزاعات العمل لدى الجهات المسجلة في السوق</li>
          <li>تسجيل وصايا غير المسلمين في سجل وصايا ADGM، وإثبات هذه الوصايا بعد الوفاة</li>
        </ul>
        <p>
          ليس في هذه القائمة طلاق ولا حضانة ولا نفقة. ويوضح الجدول التالي أين تُنظر كل مسألة تهم الزوجين:
        </p>
        <div class="compare-table">
          <div class="compare-header">
            <div>المسألة</div>
            <div>محاكم ADGM</div>
            <div>أين تُنظر فعلاً</div>
          </div>
          {comparisonData.map((row, i) => (
            <div class={`compare-row${i % 2 === 1 ? ' alt' : ''}`}>
              <div class="compare-factor">{row.factor}</div>
              <div class={`compare-col${row.adgm.startsWith('لا') ? ' compare-col--no' : ''}`}>{row.adgm}</div>
              <div class="compare-col">{row.adcfc}</div>
            </div>
          ))}
        </div>
        <p class="note-text">محكمة الأسرة المدنية ومحكمة الأحوال الشخصية في أبوظبي تتبعان دائرة القضاء في أبوظبي، وهي جهة مستقلة تماماً عن محاكم سوق أبوظبي العالمي.</p>
      </section>

      <section class="content-section">
        <h2>أين يتطلق غير المسلمين في أبوظبي فعلاً؟</h2>
        <p>
          أمام محكمة الأسرة المدنية في أبوظبي، التي تسميها دائرة القضاء أيضاً محكمة الأسرة لغير المسلمين. تعمل هذه المحكمة وفق قانون أبوظبي رقم ١٤ لسنة ٢٠٢١ بشأن الزواج المدني وآثاره، وهي المسار المخصص لقضايا الأسرة لغير المسلمين في الإمارة. وتنشر دائرة القضاء معلوماتها على <a href="https://www.adjd.gov.ae/EN/Pages/nonmuslimsfamilycourt.aspx" rel="noopener" target="_blank">صفحة المحكمة الرسمية</a>.
        </p>
        <h3>ما يميز محكمة الأسرة المدنية</h3>
        <ul>
          <li><strong>ثنائية اللغة:</strong> تسير الإجراءات بالعربية والإنجليزية، فلا يصطدم غير الناطق بالعربية بالحاجز اللغوي الذي يواجهه في محاكم أخرى.</li>
          <li><strong>طلاق دون إثبات خطأ:</strong> يحق لأي من الزوجين طلب الطلاق دون أن يثبت ضرراً أو يحمّل الآخر المسؤولية.</li>
          <li><strong>سرعة في القضايا المتفق عليها:</strong> كثيراً ما تُحسم القضية غير المتنازع عليها في جلسة واحدة.</li>
          <li><strong>المسائل المرتبطة أمام المحكمة نفسها:</strong> تنظر المحكمة الحضانة والطلبات المالية المترتبة على الطلاق، فلا حاجة إلى محكمة أخرى لهذه المسائل.</li>
        </ul>
        <p>
          وتتحقق المحكمة من شروط اختصاصها في كل قضية، فيحسن أن يراجع محاميك وضعك قبل التقديم، خاصة إذا كانت إقامتك أو زواجك مرتبطين بأكثر من إمارة. ولمقارنة هذا المسار بمسار دبي راجع <a href="/ar/طلاق-دبي-مقابل-أبوظبي/">الطلاق في دبي مقابل أبوظبي</a>، وللإطار القانوني العام راجع <a href="/ar/طلاق-غير-المسلمين-الامارات/">طلاق غير المسلمين في الإمارات</a>.
        </p>
        <h3>الزوجان المسلمان وسكان العين</h3>
        <p>
          إذا كان الزوجان مسلمَين فالمحكمة المختصة هي محكمة الأحوال الشخصية في أبوظبي، وتطبّق المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ بشأن الأحوال الشخصية، النافذ منذ ١٥ أبريل ٢٠٢٥. والعين جزء من إمارة أبوظبي، فتسري على سكانها القواعد نفسها. راجع <a href="/ar/محامي-طلاق-العين/">محامي طلاق العين</a> لتفاصيل الإجراءات هناك، و<a href="/ar/محامي-طلاق-ابوظبي/">محامي طلاق أبوظبي</a> للتمثيل أمام محاكم العاصمة.
        </p>
        <h3>إذا كنت تقيم في دبي أو إمارة أخرى</h3>
        <p>
          محكمة الأسرة المدنية مؤسسة تابعة لأبوظبي. أما غير المسلمين المقيمون في دبي فيتقدمون إلى محكمة الأحوال الشخصية في محاكم دبي وفق المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢ بشأن الأحوال الشخصية المدنية، وفي الإمارات الشمالية إلى محاكم الأحوال الشخصية المحلية وفق القانون نفسه. ومحاكم مركز دبي المالي العالمي ليست بديلاً، فهي مثل ADGM لا تنظر الطلاق. التفاصيل في <a href="/ar/الطلاق-في-محكمة-دبي-المالية-الدولية/">دليل الطلاق ومحاكم DIFC</a>.
        </p>
      </section>

      <section class="content-section">
        <h2>حصتك في شركة مسجلة في ADGM: من يقرر مصيرها عند الطلاق؟</h2>
        <p>
          محكمة الأسرة التي تنظر الطلاق، لا محاكم ADGM. فالحصة في شركة مسجلة في السوق أصل من أصول أحد الزوجين، وتُعرض ضمن الطلبات المالية كما يُعرض العقار أو الحساب البنكي أو المحفظة الاستثمارية.
        </p>
        <ul>
          <li><strong>الإفصاح:</strong> يمكن لمحكمة الأسرة أن تأمر الطرف المالك بتقديم شهادات الحصص وعقد التأسيس والحسابات وكشوف الأرباح والتوزيعات.</li>
          <li><strong>التقييم:</strong> إذا كانت قيمة الحصة محل نزاع، يمكن الاستعانة بخبير لتقييم الشركة.</li>
          <li><strong>الحجز التحفظي:</strong> إذا خُشي تهريب الأموال أو بيع الحصص، يُطلب الحجز التحفظي من محكمة الأسرة وفق الإجراءات المعتادة، لا من محاكم ADGM.</li>
          <li><strong>الدخل:</strong> الراتب والمكافآت والأرباح التي يتلقاها الطرف من عمله أو شركته في السوق تدخل في تقدير النفقة، كأي دخل آخر.</li>
          <li><strong>النزاع التجاري المستقل:</strong> إذا نشأ نزاع بين الشركاء أو مع الشركة نفسها، فقد تنظره محاكم ADGM بوصفه قضية تجارية، لكنه مسار منفصل لا يحسم الحقوق المالية بين الزوجين.</li>
        </ul>
        <p>
          وتسجيل الشركة في منطقة حرة لا يُخرجها من الطلبات المالية. للتفاصيل عن دعاوى المساهمة وتقييم الشركات راجع <a href="/ar/الطلاق-وامتلاك-شركة-في-الامارات/">الطلاق وامتلاك شركة في الإمارات</a>، وللأصول المسجلة خارج الدولة راجع <a href="/ar/الأصول-الخارجية-في-الطلاق-الامارات/">الأصول الخارجية في الطلاق</a>، ولطلبات الحماية العاجلة راجع <a href="/ar/أوامر-الطوارئ-الطلاق-الامارات/">أوامر الطوارئ في دعاوى الطلاق</a>.
        </p>
      </section>

      <section class="content-section">
        <h2>وصايا ADGM: الدور الحقيقي للسوق في شؤون الأسرة</h2>
        <p>
          الخدمة الشخصية التي تقدمها محاكم ADGM لغير المسلمين هي سجل الوصايا. من يسجّل وصيته فيه يضمن انتقال أصوله وفق الوصية، بدلاً من قواعد الإرث الافتراضية التي تسري عند غياب الوصية، وتتولى محاكم ADGM إثبات الوصية المسجلة بعد الوفاة.
        </p>
        <p>
          هذه أداة لتخطيط التركات، لا لإنهاء الزواج. لكنها ترتبط بالطلاق من زاوية عملية: الوصية التي سُجلت أثناء الزواج قد تسمّي الزوج وريثاً رئيسياً أو منفذاً للوصية أو وصياً على الأطفال. لذلك يحسن مراجعتها بعد الطلاق، أو تسجيل وصية جديدة إن لم تكن لديك واحدة. ويقدم مركز دبي المالي العالمي خدمة مماثلة عبر مركز خدمات الوصايا التابع له.
        </p>
      </section>

      <section class="content-section">
        <h2>هل يُعترف بطلاق محكمة الأسرة المدنية في أبوظبي خارج الدولة؟</h2>
        <p>
          حكم الطلاق يصدر عن محكمة الأسرة، والاعتراف به في بلد آخر تحكمه قواعد ذلك البلد. ففي إنجلترا وويلز يُعترف عموماً بالطلاق الأجنبي الصادر عبر إجراءات قضائية متى كان أحد الزوجين وقت الطلاق مقيماً إقامة معتادة في بلد الطلاق أو متوطناً فيه أو من مواطنيه، وفق الجزء الثاني من قانون الأسرة لعام ١٩٨٦. التفاصيل في <a href="/ar/اعتراف-بريطانيا-بالطلاق-الاماراتي/">اعتراف بريطانيا بالطلاق الإماراتي</a>.
        </p>
        <p>
          وتُذكر في هذا السياق قضية SA v FA [2022] EWFC 115. ففي ٩ سبتمبر ٢٠٢٢ نظر القاضي إدوارد هيس (HHJ Hess) في محكمة الأسرة المركزية في لندن نزاع زوجين يحملان الجنسية البريطانية عاشا في أبوظبي منذ ٢٠٠٨. رفعت الزوجة دعوى الطلاق في إنجلترا، ثم رفع الزوج دعواه أمام محكمة الأسرة لغير المسلمين في أبوظبي وطلب وقف الدعوى الإنجليزية. وجد القاضي أن الزوجين ما زالا متوطنين في إنجلترا، فللمحكمة الإنجليزية اختصاص، لكنه قبل طلب الوقف لصالح محكمة أبوظبي، ووصف إطارها التشريعي بأنه متكافئ على وجه العموم (broadly commensurate) مع المحاكم الإنجليزية وقادر على تحقيق عدالة جوهرية.
        </p>
        <p>
          وجاء الوقف مشروطاً بتعهدات من الزوج: أن يستمر في الإنفاق على الأسرة حتى الفصل النهائي، وأن يحافظ على أصوله في الإمارات، وأن يدفع التكاليف القانونية المعقولة للزوجة في الإجراءات الإماراتية. وهو قرار ابتدائي واحد من محكمة الأسرة، لا سابقة ملزمة، ولا يعني أن كل دعوى إنجليزية ستُوقف لصالح أبوظبي. ويمكن قراءة <a href="https://caselaw.nationalarchives.gov.uk/ewfc/2022/115" rel="noopener" target="_blank">النص الرسمي للحكم</a> على موقع الأرشيف الوطني البريطاني. وإن كانت لك صلة ببلد آخر، فراجع <a href="/ar/أين-تتقدم-بطلب-الطلاق-الإمارات-أم-بلدك/">أين تتقدم بطلب الطلاق: الإمارات أم بلدك</a> قبل أن تتحرك.
        </p>
      </section>

