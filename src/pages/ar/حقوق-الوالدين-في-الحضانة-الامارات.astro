  { aspect: 'سن انتهاء الحضانة', muslim: '١٨ سنة لجميع الأطفال (المرسوم بقانون ٤١/٢٠٢٤)', nonMuslim: '١٨ سنة لجميع الأطفال (المرسوم بقانون ٤١/٢٠٢٢)' },
  { aspect: 'الحاضن مقابل الولي', muslim: 'الأب ولي شرعي دائماً. الحضانة والولاية مستقلتان', nonMuslim: 'كلا الوالدين يتشاركان الولاية والحضانة بالتساوي' },
  { aspect: 'رأي الطفل', muslim: 'تستمع المحكمة من سن ١٥ وتُولي رأيه وزناً كبيراً دون إلزام', nonMuslim: 'تستمع المحكمة من سن ١٥. للطفل كامل الحرية عند ١٨' },
  { aspect: 'أسباب تعديل الحضانة', muslim: 'زواج الأم من غير محرم، النقل، عدم الأهلية، منع الزيارات', nonMuslim: 'تغيّر جوهري في الظروف؛ مصلحة الطفل الفضلى' },
];

const visitationRows = [
  { ages: '٠ إلى ٥ سنوات', typical: 'زيارات قصيرة في حضور الأم أو قربها؛ عادةً ٢-٣ مرات أسبوعياً لساعات محدودة', notes: 'المبيت مع الأب محدود للرضع؛ يمكن طلب زيادة تدريجية' },
  { ages: '٥ إلى ١٠ سنوات', typical: 'عطلة نهاية الأسبوع كل أسبوعين (جمعة وسبت)، مساء يوم عمل', notes: 'تبدأ تقسيم الإجازات؛ حق التواصل (مكالمات وتصوير مرئي) بين الزيارات' },
  { ages: '١٠ إلى ١٥ سنة', typical: 'عطلة نهاية الأسبوع كل أسبوعين، مبيت منتصف الأسبوع، إجازات ممتدة (ما يصل إلى نصف الإجازة المدرسية)', notes: 'يبدأ رأي الطفل يأخذ وزناً أكبر؛ قد يُأذن بالسفر مع الأب' },
  { ages: '١٥ سنة فأكثر', typical: 'المحكمة تستمع فعلاً لرأي الطفل الصريح؛ الترتيبات تزداد مرونةً', notes: 'رأي الطفل يحظى بوزن كبير جداً؛ يُأخذ به ما لم يُشَك في استقلاليته' },
];

const faqItems = [
  {
    question: 'هل صحيح أن قانون ٢٠٢٤ ألغى انتقال الحضانة عند أعمار ١١ و١٣؟',
    answer: 'نعم. المرسوم بقانون رقم ٤١ لسنة ٢٠٢٤ النافذ من ١٥ أبريل ٢٠٢٥ أنهى نظام الانتقال التلقائي بالعمر الوارد في قانون ٢٠٠٥. الحضانة تمتد الآن لسن ١٨ لجميع الأطفال بصرف النظر عن جنسهم. إن أُفيدتِ بأن ابنك سينتقل لوالده عند الحادية عشرة فهذه معلومة قائمة على القانون القديم. استأنفي استشارة قانونية محدَّثة.',
  },
  {
    question: 'ما الذي يحق للأب فعله إن منعته الأم من رؤية أطفاله؟',
    answer: 'تقدم فوراً بطلب تنفيذ في محكمة التنفيذ. أحضر الحكم الأصلي مع صيغة التنفيذ ودليلاً على المنع (التواريخ، الرسائل، السجلات). تستطيع المحكمة تغريم الأم وإنذارها، وبعد منع متكرر تُحيل الأمر لتعديل الحضانة لصالح الأب. لا تتأخر في اتخاذ الإجراء؛ المحاكم تنظر في مدى سرعة الطرف المتضرر.',
  },
  {
    question: 'ماذا يبقى من ولاية الأب إن كانت الأم حاضنة؟',
    answer: 'تبقى كل الولاية الشرعية. تعني الولاية (الولاية) موافقة الأب الإلزامية على: الالتحاق بالمدارس وتغييرها، والعمليات الجراحية والعلاجات التخصصية، والسفر خارج الإمارات، وتغيير الدين. إن تصرفت الأم في هذه الأمور دون موافقة الولي تعرضت لدعوى تنفيذ ولاية يرفعها الأب.',
