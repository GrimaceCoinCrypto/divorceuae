---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'حقوق الأب والأم في حضانة الأطفال بعد الطلاق في الإمارات — قانون ٢٠٢٤';
const description =
  'تغيير جوهري في قانون ٢٠٢٤: الحضانة تمتد لسن ١٨ بدلاً من ١١ و١٣. الفرق بين الحضانة (الأم) والولاية (الأب) في الفقه الإسلامي والقانون الإماراتي. شروط سقوط حضانة الأم. جدول مقارنة: المسلمون وفق قانون ٢٠٢٤ مقابل غير المسلمين وفق قانون ٢٠٢٢.';

const canonical = 'https://divorceu.ae/ar/حقوق-الوالدين-في-الحضانة-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/father-custody-rights-uae/',
  ar: canonical,
};

const breadcrumbItems = [
