---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الطلاق في محكمة دبي المالية الدولية DIFC: هل هو ممكن؟';
const description =
  'محاكم مركز دبي المالي العالمي DIFC لا تنظر الطلاق ولا الحضانة ولا النفقة. اعرف ما تختص به، وأين يتطلق غير المسلمين في دبي وأبوظبي، ومصير حصتك في شركات DIFC.';

const canonical = 'https://divorceu.ae/ar/الطلاق-في-محكمة-دبي-المالية-الدولية/';

const hreflang = {
  en: 'https://divorceu.ae/en/difc-divorce-dubai/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الطلاق في محكمة دبي المالية الدولية' },
];

const difcVsFederal = [
  { aspect: 'الدعاوى المدنية والتجارية (العقود، الشركات، الخدمات المالية)', difc: 'تختص', federal: 'محاكم DIFC' },
  { aspect: 'نزاعات العمل', difc: 'تختص', federal: 'محاكم DIFC' },
  { aspect: 'الطلبات المتعلقة بالتحكيم', difc: 'تختص', federal: 'محاكم DIFC' },
  { aspect: 'أوامر التجميد والتدابير المؤقتة في النزاعات المدنية والتجارية', difc: 'تختص', federal: 'محاكم DIFC' },
  { aspect: 'إثبات وصايا غير المسلمين المسجلة لدى مركز خدمات الوصايا', difc: 'تختص', federal: 'محاكم DIFC' },
  { aspect: 'طلاق غير المسلمين المقيمين في دبي', difc: 'لا تختص', federal: 'محكمة الأحوال الشخصية في محاكم دبي' },
  { aspect: 'طلاق غير المسلمين المقيمين في أبوظبي', difc: 'لا تختص', federal: 'محكمة الأسرة المدنية في أبوظبي' },
  { aspect: 'الحضانة والرؤية والنفقة', difc: 'لا تختص', federal: 'محكمة الأسرة التي تنظر الطلاق' },
  { aspect: 'القسمة المالية والتعويض بين الزوجين', difc: 'لا تختص', federal: 'محكمة الأسرة التي تنظر الطلاق' },
];

const courtOptions = [
  { court: 'محكمة الأحوال الشخصية في محاكم دبي', law: 'المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢', lang: 'العربية، مع ترجمة قانونية للمستندات', divorce: 'نعم' },
  { court: 'محكمة الأسرة المدنية في أبوظبي', law: 'قانون أبوظبي رقم ١٤ لسنة ٢٠٢١', lang: 'العربية والإنجليزية', divorce: 'نعم' },
  { court: 'محاكم الأحوال الشخصية في الإمارات الشمالية', law: 'المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢', lang: 'العربية', divorce: 'نعم' },
  { court: 'محاكم مركز دبي المالي العالمي', law: 'قانون دبي رقم ٢ لسنة ٢٠٢٥ (اختصاص مدني وتجاري)', lang: 'الإنجليزية', divorce: 'لا' },
  { court: 'محاكم سوق أبوظبي العالمي', law: 'تشريعات السوق والقانون الإنجليزي العام (اختصاص مدني وتجاري)', lang: 'الإنجليزية', divorce: 'لا' },
];

const filingSteps = [
  { n: 1, title: 'حدّد المحكمة المختصة', body: 'في دبي: محكمة الأحوال الشخصية في محاكم دبي. في أبوظبي: محكمة الأسرة المدنية. في الإمارات الأخرى: محكمة الأحوال الشخصية المحلية. عملك في المركز أو ملكيتك لشركة فيه لا يغيّر ذلك.' },
  { n: 2, title: 'اجمع صورة مالية كاملة', body: 'كشوف الرواتب والمكافآت، وشهادات الحصص وحسابات أي شركة في المركز، والحسابات البنكية والاستثمارية، والعقارات داخل الدولة وخارجها، ورصيد خطة الادخار الوظيفي إن وجد.' },
  { n: 3, title: 'اطلب الحماية العاجلة من محكمة الأسرة عند الحاجة', body: 'إذا خشيت تحويل الأموال أو سفر الطرف الآخر بالأطفال، فالحجز التحفظي ومنع السفر يُطلبان من المحكمة التي تنظر النزاع الأسري، لا من محاكم DIFC.' },
  { n: 4, title: 'جهّز المستندات والترجمة', body: 'في دبي تسير الإجراءات بالعربية، فجهّز ترجمة قانونية معتمدة لعقد الزواج وشهادات ميلاد الأطفال وأي اتفاقيات مكتوبة بين الزوجين.' },
  { n: 5, title: 'راجع وصيتك', body: 'إن كانت لديك وصية مسجلة في DIFC أو ADGM، فحدّثها بعد الطلاق حتى لا تنتقل أصولك أو الوصاية على أطفالك على نحو لم تعد تريده.' },
  { n: 6, title: 'وكّل محامياً له حق المثول أمام محاكم دبي', body: 'التسجيل لدى محاكم DIFC وحده لا يمنح المحامي حق الترافع أمام محكمة الأحوال الشخصية. اختر محامياً مرخصاً أمام محاكم دبي وله خبرة في قضايا غير المسلمين.' },
];

const faqItems = [
  {
    question: 'هل يمكنني الطلاق في محاكم مركز دبي المالي العالمي DIFC؟',
    answer: 'لا. محاكم مركز دبي المالي العالمي محاكم مدنية وتجارية تعمل بالإنجليزية، ولا تملك اختصاصاً بالطلاق أو الحضانة أو النفقة أو القسمة المالية بين الزوجين. يتطلق غير المسلمين المقيمون في دبي أمام محكمة الأحوال الشخصية في محاكم دبي، والمقيمون في أبوظبي أمام محكمة الأسرة المدنية التابعة لدائرة القضاء.',
  },
  {
    question: 'هل منح قانون دبي رقم ٢ لسنة ٢٠٢٥ محاكم DIFC اختصاصاً بقضايا الأسرة؟',
    answer: 'لا. هذا القانون، الذي حلّ محل قانون دبي رقم ١٢ لسنة ٢٠٠٤، ينظم اختصاص المحاكم في الدعاوى المدنية والتجارية ونزاعات العمل والتحكيم والتدابير المؤقتة، والقضايا التي يتفق أطرافها كتابةً على اختصاصها في المسائل المدنية والتجارية، إضافة إلى إثبات وصايا غير المسلمين المسجلة لدى مركز خدمات الوصايا. ولا يتضمن أي اختصاص بالطلاق أو الحضانة أو النفقة.',
  },
  {
    question: 'أين يتطلق غير المسلمين المقيمون في دبي؟',
    answer: 'أمام محكمة الأحوال الشخصية في محاكم دبي، وفق المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢ بشأن الأحوال الشخصية المدنية. يحق لأي من الزوجين طلب الطلاق دون إثبات ضرر، وتنظر المحكمة الحضانة والنفقة والطلبات المالية. الإجراءات بالعربية، فتحتاج المستندات الأجنبية إلى ترجمة قانونية معتمدة.',
  },
  {
    question: 'هل توجد محكمة أسرة لغير المسلمين تعمل بالإنجليزية؟',
    answer: 'نعم، في أبوظبي. محكمة الأسرة المدنية التابعة لدائرة القضاء في أبوظبي تعمل بالعربية والإنجليزية وفق قانون أبوظبي رقم ١٤ لسنة ٢٠٢١، وتخدم غير المسلمين المقيمين في الإمارة، وكثيراً ما تحسم القضية غير المتنازع عليها في جلسة واحدة. أما محاكم مركز دبي المالي العالمي وسوق أبوظبي العالمي فتعمل بالإنجليزية لكنها لا تنظر قضايا الأسرة.',
  },
  {
    question: 'أعمل في المركز أو أملك شركة فيه، فأي محكمة تنظر طلاقي؟',
    answer: 'محكمة الأسرة المختصة بحسب إقامتك، لا محاكم DIFC. فعملك أو شركتك في المركز لا يغيّر المحكمة المختصة. وتُعرض حصتك في الشركة ضمن الطلبات المالية أمام محكمة الأسرة، التي يمكنها الأمر بالإفصاح عن سجلاتها وحساباتها والاستعانة بخبير لتقييمها.',
  },
  {
    question: 'هل يمكن استصدار أمر تجميد من محاكم DIFC ضد أموال زوجي؟',
    answer: 'لا يوجد مسار أسري لذلك، فأوامر التجميد التي تصدرها محاكم DIFC تخص النزاعات المدنية والتجارية. في النزاع الزوجي يُطلب الحجز التحفظي أو منع السفر من محكمة الأسرة المختصة، وهي تنظر هذه الطلبات على وجه الاستعجال عند توافر شروطها.',
  },
  {
    question: 'هل يمنح شرط اختصاص DIFC في اتفاقية ما قبل الزواج هذه المحاكم ولاية على الطلاق؟',
    answer: 'لا. الاتفاق الكتابي على اختصاص محاكم DIFC يصلح في المسائل المدنية والتجارية وحدها، ولا ينشئ اختصاصاً بالطلاق أو الحضانة أو النفقة. وتبقى الاتفاقية مستنداً تنظر فيه محكمة الأسرة المختصة عند الفصل في الطلبات المالية.',
  },
  {
    question: 'ما فائدة وصية DIFC لمن يمر بالطلاق؟',
    answer: 'وصية DIFC أداة لتخطيط التركات، لا للطلاق. تتيح لغير المسلم أن تنتقل أصوله وفق وصيته بدلاً من قواعد الإرث الافتراضية، وأن يسمّي أوصياء على أطفاله القصّر، وتتولى محاكم DIFC إثباتها بعد الوفاة. وبعد الطلاق يحسن مراجعة أي وصية قائمة، لأنها قد تسمّي الزوج السابق وريثاً أو منفذاً.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.slice(0, 3).map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} lang="ar" />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">دليل دبي · محاكم DIFC والطلاق</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        يبحث كثير من المقيمين غير المسلمين في دبي عن «طلاق DIFC» أملاً في إجراءات بالإنجليزية وفق القانون الإنجليزي. والجواب المباشر أن محاكم مركز دبي المالي العالمي لا تنظر دعاوى الطلاق ولا الحضانة ولا النفقة ولا القسمة المالية بين الزوجين، ولم يمنحها قانون دبي رقم ٢ لسنة ٢٠٢٥ هذا الاختصاص. يشرح هذا الدليل ما تختص به هذه المحاكم فعلاً، وأين تُرفع دعوى الطلاق في دبي وأبوظبي، وكيف تُعامَل حصتك في شركة مسجلة في المركز.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="summary-box">
        <h2>الخلاصة في أربع نقاط</h2>
        <div class="summary-grid summary-grid--4">
          <div class="summary-card">
            <p class="summary-label">هل تنظر محاكم DIFC الطلاق؟</p>
            <p class="summary-value">لا</p>
            <p class="summary-note">ولا الحضانة ولا النفقة</p>
          </div>
          <div class="summary-card">
            <p class="summary-label">غير المسلمين في دبي</p>
            <p class="summary-value">محكمة الأحوال الشخصية</p>
            <p class="summary-note">محاكم دبي، القانون الاتحادي ٤١/٢٠٢٢</p>
          </div>
          <div class="summary-card">
            <p class="summary-label">غير المسلمين في أبوظبي</p>
            <p class="summary-value">محكمة الأسرة المدنية</p>
            <p class="summary-note">بالعربية والإنجليزية، قانون ١٤/٢٠٢١</p>
          </div>
          <div class="summary-card">
            <p class="summary-label">ما يقدمه المركز للأفراد</p>
            <p class="summary-value">تسجيل الوصايا</p>
            <p class="summary-note">تخطيط تركات لا طلاق</p>
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>لماذا لا يمكن رفع دعوى طلاق أمام محاكم DIFC؟</h2>
        <p>
          لأن القانون الذي يحدد اختصاص هذه المحاكم لا يمنحها أي ولاية على مسائل الأسرة. محاكم مركز دبي المالي العالمي محاكم مستقلة تعمل بالإنجليزية وفق نظام القانون العام، أُنشئت عام ٢٠٠٤ لخدمة المنطقة الحرة المالية في دبي. وينظّم اختصاصها اليوم قانون دبي رقم ٢ لسنة ٢٠٢٥ بشأن محاكم مركز دبي المالي العالمي، الذي حلّ محل قانون دبي رقم ١٢ لسنة ٢٠٠٤.
        </p>
        <p>
          يحدد هذا القانون ما تنظره المحاكم: الدعاوى المدنية والتجارية، ونزاعات العمل، والطلبات المتعلقة بالتحكيم، والتدابير المؤقتة مثل أوامر التجميد، والقضايا التي يتفق أطرافها كتابةً على اختصاصها في المسائل المدنية والتجارية، وإثبات وصايا غير المسلمين المسجلة لدى مركز خدمات الوصايا في المركز. وتخلو ملخصات القانون التي نشرتها مكاتب محاماة دولية، منها CMS وHadef &amp; Partners وCharles Russell Speechlys، من أي اختصاص بالطلاق أو الحضانة أو النفقة.
        </p>
        <p>
          النتيجة أن طلاق غير المسلمين المقيمين في دبي وما يترتب عليه يبقى من اختصاص محكمة الأحوال الشخصية في محاكم دبي، وفق المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢ بشأن الأحوال الشخصية المدنية. ولا يغيّر ذلك أن يعمل أحد الزوجين أو كلاهما في المركز، أو أن يملك شركة فيه، أو أن يفضّل الإجراءات الإنجليزية.
        </p>
        <div class="info-box info-box--warning">
          <h3>احذر المعلومات المتداولة عن «طلاق DIFC»</h3>
          <p>تتداول مواقع وأدلة على الإنترنت أن قانون دبي رقم ٢ لسنة ٢٠٢٥ فتح محاكم DIFC أمام طلاق غير المسلمين، وتذكر رسوم تقديم ومدداً وطرقاً لتقسيم الأصول على النمط الإنجليزي. هذا غير صحيح. ومن يبني خطته عليه قد يضيّع أسابيع قبل أن يتقدم إلى المحكمة المختصة، وقد يتأخر في طلب حماية عاجلة لأصوله أو لأطفاله.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>ما الذي تختص به محاكم مركز دبي المالي العالمي فعلاً؟</h2>
        <p>
          يلخص الجدول التالي ما تنظره هذه المحاكم وما لا تنظره من المسائل التي تهم الأسرة:
        </p>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>المسألة</th>
                <th>محاكم DIFC</th>
                <th>المحكمة المختصة فعلاً</th>
              </tr>
            </thead>
            <tbody>
              {difcVsFederal.map((row) => (
                <tr>
                  <td class="td-highlight">{row.aspect}</td>
                  <td class={row.difc === 'لا تختص' ? 'td-no' : 'td-yes'}>{row.difc}</td>
                  <td>{row.federal}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p>
          ولاحظ أن اتفاق الأطراف كتابةً على اختصاص محاكم DIFC يصلح في المسائل المدنية والتجارية وحدها. فلا يمنح شرطٌ في عقد زواج أو في <a href="/ar/اتفاقية-ما-قبل-الزواج-الامارات/">اتفاقية ما قبل الزواج</a> هذه المحاكم ولاية على الطلاق، والعبرة بطريقة تعامل محكمة الأسرة المختصة مع الاتفاقية.
        </p>
      </section>

      <section class="content-section">
        <h2>أين يتطلق غير المسلمين في الإمارات فعلاً؟</h2>
        <p>
          يتحدد المسار بإمارة الإقامة وبديانة الزوجين. والمقارنة التالية تضع محاكم المناطق الحرة المالية في مكانها الصحيح:
        </p>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>المحكمة</th>
                <th>القانون المطبّق</th>
                <th>اللغة</th>
                <th>تنظر الطلاق؟</th>
              </tr>
            </thead>
            <tbody>
              {courtOptions.map((row) => (
                <tr>
                  <td class="td-highlight">{row.court}</td>
                  <td>{row.law}</td>
                  <td>{row.lang}</td>
                  <td class={row.divorce === 'لا' ? 'td-no' : 'td-yes'}>{row.divorce}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3>في دبي: محكمة الأحوال الشخصية في محاكم دبي</h3>
        <p>
          هي المحكمة المختصة بطلاق غير المسلمين المقيمين في دبي، وتطبّق عليهم المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢: يحق لأي من الزوجين طلب الطلاق دون إثبات ضرر، وتنظر المحكمة الحضانة والنفقة والطلبات المالية المترتبة عليه. تسير الإجراءات بالعربية، فتحتاج المستندات الأجنبية إلى ترجمة قانونية معتمدة. تفاصيل المكان والإجراءات في دليل <a href="/ar/محكمة-الأسرة-في-دبي/">محكمة الأسرة في دبي</a>، والإطار القانوني في <a href="/ar/طلاق-غير-المسلمين-الامارات/">طلاق غير المسلمين في الإمارات</a>.
        </p>

        <h3>في أبوظبي: محكمة الأسرة المدنية</h3>
        <p>
          لغير المسلمين المقيمين في إمارة أبوظبي محكمة مخصصة هي محكمة الأسرة المدنية التابعة لدائرة القضاء، وتعمل وفق قانون أبوظبي رقم ١٤ لسنة ٢٠٢١ بشأن الزواج المدني وآثاره. إجراءاتها بالعربية والإنجليزية، والطلاق فيها دون إثبات خطأ، وكثيراً ما تُحسم القضية غير المتنازع عليها في جلسة واحدة. وهذه المحكمة، لا محاكم سوق أبوظبي العالمي، هي المسار الناطق بالإنجليزية لقضايا الأسرة في العاصمة؛ راجع <a href="/ar/الطلاق-في-سوق-أبوظبي-العالمي/">الطلاق وسوق أبوظبي العالمي</a>، وللمقارنة بين الإمارتين <a href="/ar/طلاق-دبي-مقابل-أبوظبي/">الطلاق في دبي مقابل أبوظبي</a>.
        </p>

        <h3>في الإمارات الشمالية وللأزواج المسلمين</h3>
        <p>
          في الشارقة وعجمان ورأس الخيمة والفجيرة وأم القيوين تنظر محاكم الأحوال الشخصية المحلية طلاق غير المسلمين وفق المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٢. أما الزوجان المسلمان في أي إمارة فيتقدمان إلى محكمة الأحوال الشخصية وفق المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ بشأن الأحوال الشخصية، النافذ منذ ١٥ أبريل ٢٠٢٥؛ راجع <a href="/ar/الطلاق-الشرعي-في-الإمارات/">الطلاق الشرعي في الإمارات</a>. وإذا كانت لك أو لزوجك صلة قوية ببلد آخر، فقد يكون التقاضي هناك ممكناً أيضاً؛ راجع <a href="/ar/أين-تتقدم-بطلب-الطلاق-الإمارات-أم-بلدك/">أين تتقدم بطلب الطلاق: الإمارات أم بلدك</a> قبل أن تتحرك.
        </p>
      </section>

      <section class="content-section">
        <h2>حصتك في شركة مسجلة في DIFC: من يقرر مصيرها عند الطلاق؟</h2>
        <p>
          محكمة الأسرة التي تنظر الطلاق. فالحصة في شركة مسجلة في المركز أصل كأي أصل آخر، وتُعرض ضمن الطلبات المالية أمام محكمة الأحوال الشخصية في دبي أو محكمة الأسرة المدنية في أبوظبي، بحسب مكان التقاضي.
        </p>
        <ul class="checklist">
          <li><strong>الإفصاح:</strong> يمكن لمحكمة الأسرة أن تأمر بتقديم شهادات الحصص وعقد التأسيس والحسابات وكشوف الأرباح والتوزيعات.</li>
          <li><strong>التقييم:</strong> إذا كانت قيمة الشركة محل نزاع، يمكن تعيين خبير لتقييمها.</li>
          <li><strong>الحجز التحفظي:</strong> إذا خُشي بيع الحصص أو تحويل الأموال، يُطلب الحجز التحفظي من محكمة الأسرة وفق الإجراءات المعتادة، ومعه أدوات مثل <a href="/ar/منع-السفر-أثناء-الطلاق-الامارات/">منع السفر</a> عند توافر شروطه.</li>
          <li><strong>الدخل:</strong> الراتب والمكافآت والأرباح التي يتلقاها الطرف من عمله أو شركته في المركز تدخل في تقدير النفقة، كأي دخل آخر.</li>
          <li><strong>النزاع التجاري المنفصل:</strong> إذا نشأ نزاع بين الشركاء أو مع الشركة نفسها، فقد تنظره محاكم DIFC بوصفه قضية تجارية، لكنه لا يحسم الحقوق المالية بين الزوجين.</li>
        </ul>
        <p>
          ولا يقدم هذا المسار التجاري أي أوامر مالية أسرية، فالحماية العاجلة للأصول في نزاع زوجي تُطلب من محكمة الأسرة المختصة. للتوسع راجع <a href="/ar/الطلاق-وامتلاك-شركة-في-الامارات/">الطلاق وامتلاك شركة في الإمارات</a> و<a href="/ar/الأصول-الخارجية-في-الطلاق-الامارات/">الأصول الخارجية في الطلاق</a> و<a href="/ar/أوامر-الطوارئ-الطلاق-الامارات/">أوامر الطوارئ في دعاوى الطلاق</a>. ومن كان له رصيد في خطة ادخار موظفي المركز (DEWS) فليدرجه ضمن إفصاحه المالي، وقد يفيده دليل <a href="/ar/نهاية-الخدمة-والطلاق-في-الامارات/">نهاية الخدمة والطلاق</a>.
        </p>
      </section>

      <section class="content-section">
        <h2>وصايا DIFC: الدور الحقيقي للمركز في شؤون الأسرة</h2>
        <p>
          الخدمة التي تهم الأسر غير المسلمة فعلاً في المركز هي تسجيل الوصايا. فمركز خدمات الوصايا في مركز دبي المالي العالمي يتيح لغير المسلمين تسجيل وصية تنتقل بموجبها أصولهم وفق رغبتهم بدلاً من قواعد الإرث الافتراضية، ويمكن أن تتضمن الوصية تسمية أوصياء على الأطفال القصّر. وتتولى محاكم DIFC إثبات هذه الوصايا بعد الوفاة.
        </p>
        <p>
          هذا تخطيط تركات، لا طلاق. لكن الطلاق مناسبة ضرورية لمراجعة الوصية، فالوصية التي سُجلت أثناء الزواج قد تجعل الزوج السابق وريثاً رئيسياً أو منفذاً لها. وفي أبوظبي يوجد سجل مماثل لدى محاكم سوق أبوظبي العالمي.
        </p>
      </section>

