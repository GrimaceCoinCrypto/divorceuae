  ]},
  { phase: 'قبل المباشرة بالإجراءات', items: [
    'وكّلي محامياً متخصصاً في الأحوال الشخصية — الحماية المالية جزء من دوره',
    'احصلي على تقييمات العقارات إذا كنت تمتلكين عقاراً في الإمارات',
    'استشيري محاسباً جنائياً إذا اشتبهتِ في إخفاء الأصول',
    'وثّقي جميع الديون المنزلية: رهون عقارية، قروض سيارات، بطاقات ائتمان',
    'افهمي استحقاق نهاية خدمة زوجك — يجوز لجهة عمله إعداد هذا الحساب',
  ]},
];

const faqItems = [
  {
    question: 'ما المهر المؤجل وكيف أطالب به عند الطلاق؟',
    answer: 'المهر المؤجل هو المبلغ المتفق عليه في عقد الزواج الذي يستحق الدفع عند الطلاق أو وفاة الزوج. إذا لم يُدفع المهر المؤجل عند الطلاق يمكنك رفع دعوى لاسترداده أمام محكمة الأحوال الشخصية. احتفظي بنسخة من عقد الزواج الذي يُحدد مبلغ المهر المؤجل. في حالة الخلع قد تُعيدين المهر المقدم وتتنازلين عن المؤجل، فاستشيري محامياً قبل الموافقة على أي شروط.',
  },
  {
    question: 'هل يمكن لزوجي سحب كل الأموال من حسابنا المشترك قبل الطلاق؟',
    answer: 'نعم، من الناحية التقنية يمكن لأي صاحب حساب مشترك السحب الكامل. لكن سحب الأموال المشتركة استعداداً لإجراءات الطلاق يُعدّ إساءةً مالية تؤثر سلباً على موقف الزوج أمام المحكمة. إذا اشتبهتِ في نية زوجك لاستنزاف الحسابات وكّلي محامياً فوراً للتقدم بطلب أمر قضائي بالتحفظ على الحساب. التصرف قبل وقوع السحب أسهل بكثير من الاسترداد لاحقاً.',
  },
  {
    question: 'ما نفقة العدة وكم تدوم؟',
    answer: 'نفقة العدة واجبة للمطلقة المسلمة طوال فترة العدة: ثلاثة أشهر قمرية (أو ثلاثة أطهار) للمطلقة غير الحامل، وحتى الوضع للحامل. تشمل نفقة المسكن والغذاء والملبس وما يحتاجه الحمل. لا تسقط إلا إذا ثبت نشوز الزوجة قضائياً. هذا الحق مكفول بموجب قانون الأحوال الشخصية الاتحادي.',
  },
  {
    question: 'كيف يُعامَل العقار المشترك في الإمارات عند الطلاق؟',
    answer: 'القانون الإماراتي يطبق نظام الملكية المنفصلة: العقار المسجل باسم الزوج يبقى ملكه. لكن إذا كانت الزوجة قد ساهمت فعلياً في دفع أقساط الرهن العقاري أو تكاليف التجديد أو التحويل المباشر، يمكنها المطالبة بنصيبها بإثبات ذلك بالمستندات. إذا كان العقار مسجلاً بأسمائكما معاً وجبت معالجته في اتفاق التسوية.',
  },
  {
    question: 'ماذا تفعل المرأة إذا اشتبهت في إخفاء زوجها لأصوله قبل الطلاق؟',
    answer: 'علامات إخفاء الأصول: خسائر تجارية مفاجئة، تحويلات غير مبررة، أصول مسجلة بأسماء أطراف ثالثة، ديون مزعومة مصطنعة. يمكن لمحاميك الطلب من المحكمة إصدار أوامر الإفصاح المالي وتعيين محاسب جنائي. المحاكم الإماراتية تأخذ الإخفاء المالي بجدية تامة وتعتبر عدم الإفصاح احتقاراً للمحكمة.',
  },
  {
    question: 'هل يمكن لزوجي إلغاء بطاقة الائتمان الملحقة بحسابه خلال الطلاق؟',
    answer: 'نعم، صاحب الحساب الرئيسي يمكنه طلب إلغاء البطاقة الملحقة (التكميلية) في أي وقت. انتقلي فوراً إلى حساب بطاقة ائتمان خاص بك ما إن تبدأ إجراءات الطلاق. احتفظي بسجل بالأرصدة المستحقة على بطاقات الائتمان المشتركة لأنها وثيقة الصلة بالتسوية المالية.',
  },
  {
    question: 'هل يستمر الزوج في دفع النفقة أثناء فترة انتظار الطلاق؟',
    answer: 'نعم. التزامات الزواج المالية مستمرة طوال فترة الإجراءات. الزوج ملزم بنفقة الزوجة حتى صدور حكم الطلاق. إذا رفض الدفع يمكن للزوجة تقديم طلب نفقة مؤقتة أمام المحكمة — تُنظر هذه الطلبات عادةً في غضون ٢-٤ أسابيع. لا يُعذر الزوج من النفقة بحجة الانفصال الفعلي ما لم يثبت نشوز الزوجة.',
  },
  {
    question: 'ماذا أفعل إذا كان راتبي يدخل الحساب المشترك؟',
    answer: 'أبلغي إدارة الموارد البشرية في جهة عملك كتابياً بتغيير حساب استلام الراتب إلى حسابك الفردي. هذا ليس إخفاءً للأصول بل حماية لدخلك خلال الإجراءات. افعلي ذلك قبل إخبار زوجك بأنك تعتزمين المضي في الطلاق لتجنب تجميد الوضع المالي. إذا كان زوجك يُموّل بطاقاتك الائتمانية تأكدي من توفر مصدر دخل مستقل لتغطية نفقاتك الأساسية.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">التخطيط المالي · الطلاق في الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        الطلاق في الإمارات يمكن أن يؤثر على الحسابات البنكية والعقارات ومكافأة نهاية الخدمة والبطاقات الائتمانية — وأحياناً بشكل أسرع مما تتوقعين. الخطوات المالية التي تتخذيها في الأيام والأسابيع الأولى لها أثر بالغ على نتيجتك. للمرأة المسلمة حقوق مالية شرعية وقانونية مكفولة، وهذا الدليل يشرحها بوضوح.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="answer-box">
        <h2>الحقوق المالية للمرأة المسلمة عند الطلاق في الإمارات</h2>
        <p>
          <strong>المهر المؤجل:</strong> يستحق الدفع فور وقوع الطلاق إذا لم يُدفع مسبقاً.<br />
          <strong>نفقة العدة:</strong> ثلاثة أشهر قمرية أو حتى الوضع — تشمل المسكن والغذاء والملبس.<br />
          <strong>نفقة المتعة:</strong> واجبة إذا طلّق الزوج بإرادته دون سبب من جهة الزوجة.<br />
          <strong>نفقة الأولاد:</strong> على الأب بصرف النظر عمّن يحضن، تشمل المصاريف التعليمية والطبية.<br />
          <strong>مسكن الحضانة:</strong> الأب ملزم بتوفير مسكن مناسب للحاضنة وأولاده.
        </p>
      </div>

      <section class="content-section">
        <h2>حقوقك المالية في الشريعة الإسلامية والقانون الإماراتي</h2>
        <p>
          يُجمع الفقه الإسلامي والقانون الإماراتي على أن للمرأة حقوقاً مالية راسخة عند الطلاق. المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ (قانون الأحوال الشخصية الجديد) يُكرّس هذه الحقوق ويُفصّلها. فهمك لهذه الحقوق قبل بدء أي إجراء قانوني يُمكّنك من حماية مستقبلك المالي.
        </p>
        <h3>المهر: المقدم والمؤجل</h3>
        <p>
          المهر حق إلهي للمرأة لا يجوز التنازل عنه بالإكراه. ينقسم إلى مهر مقدم يُدفع عند الزواج ومهر مؤجل يستحق عند الطلاق أو الوفاة. إذا طلبتِ الخلع قد تُضطرين لإعادة المهر المقدم، لكن في الطلاق الذي يُوقعه الزوج يبقى المهر حقاً كاملاً لك. تحققي من أن عقد زواجك يُحدد مبلغ المهر المؤجل بوضوح.
        </p>
        <h3>نفقة المتعة: تعويض الطلاق</h3>
        <p>
          نفقة المتعة واجبة للزوجة التي طُلِّقت بإرادة الزوج بغير سبب من جهتها، استناداً إلى قوله تعالى: "وَمَتِّعُوهُنَّ عَلَى الْمُوسِعِ قَدَرُهُ وَعَلَى الْمُقْتِرِ قَدَرُهُ مَتَاعًا بِالْمَعْرُوفِ". تُقدّرها المحكمة بمراعاة مدة الزواج ودخل الزوج وظروف الطلاق. تتراوح عادةً بين شهر وسنتين من النفقة الشهرية.
        </p>
        <h3>نفقة الأولاد: حق الطفل على أبيه</h3>
        <p>
          نفقة الأولاد فريضة على الأب بصرف النظر عن الحاضن. تشمل المصاريف المدرسية والطبية والملبس والغذاء والأنشطة بما يتناسب مع دخل الأب ومستوى معيشة الأسرة. حتى لو عملتِ وكان لديك دخل مرتفع يبقى الأب ملزماً بنفقة أولاده. تُصدر المحكمة حكماً بمبلغ شهري محدد يمكن مراجعته عند تغيّر الظروف.
        </p>
      </section>

      <section class="content-section">
        <h2>الحسابات البنكية والأصول المالية خلال الطلاق</h2>
        <p>
          البنوك الإماراتية لا تُبلَّغ آلياً ببدء إجراءات الطلاق. لا يوجد تجميد تلقائي على الحسابات المشتركة. هذا يعني أن المسؤولية والمخاطرة تقعان عليك.
        </p>
        <h3>الحسابات المشتركة</h3>
        <p>
          يتمتع كلا الطرفين بكامل الوصول إلى الحساب المشترك حتى يصدر حكم قضائي بشأنه. لأي طرف سحب الرصيد كاملاً. وثّقي الرصيد الحالي وحمّلي كشوفات آخر ثلاث سنوات فوراً. إذا كانت هناك مخاطر يمكن لمحاميك طلب تجميد الحساب.
        </p>
        <p>
          تجنّبي بنفسك استنزاف الحساب المشترك. المحاكم تعتبر سحب الأموال بشكل منفرد استعداداً للطلاق إساءةً مالية تُؤثر على موقفك.
        </p>
        <h3>راتبك</h3>
        <p>
          إذا كان راتبك يدخل حساباً مشتركاً أو حساباً يملك زوجك كلمة مروره، حوّليه إلى حساب فردي باسمك فوراً. أخطري جهة العمل كتابياً. هذا ليس إخفاءً للأصول، بل حماية لدخلك خلال الإجراءات.
        </p>
        <div class="highlight-box">
          <p>افتحي حساباً بنكياً شخصياً باسمك قبل إخبار زوجك بعزمك على الطلاق. بنوك الإمارات الكبرى كبنك الإمارات دبي الوطني وبنك أبوظبي الأول تتيح فتح الحسابات بسرعة بالهوية الإماراتية وجواز السفر.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>مكافأة نهاية الخدمة والطلاق في الإمارات</h2>
        <p>
          مكافأة نهاية الخدمة من أكبر الأصول المالية للموظفين طويلي الخدمة في الإمارات — وقد تبلغ أشهراً أو سنوات من الراتب بعد عقد من العمل. فهم كيفية التعامل معها قانونياً أمر بالغ الأهمية.
        </p>
        <h3>ما هي مكافأة نهاية الخدمة؟</h3>
        <p>
          بموجب قانون العمل الإماراتي، يستحق الموظف عند انتهاء الخدمة: ٢١ يوم عمل عن كل سنة في السنوات الخمس الأولى، ثم شهر عن كل سنة بعد ذلك. بعد عشر سنوات من العمل بمتوسط راتب إماراتي قد تبلغ هذه المكافأة ١٠٠٠٠٠ إلى ٥٠٠٠٠٠ درهم أو أكثر.
        </p>
        <h3>كيف تتعامل المحاكم مع مكافأة نهاية الخدمة؟</h3>
        <p>
          المكافأة حق شخصي للزوج يُدفع له من صاحب العمل. بموجب القانون الإماراتي هي ملك الزوج لأنها مسجلة باسمه. لكن في نزاعات التسوية المالية قد تُحاجج الزوجة بأن المكافأة المتراكمة خلال سنوات الزواج تمثل موارد مالية أسرية تؤثر في تقدير المتعة والنفقة. احصلي على كشف رصيد المكافأة الحالي مبكراً واستشيري محامياً.
        </p>
      </section>

      <section class="content-section">
        <h2>العقار في الإمارات عند الطلاق</h2>
        <div class="property-scenarios">
          <div class="scenario-card">
            <h3>عقار مسجل بالاسمين</h3>
            <p>إذا كانا مُدرجَين على سند الملكية معاً فالعقار مملوك مشتركاً ويجب تقسيمه: إما بيعه وتوزيع العائد، أو شراء أحدهما نصيب الآخر.</p>
          </div>
          <div class="scenario-card">
            <h3>عقار باسم الزوج فقط</h3>
            <p>المالك المسجل يحتفظ بالعقار. للزوجة مطالبة فقط إذا أثبتت مساهمتها المالية المباشرة (دفع أقساط رهن، تكاليف تجديد، تحويل مباشر) بالمستندات.</p>
          </div>
          <div class="scenario-card">
            <h3>عقار مع رهن عقاري</h3>
