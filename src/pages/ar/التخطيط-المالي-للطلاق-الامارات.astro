const title = 'التخطيط المالي للطلاق في الإمارات — حماية حقوقك المالية ٢٠٢٥';
const description =
  'التخطيط المالي للطلاق في الإمارات: حقوق المرأة المالية في الإسلام (مهر، نفقة العدة، المتعة)، الحسابات البنكية المشتركة، مكافأة نهاية الخدمة، العقار، والديون. قائمة إجراءات عملية باللغة العربية.';

const canonical = 'https://divorceu.ae/ar/التخطيط-المالي-للطلاق-الامارات/';

const hreflang = {
