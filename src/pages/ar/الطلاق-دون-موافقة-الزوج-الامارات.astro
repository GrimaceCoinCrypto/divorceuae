---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الطلاق دون موافقة الزوج في الإمارات — حقوق المرأة الكاملة ٢٠٢٥';
const description =
  'لا تحتاج المرأة في الإمارات إلى موافقة زوجها لتطلب الطلاق. دليل شامل للمسالك الأربعة للمسلمة (الخلع والتطليق للضرر والغياب والفسخ) ومسار غير المسلمة، وحقوقك المالية، وكيف تحمين نفسك وأطفالك أثناء الإجراءات.';

const canonical = 'https://divorceu.ae/ar/الطلاق-دون-موافقة-الزوج-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-without-husband-consent-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الطلاق دون موافقة الزوج في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل تستطيع المرأة طلب الطلاق في الإمارات دون موافقة الزوج؟',
