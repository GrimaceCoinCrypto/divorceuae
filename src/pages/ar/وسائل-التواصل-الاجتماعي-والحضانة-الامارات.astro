---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'وسائل التواصل الاجتماعي والحضانة في الإمارات — كيف تؤثر منشوراتك على قضيتك';
const description =
  'تأثير وسائل التواصل الاجتماعي على قضايا حضانة الأطفال في الإمارات: قانون حماية الطفل الرقمي 2025، موافقة الوالدين على نشر صور الأطفال، الأدلة الرقمية أمام المحاكم الإماراتية، والحماية من الملاحقة الإلكترونية بعد الطلاق.';

const canonical = 'https://divorceu.ae/ar/وسائل-التواصل-الاجتماعي-والحضانة-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/social-media-child-custody-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'وسائل التواصل والحضانة في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل يمكن استخدام منشورات وسائل التواصل الاجتماعي كدليل في قضايا الحضانة بالإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. المحاكم الإماراتية تقبل الأدلة الرقمية بما فيها صور الفيسبوك وإنستغرام، والرسائل الخاصة على واتساب وسناب شات، ومقاطع التيك توك، وتغريدات تويتر. يمكن للطرف الآخر تقديم لقطات شاشة لهذه المنشورات إلى القاضي مع طلب الخبير القضائي للتحقق من صحتها.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما هو المرسوم بقانون اتحادي رقم 26 لسنة 2025 وكيف يؤثر على الحضانة؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'المرسوم بقانون رقم 26/2025 (قانون حماية الطفل الرقمي) دخل حيز التنفيذ في يناير 2026. يُلزم الوالدَين في حالة الحضانة المشتركة بالحصول على موافقة الطرف الآخر قبل نشر صور أو مقاطع فيديو للأطفال على الفضاء الإلكتروني. النشر دون موافقة يُعدّ انتهاكاً لحقوق الولاية المشتركة ويمكن أن يُقدَّم كدليل ضدك في جلسات الحضانة.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن أن يُلحق واتساب ضرراً بقضية حضانتي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. رسائل واتساب تُستخدم بانتظام في قضايا الطلاق والحضانة أمام المحاكم الإماراتية. الرسائل التي تُظهر لغة عدوانية أو توجيهات مناهضة للطرف الآخر أو تهديدات أو محادثات تُثير شكوكاً حول قدرتك على التعامل مع الأطفال — كلها قابلة للتقديم كدليل. الحذف لا يكفي؛ الطرف الآخر غالباً يحتفظ بلقطات الشاشة.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل نشر الوالد صور الأطفال على إنستغرام يستوجب موافقة الطرف الآخر؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'في ظل الحضانة المشتركة لغير المسلمين (قانون 2022) والمرسوم رقم 26/2025، نعم. اتخاذ قرارات تمسّ هوية الطفل الرقمية يدخل ضمن حقوق الولاية المشتركة. قرارات محكمة أبوظبي الأسرية بدأت في تفسير قانون 2025 بهذه الطريقة. الأحوط قانونياً هو الاستئذان الصريح قبل النشر.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما هي الملاحقة الإلكترونية وكيف تحمي نفسك منها بعد الطلاق؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الملاحقة الإلكترونية (Cyberstalking) تشمل: المراقبة المستمرة لحساباتك، إرسال رسائل مزعجة أو مهددة، نشر صور أو معلومات خاصة، والتتبع الرقمي. قانون مكافحة الجرائم الإلكترونية الإماراتي (المرسوم بقانون رقم 34/2021) يُجرِّم هذه الأفعال. قدِّم شكوى للشرطة مع الأدلة الرقمية. يمكنك أيضاً طلب أمر حماية من محكمة الأحوال الشخصية.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن للزوج استخدام صور الزوجة على وسائل التواصل لإثبات نشوزها؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'من الناحية النظرية نعم. في قضايا الطلاق الإسلامي، يمكن للزوج محاولة تقديم صور أو منشورات تُظهر سلوكاً يراه منافياً لواجبات الزواج. تقدير هذه الأدلة يعود للقاضي. الصور المنتزعة من سياقها تُستخدم أحياناً بشكل مُضلِّل؛ المحامي يمكنه دحضها بتقديم السياق الكامل.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن للقاضي مراجعة حسابات وسائل التواصل بشكل مباشر؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'المحاكم الإماراتية لا تُصدر عادةً أوامر باختراق الحسابات الخاصة. لكن يمكنها الطلب من الشركات توفير بيانات معينة وفق ترتيبات قانونية دولية، أو الاعتماد على الأدلة التي يُقدِّمها الطرفان من لقطات الشاشة. الخبير الرقمي المعتمد قضائياً (digital forensic expert) يمكنه التحقق من أصالة الأدلة المقدَّمة.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الذي يجب تجنبه على وسائل التواصل أثناء إجراءات الطلاق والحضانة؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تجنب: نشر صور الأطفال دون موافقة الطرف الآخر، التعليق على القضية أو الطرف الآخر، نشر أدلة لمستوى المعيشة في توقيت قد يُستخدم ضدك، مشاركة معلومات عن سفرك أو إقامتك الجديدة. ما تنشره اليوم قد يُقرأ أمام القاضي غداً.',
      },
    },
  ],
};

const faqItems = [
  {
    question: 'ما نوع المنشورات التي تضرّ فعلاً بقضايا الحضانة أمام المحاكم الإماراتية؟',
    answer: 'المنشورات الأكثر ضرراً: (1) الصور التي تُظهر تركاً للأطفال أو إهمالاً، (2) التعليقات العدوانية أو المسيئة تجاه الطرف الآخر أمام الأطفال، (3) الصور في حفلات أو أماكن يرى القاضي أنها غير مناسبة أثناء وقت الحضانة، (4) المنشورات التي تُثبت الغياب المتكرر عن الأطفال، (5) إعلانات العلاقة الجديدة في توقيت غير ملائم. السياق يهم: الصورة وحدها نادراً ما تحسم القضية، لكنها تُشكِّل أنماطاً يستخدمها القضاة في تقييم الأصلح للأطفال.',
  },
  {
    question: 'هل رسائل واتساب مع محامين أو أطراف ثالثة محمية من الإفصاح؟',
    answer: 'الرسائل بين العميل ومحاميه تتمتع بسرية قانونية محمية. المحادثات مع الأصدقاء والأقارب أو الطرف الآخر ليست محمية. إذا أرسل الطرف الآخر رسائل تهديدية أو تطاولية، احتفظ بها كأدلة. إذا تبادلتما رسائل حول الأطفال، تذكر أن هذه الرسائل قد تُقرأ أمام القاضي بتمامها لا بجزء منها.',
  },
  {
    question: 'كيف يتعامل قانون حماية الطفل الرقمي 26/2025 مع مقاطع اليوتيوب والتيك توك للأطفال؟',
    answer: 'القانون يُغطي جميع منصات النشر الرقمي بما فيها يوتيوب وتيك توك وإنستغرام وسناب شات. إنشاء محتوى من الأطفال يتطلب موافقة الوالدَين في حالة الحضانة المشتركة. الوالد الذي يُنشئ قناةً يوتيوب أو حساباً تيك توكياً لطفله الذي يشارك في حضانة مشتركة دون إذن الطرف الآخر قد يواجه دعوى قانونية ويؤثر سلباً على قضيته.',
  },
  {
    question: 'هل يمكن للطرف الآخر توظيف خبير تقني لاستخراج بيانات من هاتفي؟',
    answer: 'لا يجوز الوصول غير المُصرَّح به إلى هاتفك الشخصي أو حساباتك. محاولة اختراق الجهاز أو الحسابات تُعدّ جريمة بموجب قانون الجرائم الإلكترونية رقم 34/2021. لكن الخبير القضائي المُعيَّن من المحكمة يمكنه — بأمر قضائي — فحص الأجهزة المشتركة أو تحليل أدلة رقمية مُقدَّمة من الطرف الآخر. التمييز بين الأجهزة الشخصية والمشتركة مهم قانونياً.',
  },
  {
    question: 'ماذا أفعل إذا تعرضت للتحرش أو الملاحقة الإلكترونية من طرف الزوج السابق؟',
    answer: 'احتفظ بكل الأدلة: لقطات الشاشة مع التاريخ والوقت، سجلات المكالمات، الرسائل المتكررة. قدِّم بلاغاً لمركز الشرطة مع نسخ من الأدلة. تقدَّم إلى النيابة العامة بشكوى بموجب المرسوم بقانون رقم 34/2021. يمكنك أيضاً طلب أمر حماية مؤقت من محكمة الأحوال الشخصية يمنع الطرف الآخر من التواصل معك إلا من خلال قنوات محددة أو عبر المحامين.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">دليل الطلاق · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        ما تنشره على إنستغرام أو تُرسله عبر واتساب يمكن أن يُقرأ أمام قاضي الحضانة غداً. المرسوم بقانون رقم 26 لسنة 2025 أدخل قواعد جديدة صريحة حول نشر صور الأطفال في حالات الحضانة المشتركة. هذا الدليل يشرح ما يُشكِّل خطراً قانونياً فعلياً وما يمكنك فعله حماةً لمصلحتك.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="answer-box">
        <h2>الخلاصة العملية</h2>
        <ul>
          <li><strong>قانون حماية الطفل الرقمي 2025:</strong> في الحضانة المشتركة، نشر صور الأطفال يستلزم موافقة الوالدَين.</li>
          <li><strong>الأدلة الرقمية مقبولة:</strong> واتساب، فيسبوك، إنستغرام، سناب شات — كلها تصل إلى القاضي.</li>
          <li><strong>لقطات الشاشة لا تُحذف:</strong> الطرف الآخر يحتفظ بها حتى بعد حذفك المنشور.</li>
          <li><strong>الملاحقة الإلكترونية جريمة:</strong> قانون الجرائم الإلكترونية 34/2021 يُجرِّمها صراحةً.</li>
        </ul>
      </div>

      <section class="content-section">
        <h2>المرسوم بقانون رقم 26/2025 — قانون حماية الطفل الرقمي</h2>

        <p>
          دخل المرسوم بقانون اتحادي رقم 26 لسنة 2025 حيز التنفيذ في يناير 2026. يُشكِّل هذا القانون تحولاً جوهرياً في طريقة تعامل المحاكم الإماراتية مع الهوية الرقمية للأطفال في سياق النزاعات الأسرية.
        </p>

        <h3>ما الذي يُنظِّمه القانون تحديداً؟</h3>
        <p>
          القانون يُلزم الوالدَين بالحصول على موافقة مشتركة قبل نشر أي صور أو مقاطع مصورة للأطفال على الفضاء الرقمي في حالة الحضانة المشتركة. هذا يشمل: منشورات المنصات العامة (فيسبوك، إنستغرام، تيك توك، يوتيوب)، القصص المؤقتة (ستوري)، المجموعات الكبيرة على واتساب أو تيليغرام التي تضم أشخاصاً من خارج نطاق الأسرة المباشرة.
        </p>

        <p>
          إلى جانب ذلك، يُقيِّد القانون استخدام صور الأطفال في أغراض تجارية أو للترويج الإلكتروني دون إذن قضائي في حالات النزاع. انتهاك القانون يُعدّ قرينةً قانونية سلبية في جلسات الحضانة — لا يُسقط الحضانة تلقائياً لكنه يُدخل في الميزان.
        </p>

        <h3>ما الذي لا يشمله القانون؟</h3>
        <p>
          الرسائل الخاصة في مجموعات عائلية صغيرة ومحدودة لا تُعدّ نشراً عاماً. صور الذكريات المشتركة التي لا تُنشر علناً لا تقع تحت طائلة القانون. إذا كانت الحضانة لطرف واحد فقط (وليست مشتركة) فالقيود تختلف ويتمتع الوالد الحاضن بهامش أوسع.
        </p>
      </section>

      <section class="content-section">
        <h2>قرارات محكمة أبوظبي الأسرية: سوابق قضائية مهمة</h2>

        <p>
          محكمة الأسرة بأبوظبي أصدرت قرارات كرّست مبدأ أن نشر صور الأطفال بدون موافقة الطرف الآخر في الحضانة المشتركة يُعدّ انتهاكاً لحقوق الولاية.
        </p>

        <div class="types-list">
          <div class="type-card">
            <div class="type-header">
              <span class="type-icon">⚖️</span>
              <div>
                <h3 class="type-name">مبدأ الموافقة المشتركة على النشر</h3>
              </div>
            </div>
            <p class="type-detail">المحاكم فسّرت حقوق الولاية المشتركة لغير المسلمين (قانون 2022) على أنها تشمل القرارات المتعلقة بالهوية الرقمية للطفل. نشر محتوى يُعرِّف الطفل أو يُحدِّد مكانه أو يُؤثر في نظرة الآخرين إليه يدخل ضمن هذه الحقوق.</p>
          </div>
          <div class="type-card">
            <div class="type-header">
              <span class="type-icon">📱</span>
              <div>
                <h3 class="type-name">الأدلة الرقمية في تقارير الخبراء</h3>
              </div>
            </div>
            <p class="type-detail">المحاكم بدأت تطلب من الخبراء الاجتماعيين (الأخصائيين الاجتماعيين المُعيَّنين قضائياً) مراجعة حضور كل ولي أمر على وسائل التواصل ضمن تقرير تقييم الأصلح للطفل (best interests assessment). الحضور الرقمي المتوازن والمُلتزم يُحسب إيجاباً.</p>
          </div>
          <div class="type-card">
            <div class="type-header">
              <span class="type-icon">🔍</span>
              <div>
                <h3 class="type-name">التحقق من أصالة الأدلة الرقمية</h3>
              </div>
            </div>
            <p class="type-detail">المحاكم الإماراتية تتعامل بحذر مع الأدلة الرقمية المُعدَّلة. يُمكن للطرف الآخر الطعن في صحة لقطات الشاشة بتكليف خبير تقني مُعتمد قضائياً للتحقق من بيانات التعريف (metadata) والأصالة.</p>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2>كيف تُضرّك وسائل التواصل في قضية الحضانة؟</h2>

        <div class="factors-list">
          <div class="factor-item">
            <h3>التصريح بالخلاف الأسري علناً</h3>
            <p>المنشورات التي تسخر من الطرف الآخر أو تنتقد تصرفاته كوالد أمام جمهور واسع تُضعف صورتك أمام القاضي، لأنها تُشير إلى صعوبة في التعاون المشترك على تربية الأطفال — وهو معيار أساسي في تقييم الحضانة.</p>
          </div>
          <div class="factor-item">
            <h3>إظهار أسلوب حياة يُثير التساؤلات</h3>
            <p>صور الحفلات أو السفر المتكرر أو العلاقات الجديدة أثناء فترة الإجراءات لا تُسقط الحضانة بحد ذاتها، لكنها تُشكِّل ذريعةً يستثمرها الطرف الآخر. القاضي يُقيِّم النمط العام لا الصورة المنفردة.</p>
          </div>
          <div class="factor-item">
            <h3>مشاركة تفاصيل القضية</h3>
            <p>النشر عن تفاصيل الإجراءات القانونية الجارية قد يُعدّ في بعض الحالات انتهاكاً لسرية التقاضي. المحاكم الإماراتية تفرض أحياناً قيوداً صريحة على الإفصاح أثناء النظر في القضية.</p>
          </div>
          <div class="factor-item">
            <h3>تحريض الأطفال عبر التواصل الرقمي</h3>
            <p>إرسال رسائل للأطفال تُحرِّضهم ضد الوالد الآخر أو تُعرِّفهم بتفاصيل النزاع يُعدّ شكلاً من أشكال التدخل في الحضانة. مثل هذه الرسائل إذا توفرت تُستخدم كدليل مباشر على التقصير في تحقيق مصلحة الطفل.</p>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2>الأدلة الرقمية أمام المحاكم الإماراتية — كيف تقدِّمها وكيف تطعن فيها</h2>

        <h3>كيفية تقديم الدليل الرقمي</h3>
        <p>
          لتقديم دليل رقمي في قضية الحضانة: احصل على لقطات الشاشة مع تاريخ ووقت النشر وبيانات الحساب ظاهرة بوضوح. أحضر ترجمةً معتمدة إذا كان المحتوى بلغة غير العربية. في الحالات المعقدة، يُفضَّل تكليف خبير تقني مُعتمد لكتابة تقرير يُثبت صحة الدليل وسياقه الرقمي.
        </p>

        <h3>كيفية الطعن في الدليل الرقمي</h3>
        <p>
          إذا قدَّم الطرف الآخر لقطات شاشة ادّعى أنك نشرتها: تحقق من المنشور الأصلي إذا كان لا يزال موجوداً وقارنه بما يُقدَّم. يمكن توظيف خبير تقني للتحقق من صحة الـ metadata. قدِّم السياق الكامل للمحادثة أو المنشور — الانتزاع من السياق هو أكثر أساليب التلاعب بالأدلة الرقمية شيوعاً.
        </p>

        <div class="info-box">
          <p><strong>تحذير عملي:</strong> لا تحذف المنشورات أو الرسائل بمجرد بدء إجراءات الطلاق. الحذف بعد بدء الإجراءات قد يُفسَّر على أنه إتلاف للأدلة. إذا كان لديك محتوى تريد الاحتفاظ به بسرية، استشر محاميك قبل أي إجراء.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>الحماية من الملاحقة الإلكترونية بعد الطلاق</h2>

        <p>
          الملاحقة الإلكترونية (Cyberstalking) بعد الطلاق ظاهرة موثَّقة وتزداد مع سهولة الوصول إلى أدوات المراقبة الرقمية. الإطار القانوني الإماراتي يُعالجها بجدية.
        </p>

        <h3>أشكال الملاحقة الإلكترونية المُجرَّمة</h3>
        <p>
          المرسوم بقانون اتحادي رقم 34 لسنة 2021 (قانون مكافحة الجرائم الإلكترونية) يُجرِّم: المراقبة الإلكترونية دون إذن، اختراق الحسابات أو الأجهزة، نشر معلومات خاصة دون موافقة، إرسال رسائل متكررة ذات طابع تهديدي أو مزعج، ونشر صور شخصية أو حميمة (الانتقام الإباحي).
        </p>

        <h3>كيف تحمي نفسك؟</h3>
        <p>
          غيِّر جميع كلمات المرور فوراً عند بدء إجراءات الطلاق. تحقق من الأجهزة المشتركة وأزل تطبيقات المراقبة إذا وجدت. راجع قوائم "من لديه وصول" لجميع حساباتك المتزامنة (جيميل، آبل، جوجل دراف). قدِّم بلاغاً للشرطة مع توثيق كل حادثة بلقطات الشاشة ومكالمات السجل.
        </p>
      </section>

