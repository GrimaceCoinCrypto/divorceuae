  { method: 'استخراج قضائي من الجهاز', strength: 'الأقوى', notes: 'خبير تقني تعيّنه المحكمة يستخرج الرسائل من الجهاز نفسه. يصعب الطعن فيه.', admissible: true },
  { method: 'تصدير بيانات واتساب للأعمال', strength: 'قوي', notes: 'تصدير رسمي من حسابات واتساب للأعمال يتضمن البيانات الوصفية ومنسَّق لتقديمه للمحكمة.', admissible: true },
  { method: 'سجلات شركة الاتصالات (الرسائل النصية)', strength: 'متوسط', notes: 'تُقدّم بأمر قضائي. لا تتضمن محتوى الرسائل بل البيانات الوصفية فحسب.', admissible: true },
  { method: 'شهادة شهود', strength: 'متوسط', notes: 'شخص اطلع على الرسالة أو سمع بها. تعزّز الدليل لكنها نادراً ما تكفي وحدها.', admissible: true },
  { method: 'لقطة شاشة غير موثَّقة', strength: 'ضعيف', notes: 'مقبولة لكن يسهل الطعن فيها. احرصي دائماً على التوثيق مع إظهار البيانات الوصفية.', admissible: true },
  { method: 'وصف شفهي للرسالة', strength: 'ضعيف جداً', notes: 'ستطلب المحكمة الرسالة الأصلية قبل قبول الوصف الشفهي.', admissible: false },
];

const faqItems = [
  {
    question: 'أرسل زوجي "أنتِ طالق" ثلاث مرات عبر واتساب — هل انتهى الزواج نهائياً؟',
    answer: 'ليس بالضرورة وليس تلقائياً. بموجب القانون الإماراتي يُحسب إرسال "طالق طالق طالق" ثلاث مرات في مجلس واحد طلقةً رجعيةً واحدة، لا طلاقاً بائناً. تأخذ المحاكم الإماراتية بمذهب المالكية والحنابلة في هذه المسألة. ويظل الطلاق عديم الأثر القانوني حتى تسجيله خلال ١٥ يوماً وفق المادة ٥٨.',
