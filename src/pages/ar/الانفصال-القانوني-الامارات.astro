---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الانفصال القانوني في الإمارات — لا يوجد وضع رسمي والبدائل المتاحة ٢٠٢٥';
const description =
  'لا يوجد "انفصال قانوني" رسمي في القانون الإماراتي. هذا الدليل يوضح ذلك للقراء العرب ويشرح البدائل المتاحة: نفقة مستقلة، أوامر وقتية، مفهوم النشوز والإعسار في الفقه الإسلامي، والفسخ القضائي.';

const canonical = 'https://divorceu.ae/ar/الانفصال-القانوني-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/legal-separation-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الانفصال القانوني في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل يوجد "انفصال قانوني" رسمي في القانون الإماراتي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. القانون الإماراتي لا يعترف بوضع "الانفصال القانوني" الرسمي المعمول به في القانون البريطاني أو الأمريكي. المتزوجون في الإمارات إما متزوجون أو مطلّقون؛ لا توجد درجة وسطى. غير أن الزوجين يستطيعان الانفصال فعلياً، وتستطيع المحكمة إصدار أوامر وقتية بشأن النفقة والحضانة وحق استخدام المسكن دون إنهاء الزواج.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكن للزوجة المطالبة بنفقة دون تقديم دعوى طلاق؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. يمكن للزوجة رفع دعوى نفقة مستقلة أمام محكمة الأحوال الشخصية دون تقديم طلب طلاق. الزوج ملزم بالنفقة طوال فترة الزواج بصرف النظر عن الانفصال الفعلي. إذا رفض الدفع يمكن صدور أمر قضائي بإلزامه. دعوى النفقة المستقلة تُنظر عادةً في غضون ٢-٤ أسابيع للحصول على أمر وقتي.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الفرق بين الخلع والفسخ القضائي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الخلع طلاق بمبادرة الزوجة مقابل ردّ المهر وحصولها على موافقة الزوج أو رفضه دون أن يمنع الطلاق نهائياً. الفسخ القضائي إنهاء قضائي للزواج بناءً على أسباب محددة كامتناع الزوج عن النفقة أو الإيذاء أو الغياب الطويل، ولا يشترط موافقة الزوج. الفسخ هو الأقرب لمفهوم "الانفصال القانوني القضائي" في الفقه الإسلامي، لكنه في الحقيقة حلٌّ كامل للزواج لا مرحلة انتقالية.',
      },
    },
  ],
};

const separationOptions = [
  { n: 1, title: 'الانفصال الفعلي دون أمر قضائي', body: 'يستطيع الزوجان السكن في مسكنين منفصلين دون الحاجة إلى أمر من المحكمة. لا يوجد إلزام قانوني بالتساكن. تبقى جميع الحقوق والالتزامات الزوجية سارية: النفقة، تأشيرة الإقامة التبعية، الملكية المشتركة. هذا أكثر الترتيبات شيوعاً في فترات الأزمات الزوجية.' },
  { n: 2, title: 'الأوامر القضائية الوقتية', body: 'أثناء محاولة الإصلاح أو في انتظار إجراءات الطلاق، يمكن للمحكمة إصدار أوامر وقتية بشأن النفقة والحضانة واستخدام المسكن. هذه الأوامر تُوفر إطاراً قانونياً للانفصال دون إنهاء الزواج، ويمكن تعديلها بتغيّر الظروف.' },
  { n: 3, title: 'الفسخ القضائي (للمسلمين)', body: 'يُتيح الفسخ القضائي للزوجة المسلمة إنهاء الزواج بأمر قضائي استناداً إلى أسباب محددة دون حاجة لموافقة الزوج. هو أقرب ما يكون في الفقه الإسلامي من "الانفصال القضائي" لكنه في الواقع حلٌّ كامل لرابطة الزواج وليس مرحلة انتقالية.' },
];

const faskhGrounds = [
  'امتناع الزوج عن النفقة المالية بغير عذر مشروع',
  'ثبوت الإضرار بالزوجة أو إيذائها',
  'غياب الزوج أو تركه الزوجة دون مبرر (يتجاوز سنةً عادةً)',
  'مرض خطير أو عجز يحول دون أداء الزوج لواجبات الزواج',
  'سجن الزوج لمدة تُلحق بالزوجة ضرراً جسيماً',
  'الإساءة المتكررة، جسديةً كانت أو نفسية',
];

const faqItems = [
  {
    question: 'هل يمكن إجبار الزوج على مغادرة المنزل خلال فترة الانفصال؟',
    answer: 'فقط بموجب أمر قضائي. لا يجوز لأي طرف إخراج الآخر من المنزل المشترك من تلقاء نفسه، وهذا يُعرّضك لمسؤولية قانونية. إذا كان الوضع يتضمن عنفاً أسرياً أو خطراً فعلياً فاطلبي أمراً قضائياً حمائياً طارئاً فوراً. في غير ذلك يجب التقدم بطلب أمر وقتي يُخوّل أحد الطرفين الانتفاع المنفرد بالمسكن.',
  },
  {
    question: 'هل يؤثر الانفصال على تأشيرة إقامة الأطفال؟',
    answer: 'لا. تأشيرات إقامة الأطفال مكفولة عادةً من أحد الوالدين (الأب غالباً) ومستقلة عن الوضع الزواجي للوالدين. انفصال الوالدين فعلياً لا يُؤثر على صحة تأشيرات الأطفال. التغيير يحدث عند صدور حكم الطلاق النهائي حين تُحدد الحضانة رسمياً لا خلال فترة الانفصال. إذا خشيتِ قيام الطرف الآخر بتغيير الكفالة اطلبي استشارة قانونية عاجلة.',
  },
  {
    question: 'هل يؤثر الانفصال على تأشيرتي الشخصية في الإمارات؟',
    answer: 'إذا كنتِ تعملين ولديك تأشيرة عمل خاصة بك فالانفصال لا يؤثر عليها. تأشيرتك مستقلة عن وضعك الزوجي. أما إذا كنتِ مكفولة بتأشيرة زوجك فتبقى تأشيرتك سارية طوال فترة الزواج القانوني. عند صدور حكم الطلاق تُلغى التأشيرة التبعية وتدخلين في مهلة ٣٠ يوماً للانتقال إلى تأشيرة مستقلة أو مغادرة الإمارات.',
  },
  {
    question: 'ما التزامات الزوج المالية خلال فترة الانفصال الفعلي؟',
    answer: 'الزواج القانوني مستمر خلال الانفصال الفعلي، وبالتالي الالتزامات المالية مستمرة. الزوج ملزم بنفقة الزوجة شاملةً المسكن طوال مدة الزواج. لا يُعفيه الانفصال الفعلي من هذا الالتزام. إذا رفض الدفع يمكنك التقدم لمحكمة الأحوال الشخصية بطلب نفقة وقتية تُنظر في غضون ٢-٤ أسابيع عادةً. مبدأ الإعسار في الفقه الإسلامي يُتيح أحياناً تخفيف الالتزام إذا ثبت عجز الزوج الحقيقي عن الدفع لا مجرد رفضه.',
  },
  {
    question: 'هل يمكن فتح حساب بنكي منفصل خلال فترة الانفصال؟',
    answer: 'نعم. يمكنك فتح حساب بنكي شخصي باسمك في أي وقت خلال الزواج، والانفصال لا يُغير ذلك. غير أن الحسابات المشتركة تستلزم موافقة الطرفين لإغلاقها أو تعديل التفويض أو إجراء سحوبات كبيرة. إذا خشيتِ استنزاف الزوج للأموال المشتركة خلال الانفصال اطلبي أمراً قضائياً بتجميد الوصول. التصرف المنفرد في إفراغ الحساب المشترك يُؤثر سلباً في الإجراءات اللاحقة.',
  },
  {
    question: 'ما النشوز وكيف يؤثر على النفقة والانفصال؟',
    answer: 'النشوز في الفقه الإسلامي هو خروج الزوجة عن طاعة الزوج دون عذر مشروع، كأن تمتنع عن السكن المشترك أو تخرج دون إذنه. إذا ثبت النشوز قضائياً تسقط نفقة الزوجة. لكن يشترط ثبوته قضائياً لا مجرد ادعاء الزوج. في حالة الانفصال الفعلي يُحاجج بعض الأزواج بالنشوز لإسقاط النفقة، وهذا يستلزم الدفاع عنه أمام المحكمة. وكّلي محامياً إذا واجهتِ هذا الادعاء.',
  },
  {
    question: 'هل يتحول الانفصال الفعلي تلقائياً إلى طلاق بعد مدة معينة؟',
    answer: 'لا. في القانون الإماراتي لا يتحول الانفصال الفعلي إلى طلاق تلقائياً مهما طالت المدة. الطلاق يستلزم إجراءً قضائياً رسمياً: طلاقاً بإرادة الزوج أو دعوى خلع أو فسخ قضائي أو طلاق بالتراضي مع صدور حكم. مجرد العيش منفصلين سنوات لا يُنهي الزواج قانونياً.',
  },
  {
    question: 'ما الفرق بين الانفصال وفترة التفكير قبل الطلاق؟',
    answer: 'كثيراً ما يلجأ الزوجان إلى فترة الانفصال كمرحلة تفكير قبل قرار نهائي. القانون الإماراتي يُتيح ذلك دون قيد، ويدعمه مبدأ الإمهال في الفقه الإسلامي لإعطاء الأطراف فرصة التروي. مرحلة توجيه الأسرة الإلزامية قبل نظر دعوى الطلاق تخدم هذا الغرض بشكل رسمي. يمكن لمحامٍ مساعدتك على هيكلة فترة الانفصال بأوامر وقتية تُحمي حقوقك دون أن تُغلق باب الإصلاح.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">الانفصال القانوني · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        كثير من الناطقين بالعربية يبحثون عن "انفصال قانوني" في الإمارات ظناً منهم أنه وضع معترف به مثلما في المملكة المتحدة أو بعض الدول الأوروبية. الجواب الصريح: لا يوجد هذا الوضع في القانون الإماراتي. لكن القانون يُتيح أدواتٍ فعليةً تحمي حقوقك المالية وحقوق أطفالك وتأشيرة إقامتك خلال مرحلة الانتظار. هذا الدليل يشرح هذه الأدوات بلغة واضحة.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="summary-box">
        <h2>حقائق أساسية</h2>
        <div class="summary-grid">
          <div class="summary-card">
            <p class="summary-label">تأشيرة الإقامة</p>
            <p class="summary-value">محفوظة</p>
            <p class="summary-note">طوال استمرار الزواج القانوني</p>
          </div>
          <div class="summary-card">
            <p class="summary-label">النفقة الزوجية</p>
            <p class="summary-value">مستمرة</p>
            <p class="summary-note">الزوج ملزم بالدفع رغم الانفصال الفعلي</p>
          </div>
          <div class="summary-card">
            <p class="summary-label">الفسخ القضائي</p>
            <p class="summary-value">٢-٤ أشهر</p>
            <p class="summary-note">إنهاء قضائي للزواج بأسباب محددة</p>
          </div>
        </div>
      </div>

      <section class="content-section">
        <h2>هل تعترف الإمارات بالانفصال القانوني؟</h2>
        <p>
          لا. الإمارات لا تعترف بوضع "الانفصال القانوني" الرسمي المعمول به في القانون البريطاني أو الأمريكي أو معظم القوانين الأوروبية. في القانون الإماراتي المتزوجون إما في زواج سارٍ أو مطلّقون؛ لا توجد مرحلة وسطى تُحفظ فيها الزوجية وتُوقف الالتزامات.
        </p>
        <p>
          هذا لا يعني أن الزوجين لا خيار لهما. الانفصال الفعلي مباح تماماً، ولا يُلزم القانون بالتساكن. يستطيع الزوجان العيش منفصلَيْن، وتستطيع المحكمة إصدار أوامر وقتية تُنظّم النفقة والحضانة وحق المسكن دون إنهاء الزواج.
        </p>
        <p>
          لغياب الانفصال الرسمي تداعيات عملية لا يتوقعها كثير من المقيمين الأجانب، لا سيما من حيث وضع التأشيرة والالتزامات المالية. فهم هذه التداعيات قبل اتخاذ أي قرار أمرٌ ضروري.
        </p>
        <div class="info-box info-box--info">
          <h3>لماذا هذا مهم للمقيمين الأجانب؟</h3>
          <p>في الدول التي تعترف بالانفصال القانوني يحمي أمر الانفصال الأصول ويُرسّخ الدعم المالي ويُنشئ سجلاً رسمياً. في الإمارات يجب الجمع بين أوامر قضائية وقتية وخطوات مالية عملية وتخطيط قانوني دقيق لتحقيق تأثير حمائي مماثل. لا شيء منها تلقائي.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>الخيارات المتاحة للانفصال دون الطلاق في الإمارات</h2>
        <div class="options-list">
          {separationOptions.map((opt) => (
            <div class="option-card">
              <div class="option-num">{opt.n}</div>
              <div class="option-content">
                <h3>{opt.title}</h3>
                <p>{opt.body}</p>
              </div>
            </div>
          ))}
        </div>
        <p>
          يلجأ كثير من الأزواج إلى مزيج من هذه الخيارات: يعيشون منفصلين باتفاق، مع أمر قضائي وقتي بالنفقة والحضانة، بينما يتداولان القرار النهائي. مرحلة توجيه الأسرة الإلزامية السابقة لقبول أكثر دعاوى الطلاق يمكن بحد ذاتها أن تكون فترة تفكير منظّمة.
        </p>
      </section>

      <section class="content-section">
        <h2>التأشيرة والإقامة خلال الانفصال</h2>
        <p>
          وضع التأشيرة أحد أكثر المخاوف العملية إلحاحاً للمقيمين الأجانب المنفصلين في الإمارات، لا سيما من هم بتأشيرات تبعية مكفولة من الزوج.
        </p>
        <h3>إذا كنتِ بتأشيرة تبعية مكفولة من زوجك</h3>
        <p>
          تأشيرة إقامتك سارية طوال فترة الزواج القانوني ما دام زوجك يجدد كفالتها. الانفصال الفعلي لا يُلغيها تلقائياً. النقطة الحرجة هي صدور حكم الطلاق النهائي؛ عندها تُلغى التأشيرة التبعية وتدخلين في مهلة ٣٠ يوماً للانتقال إلى تأشيرة مستقلة أو مغادرة الإمارات.
        </p>
        <p>
          هذا يُفرز دافعاً عملياً للتريث في إنهاء الزواج ريثما تُرتّب وضع تأشيرتك المستقبلي. كثيرات يستخدمن فترة الانفصال للحصول على تأشيرة عمل خاصة بهن أو استكشاف خيارات إقامة بديلة.
        </p>
        <h3>إذا كنتِ بتأشيرة عمل مستقلة</h3>
        <p>
          الانفصال لا يُؤثر على إقامتك. تأشيرتك مستقلة عن وضعك الزوجي تماماً. يمكنك الانفصال والطلاق أو المصالحة دون أن يمس ذلك حقك في البقاء بالإمارات بموجب كفالة عملك.
        </p>
        <div class="info-box info-box--warning">
          <h3>لا تدعي تأشيرتك تنتهي دون قصد</h3>
          <p>إذا ألغى زوجك تأشيرتك التبعية خلال فترة الانفصال (وهو مخوَّل لذلك كفيل) قد تجدين نفسك في وضع تجاوز المدة المسموح بها. احصلي على استشارة قانونية فوراً إذا خشيتِ أن يُقدم على ذلك. يمكن للمحاكم في بعض الظروف إصدار أوامر وقتية تمنع الإلغاء خلال الإجراءات السارية.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>النفقة والترتيبات المالية خلال الانفصال</h2>
        <p>
          الزواج القانوني مستمر خلال الانفصال، وبالتالي الالتزامات المالية للزواج مستمرة. للأزواج المسلمين بخاصة لهذا تداعيات عملية واسعة.
        </p>
        <h3>النفقة الزوجية الواجبة</h3>
        <p>
          الزوج المسلم ملزم شرعاً وقانوناً بنفقة زوجته طوال فترة الزواج، شاملةً المسكن حتى خارج بيت الزوجية. إذا كانت الزوجة تسكن بمسكن مستقل فهو مُلزَم بتكاليف سكنها ضمن النفقة. إذا رفض الدفع تستطيع رفع دعوى نفقة أمام محكمة الأحوال الشخصية وتصدر أوامرها الوقتية عادةً في غضون ٢-٤ أسابيع.
        </p>
        <h3>مفهوم النشوز وأثره على النفقة</h3>
        <p>
          النشوز في الفقه الإسلامي هو خروج الزوجة عن طاعة الزوج دون مسوّغ شرعي. إذا ثبت النشوز قضائياً سقطت النفقة. بعض الأزواج يتذرعون به في حالة الانفصال الفعلي محاولةً لإسقاط الالتزام المالي. لكن إثباته يستلزم دليلاً أمام المحكمة ولا يُقبل بمجرد ادعاء الزوج. إذا واجهتِ هذا الادعاء وكّلي محامياً فوراً للدفاع عن حقك.
        </p>
        <h3>الأصول المشتركة والممتلكات</h3>
        <p>
          الحسابات المشتركة والعقارات المشتركة والاستثمارات المشتركة تبقى كما هي خلال الانفصال ما لم يُصدر قرار قضائي بتغيير ذلك. لا يستطيع أيٌّ من الزوجين بيع الممتلكات المشتركة بصورة منفردة. إذا خشيتِ أن يُهرّب الزوج الأموال أو يُفرّغ الأصول فاطلبي من المحكمة أمراً بتجميدها.
        </p>
      </section>

      <section class="content-section">
        <h2>الأطفال والحضانة خلال الانفصال</h2>
        <p>
          حين ينفصل الزوجان يصبح ترتيب إقامة الأطفال الشاغل الأعجل عملياً. تستطيع المحاكم إصدار أوامر حضانة وإقامة وقتية دون انتظار انتهاء إجراءات الطلاق.
        </p>
        <p>
          الحكم الافتراضي للحضانة الوقتية خلال الانفصال يُحاكي مبادئ الطلاق النهائية: للمسلمين يغلب تطبيق قرينة الأم في الحضانة للصغار مع بقاء الولاية للأب؛ لغير المسلمين تُطبَّق قرينة المشاركة المتكافئة. كلاهما خاضع في آخر المطاف لتقدير المحكمة لمصلحة الطفل.
        </p>
        <h3>حظر السفر خلال الانفصال</h3>
        <p>
          إذا خشيتِ أن يُسافر الزوج بالأطفال خارج الإمارات دون موافقتك فتقدمي فوراً بطلب حظر سفر. تستطيع المحاكم إصداره بصورة عاجلة (٢٤-٧٢ ساعة في الحالات الحقيقية). ينفَّذ حظر السفر في جميع منافذ الحدود والمطارات الإماراتية بصرف النظر عن جنسية الطرف الآخر.
        </p>
        <p>
          حتى لو اعتقدتِ أنه لن يُسافر فعلاً يُعدّ الحصول على أمر الحظر احتياطاً معقولاً في الانفصالات عالية التوتر، ويمكن رفعه لاحقاً باتفاق أو أمر قضائي.
        </p>
      </section>

      <section class="content-section">
        <h2>الفسخ القضائي في الفقه الإسلامي: الأقرب لمفهوم الانفصال القضائي</h2>
        <p>
          الفسخ القضائي هو الآلية التي يُقدّمها القانون الإماراتي الأقرب إلى فكرة "إنهاء قضائي يُلزم الزوج". يتيح للزوجة المسلمة إنهاء الزواج بحكم قضائي عند توافر أسباب محددة حتى لو رفض الزوج الطلاق أو الخلع.
        </p>
        <p>
          الأسباب المعترف بها للفسخ بموجب قانون الأحوال الشخصية الاتحادي:
        </p>
        <ul class="checklist">
          {faskhGrounds.map((g) => <li>{g}</li>)}
        </ul>
        <p>
          يستغرق إجراء الفسخ عادةً ٢-٤ أشهر. تُقدم الزوجة التماساً لمحكمة الأحوال الشخصية، تُفحص المحكمة الأدلة، وإذا ثبتت الأسباب أصدرت أمراً بإنهاء الزواج دون الحاجة لموافقة الزوج. هذه الميزة هي ما يُميز الفسخ عن الخلع.
        </p>
        <p>
          حكم الفسخ طلاق كامل لا مرحلة انتقالية. بصدوره تبدأ فترة العدة وتترتب عليها أحكام النفقة والمهر وفق أحكام الطلاق غير الاختياري.
        </p>
        <div class="info-box info-box--info">
          <h3>الفسخ مقابل الخلع: الاختيار العملي</h3>
          <p>إذا أمكنك التفاوض مع الزوج وقبل بالطلاق مقابل رد المهر فالخلع عادةً أسرع وأقل خصومةً. إذا رفض الزوج وتوافرت لديك أسباب للفسخ فالمحكمة تستطيع تجاوز رفضه. محاميك سيُشير عليك بالمسار الأجدى بناءً على ظروفك الخاصة.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>من الانفصال إلى الطلاق أو المصالحة</h2>
        <p>
          فترة الانفصال تنتهي في نهاية المطاف بأحد مسارين: الطلاق أو المصالحة. القانون الإماراتي يُتيح كلاهما دون عقوبة على مدة الانفصال.
        </p>
        <h3>إذا حصلت المصالحة</h3>
        <p>
          لا يُلزم ذلك أي إجراء قانوني ما لم تكن دعاوى رسمية قائمة. إذا لم تُرفع دعوى طلاق رسمية يستأنف الزوجان حياتهما الزوجية ببساطة. إذا صدرت أوامر وقتية خلال الانفصال قد تحتاجان لتعديلها أو إلغائها بأمر قضائي جديد.
        </p>
        <p>
          إذا أصدر الزوج طلاقاً رجعياً (الطلقة الأولى أو الثانية) خلال الانفصال فالمراجعة قبل انقضاء العدة تُلغي الطلاق وتبقى الزوجية دون الحاجة لعقد جديد.
        </p>
        <h3>إذا أفضى الانفصال إلى الطلاق</h3>
        <p>
          يجب تقديم دعوى طلاق جديدة، فمدة الانفصال لا تُحسب إجراءً مكتملاً. تبدأ إجراءات الطلاق من جديد شاملةً مرحلة التوجيه الأسري الإلزامية عند الاقتضاء. غير أن الأوامر الوقتية الصادرة خلال الانفصال تُزوّد المحكمة بإطار مرجعي مفيد للترتيبات النهائية.
        </p>
      </section>

