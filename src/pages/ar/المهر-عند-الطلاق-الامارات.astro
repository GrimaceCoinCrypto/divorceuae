const enforcementTools = [
  { tool: 'تجميد الحساب البنكي', how: 'تُصدر المحكمة أمراً للبنوك بتجميد الحسابات ونقل المبالغ حتى قدر الحكم', timeline: '١ إلى ٣ أسابيع من أمر التنفيذ' },
  { tool: 'الحجز على الراتب', how: 'يُوجَّه صاحب العمل لخصم ما يصل إلى ٥٠٪ من الراتب الشهري حتى سداد الدين', timeline: '١ إلى ٢ شهر' },
  { tool: 'حظر السفر', how: 'يمنع الزوج من مغادرة الإمارات حتى السداد', timeline: 'يُطبّق سريعاً في أيام معدودة' },
  { tool: 'الحجز على الأصول', how: 'يُصادر المنفذون القضائيون الأصول المنقولة (مركبات، مقتنيات ثمينة) للبيع في المزاد', timeline: '٢ إلى ٤ أشهر' },
  { tool: 'التنفيذ على العقار', how: 'العقار المسجّل باسمه يمكن الحجز عليه وبيعه للوفاء بالدين', timeline: '٣ إلى ٦ أشهر' },
];

const faqItems = [
  {
    question: 'هل يستطيع الزوج تخفيض مبلغ المهر أثناء الطلاق؟',
    answer: 'لا يستطيع ذلك بشكل انفرادي. المهر المتفق عليه في عقد الزواج حق قانوني لك وتُلزِم به المحكمة. يجوز التفاوض لكن لا يجوز الإلغاء من طرف واحد.',
  },
  {
    question: 'ماذا يحدث إذا لم يُحدِّد عقد الزواج مبلغ المهر؟',
    answer: 'تُقدّر المحكمة مهر المثل وهو المبلغ المعتاد لنساء من نفس البيئة الاجتماعية لأسرة الزوجة. تستند المحكمة إلى وضع الزوج المادي ومستوى معيشته لتحديد المبلغ المناسب.',
  },
  {
    question: 'هل تستحق المرأة المهر في حالة الخلع؟',
    answer: 'في الخلع ترد الزوجة عادةً المهر المعجل. أما المهر المؤجل فحكمه أكثر تعقيداً؛ إذا كان الزوج متسبباً في انهيار الزواج قد تحتفظ الزوجة بحق المهر المؤجل. يُنصح بالحصول على استشارة متخصصة.',
  },
  {
    question: 'كيف أطالب بالمهر المؤجل غير المدفوع بعد الطلاق؟',
    answer: 'يُقدَّم طلب إلى محكمة الأحوال الشخصية مرفقاً بعقد الزواج وشهادة الطلاق. تُصدر المحكمة حكماً بالمبلغ المستحق. إذا رفض الزوج يُلجأ إلى محكمة التنفيذ.',
  },
  {
    question: 'ما مدة التقادم للمطالبة بالمهر المؤجل في الإمارات؟',
    answer: 'لا يوجد تقادم صريح لكن المحاكم تتوقع المطالبة في وقت مناسب. الأجدر دمج مطالبة المهر مع دعوى الطلاق لتوفير الوقت والتكاليف.',
  },
  {
    question: 'هل يؤثر إعادة زواج المرأة على حقها في المهر من زواجها السابق؟',
    answer: 'لا. حق المرأة في المطالبة بالمهر غير المدفوع لا يتأثر بزواجها الجديد. يبقى لها الحق في مطابعة زوجها السابق على المهر المستحق.',
  },
  {
    question: 'ما الفرق بين المهر والنفقة والمتعة في الإمارات؟',
    answer: 'ثلاثة حقوق مستقلة: المهر مبلغ عقد الزواج وملك الزوجة. النفقة مصاريف معيشية خلال العدة. المتعة تعويض لمرة واحدة عند الطلاق بإرادة الزوج. يجوز المطالبة بالثلاثة في دعوى واحدة.',
  },
  {
    question: 'هل تستطيع المحكمة تخفيض مبلغ المهر الذي تراه مبالغاً فيه؟',
    answer: 'المحاكم تحترم المهر المتفق عليه بحرية. قد تتدخل فقط إذا كان مفرطاً لدرجة الإفلاس بلا مبرر. الصعوبة المالية اللاحقة وحدها لا تُسوّغ التخفيض.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">المهر والحقوق المالية · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        المهر ليس هبةً يملك الزوج إهمالها، بل هو حق تعاقدي واجب النفاذ قانوناً. سواء دُفع المهر المعجل عند الزواج أو بقي المهر المؤجل معلّقاً، فإن كامل المبلغ المستحق يحلّ أجله فور صدور حكم الطلاق. تعامل محاكم الإمارات المهر غير المدفوع باعتباره ديناً ويُنفَّذ به بذات الآليات المعتمدة في أي حكم قضائي.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="summary-grid-wrap">
        <div class="summary-card">
          <p class="s-label">مدة التنفيذ</p>
          <p class="s-value">٢ - ٤ أشهر</p>
          <p class="s-note">من الطلب إلى الاستيفاء</p>
        </div>
        <div class="summary-card">
          <p class="s-label">رسوم التقديم</p>
          <p class="s-value">٣٠٠ - ٧٠٠ درهم</p>
          <p class="s-note">محكمة الأحوال الشخصية</p>
        </div>
        <div class="summary-card">
          <p class="s-label">أتعاب المحامي</p>
          <p class="s-value">٢,٠٠٠ - ٥,٠٠٠ درهم</p>
          <p class="s-note">طلب مهر نموذجي</p>
        </div>
      </div>

      <div class="answer-box">
        <h2>ما المهر وما أهميته عند الطلاق في الإمارات؟</h2>
        <p>
          المهر هو المبلغ الذي يُلتزم به الزوج لزوجته شرطاً في عقد الزواج الإسلامي. خلافاً للمهر في كثير من الثقافات، في الإسلام يدفع الزوج للزوجة لا العكس. هذا يعني قانونياً أن المهر ملك الزوجة الخالص لا يشاركها فيه أحد، كفلته المواد 45 إلى 48 من <strong>المرسوم بقانون اتحادي رقم 41 لسنة 2024</strong> (نافذ من 15 أبريل 2025).
        </p>
        <p>
          تتعامل محاكم الإمارات مع شرط المهر في عقد الزواج باعتباره بنداً تعاقدياً ملزماً تماماً كأي بند في عقد تجاري.
        </p>
      </div>

      <section class="content-section">
        <h2>المهر المعجل والمهر المؤجل: الفرق الفقهي والقانوني</h2>
        <p>
          ينقسم المهر إلى نوعين: المهر المعجل (المقدَّم) ويُدفع عند إتمام العقد أو بُعيد حفل الزواج، والمهر المؤجل (المؤخَّر) يتفق عليه عند الزواج لكنه لا يستحق إلا عند وقوع حدث مستقبلي هو في الغالب الطلاق أو وفاة الزوج.
        </p>
        <p>
          كثير من عقود الزواج في الإمارات تجمع بين النوعين: مهر معجل متواضع يُدفع في الحفل، ومهر مؤجل أكبر يُشكّل ضماناً مالياً للزوجة. هذه الحماية الثنائية منصوص عليها فقهاً وتعززها المادة 45 من المرسوم بقانون 41/2024.
        </p>

        <h3>المهر المعجل عند الطلاق</h3>
        <p>
          المهر المعجل مفترض دفعه عند الزواج. إذا لم يدفع الزوج المهر المعجل المتفق عليه، تراكم عليه ديناً من تاريخ استحقاقه. يمكن للزوجة المطالبة به في أي وقت، بما في ذلك أثناء دعوى الطلاق. أحكام المادتين 47 و48 من المرسوم بقانون 41/2024 تُعلي صراحةً من مكانة هذا الحق وتُشدد على أنه لا يسقط بالتقادم المعتاد.
        </p>

        <h3>المهر المؤجل عند الطلاق</h3>
        <p>
          يحلّ المهر المؤجل فور النطق بالطلاق سواء كان طلاقاً بإرادة الزوج أو خلعاً بطلب الزوجة أو طلاقاً قضائياً. لا يوجد مهلة سماح. لحظة صدور حكم الطلاق يُصبح كامل المبلغ المؤجل ديناً واجب الأداء في الحال.
        </p>
        <p>
          لا تُجيز المحاكم للزوج تقسيط المبلغ إلا بموافقة الزوجة. إذا أرادت استيفاء المبلغ كاملاً فوراً فهذا حقها. وستعامل محكمة التنفيذ الرفض أو التأخير مثل أي حكم مالي آخر.
        </p>

        <div class="info-box info-box--warning">
          <h3>المطالبة بالمهر ضمن دعوى الطلاق وليس بعدها</h3>
          <p>لا يوجد تقادم صارم للمطالبة بالمهر، لكن دمج المطالبة في دعوى الطلاق الرئيسية أكثر كفاءة وأقل تكلفة بكثير. رفع دعوى مستقلة لاحقاً يتطلب إعادة تأسيس الملف القانوني من جديد.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>حالات سقوط حق المرأة في المهر كلياً أو جزئياً</h2>
        <p>
          قانون الأحوال الشخصية الإماراتي يحدد حالات يتأثر فيها حق المهر:
        </p>
        <ul class="checklist">
          <li>الخلع: ترد الزوجة المهر المعجل لأنها هي التي طلبت إنهاء الرابطة الزوجية</li>
          <li>النشوز الموثّق قضائياً: إذا ثبت نشوز الزوجة بحكم قضائي قد تسقط بعض حقوقها لكن هذا يُقيَّد بضوابط صارمة</li>
          <li>الطلاق قبل الدخول: يكون للزوجة نصف المهر المعجل فقط إذا طُلِّقت قبل الدخول وقبل التخلي (المادة 46 من المرسوم بقانون 41/2024)</li>
          <li>التنازل الحر: إذا تنازلت الزوجة عن المهر بإرادتها الحرة الكاملة وثبت ذلك بصورة قانونية</li>
        </ul>
        <p>
          ادّعاء الزوج بأن الزوجة تنازلت غير كافٍ؛ يجب إثباته بدليل موثّق. ادعاء النشوز يستلزم حكماً قضائياً سابقاً لا مجرد قول.
        </p>
      </section>

      <section class="content-section">
        <h2>خطوات المطالبة بالمهر غير المدفوع أمام محاكم الإمارات</h2>
        <div class="step-list">
          <div class="step-item">
            <div class="step-num">١</div>
            <div class="step-content">
              <h3>جمع عقد الزواج والوثائق الثبوتية</h3>
              <p>عقد الزواج الأصلي (النكاح) أو نسخة مصدّقة منه هو دليلك الأساسي. يجب أن يُحدد مبلغ المهر صراحةً. إذا تم الزواج في الخارج قد يستلزم الأمر توثيقه أو الحصول على شهادة أبوستيل لقبوله أمام محاكم الإمارات.</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-num">٢</div>
            <div class="step-content">
              <h3>توكيل محامٍ أسرة متخصص في الإمارات</h3>
              <p>يُحضّر المحامي طلب المهر ويُقدّمه إلى محكمة الأحوال الشخصية في إمارة إقامتك. في دبي هي دائرة شؤون الأسرة في محاكم دبي. في أبوظبي هي الدائرة القضائية في جهاز القضاء الأبوظبي.</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-num">٣</div>
            <div class="step-content">
              <h3>تقديم الطلب ودفع الرسوم</h3>
              <p>رسوم التقديم 300 إلى 700 درهم حسب الإمارة وقيمة المطالبة. يُقدّم محاميك الطلب مرفقاً بعقد الزواج والوثائق الشخصية وحكم الطلاق إن كان قد صدر.</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-num">٤</div>
            <div class="step-content">
              <h3>الجلسة ومراجعة عقد الزواج</h3>
              <p>يفحص القاضي عقد الزواج ويُثبّت المبلغ المتفق عليه ويتحقق مما سُدِّد فعلاً. للزوج فرصة تقديم إثبات الدفع. إذا عجز عن ذلك صدر الحكم لصالحك.</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-num">٥</div>
            <div class="step-content">
              <h3>صدور الحكم ومرحلة التنفيذ</h3>
              <p>تُصدر المحكمة حكماً بإلزام الزوج بالدفع خلال مهلة محددة. إذا دفع انتهى الأمر. إذا أبى أو تأخر تُحيل القضية إلى محكمة التنفيذ.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2>آليات تنفيذ حكم المهر حين يمتنع الزوج عن الدفع</h2>
        <p>
          حكم المحكمة بالمهر غير المدفوع أمر نافذ لا مجرد توصية. تمتلك محكمة التنفيذ في الإمارات أدوات إلزامية قوية وراسخة:
        </p>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>أداة التنفيذ</th>
                <th>آلية العمل</th>
                <th>المدة المعتادة</th>
              </tr>
            </thead>
            <tbody>
              {enforcementTools.map((row) => (
                <tr>
                  <td class="td-highlight">{row.tool}</td>
                  <td>{row.how}</td>
