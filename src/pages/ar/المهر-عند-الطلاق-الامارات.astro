---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'المهر عند الطلاق في الإمارات — المهر المعجل والمؤجل وكيفية المطالبة به ٢٠٢٥';
const description =
  'المهر حق قانوني واجب النفاذ للمرأة المسلمة في الإمارات. تعرّفي على الفرق بين المهر المعجل والمؤجل، ومتى يسقط حق المرأة، وكيف تطالبين بالمهر غير المدفوع أمام محكمة التنفيذ.';

const canonical = 'https://divorceu.ae/ar/المهر-عند-الطلاق-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/mahr-divorce-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'المهر عند الطلاق في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
