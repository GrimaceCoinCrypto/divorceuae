  },
];

const countryGuide = [
  { country: 'المملكة المتحدة', hague: 'نعم', steps: 'مصادقة المحكمة + أبوستيل الخارجية + ترجمة إنجليزية معتمدة', embassy: 'غير مطلوب', note: 'قدّمي الوثائق المصدّقة لمكتب السجل لإعادة الزواج' },
  { country: 'الهند', hague: 'نعم (٢٠٠٥)', steps: 'مصادقة المحكمة + أبوستيل الخارجية + ترجمة إنجليزية', embassy: 'تصديق القنصلية الهندية مطلوب أحياناً من الجهات المحلية', note: 'راجعي متطلبات نادرا/السجل المدني في ولايتك' },
  { country: 'باكستان', hague: 'لا', steps: 'مصادقة المحكمة + تصديق الخارجية + تصديق السفارة الباكستانية', embassy: 'السفارة/المفوضية الباكستانية في الإمارات', note: 'ثم التسجيل في نادرا باكستان' },
  { country: 'الفلبين', hague: 'نعم', steps: 'مصادقة المحكمة + أبوستيل الخارجية', embassy: 'تصديق القنصلية الفلبينية مطلوب أحياناً إضافةً', note: 'راجعي متطلبات هيئة الإحصاء PSA' },
  { country: 'روسيا', hague: 'نعم', steps: 'مصادقة المحكمة + أبوستيل الخارجية', embassy: 'غير مطلوب؛ لكن يلزم التسجيل في ZAGS في روسيا', note: 'خذي الوثيقة المصدّقة إلى ZAGS لتحديث السجل المدني الروسي' },
