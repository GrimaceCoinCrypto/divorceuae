  { country: 'أستراليا', hague: 'نعم', steps: 'مصادقة المحكمة + أبوستيل الخارجية + ترجمة إنجليزية', embassy: 'غير مطلوب', note: 'قدّمي الوثيقة لسجل المواليد والوفيات والزواج' },
  { country: 'ألمانيا', hague: 'نعم', steps: 'مصادقة المحكمة + أبوستيل الخارجية + ترجمة ألمانية من مترجم محلّف', embassy: 'غير مطلوب', note: 'قدّمي الوثيقة لمكتب الأحوال المدنية Standesamt' },
