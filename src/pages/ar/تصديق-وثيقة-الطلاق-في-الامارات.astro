---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'تصديق وثيقة الطلاق في الإمارات: الخطوات والتكلفة';
const description =
  'دليل تصديق حكم الطلاق الإماراتي لاستخدامه في الخارج: نسخة المحكمة، تصديق وزارة الخارجية، التصديق القنصلي من سفارة دولة الوجهة، والترجمة القانونية المعتمدة. الإمارات ليست دولة أبوستيل.';

const canonical = 'https://divorceu.ae/ar/تصديق-وثيقة-الطلاق-في-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-certificate-attestation-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'تصديق وثيقة الطلاق في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'كيف أحصل على وثيقة الطلاق الإماراتية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الوثيقة الرسمية للطلاق في الإمارات هي حكم المحكمة (حكم الطلاق) أو إشهاد الطلاق الذي توثّقه المحكمة. احصلي على نسخة مصدّقة من المحكمة التي أصدرته: محاكم دبي، أو دائرة القضاء في أبوظبي، أو المحاكم الاتحادية عبر وزارة العدل. الرسوم تقديرياً بين ٥٠ و١٠٠ درهم، وتكون النسخة جاهزة عادةً خلال يوم إلى ٣ أيام عمل. أحضري جواز سفرك والهوية الإماراتية ورقم القضية. هذه النسخة المصدّقة هي نقطة البداية لكل إجراءات التصديق.',
      },
    },
    {
      '@type': 'Question',
      name: 'كم يستغرق التصديق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'المدد تقديرية وتختلف حسب المحكمة والوثيقة ودولة الوجهة. النسخة المصدّقة من المحكمة تستغرق عادةً من يوم إلى ٣ أيام عمل، وتصديق وزارة الخارجية عبر البوابة الإلكترونية (mofa.gov.ae) من ٣ إلى ٧ أيام عمل تقريباً. أما تصديق سفارة دولة الوجهة، إن اشترطته الجهة المستلِمة، فيتفاوت كثيراً من سفارة لأخرى، وقد يصل الإجراء كاملاً إلى ٣ أو ٤ أسابيع. تحقّقي من المدد الحالية لدى كل جهة قبل أن تلتزمي بموعد في الخارج.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل تصدر الإمارات أبوستيل لوثيقة الطلاق؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. الإمارات ليست طرفاً في اتفاقية لاهاي للأبوستيل، فلا تصدر وزارة الخارجية أبوستيل على الوثائق الإماراتية، ولا تقبل الجهات الإماراتية الأبوستيل الأجنبي وحده. تعتمد الإمارات بدلاً من ذلك التصديق (التصديق القنصلي): نسخة مصدّقة من المحكمة، ثم تصديق وزارة الخارجية، ثم تصديق سفارة دولة الوجهة أو قنصليتها في الإمارات إذا اشترطته الجهة المستلِمة، ثم الترجمة القانونية المعتمدة عند الحاجة. ولا يغيّر ذلك أن تكون دولة الوجهة عضواً في الاتفاقية، لأن الأبوستيل لا يُستخدم إلا بين دولتين عضوين. تكتفي بعض الجهات الأجنبية بتصديق وزارة الخارجية وحده، والجهة المستلِمة هي التي تقرّر، فاسأليها أولاً.',
      },
    },
    {
      '@type': 'Question',
      name: 'كيف أستخدم وثيقة طلاقي الإماراتية في بريطانيا؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'بريطانيا دولة أبوستيل، لكن الإمارات ليست كذلك، فلا تحمل وثيقة الطلاق الإماراتية أبوستيل. المسار المعتاد: نسخة مصدّقة من المحكمة الإماراتية، ثم تصديق وزارة الخارجية الإماراتية، ثم ترجمة إنجليزية معتمدة. ويُعترف بالطلاق الإماراتي عادةً في إنجلترا وويلز بموجب قانون الأسرة لعام ١٩٨٦ إذا صدر بإجراءات قضائية وكان أحد الطرفين مقيماً إقامة معتادة في الإمارات أو متوطناً فيها أو من مواطنيها. قبل التقديم، اسألي الجهة البريطانية المستلِمة (مكتب السجل لإعادة الزواج، أو جهة المزايا أو المعاش) عمّا إذا كانت تكتفي بتصديق وزارة الخارجية أو تطلب خطوات إضافية.',
      },
    },
    {
      '@type': 'Question',
      name: 'كيف أستخدم وثيقة طلاقي الإماراتية في الهند؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الهند عضو في اتفاقية لاهاي للأبوستيل، لكن ذلك لا ينطبق على وثيقة إماراتية لأن الإمارات ليست عضواً. المسار: نسخة المحكمة المصدّقة، ثم تصديق وزارة الخارجية الإماراتية، ثم تصديق السفارة الهندية في أبوظبي أو القنصلية الهندية في دبي إذا طلبته الجهة الهندية، مع ترجمة إنجليزية معتمدة إذا كانت الوثيقة بالعربية فقط. تطلب بعض مكاتب تسجيل الزواج والسجلات المدنية في الولايات الهندية تصديق البعثة الهندية تحديداً، فتحقّقي من متطلبات الجهة المعنية بحالتك.',
      },
    },
    {
      '@type': 'Question',
      name: 'كيف أستخدم وثيقة طلاقي الإماراتية في باكستان؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تنطبق سلسلة التصديق المعتادة: نسخة مصدّقة من المحكمة الإماراتية، ثم تصديق وزارة الخارجية الإماراتية، ثم تصديق السفارة الباكستانية في أبوظبي أو القنصلية الباكستانية في دبي. خذي الوثيقة المصدّقة إلى هيئة نادرا (NADRA) في باكستان لتسجيل الحالة المدنية. تطلب بعض مكاتب نادرا أيضاً ترجمة معتمدة بالأردية أو الإنجليزية. راجعي نظام المواعيد والرسوم الحالي لدى البعثة الباكستانية لأن مدد المعالجة تتفاوت.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا لو لم أذهب إلى المحكمة، هل يمكنني الحصول على وثيقة طلاق لطلاق شفهي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الطلاق المنطوق (شفهياً أو كتابةً خارج المحكمة) ليس له وثيقة مستقلة قابلة للتصديق. يجب توثيقه لدى محكمة الأحوال الشخصية، وتلزم المادة ٥٨ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ الزوج بتوثيق الطلاق خلال ١٥ يوماً على الأكثر من وقوعه، مع احتفاظ الزوجة بحقها في رفع دعوى إثبات الطلاق. بعد التوثيق تصدر المحكمة وثيقة يمكن تصديقها عبر السلسلة المعتادة. ومن دون توثيق قضائي، لا توجد وثيقة قابلة للتصديق.',
      },
    },
    {
      '@type': 'Question',
      name: 'من أين أحصل على ترجمة معتمدة لوثيقة طلاقي الإماراتية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'للاستخدام الرسمي، تُنجز الترجمة القانونية المعتمدة على يد مترجم قانوني مرخّص من وزارة العدل الإماراتية، وتتوفر قائمة المترجمين المرخّصين على موقع الوزارة (moj.gov.ae). وتقبل بعض الدول بدلاً من ذلك ترجمة مترجم محلّف لديها فقط، فاسألي الجهة المستلِمة أولاً. أسعار المكاتب المرخّصة تقديرياً بين ١٥٠ و٤٠٠ درهم للصفحة حسب اللغة ودرجة التعقيد. تجنّبي مكاتب الترجمة العامة غير المرخّصة للترجمة القانونية.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا لو احتفظ الطرف الآخر بأصول وثائق الطلاق ورفض مشاركتها؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا تحتاجين إلى الأصل. تحتفظ المحكمة الإماراتية بالحكم الأصلي وتصدر نسخاً مصدّقة لأي طرف في القضية. توجّهي إلى المحكمة (أو استخدمي خدماتها الإلكترونية) بجواز سفرك والهوية الإماراتية، وقدّمي رقم القضية (أو اسمك الكامل وسنة الطلاق التقريبية)، واطلبي نسخة مصدّقة. لكلا طرفي الطلاق الحق في الحصول على نسخ مصدّقة بشكل مستقل.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكنني استخدام البوابة الإلكترونية لوزارة الخارجية للتصديق؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. توفّر وزارة الخارجية خدمة تصديق إلكترونية عبر mofa.gov.ae وتطبيقها: تقدّمين طلب تصديق الوثيقة، وتدفعين الرسوم، وتتابعين الحالة، ثم تستلمين الوثيقة المصدّقة. هذا تصديق وزارة الخارجية وليس أبوستيل، فالإمارات ليست دولة أبوستيل. تستغرق الخدمة العادية تقديرياً من ٣ إلى ٧ أيام عمل، وقد تتوفر خدمة أسرع عبر مراكز الخدمة المعتمدة برسوم أعلى.',
      },
    },
  ],
};

const faqItems = faqSchema.mainEntity.map((q) => ({
  question: q.name,
  answer: q.acceptedAnswer.text,
}));

const attestationChain = [
  {
    step: '٠١',
    title: 'نسخة الحكم المصدّقة من المحكمة المُصدِرة',
    where: 'محاكم دبي، أو دائرة القضاء في أبوظبي، أو المحاكم الاتحادية عبر وزارة العدل، أو محكمة الإمارة المعنية',
    cost: '٥٠-١٠٠ درهم (تقديرية)',
    time: '١-٣ أيام عمل (تقديرية)',
    notes: 'حكم الطلاق أو إشهاده بختم المحكمة. يمكن لكلا الطرفين طلبه بشكل مستقل.',
  },
  {
    step: '٠٢',
    title: 'تصديق وزارة الخارجية (MOFA)',
    where: 'mofa.gov.ae أو تطبيق الوزارة، أو مراكز الخدمة المعتمدة',
    cost: '١٥٠-٣٠٠ درهم (تقديرية، حسب نوع الوثيقة)',
    time: '٣-٧ أيام عمل إلكترونياً (تقديرية)',
    notes: 'تصادق الوزارة على ختم المحكمة وتوقيعها. هذا تصديق وليس أبوستيل: الإمارات ليست طرفاً في اتفاقية لاهاي للأبوستيل.',
  },
  {
    step: '٠٣',
    title: 'تصديق سفارة دولة الوجهة في الإمارات (إن طُلب)',
    where: 'سفارة دولة الوجهة أو قنصليتها في الإمارات',
    cost: 'رسوم السفارة (تختلف)',
    time: 'تختلف من سفارة لأخرى',
    notes: 'تكتفي بعض الجهات الأجنبية بتصديق وزارة الخارجية وحده، وتشترط جهات أخرى هذا التصديق القنصلي. الجهة المستلِمة هي التي تقرّر.',
  },
  {
    step: '٠٤',
    title: 'الترجمة القانونية المعتمدة (عند الحاجة)',
    where: 'مترجم قانوني مرخّص من وزارة العدل الإماراتية، أو مترجم محلّف في دولة الوجهة إذا اشترطت ذلك',
    cost: '١٥٠-٤٠٠ درهم للصفحة (تقديرية)',
    time: '١-٢ يوم عمل (تقديرية)',
    notes: 'مطلوبة إذا كانت دولة الوجهة تعتمد لغة غير العربية. اسألي الجهة المستلِمة هل تقبل ترجمة من الإمارات أم تشترط ترجمة محلية.',
  },
];

const countryGuide = [
  { country: 'المملكة المتحدة', steps: 'نسخة المحكمة + تصديق وزارة الخارجية + ترجمة إنجليزية معتمدة', embassy: 'اسألي الجهة البريطانية المستلِمة عمّا إذا كانت تطلب أكثر من تصديق وزارة الخارجية', note: 'قدّمي الوثائق المصدّقة لمكتب السجل لإعادة الزواج' },
  { country: 'الهند', steps: 'نسخة المحكمة + تصديق وزارة الخارجية + ترجمة إنجليزية', embassy: 'تصديق السفارة أو القنصلية الهندية في الإمارات مطلوب أحياناً من الجهات المحلية', note: 'راجعي متطلبات السجل المدني في ولايتك' },
  { country: 'باكستان', steps: 'نسخة المحكمة + تصديق وزارة الخارجية + تصديق البعثة الباكستانية', embassy: 'السفارة أو القنصلية الباكستانية في الإمارات', note: 'ثم التسجيل في نادرا باكستان' },
  { country: 'الفلبين', steps: 'نسخة المحكمة + تصديق وزارة الخارجية + ترجمة إنجليزية', embassy: 'قد تطلب الجهات الفلبينية تصديق السفارة أو القنصلية الفلبينية في الإمارات', note: 'راجعي متطلبات هيئة الإحصاء PSA' },
  { country: 'روسيا', steps: 'نسخة المحكمة + تصديق وزارة الخارجية + ترجمة روسية', embassy: 'قد يُطلب تصديق السفارة أو القنصلية الروسية في الإمارات', note: 'خذي الوثيقة المصدّقة إلى ZAGS لتحديث السجل المدني الروسي' },
  { country: 'الولايات المتحدة', steps: 'نسخة المحكمة + تصديق وزارة الخارجية + ترجمة إنجليزية', embassy: 'تختلف المتطلبات حسب الولاية والجهة المستلِمة', note: 'قد تختلف إجراءات تحديث السجلات بين الولايات' },
  { country: 'أستراليا', steps: 'نسخة المحكمة + تصديق وزارة الخارجية + ترجمة إنجليزية', embassy: 'اسألي الجهة الأسترالية المستلِمة', note: 'قدّمي الوثيقة لسجل المواليد والوفيات والزواج' },
  { country: 'ألمانيا', steps: 'نسخة المحكمة + تصديق وزارة الخارجية + ترجمة ألمانية من مترجم محلّف', embassy: 'اسألي مكتب الأحوال المدنية Standesamt عن متطلباته', note: 'قدّمي الوثيقة لمكتب الأحوال المدنية Standesamt' },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} lang="ar" />
  </div>

  <!-- Hero -->
  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">وثيقة الطلاق · الإمارات ٢٠٢٦</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        بين يديك حكم طلاق إماراتي، وتريدين الآن استخدامه في الخارج: لإعادة الزواج، أو تحديث جواز السفر، أو الوصول إلى معاش تقاعدي، أو نقل ملكية عقار في بلدك الأم. الإمارات ليست طرفاً في اتفاقية لاهاي للأبوستيل، لذلك تمرّ الوثيقة بسلسلة تصديق محددة: نسخة المحكمة، ثم تصديق وزارة الخارجية، ثم تصديق سفارة دولة الوجهة عند الحاجة، ثم الترجمة القانونية المعتمدة. إذا لم تُتَّبع السلسلة بدقة، قد ترفض الجهات الأجنبية الوثيقة.
      </p>
      <p class="hero-author">بقلم <strong>أليكسي سوننين</strong> · مستشار قانوني ومغترب في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <!-- Key facts box -->
      <div class="answer-box">
        <h2>ما يجب أن تعرفيه من البداية</h2>
        <ul class="key-facts">
          <li><strong>الإمارات ليست دولة أبوستيل.</strong> لا تصدر وزارة الخارجية أبوستيل، بل تصدّق الوثيقة (تصديق وزارة الخارجية)، وقد تشترط دولة الوجهة بعد ذلك تصديق سفارتها في الإمارات.</li>
          <li><strong>وثيقة الطلاق هي حكم المحكمة (حكم الطلاق) أو إشهاده الموثّق.</strong> وليست شهادة تصدرها جهة حكومية أخرى.</li>
          <li><strong>يمكن لكلا الطرفين الحصول على نسخة مصدّقة بشكل مستقل.</strong> لا تحتاجين إلى تعاون الطرف الآخر.</li>
          <li><strong>الطلاق المنطوق دون توثيق قضائي ليس له وثيقة قابلة للتصديق.</strong> يجب توثيق الطلاق في المحكمة أولاً.</li>
          <li><strong>الترجمة القانونية المعتمدة فقط.</strong> استخدمي مترجماً قانونياً مرخّصاً من وزارة العدل، أو المترجم الذي تشترطه دولة الوجهة.</li>
        </ul>
      </div>

      <!-- Section 1: Why You Need It -->
      <section class="content-section">
        <h2>لماذا تحتاجين إلى تصديق وثيقة الطلاق الإماراتية</h2>
        <p>
          تُطلب وثيقة الطلاق الإماراتية المصدّقة في عدة حالات شائعة:
        </p>
        <ul>
          <li><strong>إعادة الزواج في الخارج:</strong> تشترط معظم الدول إثبات انتهاء الزواج السابق قانونياً قبل تسجيل زواج جديد. يحتاج حكم الطلاق الإماراتي إلى تصديق ليُقبل لدى السجلات المدنية والجهات الدينية الأجنبية.</li>
          <li><strong>تحديث جواز السفر والجنسية:</strong> يتطلب تغيير حالتك الاجتماعية في جواز سفر بلدك أو سجلك الوطني إثباتاً مصدّقاً للطلاق.</li>
          <li><strong>الوصول إلى المعاش والمزايا:</strong> تتطلب المعاشات البريطانية ومزايا الناجين في الضمان الاجتماعي الأمريكي والأنظمة المماثلة إثبات الطلاق لتحديد الأهلية أو الوصول إلى مزايا الزوج السابق.</li>
          <li><strong>إجراءات الميراث:</strong> في بعض الدول يحتفظ الزوج السابق بحقوق في التركة ما لم يُعترف بالطلاق قانونياً. يوضّح الحكم الإماراتي المصدّق وضعك.</li>
          <li><strong>نقل الملكية في الخارج:</strong> إذا كنت تملكين عقاراً في بلدك بأسماء مشتركة وتستخدمين الطلاق الإماراتي لإثبات الملكية المنفردة، فيجب تصديق حكم الطلاق للسجل العقاري المعني.</li>
          <li><strong>الحسابات المصرفية والمالية:</strong> تشترط بعض البنوك في دول أخرى إثبات الطلاق لتحديث ترتيبات الحسابات المشتركة أو المستفيدين.</li>
        </ul>
      </section>

      <!-- Section 2: Step 1 -->
      <section class="content-section">
        <h2>الخطوة الأولى: الحصول على نسخة المحكمة المصدّقة</h2>
        <p>
          الوثيقة الرسمية للطلاق في الإمارات هي الحكم الصادر عن المحكمة (حكم الطلاق أو حكم التطليق)، أو إشهاد الطلاق الذي توثّقه المحكمة. تحتاجين إلى نسخة مصدّقة تحمل ختم المحكمة التي أصدرتها.
        </p>

        <h3>ما تحضرينه إلى المحكمة</h3>
        <ul>
          <li>جواز سفرك (الأصل)</li>
          <li>الهوية الإماراتية (إن كانت سارية)</li>
          <li>رقم القضية من إجراءات طلاقك (على أي مراسلة قضائية سابقة)</li>
          <li>الرسوم، وهي تقديرياً بين ٥٠ و١٠٠ درهم</li>
        </ul>
        <p>
          إذا لم يكن لديك رقم القضية، قدّمي اسمك الكامل واسم الطرف الآخر وسنة الطلاق التقريبية، ويستطيع قلم المحكمة تحديد الملف. تستغرق المعالجة عادةً من يوم إلى ٣ أيام عمل.
        </p>
        <p>
          تحتفظ كل جهة قضائية بسجلاتها. إذا نظرت دائرة القضاء في أبوظبي في طلاقك، فاطلبي النسخة منها. وإذا كان في دبي، فمن محاكم دبي (محكمة الأحوال الشخصية). وإذا كانت القضية أمام المحاكم الاتحادية (الشارقة وعجمان وأم القيوين والفجيرة)، فمن خلال وزارة العدل. أما رأس الخيمة فلها محاكمها المحلية.
        </p>

        <div class="info-box info-box--info">
          <h3>إذا كنت خارج الإمارات</h3>
          <p>إذا غادرت الإمارات بالفعل، يمكنك توكيل مكتب محاماة إماراتي مسجّل أو شخص موثوق مقيم في الإمارات بوكالة موثّقة للحصول على النسخة المصدّقة وإنجاز التصديق نيابةً عنك. ويجب أن تحدد الوكالة صلاحية استلام وثائق المحكمة وتفاصيل القضية. إذا أُصدرت الوكالة خارج الإمارات، فهي نفسها تحتاج إلى تصديق في بلد الإصدار ثم لدى سفارة الإمارات ثم وزارة الخارجية قبل استخدامها في الإمارات.</p>
        </div>
      </section>

      <!-- Section 3: The Attestation Chain -->
      <section class="content-section">
        <h2>سلسلة التصديق الكاملة</h2>
        <p>
          يتبع تصديق الوثائق في الإمارات سلسلة ثابتة، وتصادق كل خطوة على توقيع الخطوة السابقة أو ختمها، فلا يمكنك تخطّي أي خطوة. سلسلة وثيقة الطلاق الإماراتية المستخدمة في الخارج هي:
        </p>

        <div class="steps-list">
          {attestationChain.map((s) => (
            <div class="step-card">
              <div class="step-num">{s.step}</div>
              <div class="step-body">
                <h3>{s.title}</h3>
                <div class="step-meta">
                  <span class="meta-label">الجهة:</span> {s.where}<br />
                  <span class="meta-label">التكلفة:</span> {s.cost}<br />
                  <span class="meta-label">المدة:</span> {s.time}
                </div>
                <p>{s.notes}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="note-text">الرسوم والمدد تقديرية وتتغير. تكتفي بعض الجهات الأجنبية بالخطوتين ٠١ و٠٢ مع الترجمة، وتشترط جهات أخرى الخطوة ٠٣ أيضاً. اسألي الجهة المستلِمة في دولة الوجهة قبل البدء.</p>
      </section>

      <!-- Section 4: Why no apostille -->
      <section class="content-section">
        <h2>لماذا لا يوجد أبوستيل لوثيقة الطلاق الإماراتية</h2>
        <p>
          اتفاقية لاهاي للأبوستيل اتفاق دولي يسمح للدول الأعضاء بالاعتراف بختم "الأبوستيل" الصادر عن الجهة المختصة في الدولة المُصدِرة، بدلاً من سلسلة التصديق عبر السفارات. لكن هذا لا يعمل إلا إذا كانت الدولة المُصدِرة ودولة الوجهة كلتاهما عضوين في الاتفاقية.
        </p>
        <p>
          <strong>الإمارات ليست طرفاً في اتفاقية لاهاي للأبوستيل</strong> (راجعي جدول الدول الأعضاء على موقع مؤتمر لاهاي hcch.net). لذلك لا تصدر وزارة الخارجية الإماراتية أبوستيل، بل تصدّق الوثائق، وتعتمد الإمارات نظام التصديق والتصديق القنصلي في الاتجاهين. وكون دولتك عضواً في الاتفاقية، مثل بريطانيا أو الهند أو الولايات المتحدة، لا يغيّر شيئاً بالنسبة لوثيقة صادرة في الإمارات.
        </p>

        <div class="callout-box callout-box--gold">
          <h3>وثيقة إماراتية تُستخدم في الخارج</h3>
          <p class="callout-body">نسخة مصدّقة من المحكمة المُصدِرة، ثم تصديق وزارة الخارجية الإماراتية، ثم تصديق سفارة دولة الوجهة أو قنصليتها في الإمارات إذا اشترطته الجهة المستلِمة، ثم الترجمة القانونية المعتمدة عند الحاجة. تكتفي بعض الجهات بتصديق وزارة الخارجية وحده، والقرار للجهة المستلِمة.</p>
        </div>

        <div class="callout-box callout-box--blue">
          <h3>وثيقة أجنبية تُستخدم في الإمارات (مثل عقد زواج من بلدك)</h3>
          <p class="callout-body">تُصدَّق أولاً في البلد الذي أصدرها (في دول الأبوستيل تكون هذه الخطوة غالباً هي الأبوستيل نفسه أو تصديق وزارة خارجية ذلك البلد)، ثم تُصدَّق لدى سفارة الإمارات أو قنصليتها في ذلك البلد (وهي خطوة رقمية إلى حد كبير الآن)، ثم تصديق وزارة الخارجية في الإمارات، ثم ترجمة قانونية معتمدة إلى العربية على يد مترجم مرخّص في الإمارات. الأبوستيل وحده لا يكفي لتقبل المحاكم الإماراتية الوثيقة.</p>
        </div>
      </section>

      <!-- Section 5: Country Guide -->
      <section class="content-section">
        <h2>متطلبات كل دولة على حدة</h2>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>الدولة</th>
                <th>الإجراء المعتاد</th>
                <th>خطوة السفارة؟</th>
                <th>ملاحظة</th>
              </tr>
            </thead>
            <tbody>
              {countryGuide.map((row, i) => (
                <tr class={i % 2 === 0 ? '' : 'row-alt'}>
                  <td class="td-bold">{row.country}</td>
                  <td class="td-light">{row.steps}</td>
                  <td class="td-light">{row.embassy}</td>
                  <td class="td-light">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note-text">المتطلبات تتغير. تحقّقي من الجهة المستلِمة ومن السفارة المعنية ومن بوابة وزارة الخارجية قبل التقديم. لدى مكاتب السجل المدني في بعض الدول متطلبات إضافية تتجاوز التصديق.</p>

        <h3>بريطانيا بالتفصيل</h3>
        <p>
          بريطانيا دولة أبوستيل، لكن وثيقة الطلاق الإماراتية لا تحمل أبوستيل لأن الإمارات ليست عضواً في الاتفاقية. الحزمة التي تُقدَّم عادةً هي نسخة مصدّقة من حكم المحكمة الإماراتي، مصدّقة من وزارة الخارجية الإماراتية، مع ترجمة إنجليزية معتمدة. وتُقدَّم هذه الحزمة إلى جهات مثل:
        </p>
        <ul>
          <li>مكاتب السجل في إنجلترا وويلز لإعادة الزواج</li>
          <li>مكتب السجل العام للحالة المدنية</li>
          <li>مصلحة الضرائب وإدارة العمل والمعاشات لأغراض المزايا والمعاش</li>
          <li>المحاكم البريطانية إذا جرى الاحتجاج بالطلاق الإماراتي في إجراءات بريطانية</li>
        </ul>
        <p>
          تقرّر كل جهة ما تقبله، فاسأليها قبل التقديم. ولا يلزم عادةً الحصول على حكم من محكمة بريطانية بالاعتراف بالطلاق الإماراتي لأغراض الحالة المدنية: يُعترف بالطلاق الأجنبي بموجب قانون الأسرة لعام ١٩٨٦ إذا تم بإجراءات قضائية وكان نافذاً في الإمارات، وكان أحد الطرفين على الأقل مقيماً إقامة معتادة في الإمارات أو متوطناً فيها أو من مواطنيها عند بدء الإجراءات. وتُستخدم الوثيقة المصدّقة كإثبات مستندي. التفاصيل في <a href="/ar/اعتراف-بريطانيا-بالطلاق-الاماراتي/">اعتراف بريطانيا بالطلاق الإماراتي</a>.
        </p>

        <h3>الهند بالتفصيل</h3>
        <p>
          الهند عضو في اتفاقية لاهاي منذ ٢٠٠٥، لكن الأبوستيل لا يُستخدم لوثيقة إماراتية لأن الإمارات ليست عضواً. المسار هو تصديق وزارة الخارجية الإماراتية، ثم تصديق البعثة الهندية في الإمارات إذا طلبته الجهة الهندية. وتطلب بعض الجهات الهندية، خاصةً مكاتب مسجّل الزواج في الولايات وبعض البنوك، تصديق القنصلية الهندية تحديداً.
        </p>
        <p>
          لتغطية الحالتين: احصلي على تصديق وزارة الخارجية، ثم قدّمي الوثيقة لدى القنصلية الهندية في دبي (أو السفارة الهندية في أبوظبي) أو مركز الخدمة المعتمد لديها لختم تصديقها. يضيف ذلك تقديرياً من ٥ إلى ١٠ أيام عمل ورسماً قنصلياً، فراجعي الرسوم الحالية على موقع البعثة.
        </p>

        <h3>باكستان بالتفصيل</h3>
        <p>
          تلزم سلسلة التصديق الكاملة: نسخة المحكمة المصدّقة، ثم تصديق وزارة الخارجية الإماراتية، ثم تصديق السفارة الباكستانية في أبوظبي أو القنصلية الباكستانية في دبي.
        </p>
        <p>
          تتوفر الرسوم الحالية وحجز المواعيد على موقعي البعثتين، وتستغرق المعالجة تقديرياً من ٥ إلى ٧ أيام عمل من الموعد. وبعد العودة إلى باكستان، يجب تسجيل الوثيقة المصدّقة لدى نادرا لتحديث الحالة المدنية.
        </p>
        <p>
          قد تُطلب أيضاً ترجمة بالأردية من مترجم معتمد في مرحلة نادرا، حسب مكتب التسجيل. أحضري حكم المحكمة الأصلي بالعربية، وترجمته الإنجليزية المعتمدة، وترجمته الأردية المعتمدة عند مراجعة نادرا.
        </p>
      </section>

      <!-- Section 6: MOFA Online Portal -->
      <section class="content-section">
        <h2>استخدام البوابة الإلكترونية لوزارة الخارجية</h2>
        <p>
          تشغّل وزارة الخارجية بوابة إلكترونية لتصديق الوثائق على <strong>mofa.gov.ae</strong>، إلى جانب تطبيقها على الهاتف. وهي المسار الأساسي لمعظم المتقدمين وأسرع عادةً من الحضور الشخصي. ما تحصلين عليه هو تصديق وزارة الخارجية، وليس أبوستيل.
        </p>

        <div class="steps-list">
          <div class="step-card">
            <div class="step-num">٠١</div>
            <div class="step-body">
              <h3>إنشاء حساب وتسجيل الدخول</h3>
              <p>ادخلي إلى mofa.gov.ae وسجّلي الدخول، ويمكن لحاملي الهوية الإماراتية استخدام الهوية الرقمية UAE Pass. اختاري خدمة تصديق الوثائق، وحدّدي نوع الوثيقة (حكم محكمة) والجهة المُصدِرة.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٢</div>
            <div class="step-body">
              <h3>رفع الوثائق الممسوحة</h3>
              <p>ارفعي نسخاً ممسوحة عالية الجودة من نسخة الحكم المصدّقة من المحكمة. قد تطلب منك الوزارة تقديم الأصل المختوم عند الاستلام أو التسليم.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٣</div>
            <div class="step-body">
              <h3>دفع الرسوم وتتبّع الحالة</h3>
              <p>الرسوم تقديرياً بين ١٥٠ و٣٠٠ درهم للوثيقة حسب نوعها، وتظهر القيمة الدقيقة في البوابة قبل الدفع. الدفع بالبطاقة إلكترونياً، ويمكن تتبّع حالة الطلب عبر البوابة. المعالجة المعتادة تقديرياً من ٣ إلى ٧ أيام عمل.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٤</div>
            <div class="step-body">
              <h3>استلام الوثائق المصدّقة</h3>
              <p>استلميها أو اطلبي التوصيل بالبريد السريع، ثم انتقلي إلى تصديق سفارة دولة الوجهة إن اشترطته الجهة المستلِمة. إذا غادرت الإمارات بالفعل، يمكنك توكيل شخص موثوق لاستلامها نيابةً عنك.</p>
            </div>
          </div>
        </div>

        <h3>الخدمة العاجلة</h3>
        <p>
          قد تتوفر لدى مراكز الخدمة المعتمدة معالجة أسرع برسوم أعلى، وهذا مفيد إذا كان لديك موعد نهائي ضيق لجهة أجنبية. تحقّقي من توفر الخدمة ورسومها الحالية قبل الذهاب، وأحضري جميع الوثائق.
        </p>
      </section>

      <!-- Section 7: Talaq Registration -->
      <section class="content-section">
        <h2>الطلاق دون إجراء قضائي: الحصول على وثيقة رسمية</h2>
        <p>
          تبدأ كثير من حالات طلاق المسلمين في الإمارات بطلاق منطوق خارج الإجراءات القضائية الرسمية. وقد يكون هذا صحيحاً شرعاً بموجب قانون الأحوال الشخصية الإماراتي إذا توفرت شروطه. غير أن الطلاق المنطوق شفهياً أو المسجّل بشكل غير رسمي ليس له وثيقة مستقلة قابلة للتصديق.
        </p>

        <h3>لماذا التوثيق ضروري</h3>
        <p>
          تُلزم المادة ٥٨ من المرسوم بقانون اتحادي رقم ٤١ لسنة ٢٠٢٤ بشأن الأحوال الشخصية (النافذ منذ ١٥ أبريل ٢٠٢٥، والذي حلّ محل القانون الاتحادي رقم ٢٨ لسنة ٢٠٠٥) الزوج بتوثيق الطلاق أمام المحكمة المختصة خلال ١٥ يوماً على الأكثر من تاريخ وقوعه، ولا يخل ذلك بحق الزوجة في رفع دعوى إثبات الطلاق. وإذا لم يوثّقه خلال هذه المدة دون عذر تقبله المحكمة، جاز للمحكمة أن تحكم للزوجة بتعويض يعادل النفقة من تاريخ الطلاق إلى تاريخ توثيقه. والتوثيق هو ما ينشئ السجل القضائي الرسمي الذي تصدر عنه وثيقة قابلة للتصديق.
        </p>
        <p>
          ومن دون توثيق قضائي، تكون "الوثيقة" الوحيدة لديك هي أي سجل غير رسمي للنطق بالطلاق. ولن تقبل السجلات المدنية الأجنبية والسفارات والجهات الحكومية طلاقاً غير موثّق، فهي تشترط وثيقة صادرة عن المحكمة.
        </p>

        <h3>كيفية توثيق الطلاق</h3>
        <p>
          توجّهي إلى محكمة الأحوال الشخصية مع الطرف الآخر، أو ارفعي دعوى إثبات طلاق إذا لم يتعاون. ستتحقق المحكمة من وقوع الطلاق وتوثّقه، وبعد ذلك يمكن تصديق الوثيقة الصادرة عبر السلسلة الموصوفة أعلاه.
        </p>
        <p>
          إذا وقع الطلاق منذ مدة ولم يوثَّق في موعده، فلا يزال التوثيق أو الإثبات ممكناً لكنه قد يتطلب وثائق وإجراءات إضافية. ويستطيع محامي أسرة إماراتي تقديم المشورة بشأن حالتك.
        </p>
      </section>

      <!-- Section 8: Legal translation -->
      <section class="content-section">
        <h2>الحصول على ترجمة قانونية معتمدة</h2>
        <p>
          تشترط معظم دول الوجهة ترجمة لحكم المحكمة العربي. وليست كل الترجمات مقبولة في الإجراءات الرسمية: فوزارة العدل الإماراتية ترخّص المترجمين القانونيين، والترجمة على يد مترجم غير مرخّص تعرّض الوثيقة للرفض.
        </p>

        <h3>العثور على مترجم قانوني مرخّص</h3>
        <p>
