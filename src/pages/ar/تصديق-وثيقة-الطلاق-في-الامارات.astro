---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'تصديق وثيقة الطلاق في الإمارات: الخطوات والتكلفة';
const description =
  'دليل تصديق حكم الطلاق الإماراتي لاستخدامه في الخارج: نسخة المحكمة، الأبوستيل من وزارة الخارجية، والتصديق من السفارات، مع متطلبات كل دولة والترجمة المعتمدة.';

const canonical = 'https://divorceu.ae/ar/تصديق-وثيقة-الطلاق-في-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-certificate-attestation-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'تصديق وثيقة الطلاق في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'كيف أحصل على وثيقة الطلاق الإماراتية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الوثيقة الرسمية للطلاق في الإمارات هي حكم المحكمة (حكم الطلاق). احصلي على نسخة مصدّقة من سجل المحكمة التي أصدرت حكم الطلاق. في دبي يكون ذلك من سجل محكمة الأحوال الشخصية بدبي. الرسوم تتراوح بين ٥٠ و١٠٠ درهم، وتكون النسخة جاهزة عادةً خلال يوم إلى ٣ أيام عمل. أحضري جواز سفرك والهوية الإماراتية ورقم القضية من إجراءات طلاقك. هذه النسخة القضائية المصدّقة هي نقطة البداية لكل إجراءات التصديق.',
      },
    },
    {
      '@type': 'Question',
      name: 'كم يستغرق التصديق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تستغرق مصادقة محاكم دبي من يوم إلى ٣ أيام عمل. ويستغرق الأبوستيل أو التصديق من وزارة الخارجية من ٣ إلى ٧ أيام عمل عبر البوابة الإلكترونية (mofa.gov.ae)، أو في نفس اليوم للخدمة العاجلة في مراكز الطباعة. يتفاوت تصديق السفارات بشكل كبير: نادراً ما تشترط سفارتا بريطانيا وأستراليا تصديقاً يتجاوز الأبوستيل؛ ويستغرق تصديق السفارة الهندية من ٥ إلى ١٠ أيام عمل، والسفارة الباكستانية من ٥ إلى ٧ أيام عمل. الإجمالي لدول الأبوستيل: أسبوع إلى أسبوعين. ولدول التصديق الكامل: ٣ إلى ٤ أسابيع.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل أحتاج إلى أبوستيل على وثيقة طلاقي الإماراتية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'انضمت الإمارات إلى اتفاقية لاهاي للأبوستيل عام ٢٠٢١. بالنسبة لأي دولة موقّعة على الاتفاقية أيضاً (بما فيها بريطانيا والولايات المتحدة وجميع دول الاتحاد الأوروبي وأستراليا ومعظم أوروبا)، يكفي ختم الأبوستيل من وزارة الخارجية. لا تحتاجين إلى تصديق إضافي من السفارة لدول الأبوستيل. أما الدول خارج الاتفاقية (بعض دول الشرق الأوسط وجنوب آسيا وأفريقيا)، فتتطلب سلسلة التصديق الكاملة: المحكمة، ثم وزارة الخارجية، ثم سفارة دولة الوجهة.',
      },
    },
    {
      '@type': 'Question',
      name: 'كيف أستخدم وثيقة طلاقي الإماراتية في بريطانيا؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'انضمت الإمارات إلى اتفاقية لاهاي للأبوستيل، لذا فإن وثيقة الطلاق الإماراتية المصدّقة بالأبوستيل من وزارة الخارجية معترف بها قانونياً في إنجلترا وويلز. لتحديث حالتك المدنية (لإعادة الزواج أو المزايا أو السجلات المالية)، قدّمي الوثيقة المصدّقة بالأبوستيل وترجمة معتمدة من العربية إلى الإنجليزية لدى الجهة البريطانية المختصة. ولإعادة الزواج في بريطانيا، يقبل مكتب السجل المدني وثائق الطلاق الأجنبية المصدّقة بالأبوستيل. لا حاجة لتصديق منفصل من السفارة البريطانية.',
      },
    },
    {
      '@type': 'Question',
      name: 'كيف أستخدم وثيقة طلاقي الإماراتية في الهند؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'انضمت الهند إلى اتفاقية لاهاي للأبوستيل. لمعظم الأغراض، يكفي الأبوستيل من وزارة الخارجية مع ترجمة إلى الإنجليزية (إذا كانت الوثيقة بالعربية فقط). غير أن بعض الجهات الهندية، خاصةً لإعادة الزواج أو تحديث الحالة المدنية، تطلب إضافةً تصديقاً من السفارة الهندية في أبوظبي أو القنصلية الهندية في دبي. أنجزي الأبوستيل من وزارة الخارجية أولاً، ثم توجّهي إلى القنصلية الهندية لإضافة تصديقها إذا اشترط ذلك السجل الخاص بحالتك.',
      },
    },
    {
      '@type': 'Question',
      name: 'كيف أستخدم وثيقة طلاقي الإماراتية في باكستان؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'باكستان ليست عضواً في اتفاقية لاهاي، لذا تنطبق سلسلة التصديق الكاملة: مصادقة محاكم دبي، ثم التصديق من وزارة الخارجية، ثم التصديق من السفارة أو المفوضية الباكستانية في الإمارات. خذي الوثيقة المصدّقة إلى هيئة نادرا (NADRA) في باكستان لتسجيل الحالة المدنية. تطلب بعض مكاتب نادرا أيضاً ترجمة معتمدة بالأردية أو الإنجليزية. تتولى السفارة الباكستانية في أبوظبي والقنصلية في دبي تصديق الوثائق، وراجعي نظام المواعيد الحالي لديهما لأن مدد المعالجة تتفاوت.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا لو لم أذهب إلى المحكمة، هل يمكنني الحصول على وثيقة طلاق لطلاق شفهي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الطلاق المجرّد المنطوق (شفهياً أو كتابةً خارج المحكمة) ليس له وثيقة مستقلة قابلة للتصديق. للحصول على وثيقة طلاق إماراتية رسمية لطلاق منطوق، يجب تسجيله لدى محكمة الأحوال الشخصية. تصدر المحكمة شهادة تسجيل طلاق بعد التحقق من الطلاق وإثبات فترة العدة. يمكن بعد ذلك تصديق هذه الشهادة المسجّلة عبر السلسلة المعتادة. ومن دون تسجيل قضائي، لا توجد وثيقة قابلة للتصديق.',
      },
    },
    {
      '@type': 'Question',
      name: 'من أين أحصل على ترجمة معتمدة لوثيقة طلاقي الإماراتية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'يجب أن تتم الترجمة على يد مترجم قانوني معتمد من وزارة العدل الإماراتية. تتوفر قائمة المترجمين المعتمدين على موقع وزارة العدل (moj.gov.ae). استخدام مترجم غير معتمد يعرّض الترجمة المصدّقة للرفض من الجهات الأجنبية. تتقاضى المكاتب المعتمدة من وزارة العدل بين ١٥٠ و٤٠٠ درهم للصفحة حسب اللغة ودرجة التعقيد. تجنّبي مكاتب الترجمة العامة ما لم تكن معتمدة تحديداً من وزارة العدل للوثائق القانونية.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا لو احتفظ الطرف الآخر بأصول وثائق الطلاق ورفض مشاركتها؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا تحتاجين إلى الأصل. يحتفظ سجل المحكمة الإماراتية بالحكم الأصلي ويصدر نسخاً مصدّقة لأي طرف في القضية. توجّهي إلى سجل المحكمة بجواز سفرك والهوية الإماراتية (أو هوية سارية)، وقدّمي رقم القضية (أو اسمك الكامل وسنة الطلاق التقريبية)، واطلبي نسخة مصدّقة. لكلا طرفي الطلاق الحق في الحصول على نسخ مصدّقة من سجل المحكمة بشكل مستقل.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكنني استخدام البوابة الإلكترونية لوزارة الخارجية للتصديق؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. توفّر وزارة الخارجية والتعاون الدولي خدمة تصديق إلكترونية عبر mofa.gov.ae. يمكنك تقديم الوثائق لأبوستيل أو تصديق، وتتبّع الحالة، واستلام الوثيقة المصدّقة. البوابة الإلكترونية هي المسار الأسرع للأبوستيل من وزارة الخارجية، وتستغرق عادةً من ٣ إلى ٧ أيام عمل. وتتوفر خدمة عاجلة حضورية في مراكز الطباعة التابعة للوزارة للمعالجة في نفس اليوم برسوم أعلى.',
      },
    },
  ],
};

const faqItems = faqSchema.mainEntity.map((q) => ({
  question: q.name,
  answer: q.acceptedAnswer.text,
}));

const attestationChain = [
