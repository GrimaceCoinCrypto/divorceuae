---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الزواج مجدداً بعد الطلاق في الإمارات — العدة وشرط المحرم وتأثير الحضانة ٢٠٢٥';
const description =
  'الزواج بعد الطلاق في الإمارات له أحكام قانونية مهمة خاصةً للأمهات الحاضنات. تعرّفي على عدة المرأة ومن يُعدّ محرماً للأطفال وتأثير الزواج الجديد على الحضانة والنفقة والإقامة.';

const canonical = 'https://divorceu.ae/ar/الزواج-بعد-الطلاق-في-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/remarriage-after-divorce-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الزواج بعد الطلاق في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل تفقد الأم الحضانة تلقائياً إذا تزوجت بعد الطلاق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تفقدها إذا تزوجت من رجل ليس محرماً لأطفالها. هذا هو الحكم الافتراضي في قانون الأحوال الشخصية الإماراتي. إذا كان زوجها الجديد محرماً للأطفال (كعمهم أو خالهم) تحتفظ بالحضانة. يُنصح بالحصول على استشارة قانونية قبل الإقدام على الزواج إذا كان لديك أطفال تحت الحضانة.',
      },
    },
    {
      '@type': 'Question',
      name: 'كم تستمر العدة بعد الطلاق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تستمر العدة ثلاثة أشهر قمرية (نحو تسعين يوماً) للمرأة غير الحامل منتظمة الحيض، وتمتد حتى الوضع إذا كانت حاملاً. تبدأ العدة من تاريخ النطق بالطلاق أو صدور حكم المحكمة لا من تاريخ استلام الأوراق. الزواج خلال العدة باطل وله تبعات قانونية.',
      },
    },
    {
      '@type': 'Question',
      name: 'من يُعدّ محرماً للأطفال في قانون الأحوال الشخصية الإماراتي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'المحرم هو قريب ذكر يحرم عليه الزواج من الأطفال تحريماً مؤبداً: الجد (من الأب أو الأم)، الأخ الشقيق أو لأب أو لأم، العم (أخ الأب أو أخ الأم)، والابن (بالنسبة للأطفال الكبار). ابن العم والصهر وأخو الزوج ليسوا محارم للأطفال حتى وإن كانت العلاقة العائلية وثيقة.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يستطيع الرجل المسلم الزواج مباشرةً بعد الطلاق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. لا توجد مدة انتظار للرجل المسلم بعد الطلاق. يجوز له الزواج مجدداً في اليوم ذاته إذا رغب. القيد الوحيد هو حكم الطلاق الثلاثي: إذا طلّق زوجته ثلاثاً لا يحل له العودة إليها حتى تتزوج من آخر ويطلقها أو يتوفى عنها.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل ينتهي حق النفقة إذا تزوجت المرأة المطلّقة من جديد؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. أي نفقة ممتدة تجاوزت مدة العدة تنتهي عادةً بزواج المرأة الجديد لأن زوجها الجديد يتولى نفقتها. نفقة الأطفال تستمر على الأب بصرف النظر عن زواج الأم.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا يحدث إذا تزوجت خارج الإمارات لتتجنب قاعدة المحرم؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تُطبّق محاكم الإمارات القانون الإماراتي بصرف النظر عن مكان انعقاد الزواج. إذا كنت مقيمة في الإمارات وبيدك حضانة أطفال مقيمين فيها فللمحاكم اختصاص النظر. الزواج في الخارج لا يتحايل على قاعدة المحرم.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل تسري قاعدة المحرم وحكم العدة على غير المسلمين في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. بموجب المرسوم بقانون اتحادي رقم 41 لسنة 2022 لا تسري قواعد الأحوال الشخصية الإسلامية على غير المسلمين. لا يوجد شرط انتظار بعد الطلاق بمجرد صيرورة الحكم باتاً. الحضانة بعد الزواج الجديد تُقيَّم وفق معيار مصلحة الطفل لا قاعدة المحرم.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يلتزم زوج الأم الجديد بالإنفاق على أطفالها من زواجها السابق؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. لا يُلزَم زوج الأم الجديد قانوناً بالإنفاق على أطفالها من زواج سابق. النفقة واجبة على الأب البيولوجي. وهذا أحد الأسباب التي يفترض فيها القانون أن بيت الأب أنسب للأطفال حين تتزوج الأم من غير محرم لهم.',
      },
    },
  ],
};

const mahramRelatives = [
  { who: 'جد الأطفال (من الأب أو الأم)', isMahram: true },
  { who: 'أخو الأطفال الشقيق أو لأب أو لأم', isMahram: true },
  { who: 'عم الأطفال (أخو الأب أو أخو الأم)', isMahram: true },
  { who: 'ابن الأطفال (في حالة الأطفال الكبار)', isMahram: true },
  { who: 'ابن عم الأم أو الأطفال', isMahram: false },
  { who: 'أخو زوج الأخت (صهر الأسرة)', isMahram: false },
  { who: 'أبناء الأشقاء بالرضاعة', isMahram: false },
  { who: 'أقارب بالمصاهرة لا الدم', isMahram: false },
];

const faqItems = [
  {
    question: 'هل تفقد الأم الحضانة تلقائياً إذا تزوجت بعد الطلاق في الإمارات؟',
    answer: 'تفقدها إذا تزوجت من رجل ليس محرماً لأطفالها. إذا كان الزوج الجديد محرماً للأطفال كعمهم أو خالهم تحتفظ بالحضانة. يُنصح بالحصول على استشارة قانونية قبل الإقدام على الزواج.',
  },
  {
    question: 'كم تستمر العدة بعد الطلاق في الإمارات؟',
    answer: 'ثلاثة أشهر قمرية تقريباً للمرأة غير الحامل، وحتى الوضع للحامل. تبدأ من تاريخ النطق بالطلاق لا من تاريخ استلام الأوراق. الزواج خلال العدة باطل.',
  },
  {
    question: 'من يُعدّ محرماً للأطفال في قانون الأحوال الشخصية الإماراتي؟',
    answer: 'المحرم قريب ذكر تحرم عليه مخالطة الأطفال النساء تحريماً مؤبداً: الجد والأخ والعم والخال والابن. ابن العم والصهر ليسوا محارم.',
  },
  {
    question: 'هل يستطيع الرجل المسلم الزواج مباشرةً بعد الطلاق في الإمارات؟',
    answer: 'نعم. لا توجد مدة انتظار للرجل. القيد الوحيد هو حكم الطلاق الثلاثي إذا طلّق ثلاثاً لا يحل له العودة إليها إلا بعد زواجها من آخر.',
  },
  {
    question: 'هل ينتهي حق النفقة إذا تزوجت المرأة المطلّقة؟',
    answer: 'نعم. أي نفقة ممتدة تجاوزت العدة تنتهي بزواج المرأة الجديد. نفقة الأطفال تستمر على الأب بصرف النظر.',
  },
  {
    question: 'ماذا يحدث إذا تزوجت خارج الإمارات لتتجنب قاعدة المحرم؟',
    answer: 'لا يُجدي. محاكم الإمارات تُطبّق القانون الإماراتي بصرف النظر عن مكان انعقاد الزواج إذا كانت الأطفال مقيمين في الإمارات.',
  },
  {
    question: 'هل تسري قاعدة المحرم وحكم العدة على غير المسلمين في الإمارات؟',
    answer: 'لا. بموجب المرسوم بقانون 41/2022 لا تسري هذه القواعد على غير المسلمين. الحضانة بعد زواج الأم تُقيَّم وفق مصلحة الطفل لا قاعدة المحرم.',
  },
  {
    question: 'هل يلتزم زوج الأم الجديد بالإنفاق على أطفالها؟',
    answer: 'لا. لا يُلزَم قانوناً. النفقة واجبة على الأب البيولوجي. وهذا أحد أسباب افتراض القانون أن بيت الأب أنسب للأطفال حين تتزوج الأم من غير محرم.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">الزواج بعد الطلاق · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        الزواج من جديد بعد الطلاق في الإمارات ليس قراراً شخصياً صرفاً بل له تبعات قانونية مباشرة لا سيما للأمهات الحاضنات. تختلف القواعد اختلافاً جوهرياً بين المسلمين وغير المسلمين. للأم المسلمة، الزواج من رجل غير محرم لأطفالها قد يُفضي تلقائياً إلى انتقال الحضانة إلى الأب. معرفة الأحكام قبل اتخاذ القرار واجب لا ترف.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="summary-grid-wrap">
        <div class="summary-card">
          <p class="s-label">مدة العدة</p>
          <p class="s-value">٣ أشهر قمرية</p>
          <p class="s-note">نحو ٩٠ يوماً للمرأة غير الحامل</p>
        </div>
        <div class="summary-card">
          <p class="s-label">مسقط الحضانة</p>
          <p class="s-value">الزواج من غير محرم</p>
          <p class="s-note">خطر انتقال الحضانة تلقائياً</p>
        </div>
        <div class="summary-card">
          <p class="s-label">أثر الزواج على النفقة</p>
          <p class="s-value">تسقط عادةً</p>
          <p class="s-note">عند زواج الأم من جديد</p>
        </div>
      </div>

      <div class="answer-box">
        <h2>هذه الصفحة موجّهة لكل أم حاضنة تفكر في الزواج من جديد</h2>
        <p>
          إذا كنتِ مطلّقة ولديكِ أطفال تحت حضانتك وتفكرين في الزواج من جديد، فإن هذه الصفحة قد تُغيّر قرارك أو على الأقل تُشكّل طريقة اتخاذه. القانون الإماراتي ربط تلقائياً بين زواج الأم من رجل غير محرم لأطفالها وانتقال الحضانة إلى الأب. ليس هذا تهديداً بل حكم قانوني يُطبّقه القضاء.
        </p>
      </div>

      <section class="content-section">
        <h2>العدة الشرعية: شرط الانتظار قبل إعادة الزواج</h2>
        <p>
          العدة هي فترة الانتظار الشرعية التي يجب على المرأة المسلمة المطلّقة التزامها قبل أن يحلّ لها الزواج من جديد. مكفولة في الفقه الإسلامي والمرسوم بقانون اتحادي رقم 41 لسنة 2024 (المواد 56 إلى 63).
        </p>
        <p>
          للمرأة غير الحامل منتظمة الحيض تستمر العدة ثلاثة أشهر قمرية أي نحو تسعين يوماً من تاريخ الطلاق. وللحامل تمتد العدة حتى الوضع بصرف النظر عن حداثة الطلاق. ومن لا تحيض لسبب مرضي أو لكبر السن فعدتها كذلك ثلاثة أشهر قمرية.
        </p>
        <p>
          تؤدي العدة أغراضاً متعددة في الفقه الإسلامي: التثبت من الحمل ونسب المولود، وإتاحة فرصة للمراجعة في الطلاق الرجعي إذ يحق للزوج الرجوع في طلاقه دون عقد جديد خلال العدة.
        </p>
        <p>
          الزواج خلال العدة باطل بموجب القانون الإسلامي والقانون الإماراتي. لا يعترف به القانون وقد يُعرّض أصحابه لتبعات جزائية.
        </p>

        <div class="info-box info-box--info">
          <h3>متى تبدأ العدة بالضبط؟</h3>
          <p>تبدأ العدة من تاريخ النطق بالطلاق أو صدور حكم المحكمة لا من تاريخ استلامك الأوراق الرسمية. إذا كنتِ غير متأكدة من التاريخ الدقيق يُراجع محاميك سجلات المحكمة لتحديده.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>من يجوز للمرأة المطلّقة الزواج منه بعد انقضاء العدة؟</h2>
        <p>
          بعد انقضاء العدة يحلّ للمرأة المسلمة الزواج من أي رجل مسلم مؤهل شريطة استيفاء أركان الزواج الشرعية: الإسلام والخلو من موانع الزواج وعدم وجود زوجة رابعة في حالة الرجل.
        </p>
        <p>
          قيد خاص بالخالعة: المرأة التي حصلت على طلاقها بالخلع لا يحل لها العودة للزواج من زوجها المطلّق إلا بعد أن تتزوج رجلاً آخر ويطلقها أو يتوفى عنها. هذا الحكم نادر التطبيق في واقع حياة الطلاق لكنه يستحق المعرفة.
        </p>
        <p>
          للرجل المسلم لا توجد مدة انتظار أصلاً بعد الطلاق. يجوز له الزواج في اليوم ذاته إذا شاء. القيد الوحيد هو حكم التحريم بعد الطلاق الثلاثي.
        </p>

        <h3>غير المسلمين</h3>
        <p>
          غير المسلمين الخاضعون للمرسوم بقانون اتحادي رقم 41 لسنة 2022 لا تسري عليهم مدة الانتظار بعد صيرورة حكم الطلاق باتاً. بمجرد صدور الحكم النهائي كلا الطرفين حر في الزواج متى أراد وفق قانونه الشخصي والإطار المدني الإماراتي.
        </p>
      </section>

      <section class="content-section">
        <h2>الزواج الجديد وفقدان الحضانة: الحكم الحاسم</h2>
        <p>
          هذا القسم الأهم في هذه الصفحة للأمهات المطلّقات. بموجب قانون الأحوال الشخصية الإماراتي، تفقد الأم المسلمة المطلّقة الحضانة الجسدية لأطفالها إذا تزوجت من رجل ليس محرماً لهم.
        </p>
        <p>
          حين تتزوج الأم من غير محرم يفترض القانون أن مصلحة الأطفال تقتضي انتقالهم إلى بيت الأب. الأطفال ليسوا مألوفين للرجل الجديد، والرجل الجديد لا تُلزمه رابطة طبيعية بالاهتمام بهم، وقد لا تكون خصوصية الزواج الجديد مناسبة للأطفال الصغار من زواج سابق.
        </p>
        <p>
          هذا حكم افتراضي وليس توجيهاً اختيارياً. للأب الحق في طلب انتقال الحضانة فور زواج الأم من غير محرم وتُجيبه المحاكم في الغالب ما لم تكن ثمة ظروف استثنائية.
        </p>

        <div class="info-box info-box--warning">
          <h3>ينطبق هذا الحكم على جميع الأطفال ضمن سن الحضانة</h3>
          <p>قاعدة المحرم تسري على الأطفال في سن الحضانة. وفق الاتجاه العام في محاكم الإمارات: الأولاد حتى الحادية عشرة والبنات حتى الثالثة عشرة مع صلاحية القاضي في التمديد وفق مصلحة الطفل. إذا كان أطفالك ضمن هذا النطاق العمري وبيدك حضانتهم فالزواج من غير محرم لهم سيُفضي على الأرجح إلى فقدانك الحضانة الجسدية.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>جدول المحارم وغير المحارم للأطفال</h2>
        <p>
          المحرم هو القريب الذكر الذي تحرم عليه المخالطة بالأطفال (البنات) تحريماً مؤبداً بحكم الفقه الإسلامي. الكلمة الجوهرية هي "مؤبد" لأن التحريم يجب أن يكون دائماً لا عارضاً.
        </p>
        <div class="mahram-table">
          {mahramRelatives.map((r) => (
            <div class={`mahram-row ${r.isMahram ? 'is-mahram' : 'not-mahram'}`}>
              <span class="mahram-badge">{r.isMahram ? 'محرم' : 'ليس محرماً'}</span>
              <span class="mahram-name">{r.who}</span>
            </div>
          ))}
        </div>
        <p>
          يُجرى تقييم المحرم في وقت الزواج الجديد. إذا كنتِ تفكرين في الزواج ولديكِ أطفال تحت حضانتك، يجب أن يُقيّم محاميك تحديداً ما إذا كان الزوج المقبل محرماً لأطفالك قبل المضي قُدُماً.
        </p>
      </section>

      <section class="content-section">
        <h2>أثر الزواج الجديد على النفقة والمهر والدعم المالي</h2>

        <h3>النفقة المستمرة</h3>
        <p>
          بموجب قانون الأحوال الشخصية الإسلامي الإماراتي تنتهي عادةً أي نفقة ممتدة تجاوزت فترة العدة المفروضة بحكم قضائي للزوجة عند زواجها الجديد. المسوّغ القانوني أن زوجها الجديد يتولى نفقتها. ينطبق هذا على أي نفقة إضافية أمرت بها المحكمة في ظروف خاصة.
        </p>

        <h3>نفقة المتعة</h3>
        <p>
          نفقة المتعة، وهي الدفعة التعويضية الواجبة عند الطلاق بإرادة الزوج دون سبب من الزوجة، لا تتأثر بزواج الزوجة اللاحق. إذا صدر بها حكم أو اتُّفق عليها بين الطرفين فتظل واجبة الأداء بصرف النظر عن تصرف الزوجة بعد الطلاق.
        </p>

        <h3>نفقة الأطفال</h3>
        <p>
          نفقة الأطفال تستمر بصرف النظر عن زواج أي من الوالدين. التزام الأب بالإنفاق على أطفاله لا يتقلص بزواجه من جديد ولا بزواج الأم. إذا انتقلت الحضانة إلى الأب بسبب زواج الأم من غير محرم تتحول الديناميكية المالية: الأب يتحمل الحضانة الجسدية والنفقة معاً وقد تُعاد هيكلة التحويلات المالية للأم.
        </p>

        <h3>التزامات الزوج الجديد</h3>
        <p>
          لا يُلزَم زوج الأم الجديد قانوناً بالإنفاق على أطفالها من زواج سابق. قد يفعل ذلك طوعاً لكن لا يُجبَر عليه. وهذا أحد أسباب افتراض القانون الإماراتي أن بيت الأب البيولوجي أنسب بيئة للأطفال حين تتزوج الأم من غير محرم لهم.
        </p>
      </section>

      <section class="content-section">
        <h2>الإقامة والتأشيرة بعد إعادة الزواج</h2>
        <p>
          بعد الطلاق تُمنح الزوجة في العادة ثلاثين يوماً لتغيير وضعها الإقامي من كفالة الزوج المطلّق إلى بديل مناسب. إذا تزوجت خلال هذه المدة الانتقالية يستطيع زوجها الجديد كفالة تأشيرتها مما يحل الإشكال الإقامي في آنٍ واحد مع الزواج.
        </p>
        <p>
          إذا حصلت على تأشيرة عمل أو استثمار مستقلة بعد الطلاق فإن زواجها الجديد لا يُخلّ بتأشيرتها. يُصبح الزوج الجديد عاملاً ثانوياً في مسألة الإقامة لا اعتماداً جوهرياً.
        </p>
        <p>
          تأشيرات الأطفال أكثر تعقيداً. إذا كانوا مكفولين بتأشيرة الأب تستمر الكفالة بصرف النظر عن زواج أي منهما ما لم تتغير الحضانة. إذا انتقلت الحضانة إلى الأب بسبب زواج الأم من غير محرم يبقى الأطفال مكفولين بتأشيرة الأب. في الحالات الاستثنائية حين تحتفظ الأم بالحضانة بعد الزواج من غير محرم بأمر قضائي خاص يستطيع الزوج الجديد كفالة الأطفال لكن ذلك يستلزم إذناً قضائياً صريحاً.
        </p>

        <div class="info-box info-box--info">
          <h3>حدّث بياناتك في دوائر الهجرة</h3>
          <p>تغيير الحالة الاجتماعية يؤثر على سجلات الهجرة الإماراتية. عند إعادة زواجك حدّث وضعك عبر الهيئة الاتحادية للهوية والجنسية أو دائرة الهجرة في إمارتك. التقاعس عن تحديث البيانات قد يُوقع تعقيدات عند تجديد الوثائق أو معالجة تأشيرات الأفراد المعالين.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>الزواج بعد الطلاق لغير المسلمين</h2>
        <p>
          لغير المسلمين الخاضعين للمرسوم بقانون اتحادي رقم 41 لسنة 2022 المشهد القانوني بعد الزواج الجديد مختلف جوهرياً وأكثر يسراً.
        </p>
        <p>
          لا توجد عدة. بمجرد صيرورة الطلاق باتاً كلا الطرفين حر في الزواج متى أراد.
        </p>
        <p>
          تبعات الحضانة عند زواج الأم غير المسلمة من جديد تختلف كذلك. قاعدة المحرم التلقائية لا تسري. تُقيّم المحاكم الحضانة وفق معيار مصلحة الطفل وهو المعيار ذاته المعتمد في أغلب الأنظمة القانونية حول العالم. زواج الأم ليس عاملاً يُفضي تلقائياً إلى انتقال الحضانة. تنظر المحكمة في الأثر الفعلي للترتيب المنزلي الجديد على الأطفال وطبيعة علاقتهم بزوج الأم الجديد واستقرار البيئة الجديدة.
        </p>
        <p>
          غير المسلمين الذين يفكرون في إعادة الزواج ولديهم أطفال من طلاقهم الإماراتي لا يزالون بحاجة إلى استشارة محامٍ قبل الإقدام، ليس لأن القانون يفرض تبعات تلقائية، بل لأن ترتيبات الحضانة المقررة وقت الطلاق قد تحتاج إلى مراجعة وتحديث ليعكسا البنية الأسرية الجديدة.
        </p>
      </section>

