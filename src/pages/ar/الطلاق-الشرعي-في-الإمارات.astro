---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الطلاق الشرعي في الإمارات — أنواعه وأحكامه وحقوق المطلّقة ٢٠٢٥';
const description =
  'دليل شامل لأحكام الطلاق الشرعي في الإمارات: أنواع الطلاق الثلاثة، حكم الطلاق الثلاثي في القانون الإماراتي، اشتراط التسجيل خلال ١٥ يوماً وفق المادة ٥٨ من المرسوم بقانون ٤١/٢٠٢٤، الطلاق الرجعي والبائن، وحقوق المطلّقة المالية.';

const canonical = 'https://divorceu.ae/ar/الطلاق-الشرعي-في-الإمارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/talaq-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الطلاق الشرعي في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل الطلاق الثلاثي بلفظ واحد نافذ في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. تأخذ المحاكم الإماراتية بمذهب المالكية والحنابلة القائل بأن الطلاق الثلاثي في مجلس واحد يُعدّ طلقة رجعية واحدة فحسب، وليس ثلاث طلقات. فإذا قال الزوج "أنتِ طالق طالق طالق" في مجلس واحد، حُسب طلاقاً رجعياً قابلاً للمراجعة خلال العدة، ولا يترتب عليه البينونة الكبرى فوراً.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما المقصود بالتسجيل خلال ١٥ يوماً وفق المادة ٥٨ من المرسوم بقانون ٤١/٢٠٢٤؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تُلزم المادة ٥٨ من المرسوم بقانون رقم ٤١ لسنة ٢٠٢٤ الزوجَ بتسجيل الطلاق لدى محكمة الأحوال الشخصية خلال ١٥ يوماً من وقوعه، وإلا اعتُبر الطلاق غير نافذ قانونياً وبقي عقد الزواج قائماً. ويجوز للزوجة طلب التسجيل القضائي للطلاق إذا امتنع الزوج عن ذلك.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الفرق بين الطلاق الرجعي والطلاق البائن؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الطلاق الرجعي هو الطلقة الأولى أو الثانية، ويحق للزوج فيه مراجعة زوجته خلال العدة بغير عقد جديد. أما الطلاق البائن بينونة صغرى فيقع بعد انقضاء العدة دون مراجعة، ولإعادة الزواج يلزم عقد جديد. والبينونة الكبرى تقع بعد الطلاق ثلاث مرات في ثلاثة زيجات مستقلة، ولا تحل الزوجة لمطلّقها إلا بعد زواج آخر يُدخل بها.',
      },
    },
    {
      '@type': 'Question',
      name: 'كم تستغرق إجراءات الطلاق في محاكم الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'يستغرق الطلاق غير المتنازع عليه عادةً ٢ إلى ٤ أشهر من تاريخ التقديم حتى صدور شهادة الطلاق. أما في حالة الطلاق المتنازع عليه حيث يكون ثمة خلاف على الحقوق المالية أو الحضانة، فقد تمتد الإجراءات من ٦ إلى ١٨ شهراً.',
      },
