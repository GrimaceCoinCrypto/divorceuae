---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'حساب النفقة في الإمارات — مبالغ واقعية بالدرهم وكيف تُحدّدها المحاكم ٢٠٢٥';
const description =
  'لا توجد معادلة ثابتة للنفقة في الإمارات. العوامل الستة التي تراعيها المحكمة وفق المادة ٩ من قانون ٤١/٢٠٢٢. جدول مبالغ بالدرهم وفق خمس فئات دخل. الفرق بين نفقة العدة والمتعة والنفقة الدورية.';

const canonical = 'https://divorceu.ae/ar/حساب-النفقة-في-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/alimony-calculator-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'حساب النفقة في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
