---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'الطلاق بسبب غياب الزوج في الإمارات — المادة ٧٩ والحقوق المالية ٢٠٢٥';
const description =
  'كيف تحصلين على الطلاق في الإمارات إن كان زوجك غائباً أو هجركِ؟ دليل المادة ٧٩ (الغياب سنة فأكثر) والمادة ٧٢ (ترك النفقة ٣ أشهر) من المرسوم بقانون ٤١/٢٠٢٤، إعلان الزوج الغائب، وكيفية حفظ حقوقك المالية كاملة.';

const canonical = 'https://divorceu.ae/ar/الطلاق-بسبب-غياب-الزوج-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-absent-husband-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'الطلاق بسبب غياب الزوج في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'هل يجوز لي طلب الطلاق إن غادر زوجي الإمارات ورفض التعاون؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. تجيز المادة ٧٩ من المرسوم بقانون رقم ٤١ لسنة ٢٠٢٤ طلب التطليق القضائي إذا غاب الزوج سنةً فأكثر دون نفقة ودون عذر مقبول. وبموجب المادة ٧٢ يجوز طلب التطليق لترك النفقة ثلاثة أشهر متتالية فأكثر دون عذر، سواء أكان غائباً أم حاضراً في الإمارات. وفي الحالتين لا يستلزم الأمر تعاون الزوج.',
      },
    },
    {
      '@type': 'Question',
      name: 'كم تستغرق دعوى التطليق للغياب في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تستغرق دعوى التطليق القضائي للغياب بموجب المادة ٧٩ نحو ٦ إلى ١٨ شهراً من رفع الدعوى. تشمل هذه المدة فترة التحقق (٣٠ إلى ٩٠ يوماً) ثم الإعلان في الجريدة الرسمية والصحيفة (٣٠ إلى ٦٠ يوماً) ثم جلسة الحكم. أما التطليق لترك النفقة بالمادة ٧٢ فيكون عادةً أسرع لعدم اشتراط انقضاء سنة.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا أفعل إن كنت لا أعرف مكان زوجي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تستطيع المحاكم الإماراتية المضي في الدعوى بالإعلان العلني. تُجري المحكمة محاولات معقولة للتواصل مع الزوج عبر آخر عنوان معروف والبريد الإلكتروني وواتساب والجهات الحكومية المختصة. فإن لم يستجب نشرت إعلاناً في الجريدة الرسمية وصحيفة عربية واسعة الانتشار. وإن انقضت مدة الإعلان دون رد أصدرت المحكمة حكمها غيابياً.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل أخسر المهر إن رفعت دعوى التطليق للغياب بدلاً من انتظار طلاقه؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا. دعوى الفسخ أو التطليق للغياب أو ترك النفقة لا تُسقط حق المطلّقة في المهر. يختلف الأمر عن الخلع الذي تردّ فيه الزوجة المهر مقابل الفراق. في التطليق القضائي يثبت المهر المؤجل ويستحق بمجرد صدور الحكم.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل أستطيع الحصول على نفقة مؤقتة أثناء سير الدعوى؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'نعم. تستطيعين طلب نفقة مؤقتة من المحكمة أثناء الدعوى، وقد تُصدر في حالات الاستعجال خلال ٤٨ إلى ٧٢ ساعة حين تكونين بلا دخل مستقل وزوجك هجر الأسرة. وغياب الزوج لا يحول دون تنفيذ أمر النفقة المؤقت على أموال له في الإمارات.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الذي يعتبره القانون الإماراتي عذراً مقبولاً للغياب؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'يشمل العذر المقبول في أحكام المحاكم الإماراتية: الكارثة الطبية الموثَّقة، والسجن، وظروف القوة القاهرة الخارجة عن الإرادة. أما العمل خارج الإمارات مع إرسال بعض النفقة جزئياً فيُعدّ دفاعاً جزئياً قد يرفع المحاكم درجته أو تُنقّصه. ولا يُعدّ الإحجام عن العودة لتفادي المسؤوليات عذراً مقبولاً إطلاقاً.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل تسري أحكام الغياب نفسها على غير المسلمين؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لغير المسلمين مسار أيسر: يُتيح المرسوم بقانون ٤١/٢٠٢٢ الطلاق المدني بلا أسباب ودون اشتراط تعاون الزوج. يتقدم أحد الزوجين بالطلب وتنتظر المحكمة ٩٠ يوماً ثم يُمنح الطلاق بصرف النظر عن مكان الزوج الآخر ورده. لذا فالمسألة لغير المسلمين أقل تعقيداً بكثير مما هي عليه للمسلمين.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يُؤثر عودة الزوج على سير الدعوى القضائية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'إن عاد الزوج وحضر المحكمة بعد رفع الدعوى تستمر الإجراءات ولا تتوقف تلقائياً. يحق له الدفاع عن نفسه وتقديم حججه. إن دفع النفقة المتأخرة وأثبت عذراً مقبولاً لغيابه فقد ترفض المحكمة التطليق. لكن المحكمة تأخذ بعين الاعتبار الهجر الحقيقي الذي مرّت به الزوجة وتُوازن المصالح.',
      },
    },
  ],
};

const groundsRows = [
  {
    ground: 'الغياب مع ترك النفقة لمدة سنة فأكثر',
    law: 'المادة ٧٩، المرسوم بقانون ٤١/٢٠٢٤',
    who: 'الزوجة المسلمة',
    requirement: 'غياب الزوج سنةً فأكثر دون نفقة ودون عذر مقبول. يستلزم تحقق المحكمة وإعلان غيابي.',
    flag: 'primary',
  },
  {
    ground: 'ترك النفقة لمدة ٣ أشهر فأكثر',
    law: 'المادة ٧٢، المرسوم بقانون ٤١/٢٠٢٤',
    who: 'الزوجة المسلمة',
    requirement: 'توقف الزوج عن النفقة ٣ أشهر متتالية فأكثر دون عذر مقبول، سواء أكان في الإمارات أم خارجها.',
    flag: 'primary',
  },
  {
    ground: 'الزوج المحكوم عليه بالسجن ٣ سنوات فأكثر',
    law: 'المادتان ٧٣-٧٤، المرسوم بقانون ٤١/٢٠٢٤',
    who: 'الزوجة المسلمة',
    requirement: 'صدور حكم بسجن الزوج ٣ سنوات فأكثر. يجوز رفع الدعوى بعد انقضاء سنة من تنفيذ الحكم.',
    flag: 'secondary',
  },
  {
    ground: 'الضرر / انهيار الرابطة الزوجية',
    law: 'المادتان ٧٥-٧٦، المرسوم بقانون ٤١/٢٠٢٤',
    who: 'الزوجة المسلمة',
    requirement: 'إثبات ضرر يتعذر معه استمرار الزواج. قد يُشكّل الهجر والغياب بذاتهما ضرراً كافياً.',
    flag: 'secondary',
  },
  {
    ground: 'الطلاق المدني بلا أسباب',
    law: 'المرسوم بقانون ٤١/٢٠٢٢',
    who: 'المقيمون غير المسلمين',
    requirement: 'لا يُشترط إثبات أي سبب. يُقدَّم الطلب وتنتظر المحكمة ٩٠ يوماً ثم يُصدر الحكم بصرف النظر عن تعاون الزوج.',
    flag: 'nonmuslim',
  },
];

const faqItems = [
  {
    question: 'مضى على غياب زوجي ٨ أشهر ولم يرسل نفقة — هل يجوز لي التقديم الآن؟',
    answer: 'لدعوى التطليق للغياب بالمادة ٧٩ يُشترط مرور سنة كاملة، فأنتِ لم تبلغي الحد بعد. لكن إن كان قد توقف عن النفقة ثلاثة أشهر متتالية فأكثر فبإمكانك رفع الدعوى الآن بموجب المادة ٧٢ لترك النفقة. لا تنتظري اكتمال سنة الغياب إن توفّر سبب ترك النفقة أصلاً.',
  },
  {
    question: 'زوجي سجين في الخارج — هل يجوز لي التطليق منه؟',
    answer: 'نعم. تُجيز المادتان ٧٣-٧٤ من المرسوم بقانون ٤١/٢٠٢٤ طلب التطليق إن صدر بحق الزوج حكم بالسجن ثلاث سنوات فأكثر في أي دولة، وذلك بعد انقضاء سنة من تنفيذ الحكم. تحتاجين إلى وثيقة رسمية معتمدة تُثبت الحكم، ويُمكن للمحامي مساعدتك في استحصالها عبر القنوات الدبلوماسية.',
  },
  {
    question: 'كيف تُعلن المحكمة زوجي الغائب في الخارج؟',
    answer: 'تسلك المحاكم الإماراتية عدة مسالك للإعلان على المستجيب المقيم خارج الإمارات: (١) البريد الإلكتروني إلى آخر عنوان معروف، (٢) واتساب أو الرسائل النصية على آخر رقم معروف، (٣) التنسيق مع وزارة العدل عبر قنوات التعاون القضائي الدولي، (٤) الإعلان في الجريدة الرسمية وصحيفة عربية واسعة الانتشار إن تعذّرت كل الوسائل السابقة. وبعد انقضاء مدة الإعلان تواصل المحكمة الدعوى.',
  },
  {
    question: 'هل تتوقف دعواي إن عاد زوجي فجأة؟',
    answer: 'لا تتوقف الدعوى تلقائياً بعودته. يحق له التقدم والدفاع، وستنظر المحكمة في موقفه. لكن مجرد العودة لا يمحو الهجر الذي عانيتِ منه. إن دفع المتأخرات وقدّم تفسيراً مقنعاً قد تقرر المحكمة عدم التطليق، وإن ثبت الهجر الفعلي مضت المحكمة في حكمها.',
  },
  {
    question: 'هل يمكنني الجمع بين دعوى الغياب ودعوى الحضانة والنفقة؟',
    answer: 'نعم. يجوز نظر الحضانة ونفقة الأولاد في الدعوى ذاتها أو في دعاوى مرتبطة بها. يصدر القضاء أوامر بالحضانة غيابياً إن تعذّر حضور الزوج، مراعياً مصلحة الأطفال. وينفّذ الأب المحكوم عليه بنفقة الأولاد حتى غيابياً على أي أصول له في الإمارات.',
  },
  {
    question: 'ما الذي يُوهن حجج الزوج في دعوى الغياب؟',
    answer: 'يُعدّ التهرب المتعمد من الإجراءات القضائية المعلومة أقوى ما يُسقط هذا الدفاع. ولكي ينجح دفع "لم أعلم بالدعوى" يجب إثبات أنه لم يصله أي من مسالك الإعلان المتعددة، وأن المحكمة لم تُراعِ الإجراءات القانونية الواجبة. والإعلان في الجريدة الرسمية أثبت قانوناً مع استيفاء مدته كافٍ للمضي في الدعوى.',
  },
  {
    question: 'هل أُفقَد حقي في المهر إن رفعت دعوى التطليق؟',
    answer: 'لا. التطليق القضائي للغياب أو ترك النفقة (الفسخ) يصون حق الزوجة كاملاً في المهر المؤجل. يختلف الأمر عن الخلع الذي تتنازل فيه الزوجة عن المهر مقابل الفراق. يستحق المهر المؤجل بصدور حكم التطليق ويُنفَّذ كدين ممتاز على أموال الزوج.',
  },
  {
    question: 'ما الأوراق والمستندات الضرورية لرفع دعوى التطليق للغياب؟',
    answer: 'تحتاجين إلى: وثيقة الزواج الأصلية (معتمدة ومترجمة إذا كانت أجنبية)، جواز السفر وبطاقة الهوية، آخر معلومات التواصل بزوجك، كشوف الحساب البنكي تُثبت انقطاع النفقة، سجلات التواصل (واتساب والبريد الإلكتروني والمكالمات) تُثبت الهجر، ووثائق الأطفال إن طلبتِ الحضانة ونفقتهم في الوقت ذاته.',
  },
];
---

<BaseLayout
  {title}
  {description}
  {canonical}
  {hreflang}
  lang="ar"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbItems} />
  </div>

  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">الطلاق للغياب · الإمارات ٢٠٢٥</p>
      <h1>{title}</h1>
      <p class="hero-desc">
        غادر زوجك وتركك دون نفقة ودون معرفة مكانه. القانون الإماراتي يُتيح لك طريقاً واضحة للطلاق دون الحاجة إلى تعاونه. هذا هو الإطار القانوني والأدلة المطلوبة وحقوقك المالية كاملة.
      </p>
      <p class="hero-author">بقلم <strong>ألكسي سوونينن</strong> · مستشار قانوني ومقيم في الإمارات · divorceu.ae</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <div class="answer-box">
        <h2>ما تحتاجين معرفته الآن</h2>
        <ul class="key-facts">
          <li><strong>تطليق الزوج الغائب ممكن في الإمارات.</strong> لا يُشترط تعاونه. للمحاكم إجراءات مُقنَّنة للنظر في الدعاوى الغيابية.</li>
          <li><strong>المادة ٧٩ (المرسوم بقانون ٤١/٢٠٢٤):</strong> غياب سنة دون نفقة = سبب للتطليق القضائي بعد تحقق المحكمة والإعلان الغيابي.</li>
          <li><strong>المادة ٧٢ (المرسوم بقانون ٤١/٢٠٢٤):</strong> ترك النفقة ٣ أشهر = سبب للتطليق حتى لو كان الزوج في الإمارات.</li>
          <li><strong>النفقة المؤقتة متاحة</strong> أثناء الدعوى وتُصدر في ٤٨ إلى ٧٢ ساعة في الحالات الاستعجالية.</li>
          <li><strong>المهر محفوظ كاملاً</strong> في دعوى التطليق القضائي. لا تُفقدينه برفع الدعوى.</li>
          <li><strong>غير المسلمين</strong> لهم مسار أيسر: طلاق مدني بلا أسباب ودون اشتراط تعاون الزوج.</li>
        </ul>
      </div>

      <section class="content-section">
        <h2>حالتان مختلفتان ولكل منهما حلّها</h2>
        <p>
          حين نتحدث عن التطليق لغياب الزوج نقصد في الحقيقة حالتين متمايزتين لكلٍّ منهما حكمها وإن تداخلتا في حالات كثيرة.
        </p>
        <p>
          <strong>الحالة الأولى: الغياب الجسدي.</strong> غادر الزوج الإمارات أو لم يكن موجوداً فيها أصلاً، وانقطع التواصل به أو يرفضه، ولا تعلمين له مكاناً أو لا يمكن الوصول إليه.
        </p>
        <p>
          <strong>الحالة الثانية: الهجر المالي.</strong> الزوج قابل للوصول داخل الإمارات أو خارجها، لكنه توقف كلياً عن الإنفاق. قد يردّ على الهاتف لكنه يرفض الانخراط في أي إجراء قانوني.
        </p>
        <p>
          يُتيح القانون الإماراتي سبباً مستقلاً لكل حالة، ويجوز الجمع بينهما في دعوى واحدة إن تحققت شروط كليهما. والتطليق في هذه الحالات دعوى فسخ قضائي لا خلعاً، مما يعني حفظ جميع الحقوق المالية للزوجة.
        </p>
        <div class="info-box info-box--info">
          <h3>الفرق بين الفسخ والخلع</h3>
          <p>الخلع طلب تقدمه الزوجة لفسخ الزواج مقابل ردّ المهر. أما الفسخ (التطليق القضائي) فيصدره القاضي بسبب تقصير الزوج أو عجزه. في دعوى الغياب أنتِ تطلبين الفسخ لا الخلع، وهذا يعني استيفاء جميع الحقوق المالية شاملةً المهر الكامل دون تنازل.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>أسباب التطليق عند غياب الزوج</h2>

        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>السبب</th>
                <th>السند القانوني</th>
                <th>يسري على</th>
                <th>الشرط الجوهري</th>
              </tr>
            </thead>
            <tbody>
              {groundsRows.map((row, i) => (
                <tr class={i % 2 === 0 ? '' : 'row-alt'}>
                  <td class={`td-ground td-ground--${row.flag}`}>{row.ground}</td>
                  <td class="td-law">{row.law}</td>
                  <td class="td-who">{row.who}</td>
                  <td class="td-light">{row.requirement}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note-text">يجوز الجمع بين أكثر من سبب في الدعوى الواحدة. الزوجة التي مضى على غياب زوجها سنتان دون نفقة تستطيع الاستناد إلى المادتين ٧٩ و٧٢ معاً في آنٍ واحد.</p>
      </section>

      <section class="content-section">
        <h2>التطليق بالمادة ٧٩: الإجراءات خطوة بخطوة</h2>
        <p>
          تُشكّل المادة ٧٩ من المرسوم بقانون ٤١/٢٠٢٤ المسلك الرئيسي للتطليق حين يغيب الزوج فعلاً. تستلزم أن يكون الغياب سنةً فأكثر، وأن تكون النفقة منقطعة خلالها، وألا يكون ثمة عذر مقبول للغياب.
        </p>

        <div class="steps-list">
          <div class="step-card">
            <div class="step-num">٠١</div>
            <div class="step-body">
              <h3>تقديم الطلب ووضع المحكمة في الصورة</h3>
              <p>ترفعين الدعوى في محكمة الأحوال الشخصية في إمارة إقامتك. تُرفق جميع وسائل التواصل المعروفة بزوجك: رقم هاتفه وبريده الإلكتروني وعنوانه الأخير ومكان عمله إن عُرف. كلما وفّرتِ المحكمة بيانات أوفر أسرعت في مرحلة التحقق.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٢</div>
            <div class="step-body">
              <h3>مرحلة التحقق (٣٠ إلى ٩٠ يوماً)</h3>
              <p>تُجري المحكمة تحقيقاً للتحقق من الغياب وعدم توافر عذر مقبول له. يشمل ذلك الاستعلام عبر دائرة الأحوال المدنية، وسجلات الإدارة العامة للإقامة وشؤون الأجانب، ومحاولات التواصل عبر جميع المسالك المتاحة.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٣</div>
            <div class="step-body">
              <h3>الإعلان في الجريدة الرسمية والصحيفة</h3>
              <p>إن لم تُفضِ مرحلة التحقق إلى الوصول بالزوج تأمر المحكمة بنشر إعلان في الجريدة الرسمية وصحيفة عربية واسعة الانتشار. مدة الإعلان ٣٠ إلى ٦٠ يوماً. هذا الإجراء هو الوسيلة القانونية لإبلاغ العالم بالدعوى الجارية، ومكافئ في الأثر القانوني لما يُسمى "الإعلان بالنشر" في الأنظمة الأخرى.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٤</div>
            <div class="step-body">
              <h3>جلسة الحكم</h3>
              <p>بعد انقضاء مدة الإعلان تُحدد المحكمة جلسةً للحكم. تُقدمين فيها أدلتك ومستنداتك. إن ثبتت الأسباب القانونية يصدر حكم التطليق. هذا الحكم بالمادة ٧٩ بمثابة أي حكم طلاق آخر: يُنهي الزواج ويُسجَّل في سجلات الأحوال المدنية ويُثبت حقوقك المالية.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2>التطليق بالمادة ٧٢: ترك النفقة دون غياب كامل</h2>
        <p>
          تعالج المادة ٧٢ من المرسوم بقانون ٤١/٢٠٢٤ حالةً يُعاني منها كثيرات: الزوج موجود ويمكن الوصول إليه لكنه أوقف النفقة كلياً. إن توقف الزوج عن الإنفاق ثلاثة أشهر متتالية فأكثر دون عذر مقبول جاز للزوجة طلب التطليق حتى لو كان الزوج في الإمارات.
        </p>
        <p>
          "دون عذر مقبول" يعني انعدام الإعسار الحقيقي الموثَّق والمرض والقوة القاهرة. "لا أريد أن أدفع" ليس عذراً مقبولاً. ويُعدّ هذا المسلك في الغالب أسرع من المادة ٧٩ لأنه لا يستلزم انتظار اكتمال سنة الغياب.
        </p>
        <p>
          الأدلة اللازمة للتطليق بالمادة ٧٢: كشوف الحساب البنكي تُثبت انقطاع التحويلات لمدة ٣ أشهر فأكثر، وسجلات التواصل تُثبت طلبك النفقة وإحجام الزوج، والبريد الإلكتروني أو الرسائل النصية تُثبت الرفض الصريح أو الصمت.
        </p>
        <div class="info-box info-box--warning">
          <h3>وثّقي انقطاع النفقة الآن</h3>
          <p>أخرجي كشوف حسابك البنكية فوراً لتشمل فترة ما قبل الانقطاع وفترة الانقطاع ذاتها. خذي لقطات شاشة لأي رسائل واتساب أو بريد إلكتروني طالبتِ فيها النفقة ولم تُلبَّ. دوّني تواريخ آخر دفعات نقدية إن وجدت. هذه الأدلة هي أساس طلب التطليق بالمادة ٧٢.</p>
        </div>
      </section>

      <section class="content-section">
        <h2>إعلان الزوج الغائب في الخارج</h2>

        <div class="steps-list">
          <div class="step-card">
            <div class="step-num">٠١</div>
            <div class="step-body">
              <h3>الإعلان بالبريد الإلكتروني</h3>
              <p>تعترف المحاكم الإماراتية بالبريد الإلكتروني وسيلةً صحيحة للإعلان إن تحققت صحة العنوان. تُدرجين في طلبك آخر عنوان بريد إلكتروني معروف وتُوجّه المحكمة الإعلان إليه رسمياً.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٢</div>
            <div class="step-body">
              <h3>واتساب والرسائل النصية</h3>
              <p>تعترف المحاكم الإماراتية تبعاً لاعتراف الدولة بالتواصل الرقمي بواتساب والرسائل النصية وسائلَ إعلان صحيحة. تُسجَّل الرسائل المُرسَلة إلى آخر رقم معروف ضمن سجل الإعلان.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٣</div>
            <div class="step-body">
              <h3>وزارة العدل والتعاون القضائي الدولي</h3>
              <p>تربط وزارة العدل الإماراتية علاقات تعاون قضائي مع دول عديدة تُتيح طلب تبليغ المستجيب عبر هيئات قضائية أجنبية. هذا المسلك أكثر رسمية ويستغرق ٤ إلى ٨ أسابيع إضافية لكنه يُوفر أقوى سجل إعلان للطعن فيه.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">٠٤</div>
            <div class="step-body">
              <h3>الإعلان في الجريدة الرسمية</h3>
              <p>حين تعذّر جميع الوسائل السابقة تأمر المحكمة بنشر الإعلان في الجريدة الرسمية الإماراتية وصحيفة عربية. هذا الإعلان يُوازي قانونياً تسليم الإعلان الشخصي، وبعد انقضاء مدته يحق للمحكمة إصدار حكمها غيابياً.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2>النفقة المؤقتة أثناء سير الدعوى</h2>
        <p>
          من أشد المشاغل العملية قلقاً بالنسبة للزوجة التي تركها زوجها: كيف تُوفّر الإيجار ورسوم المدرسة ومصاريف الحياة اليومية طوال فترة الدعوى التي قد تمتد من ٦ إلى ١٨ شهراً؟
        </p>
        <p>
          تستطيع محاكم الأحوال الشخصية الإماراتية إصدار أوامر نفقة مؤقتة أثناء نظر دعاوى الطلاق. وفي الحالات الاستعجالية التي تكون فيها الزوجة بلا دخل وقد هجر الزوج الأسرة يمكن صدور هذا الأمر خلال ٤٨ إلى ٧٢ ساعة. ويُقدَّم طلب النفقة المؤقتة مع الدعوى الأصلية أو بعدها مباشرة.
        </p>
        <p>
          إن كان لزوجك أصول أو حسابات مصرفية في الإمارات جاز لمحكمة التنفيذ تجميدها وتحصيل النفقة المؤقتة منها حتى وهو في الخارج.
        </p>
      </section>

