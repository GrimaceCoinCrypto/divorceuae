---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'أوامر الطوارئ في دعاوى الطلاق بالإمارات — الحضانة المؤقتة وحظر السفر وتجميد الأصول';
const description =
  'يمكن لمحاكم الإمارات إصدار أوامر طوارئ خلال 48 إلى 72 ساعة لحماية الأطفال وتجميد الأصول ومنع السفر. تعرّف على الأنواع والإجراءات والأدلة المطلوبة.';

const canonical = 'https://divorceu.ae/ar/أوامر-الطوارئ-الطلاق-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/emergency-orders-divorce-uae/',
  ar: canonical,
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'أوامر الطوارئ في دعاوى الطلاق' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'كم تستغرق المحكمة في إصدار أمر طوارئ بالحضانة في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'في الحالات الطارئة الحقيقية تستطيع محكمة الأحوال الشخصية إصدار أمر مؤقت خلال 48 إلى 72 ساعة من تقديم الطلب. في الحالات البالغة الخطورة كخطر اختطاف الأطفال أو تهريب الأصول، يمكن إصدار الأمر في نفس اليوم. الشرط هو تقديم دليل موثّق وملموس على الخطر لا مجرد خلاف عائلي عادي.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يمكنني الحصول على أمر طوارئ بدون محامٍ في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'يسمح نظام المحاكم نظرياً بالتمثيل الذاتي، لكن في الواقع العملي تكون إجراءات طلبات الطوارئ معقدة ويتعين تقديم كافة الوثائق باللغة العربية. توكيل محامٍ متخصص يرفع بشكل ملحوظ احتمالية قبول المحكمة للطلب في المرة الأولى. التأخير في حالات الطوارئ قد يعني خروج الأطفال من البلاد أو اختفاء الأصول.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل يستطيع الزوج إلغاء حظر سفر الأطفال الصادر بأمر قضائي؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'لا يمكن ذلك بشكل انفرادي؛ يجب اللجوء إلى المحكمة. على الزوج تقديم طلب للمحكمة ذاتها لتعديل الأمر أو رفعه مع إبداء الأسباب. تُخطر الطرف الآخر بهذا الطلب ولها حق الاعتراض. تنظر المحكمة في ما إذا كانت الظروف المبررة للحظر قد تغيّرت وهل ثمة ضمانات كافية في حال السفر.',
      },
    },
    {
      '@type': 'Question',
      name: 'ماذا أفعل إذا أخذ زوجي الأطفال من الإمارات بغير إذني؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تصرّف فوراً. اتصل بمحامٍ أولاً، ثم أبلغ أقرب مركز شرطة، ثم وزارة العدل (إدارة التعاون الدولي) المعنية بقضايا اختطاف الأطفال عبر الحدود. الإمارات لديها اتفاقيات ثنائية مع عدد من الدول. السرعة حاسمة: كلما طالت إقامة الطفل في الدولة الأخرى، صعُبت مسألة إعادته.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما مدة سريان أمر تجميد الأصول في دعاوى الطلاق بالإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'يرتبط أمر التجميد في الغالب بمسار الدعوى الرئيسية؛ يستمر حتى يُصدر القاضي حكماً نهائياً في توزيع الأصول أو حتى يتوصل الطرفان إلى تسوية مسجّلة. إذا انتهت الدعوى في وقت قصير رُفع التجميد ضمن بنود التسوية. قد يستمر التجميد 12 إلى 24 شهراً إذا امتدت الإجراءات، ما لم يُطلب تعديله.',
      },
    },
    {
      '@type': 'Question',
      name: 'كم تبلغ تكلفة تقديم طلب طوارئ أمام محاكم الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'رسوم تقديم الطلب القضائي 300 إلى 500 درهم حسب الإمارة. أتعاب المحامي لطلب طوارئ شاملة (تحضير الإقرار والحضور وما بعد الأمر) تتراوح عادة بين 3,000 و8,000 درهم. هذا مستقل عن أتعاب الاستئجار الكاملة لدعوى الطلاق. في حالات الطوارئ الحقيقية تكون السرعة أهم من التكلفة.',
      },
    },
    {
      '@type': 'Question',
      name: 'هل تؤثر أوامر الطوارئ على نتيجة دعوى الطلاق النهائية؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'أوامر الطوارئ مؤقتة ولا تحسم النتيجة النهائية. لكن الأدلة المقدّمة لاستصدارها والسلوك الموثّق أثناء مرحلة الطوارئ قد يؤثر على تقدير القاضي لكلا الطرفين. التصرف بتناسب ومع توثيق مبرر كل طلب طوارئ يعزز مصداقيتك أمام المحكمة.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الفرق بين الأمر المستعجل وأمر الحماية من العنف الأسري في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'الأوامر المستعجلة تصدر ضمن دعاوى الطلاق والحضانة لحماية الأصول والأطفال. أمر الحماية من العنف الأسري يصدر استناداً إلى القانون الاتحادي رقم 15 لسنة 2021 وهو مستقل عن دعوى الطلاق؛ يمنع المدّعى عليه من الاقتراب أو التواصل ومخالفته تشكّل جريمة جزائية. يمكن استصدار كليهما بالتوازي.',
      },
    },
  ],
};

const orderTypes = [
  { icon: '👶', title: 'أمر الحضانة المؤقتة', desc: 'يمنح أحد الوالدين الحضانة الجسدية المؤقتة للأطفال عند وجود خطر موثّق. يقترن عادةً بحظر سفر الأطفال في آنٍ واحد.' },
  { icon: '✈️', title: 'حظر سفر الأطفال', desc: 'يمنع خروج الأطفال من الإمارات عبر أي منفذ حدودي أو مطار. تُطبّقه الجهات الأمنية خلال 24 ساعة من صدور الأمر.' },
  { icon: '🏦', title: 'أمر تجميد الأصول', desc: 'يحول دون تحويل الأموال أو بيع العقارات أو التصرف في الأصول الزوجية أثناء سير الإجراءات.' },
  { icon: '🏠', title: 'أمر تقييد التصرف في العقار', desc: 'يوقف تسجيل نقل الملكية في دائرة الأراضي والأملاك بدبي أو ما يعادلها في الإمارات الأخرى.' },
  { icon: '🛡️', title: 'أمر الحماية (العنف الأسري)', desc: 'صادر بموجب القانون الاتحادي رقم 15 لسنة 2021. مستقل عن دعوى الطلاق. يمنع التواصل والاقتراب.' },
  { icon: '📋', title: 'أمر النفقة المؤقتة', desc: 'يُلزم الزوج بدفع النفقة ريثما يصدر الحكم النهائي. قابل للتنفيذ على الراتب خلال أسبوعين إلى أربعة أسابيع.' },
];

const steps = [
  { n: 1, title: 'توثيق الأدلة', body: 'قبل الاتصال بمحامٍ، اجمع كل ما يثبت الخطر أو الإلحاح: صور، تقارير طبية، بلاغات شرطة، رسائل واتساب تتضمن تهديدات أو خططاً للسفر، كشوف حسابات بنكية تُظهر تحويلات للخارج، سجلات مدرسية، بيانات شهود. تحتاج المحكمة إلى دليل محدد وموثّق لا مجرد وصف لأزمة زوجية عامة.' },
  { n: 2, title: 'توكيل محامٍ فوراً', body: 'تستلزم طلبات الطوارئ تحضير إقرار مكتوب بالعربية يستوفي الأسباب القانونية. محامٍ متخصص بالطلبات العاجلة يستطيع إعداد هذا الإقرار في غضون ساعات في الحالات الحقيقية.' },
  { n: 3, title: 'تقديم الطلب المستعجل', body: 'يُقدّم محاميك الطلب المستعجل (طلب استعجالي) إلى محكمة الأحوال الشخصية. رسوم التقديم 300 إلى 500 درهم حسب الإمارة. تقيّم المحكمة ما إذا كانت ستعقد جلسة طارئة في نفس اليوم أو في اليوم التالي.' },
  { n: 4, title: 'الجلسة الطارئة', body: 'يراجع القاضي أدلتك وإقرارك. قد تحضر أنت أو محامٍ فقط حسب الحالة. في الأمور البالغة الخطورة (خطر نقل الأطفال وشيك، دليل على تهريب أصول) تستطيع المحاكم إصدار الأمر بمعزل عن الطرف الآخر مؤقتاً.' },
  { n: 5, title: 'صدور الأمر وتنفيذه', body: 'فور صدور الأمر تُبلَّغ به الجهات المعنية مباشرة: الجهات الأمنية (لحظر السفر)، البنوك (لتجميد الحسابات)، دائرة الأراضي والأملاك (لتقييد العقارات). التنفيذ يكون عادةً خلال 24 ساعة من صدور الأمر.' },
  { n: 6, title: 'إخطار الطرف الآخر', body: 'في أغلب الحالات يُخطر الطرف الآخر بالأمر ومضمونه وله حق الطعن أو طلب تعديله. يجب حضور أي جلسة مراجعة مع توثيق مبررات الأمر بالأدلة.' },
];

const faqItems = [
  {
    question: 'كم تستغرق المحكمة في إصدار أمر طوارئ بالحضانة في الإمارات؟',
    answer: 'في الحالات الطارئة الحقيقية تستطيع محكمة الأحوال الشخصية إصدار أمر مؤقت خلال 48 إلى 72 ساعة. في الحالات البالغة الخطورة كخطر اختطاف الأطفال يمكن إصداره في نفس اليوم. الشرط هو تقديم دليل موثّق وملموس على الخطر.',
  },
  {
    question: 'هل يمكنني الحصول على أمر طوارئ بدون محامٍ في الإمارات؟',
    answer: 'يسمح النظام نظرياً بالتمثيل الذاتي، لكن إجراءات الطوارئ معقدة والوثائق يجب تقديمها بالعربية. توكيل محامٍ متخصص يرفع احتمالية قبول الطلب بشكل ملحوظ. التأخير في حالات الطوارئ قد يعني خروج الأطفال من البلاد.',
  },
  {
    question: 'هل يستطيع الزوج إلغاء حظر سفر الأطفال الصادر بأمر قضائي؟',
    answer: 'لا يمكن ذلك بشكل انفرادي. يجب اللجوء إلى المحكمة لتقديم طلب تعديل أو رفع الأمر مع إبداء الأسباب. تُخطر الطرف الآخر وله حق الاعتراض.',
  },
  {
    question: 'ماذا أفعل إذا أخذ زوجي الأطفال من الإمارات بغير إذني؟',
    answer: 'تصرّف فوراً. اتصل بمحامٍ أولاً ثم أبلغ أقرب مركز شرطة ووزارة العدل (إدارة التعاون الدولي). الإمارات لديها اتفاقيات ثنائية مع عدد من الدول. السرعة حاسمة.',
  },
  {
    question: 'ما مدة سريان أمر تجميد الأصول في دعاوى الطلاق بالإمارات؟',
    answer: 'يرتبط أمر التجميد بمسار الدعوى الرئيسية ويستمر حتى يُصدر القاضي حكماً نهائياً أو يتوصل الطرفان إلى تسوية. قد يستمر التجميد 12 إلى 24 شهراً إذا امتدت الإجراءات.',
  },
  {
    question: 'كم تبلغ تكلفة تقديم طلب طوارئ أمام محاكم الإمارات؟',
