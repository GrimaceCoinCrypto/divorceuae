---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'قانون الطلاق في الإمارات — شرح قانون الأحوال الشخصية 2026';
const description =
  'شرح شامل لقانون الطلاق في الإمارات وفق النظام المزدوج: المرسوم بقانون اتحادي رقم 41 لسنة 2024 للمسلمين (ساري منذ 15 أبريل 2025) والمرسوم بقانون اتحادي رقم 41 لسنة 2022 لغير المسلمين. أنواع الطلاق، الحضانة، النفقة، وحقوق الزوجين.';

const canonical = 'https://divorceu.ae/ar/قانون-الطلاق-في-الامارات/';

const hreflang = {
  en: 'https://divorceu.ae/en/uae-divorce-law/',
  ar: 'https://divorceu.ae/ar/قانون-الطلاق-في-الامارات/',
};

const breadcrumbItems = [
  { name: 'الرئيسية', url: 'https://divorceu.ae/ar/' },
  { name: 'قانون الطلاق في الإمارات' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'ما هو القانون الذي يحكم الطلاق في الإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'تعتمد الإمارات نظاماً قانونياً مزدوجاً. للمسلمين يُطبَّق المرسوم بقانون اتحادي رقم 41 لسنة 2024 بشأن الأحوال الشخصية، الساري منذ 15 أبريل 2025، والذي حلّ محلّ القانون رقم 28 لسنة 2005 بالكامل. أما غير المسلمين المقيمين فيُطبَّق عليهم المرسوم بقانون اتحادي رقم 41 لسنة 2022 بشأن الأحوال الشخصية المدنية.',
      },
    },
    {
      '@type': 'Question',
      name: 'ما الذي غيّره قانون 2022 في أحكام الطلاق بالإمارات؟',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'أتاح المرسوم بقانون اتحادي رقم 41 لسنة 2022 لغير المسلمين الطلاق وفق أحكام مدنية دون إثبات ضرر أو أسباب. لا يفرض القانون اقتساماً تلقائياً بنسبة 50/50، بل تنظر المحكمة في مساهمات كل زوج وظروفه المالية. كما تكون الحضانة المشتركة هي الأصل، ولا تسري فترة العدة. ويشمل القانون أيضاً أحكام الميراث والوصية وإثبات النسب.',
      },
    },
  ],
};

const faqItems = [
  {
    question: 'ما هو القانون الذي يحكم الطلاق في الإمارات؟',
    answer: 'للمسلمين: <strong>المرسوم بقانون اتحادي رقم 41 لسنة 2024</strong> الساري منذ 15 أبريل 2025، والذي حلّ محلّ قانون 2005. ولغير المسلمين المقيمين: <strong>المرسوم بقانون اتحادي رقم 41 لسنة 2022</strong> بأحكام مدنية.',
  },
  {
    question: 'ما الذي غيّره قانون 2022؟',
    answer: 'أتاح لغير المسلمين الطلاق وفق أحكام مدنية <strong>دون إثبات ضرر</strong>، مع <strong>حضانة مشتركة</strong> و<strong>انتفاء العدة</strong>. وتنظر المحكمة في قسمة الأصول وفق مساهمات كل زوج، دون اقتسام تلقائي بنسبة 50/50.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  lang="ar"
  dir="rtl"
  hreflang={hreflang}
  schema={faqSchema}
>
  <main>
    <header class="hero">
      <div class="container hero__inner">
        <div class="hero__content">
          <Breadcrumb items={breadcrumbItems} lang="ar" />
          <h1 class="hero__h1">
            قانون الطلاق في الإمارات —<br />
            شرح شامل للتشريع والأحكام
          </h1>
          <p class="hero__sub">
            يقوم الطلاق في الإمارات على نظام مزدوج: قانون الأحوال الشخصية للمسلمين
            (المرسوم بقانون رقم 41 لسنة 2024 الساري منذ 15 أبريل 2025)، ونظام مدني خاص
            بغير المسلمين (المرسوم بقانون رقم 41 لسنة 2022). هذا الدليل يشرح القانون
            الإماراتي للطلاق بلغة واضحة: أنواع الطلاق، حقوق الزوجين، الحضانة، والنفقة.
          </p>
          <ul class="hero__trust">
            <li>✓ قانون المسلمين رقم 41 لسنة 2024</li>
            <li>✓ قانون غير المسلمين رقم 41 لسنة 2022</li>
            <li>✓ حقوق الزوجين كاملةً</li>
            <li>✓ استشارة مجانية</li>
          </ul>
        </div>
        <div class="hero__form">
          <LeadForm lang="ar" variant="hero" heading="افهم حقوقك — استشارة مجانية" />
        </div>
      </div>
    </header>

    <div class="container">

      <section class="section" aria-labelledby="law-heading">
        <h2 id="law-heading">قانون الأحوال الشخصية للمسلمين — المرسوم بقانون اتحادي رقم 41 لسنة 2024</h2>
        <p>
          يُشكّل هذا القانون الإطار القانوني الرئيسي للزواج والطلاق والحضانة والنفقة
          للمسلمين في الإمارات العربية المتحدة، من مواطنين ومقيمين. وقد دخل حيّز التنفيذ
          في <strong>15 أبريل 2025</strong>، وحلّ محلّ قانون الأحوال الشخصية رقم 28 لسنة 2005
          بالكامل. يستند القانون إلى مبادئ الشريعة الإسلامية، مع تمكين القاضي من الاجتهاد بما
          يحقّق مصلحة الأسرة دون التقيّد بمذهب فقهي واحد.
        </p>

        <h3>أبرز أحكام الطلاق في القانون</h3>
        <ul class="list">
          <li><strong>الطلاق:</strong> حق الزوج في إنهاء الزواج، ويجب توثيقه أمام المحكمة المختصة ليكون نافذاً؛ وتكرار لفظ الطلاق يُحتسب طلقة واحدة</li>
          <li><strong>الخلع:</strong> حق الزوجة في طلب الطلاق مقابل رد المهر، لا يحق للزوج رفضه</li>
          <li><strong>التفريق القضائي:</strong> الطلاق للضرر أو الغيبة أو عدم الإنفاق، وقد أُضيف <strong>الإدمان على المسكرات</strong> سبباً جديداً للطلاق</li>
          <li><strong>العدة:</strong> فترة انتظار إلزامية للزوجة المسلمة بعد الطلاق قبل الزواج الجديد</li>
          <li><strong>النفقة:</strong> يلتزم الزوج بالإنفاق على الزوجة المطلقة طوال فترة العدة</li>
          <li><strong>المهر المؤجل:</strong> يُستحق للزوجة عند الطلاق أو الوفاة</li>
        </ul>

        <h3>أبرز التغييرات في قانون 2024</h3>
        <ul class="list">
          <li><strong>الحضانة حتى سن 18:</strong> تمتد حضانة الأولاد والبنات إلى سن الثامنة عشرة، بعد أن كانت تنتهي عند نحو 11 سنة للأولاد و13 سنة للبنات في القانون القديم</li>
          <li><strong>حق اختيار الطفل:</strong> يحق للطفل من عمر 15 سنة اختيار الوالد الذي يعيش معه، بما يحقق مصلحته الفضلى</li>
          <li><strong>فترة الصلح:</strong> اختُصرت مدة التوجيه والصلح الأسري إلى <strong>60 يوماً</strong> بعد أن كانت 90 يوماً</li>
          <li><strong>توثيق الطلاق:</strong> يجب توثيق الطلاق أمام المحكمة، ويُلزَم الزوج بتوثيقه خلال مدة قصيرة (يُشار إليها بنحو 15 يوماً) من إيقاعه</li>
          <li><strong>سن الزواج:</strong> تحديد الحد الأدنى لسن الزواج بـ 18 سنة، مع استثناءات ضيقة بموافقة قضائية</li>
        </ul>
        <p class="note-small">
          ملاحظة: أرقام المواد التفصيلية مستندة إلى تحليلات قانونية، ويُنصح بالرجوع إلى النص الرسمي للقانون للتأكد من الصياغة الدقيقة.
        </p>
      </section>

      <section class="section" aria-labelledby="2022-heading">
        <h2 id="2022-heading">المرسوم بقانون اتحادي رقم 41 لسنة 2022 — أحكام غير المسلمين</h2>
        <p>
          يُعدّ هذا القانون نقلة نوعية في التشريع الإماراتي، إذ يُتيح لغير المسلمين المقيمين
          في الإمارات تطبيق أحكام مدنية على زواجهم وطلاقهم بدلاً من أحكام الشريعة الإسلامية.
          وقد دخل حيّز التنفيذ في 1 فبراير 2023، ويُطبَّق في جميع إمارات الدولة، ما لم يختر
          أحد الطرفين تطبيق قانون بلده الأصلي.
        </p>

        <h3>أحكام الطلاق لغير المسلمين</h3>
        <div class="law-grid">
          <div class="law-item">
            <span class="law-icon">⚖️</span>
            <h3>قسمة الأصول</h3>
            <p>لا يفرض القانون اقتساماً تلقائياً بنسبة 50/50؛ بل تنظر المحكمة في مساهمات كل زوج المالية وغير المالية وظروفه واحتياجاته وأي اتفاق بينهما.</p>
          </div>
          <div class="law-item">
            <span class="law-icon">👨‍👧</span>
            <h3>الحضانة المشتركة</h3>
            <p>الحضانة المشتركة هي الأصل — يتشارك الوالدان وقت الأطفال بالتساوي ولهما حق متساوٍ في القرارات المصيرية.</p>
          </div>
          <div class="law-item">
            <span class="law-icon">🚫</span>
            <h3>انتفاء العدة</h3>
            <p>لا تسري فترة العدة الإسلامية على غير المسلمين — يجوز الزواج الجديد فور صدور حكم الطلاق.</p>
          </div>
          <div class="law-item">
            <span class="law-icon">📋</span>
            <h3>إجراءات مبسّطة</h3>
            <p>لا يشترط تقديم أسباب للطلاق — طلب الطرفين أو أحدهما كافٍ، دون الحاجة لإثبات الضرر.</p>
          </div>
        </div>

        <div class="callout">
          <strong>كيف تستفيد من قانون 2022:</strong> يجب أن يكون أحد الزوجين على الأقل غير مسلم،
          وأن تطلب صراحةً تطبيق هذا القانون عند تقديم دعوى الطلاق. إذا لم تطلبه، قد يُطبَّق
          القانون الإسلامي تلقائياً.
        </div>
      </section>

      <section class="section" aria-labelledby="types-heading">
        <h2 id="types-heading">أنواع الطلاق وفق القانون الإماراتي</h2>

        <h3>الطلاق (بإرادة الزوج)</h3>
        <p>يملك الزوج المسلم حق الطلاق، لكن يجب تسجيله قضائياً في محكمة الأحوال الشخصية ليكون نافذاً قانونياً. الطلاق الشفهي غير المسجّل لا أثر قانونياً له في الإمارات.</p>

        <h3>الخلع (بطلب الزوجة)</h3>
        <p>تطلب الزوجة من المحكمة إنهاء الزواج مقابل ردّ المهر المقدّم. لا يحق للزوج الاعتراض، لكنه يحق له استرداد المهر. يستغرق الخلع عادةً 1–3 أشهر.</p>

        <h3>التفريق القضائي للضرر</h3>
        <p>تلجأ إليه الزوجة عند الإيذاء أو الإهمال أو الهجر. يتطلب تقديم أدلة أمام المحكمة.</p>

        <h3>الطلاق بالتراضي</h3>
        <p>يتفق الزوجان على جميع شروط الطلاق ويقدمان طلباً مشتركاً. الأسرع والأقل تكلفةً: 1–3 أشهر.</p>

        <p>
          <a href="/ar/كيفية-تقديم-الطلاق-في-الامارات/">دليل مفصّل: إجراءات الطلاق خطوة بخطوة ←</a>
        </p>
      </section>

      <section class="section" aria-labelledby="related-heading">
        <h2 id="related-heading">أدلة ذات صلة</h2>
        <div class="related-links">
          <a href="/ar/قانون-الأحوال-الشخصية-الجديد-الامارات/" class="related-link">
            <strong>قانون الأحوال الشخصية الإماراتي الجديد ٢٠٢٥</strong>
            <span>أهم تغييرات قانون رقم ٤١ لسنة ٢٠٢٤ في الطلاق والحضانة والنفقة</span>
          </a>
          <a href="/ar/محامي-طلاق/" class="related-link">
            <strong>محامي طلاق في الإمارات</strong>
            <span>استشر محامياً متخصصاً في القانون الإماراتي</span>
          </a>
          <a href="/ar/كيفية-تقديم-الطلاق-في-الامارات/" class="related-link">
            <strong>إجراءات الطلاق في الإمارات</strong>
            <span>خطوة بخطوة من التقديم للحكم</span>
          </a>
          <a href="/ar/حقوق-الزوجة-بعد-الطلاق-الامارات/" class="related-link">
            <strong>حقوق الزوجة بعد الطلاق</strong>
            <span>النفقة والمهر وحق السكن</span>
          </a>
          <a href="/ar/طلاق-للضرر/" class="related-link">
            <strong>الطلاق للضرر</strong>
            <span>الشروط والأدلة والإجراءات</span>
          </a>
        </div>
      </section>

      <FAQSection items={faqItems} lang="ar" />

      <section class="section section--cta" id="contact" aria-labelledby="cta-heading">
        <h2 id="cta-heading">افهم حقوقك القانونية — استشارة مجانية</h2>
        <p>تحدث مع محامٍ متخصص في قانون الأحوال الشخصية الإماراتي. سري ومجاني.</p>
        <LeadForm lang="ar" variant="inline" />
      </section>
    </div>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <p>© 2026 DivorceU.AE — خدمة إحالة قانونية. ليست مكتب محاماة.</p>
      <nav aria-label="تنقل التذييل">
        <a href="/ar/">الرئيسية</a>
        <a href="/en/uae-divorce-law/">English</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
