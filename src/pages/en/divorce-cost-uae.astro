const lawyerFees = [
  { type: 'Uncontested / Mutual Consent', range: 'AED 8,000–25,000', desc: 'Both parties agree on all terms. The lawyer drafts and files the settlement. Lower end for simple civil uncontested cases; higher where a fixed full-service fee applies.' },
  { type: 'Contested (assets or alimony)', range: 'AED 40,000–80,000', desc: 'Disputes over assets, alimony or property need multiple hearings, disclosure and expert input. Complexity drives the range.' },
  { type: 'Complex contested / custody', range: 'AED 80,000–150,000+', desc: 'Custody fights, business valuations and international elements are the most expensive. Cases can run 1 to 3 years including appeals.' },
  { type: 'Non-Muslim civil divorce', range: 'AED 8,000–30,000', desc: 'No-fault filings under Federal Decree-Law 41/2022 or the Abu Dhabi Civil Family Court are usually faster and cheaper than Sharia-track contested cases.' },
  { type: 'Khulʿ (wife-initiated)', range: 'AED 4,000–12,000', desc: 'Simpler where the husband agrees. Contested khulʿ is more complex, as the wife may have to return the mahr.' },
];

const hourlyRates = [
  { level: 'Junior associate', rate: 'AED 750–1,000 / hour' },
  { level: 'Mid-level lawyer', rate: 'AED 1,200–1,800 / hour' },
  { level: 'Senior partner', rate: 'AED 2,000–2,500 / hour' },
];

const dldFees = [
  { item: 'Pre-divorce gift transfer (spouse to spouse)', cost: '0.125% of property value + AED 530', notes: 'The reduced “gift” (hiba) rate applies when the transfer is between spouses and is completed while still legally married. This is the cheapest route.' },
  { item: 'Standard transfer after divorce', cost: '4% of property value + AED 540', notes: 'The ordinary DLD transfer fee once the marriage has ended. On a AED 2m property this is AED 80,540 versus AED 3,030 for the pre-divorce gift route.' },
  { item: 'Title deed issuance', cost: 'AED 250', notes: 'New title deed reflecting the updated ownership.' },
  { item: 'Property map / site plan', cost: 'AED 250', notes: 'Issued alongside the transfer.' },
  { item: 'Knowledge & Innovation fees', cost: 'AED 10', notes: 'Fixed government levy on the transaction.' },
  { item: 'Trustee office fee (property under AED 500k)', cost: 'AED 2,000 + 5% VAT', notes: 'Paid to the DLD-authorised registration trustee handling the transfer.' },
  { item: 'Trustee office fee (property AED 500k+)', cost: 'AED 4,000 + 5% VAT', notes: 'Higher trustee fee band for higher-value properties.' },
  { item: 'Property valuation', cost: 'From AED 2,500', notes: 'Needed where the transfer value or an equity buy-out must be evidenced.' },
];

const faqItems = [
  {
    question: 'How much does it cost to file for divorce in Dubai?',
    answer: 'Government court fees for a Dubai divorce typically run AED 2,000–5,000 for a straightforward case, covering petition registration, first-instance court fees, and document processing. This is separate from lawyer fees, which are the larger cost. For a simple uncontested civil divorce with a lawyer, the all-in out-of-pocket cost is usually AED 12,000–30,000. A contested divorce with a custody dispute can reach AED 60,000–100,000 or more over the full case. All figures are indicative and vary by firm and case.',
  },
  {
    question: 'Is divorce cheaper for non-Muslims in the UAE?',
    answer: 'Often, yes. Non-Muslim residents divorce under Federal Decree-Law 41/2022, or in Abu Dhabi under Law 14/2021. These no-fault routes do not require proof of grounds and do not go through mandatory Sharia reconciliation, so cases move faster with fewer hearings. The Abu Dhabi Civil Family Court, which runs proceedings in English, is generally the fastest and cheapest venue for a non-Muslim uncontested divorce. A Muslim divorce under Federal Decree-Law 41/2024 follows the Sharia track with a 60-day reconciliation period, which adds time and cost if disputed.',
  },
  {
    question: 'What are the DLD fees to transfer property after a UAE divorce?',
    answer: 'This is where timing matters most. If a property is transferred between spouses as a gift while still legally married, the Dubai Land Department (DLD) charges a reduced gift-transfer fee of 0.125% of the property value plus AED 530. Once the divorce is finalised, an ordinary transfer costs 4% of the property value plus AED 540. On a AED 2 million home that is roughly AED 3,030 versus AED 80,540, a difference of about AED 77,000. Where both parties agree on who keeps the property, completing the transfer before the divorce is finalised can save a large sum. Figures per the Dubai Land Department fee schedule; add title deed, trustee and valuation fees.',
  },
  {
    question: 'Do I need a lawyer to get divorced in the UAE?',
    answer: 'Technically no, you can represent yourself in UAE courts. In practice, for foreign nationals especially, the procedural requirements (Arabic pleadings, court decorum, personal status law knowledge) make self-representation very difficult. Onshore courts require documents in Arabic, and many expats cannot follow proceedings. A lawyer also ensures that settlements, especially custody and property terms, are correctly drafted and enforceable.',
  },
  {
    question: 'How long does divorce take in the UAE and how does that affect cost?',
    answer: 'An uncontested divorce usually completes in about 3 months; an Abu Dhabi civil no-fault divorce can be under 1 month. A contested divorce typically takes 1 to 3 years including appeals. Duration drives lawyer fees, as UAE lawyers often bill per hearing or on a monthly retainer. A case running 18 months at senior rates can accumulate AED 60,000–150,000 in legal fees alone.',
  },
  {
    question: 'Are mediation sessions mandatory before divorce in the UAE?',
    answer: 'For Muslim (Sharia-track) divorces, yes. Cases start at the Family Guidance Department and mediation is compulsory, with a reconciliation window of 60 days under Federal Decree-Law 41/2024 (reduced from 90). For non-Muslims under Federal Decree-Law 41/2022, mandatory reconciliation does not apply; couples may attend voluntarily. Court session fees are nominal (AED 100–300). Private mediation, if you choose it, is separate and runs AED 5,000–10,000.',
  },
  {
    question: 'What hidden costs should I budget for in a UAE divorce?',
    answer: 'Several costs catch people off guard: (1) certified Arabic translation of foreign documents (AED 1,000–4,000 in total depending on volume); (2) attestation of foreign marriage certificates (AED 150–1,000+); (3) expert and welfare reports in disputed cases (AED 3,000–10,000); (4) DLD property-transfer fees if a home changes hands; and (5) enforcement proceedings if your ex-spouse does not comply with the order, which cost an additional AED 2,000–6,000 in fees and legal time.',
