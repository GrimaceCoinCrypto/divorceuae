const courtFees = [
  { item: 'Court filing fee (petition registration)', cost: 'AED 200–500', notes: 'Paid when submitting the divorce petition. Differs slightly by emirate and case type.' },
  { item: 'First-instance court fees (uncontested)', cost: 'AED 2,000–3,000', notes: 'Registration and processing to open and run the case file in the Family Court system.' },
  { item: 'First-instance court fees (contested)', cost: 'AED 4,000–8,000', notes: 'Higher where multiple claims (custody, alimony, property) are joined and more hearings are scheduled.' },
  { item: 'Certified legal translation (uncontested)', cost: 'AED 1,000–2,000', notes: 'Arabic translation of passports, marriage certificate and core documents by a Ministry of Justice-licensed translator.' },
