---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'Is WhatsApp Divorce Valid in UAE? What the Law Says (2026)';
const description =
  'A WhatsApp message saying "I divorce you" can constitute a valid talaq in UAE, but the husband must document it in court within 15 days. What UAE law says, the court documentation duty, evidence rules, and what to do if you received a digital divorce.';

const hreflang = {
  en: 'https://divorceu.ae/en/whatsapp-divorce-uae/',
  ar: 'https://divorceu.ae/ar/الطلاق-عبر-واتساب-الامارات/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'WhatsApp Divorce UAE', url: 'https://divorceu.ae/en/whatsapp-divorce-uae/' },
];

const faqSchema = {
