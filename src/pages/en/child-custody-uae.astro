---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'Child Custody UAE: Complete Guide for Expat Parents (2026)';
const description =
  'Child custody UAE explained for expat parents. Custody now runs to 18 under the 2024 law, joint custody for non-Muslims, Hague Convention gap, travel bans, dual nationality, enforcement. Updated July 2026.';

const canonical = 'https://divorceu.ae/en/child-custody-uae/';

const hreflang = {
  en: 'https://divorceu.ae/en/child-custody-uae/',
  ar: 'https://divorceu.ae/ar/حضانة-الاطفال-الامارات/',
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Child Custody in UAE: The Complete Guide for Expat Parents',
  description:
    'How UAE child custody law works for expat families under Federal Decree-Law No. 41 of 2024 and No. 41 of 2022: custody to age 18, joint custody, the Hague Convention gap, travel bans and enforcement.',
  author: {
    '@type': 'Person',
    name: 'Aleksi Suon',
  },
  publisher: {
    '@type': 'Organization',
    name: 'DivorceU.AE',
  },
  dateModified: '2026-07-25',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': 'https://divorceu.ae/en/child-custody-uae/',
  },
};

const breadcrumbItems = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'Child Custody UAE' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who gets child custody in UAE after divorce in 2025?',
