const faqItems = faqSchema.mainEntity.map((q) => ({ question: q.name, answer: q.acceptedAnswer.text }));

const comparisonRows = [
  { criterion: 'Governing law (non-Muslim)', adcfc: 'Federal Decree-Law No. 41/2022 + civil framework under Abu Dhabi Law No. 14/2021', dubai: 'Federal Decree-Law No. 41/2022 (same substantive law)' },
