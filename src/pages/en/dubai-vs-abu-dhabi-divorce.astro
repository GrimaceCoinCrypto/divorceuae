const faqItems = faqSchema.mainEntity.map((q) => ({ question: q.name, answer: q.acceptedAnswer.text }));

const comparisonRows = [
  { criterion: 'Governing law (non-Muslim)', adcfc: 'Federal Decree-Law No. 41/2022 + civil framework under Abu Dhabi Law No. 14/2021', dubai: 'Federal Decree-Law No. 41/2022 (same substantive law)', difc: 'FL 41/2022 + common law procedure; home country law available' },
  { criterion: 'Mandatory counselling', adcfc: 'No (not required for uncontested)', dubai: 'Yes -- 2-3 sessions at Family Guidance, adds 4-6 weeks minimum', difc: 'No' },
  { criterion: 'Speed (uncontested)', adcfc: '3-6 weeks', dubai: '8-12 weeks', difc: '8-16 weeks (high procedural rigour)' },
  { criterion: 'Language', adcfc: 'Arabic (English translation provided)', dubai: 'Arabic only (court translator for expats)', difc: 'English throughout' },
  { criterion: 'Judge type', adcfc: 'Civil judges; secular framework', dubai: 'Personal Status judges; religious law background', difc: 'English common law judges' },
  { criterion: 'Financial disclosure', adcfc: 'Court can order; growing use', dubai: 'Court can order; less routinely applied', difc: 'Full English-style financial disclosure; Mareva injunctions available' },
  { criterion: 'Alimony approach', adcfc: 'Flexible; contribution and needs considered', dubai: 'Stricter separate-property approach', difc: 'Common law needs and sharing analysis' },
