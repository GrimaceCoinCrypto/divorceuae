const hreflang = {
  en: 'https://divorceu.ae/en/dubai-vs-abu-dhabi-divorce/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'Dubai vs Abu Dhabi Divorce', url: 'https://divorceu.ae/en/dubai-vs-abu-dhabi-divorce/' },
