  { criterion: 'Judge type', adcfc: 'Civil judges; secular framework', dubai: 'Personal Status judges; religious law background' },
  { criterion: 'Financial disclosure', adcfc: 'Court can order; growing use', dubai: 'Court can order; less routinely applied' },
  { criterion: 'Alimony approach', adcfc: 'Flexible; contribution and needs considered', dubai: 'Stricter separate-property approach' },
