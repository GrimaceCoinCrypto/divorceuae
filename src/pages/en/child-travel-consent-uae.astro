const title = 'Child Travel Consent UAE: Letter, Court Permit & Passport (2026)';
const description =
  'When you need the other parent’s consent to take a child out of the UAE, what the letter must say, notarisation, and the court permit if they refuse.';

const hreflang = {
  en: 'https://divorceu.ae/en/child-travel-consent-uae/',
};

const breadcrumbs = [
