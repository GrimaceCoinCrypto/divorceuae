const financialRights = [
  { right: 'Prompt mahr (mu\'ajjal)', timing: 'Due at marriage / already due', notes: 'Enforceable immediately. Unpaid prompt mahr becomes a debt from day of divorce.' },
  { right: 'Deferred mahr (mu\'ajjal)', timing: 'Due immediately on divorce', notes: 'Falls due in full on pronouncement of divorce, regardless of any original deferral. Enforced as privileged debt.' },
  { right: "Nafaqa al-iddah (iddah maintenance)", timing: 'During iddah period', notes: "3 lunar months (if not pregnant) or until childbirth. Father's obligation even if wife is working." },
  { right: "Mut'a (consolation)", timing: 'One-time payment post-divorce', notes: "Minimum 1 year's maintenance. Only if wife did not initiate divorce (khula'). Amount determined by court based on husband's means and marriage duration." },
  { right: 'Child support (nafaqa al-awlad)', timing: "Until child's majority / marriage", notes: "Father's obligation regardless of custody arrangement. Continues for daughter until she marries." },
  { right: 'Hadhana housing (iddah period)', timing: 'During iddah', notes: 'Husband must provide suitable accommodation for wife during iddah period unless she moves out voluntarily.' },
];

const faqItems = [
