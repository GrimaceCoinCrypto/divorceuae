---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LeadForm from '../../../components/ui/LeadForm.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import Breadcrumb from '../../../components/seo/Breadcrumb.astro';

const title = 'Aleksi Suoninen, UAE Expat and Legal Consultant';
const description =
  'Aleksi Suoninen is a UAE expat and legal consultant who researches UAE divorce and family law and works with licensed UAE lawyers to review the guidance.';

const hreflang = {
  en: 'https://divorceu.ae/en/author/aleksi-suoninen/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'About', url: 'https://divorceu.ae/en/about/' },
  { name: 'Aleksi Suoninen', url: 'https://divorceu.ae/en/author/aleksi-suoninen/' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Aleksi Suoninen',
  jobTitle: 'UAE Expat and Legal Consultant',
  description:
    'UAE expat and legal consultant who researches UAE divorce and family law in plain English and works with independent UAE-licensed lawyers who review the content. Not a practising lawyer.',
  url: 'https://divorceu.ae/en/author/aleksi-suoninen/',
  worksFor: {
    '@type': 'Organization',
    name: 'Divorce UAE',
    url: 'https://divorceu.ae',
  },
  knowsAbout: [
    'UAE divorce law',
    'UAE personal status law',
    'child custody UAE',
    'expat divorce UAE',
  ],
};

const faqItems = [
  {
    question: 'Is Aleksi Suoninen a lawyer?',
    answer:
      'No. Aleksi is a UAE expat and legal consultant who researches and writes about UAE family law in plain English. He is not a practising lawyer and does not represent clients. Independent UAE-licensed lawyers review the guidance for accuracy, and the content is general information, not legal advice.',
  },
  {
    question: 'How is the content on this site kept accurate?',
    answer:
      'Every guide is researched against primary UAE legal sources, including Federal Decree-Law No. 41 of 2024 for Muslim personal status and Federal Decree-Law No. 41 of 2022 for non-Muslim civil divorce. Independent UAE-licensed lawyers review the material, and pages are updated when the law changes.',
  },
  {
    question: 'Can Aleksi give me legal advice on my divorce?',
    answer:
      'No. The articles here are general information for expats and residents, not advice on your specific case. For advice you can rely on, speak to a licensed UAE family lawyer. You can request a free consultation through the form on this page.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  dir="ltr"
  hreflang={hreflang}
  schema={schema}
>
  <header class="hero">
    <div class="container hero__inner">
      <div class="hero__content">
        <Breadcrumb items={breadcrumbs} lang="en" />
        <h1 class="hero__h1">Aleksi Suoninen</h1>
        <p class="byline">UAE Expat and Legal Consultant</p>
        <p class="hero__sub">
          Aleksi is a long-term UAE expat who researches and writes about divorce and family law in
          plain English for other expats and residents. He is not a lawyer. His work pairs a lived
          expat perspective with careful research against primary UAE legal sources, checked by
          independent UAE-licensed lawyers before it goes live.
        </p>
        <ul class="hero__trust">
          <li>✓ Long-term UAE resident</li>
          <li>✓ Research against primary sources</li>
          <li>✓ Reviewed by licensed UAE lawyers</li>
          <li>✓ General information, not legal advice</li>
        </ul>
      </div>
      <div class="hero__form">
        <LeadForm lang="en" variant="hero" heading="Free Divorce Consultation" />
      </div>
    </div>
  </header>

  <main class="container main-content">

    <section class="section" aria-labelledby="who-heading">
      <h2 id="who-heading">Who Aleksi Is</h2>
      <p>
        Aleksi Suoninen is a UAE expat who has spent years living in the Emirates and reading through
        how the country family-law system actually works for foreigners. He is not a practising
        lawyer, and he does not represent anyone in court. What he brings instead is the perspective
        of someone who has been through the paperwork, the courts and the residency rules as a
        resident, and who now writes about all of it in plain English so other expats do not have to
        start from zero.
      </p>
      <p>
        Divorce and family matters in the UAE sit under two parallel legal tracks, and the rules
        changed significantly in 2025. Most people arriving at this site are confused about which
        law applies to them, what a case will cost, and how long it takes. Aleksi role is to turn
        the statutes and the court procedure into guidance a non-lawyer can follow, then hand the
        specifics of any individual case to a licensed professional. You can read more about the
        wider team and mission on our <a href="/en/about/">about page</a>.
      </p>
      <div class="info-box info-box--gold" style="margin-top:8px;">
        <h3>Being clear about what this is</h3>
        <p>
          Aleksi is a researcher and writer, not an attorney. Nothing on this site is legal advice
          for your situation, and reading it does not create a lawyer-client relationship. For advice
          you can act on, you need a licensed UAE family lawyer, and this site can connect you with
          one.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="value-heading">
      <h2 id="value-heading">Why the Expat Perspective Matters</h2>
      <p>
        Much of the divorce information aimed at UAE residents is written either as dense legal text
        or as marketing for a single law firm. Neither is much help when you are trying to work out
        your own next step. Aleksi writes from the middle ground: close enough to the law to get the
        details right, but from the point of view of an expat who has to deal with visas, sponsorship,
        custody across borders and the practical cost of it all.
      </p>
      <p>
        That perspective shapes the questions the guides answer. What happens to a spouse-sponsored
        visa after a decree. Whether you can file if you have only been in the country a short while.
        How a UAE decree is recognised back home. These are the things residents actually ask, and
        they are the things a purely academic summary of the law tends to skip.
      </p>
    </section>

    <section class="section" aria-labelledby="topics-heading">
      <h2 id="topics-heading">What Aleksi Writes About</h2>
      <p>
        His writing covers the parts of UAE family law that matter most to expats and residents going
        through a separation. The main areas are:
      </p>
      <div class="cards">
        <div class="card">
          <h3>UAE personal status law</h3>
          <p>How the Muslim and civil tracks work and which one applies to you.</p>
          <a href="/en/uae-divorce-law/" class="card-link">UAE divorce law →</a>
        </div>
        <div class="card">
          <h3>Expat divorce</h3>
          <p>The civil, no-fault route for non-Muslims and the court process behind it.</p>
          <a href="/en/divorce-in-uae/" class="card-link">Divorce in the UAE →</a>
        </div>
        <div class="card">
          <h3>Child custody</h3>
          <p>Custody age changes under the 2024 law and how the courts decide.</p>
          <a href="/en/child-custody-uae/" class="card-link">Child custody UAE →</a>
        </div>
        <div class="card">
          <h3>Alimony and costs</h3>
          <p>Maintenance, spousal support and the indicative cost of a case.</p>
          <a href="/en/alimony-uae/" class="card-link">Alimony in the UAE →</a>
        </div>
      </div>
      <p style="margin-top:24px;">
        Cost is a recurring worry for readers, so the site keeps a dedicated
        <a href="/en/divorce-cost-uae/">cost of divorce guide</a> with indicative fee ranges drawn
        from law-firm cost tables rather than guesswork.
      </p>
    </section>

    <section class="section" aria-labelledby="editorial-heading">
      <h2 id="editorial-heading">How the Content Stays Accurate</h2>
      <p>
        UAE family law is not static, and getting it wrong on a legal site can genuinely hurt someone.
        So the editorial approach is deliberately careful. Every guide is built from primary UAE legal
        sources first, then reviewed by independent UAE-licensed lawyers before publication, then
        updated whenever the underlying law moves.
      </p>
      <div class="two-col">
        <div class="info-box info-box--blue">
          <h3>Grounded in the statutes</h3>
          <p>
            Muslim personal status now follows Federal Decree-Law No. 41 of 2024, in force since 15
            April 2025. Non-Muslim expats fall under Federal Decree-Law No. 41 of 2022. Guides cite
            these laws directly rather than repeating second-hand summaries.
          </p>
        </div>
        <div class="info-box info-box--gold">
          <h3>Reviewed and updated</h3>
          <p>
            Licensed UAE lawyers review the guidance for accuracy, and where a figure comes from
            law-firm estimates rather than an official source, it is flagged as indicative. When the
            law changes, the affected pages are revised.
          </p>
        </div>
      </div>
      <p style="margin-top:8px;">
        This matters because the 2024 law changed real things: it shortened the reconciliation window,
        extended custody to age 18 for boys and girls, and changed how repeated talaq is counted.
        Guidance written before those changes is simply wrong now, which is why keeping pages current
        is treated as part of the job, not an afterthought.
      </p>
    </section>

    <section class="section" aria-labelledby="help-heading">
      <h2 id="help-heading">How to Get Help</h2>
      <p>
        The guides on this site are here to help you understand your options before you spend money on
        a lawyer. They are not a substitute for advice on your own case. If you are facing a divorce or
        a custody question in the UAE, the right next step is a conversation with a licensed UAE family
        lawyer who can look at your specific facts.
      </p>
      <p>
        You can request a free, confidential consultation using the form below, and the site will
        connect you with a qualified lawyer. In the meantime, a good place to start reading is the
        overview of <a href="/en/divorce-in-uae/">divorce in the UAE</a>.
      </p>
      <div class="cta-inline">
        <p>Ready to talk to a lawyer?</p>
        <a href="#contact" class="btn btn--primary">Get a Free Consultation</a>
      </div>
    </section>

    <FAQSection items={faqItems} lang="en" />

    <section class="section section--cta" aria-labelledby="bottom-cta-heading" id="contact">
      <h2 id="bottom-cta-heading">Speak to a Licensed UAE Family Lawyer</h2>
      <p>Request a free consultation and a qualified UAE family lawyer will get back to you within 24 hours. Completely confidential. English and Arabic support.</p>
      <LeadForm lang="en" variant="inline" />
    </section>

  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <p>&copy; 2026 DivorceU.AE, a legal referral service. Not a law firm. Information provided is for guidance only and does not constitute legal advice.</p>
      <nav aria-label="Footer navigation">
        <a href="/en/privacy-policy/">Privacy Policy</a>
        <a href="/en/disclaimer/">Disclaimer</a>
        <a href="/ar/">العربية</a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .hero { background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%); color: #fff; padding: 80px 0 60px; }
  .hero__inner { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
  .hero__h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; line-height: 1.2; margin-bottom: 16px; }
  .byline { font-size: 0.85rem; opacity: 0.8; margin-bottom: 20px; }
  .hero__sub { font-size: 1.05rem; opacity: 0.9; margin-bottom: 24px; line-height: 1.7; }
  .hero__sub a { color: #fff; text-decoration: underline; }
  .hero__trust { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 0.9rem; }
  .hero__trust li { opacity: 0.9; }

  .section { padding: 60px 0; border-bottom: 1px solid #f3f4f6; }
  .section h2 { font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 700; color: #1e3a5f; margin-bottom: 20px; }
  .section h3 { font-size: 1.1rem; font-weight: 700; color: #1e3a5f; margin: 24px 0 10px; }
  .section p { color: #374151; line-height: 1.8; margin-bottom: 16px; }
  .section p a { color: #2563eb; text-decoration: none; font-weight: 600; }
  .section p a:hover { text-decoration: underline; }
  .section--cta { border-bottom: none; background: #f0f4ff; border-radius: 16px; padding: 60px 40px; margin-bottom: 60px; text-align: center; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; margin-bottom: 8px; }
  .info-box { padding: 24px; border-radius: 12px; }
  .info-box--blue { background: #eff6ff; border: 2px solid #2563eb; }
  .info-box--gold { background: #fffbeb; border: 2px solid #c9a84c; }
  .info-box h3 { font-size: 1rem; font-weight: 700; color: #1e3a5f; margin-bottom: 8px; }
  .info-box p { font-size: 0.9rem; color: #374151; margin: 0; }
  .info-box p a { color: #2563eb; text-decoration: none; font-weight: 600; }
  .info-box p a:hover { text-decoration: underline; }

  .cta-inline { display: flex; align-items: center; gap: 20px; margin-top: 28px; flex-wrap: wrap; }
  .cta-inline p { margin: 0; font-weight: 600; }
  .btn--primary { display: inline-block; padding: 12px 28px; background: #c9a84c; color: #fff; border-radius: 8px; text-decoration: none; font-weight: 700; transition: background 0.2s; }
  .btn--primary:hover { background: #b8942d; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 24px; }
  .card { padding: 24px; background: #f8faff; border: 1.5px solid #e5e7eb; border-radius: 12px; }
  .card h3 { font-size: 0.95rem; font-weight: 700; color: #1e3a5f; margin-bottom: 8px; }
  .card p { font-size: 0.875rem; color: #6b7280; margin: 0 0 10px; }
  .card-link { font-size: 0.875rem; color: #2563eb; text-decoration: none; font-weight: 600; }
  .card-link:hover { text-decoration: underline; }

  .footer { background: #1e3a5f; color: rgba(255,255,255,0.7); padding: 40px 0; }
  .footer__inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
  .footer p { font-size: 0.85rem; margin: 0; }
  .footer nav { display: flex; gap: 20px; }
  .footer nav a { color: rgba(255,255,255,0.7); text-decoration: none; font-size: 0.85rem; }
  .footer nav a:hover { color: #fff; }
  .main-content { padding-top: 20px; }

  @media (max-width: 768px) {
    .hero__inner { grid-template-columns: 1fr; gap: 40px; }
    .hero { padding: 50px 0 40px; }
    .two-col { grid-template-columns: 1fr; }
    .section--cta { padding: 40px 24px; }
    .footer__inner { flex-direction: column; text-align: center; }
  }
</style>
