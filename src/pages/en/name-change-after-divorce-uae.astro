---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'Name Change After Divorce UAE: Step-by-Step Guide 2025';
const description =
  'How to revert to your maiden name after divorce in UAE. Complete step-by-step guide: Emirates ID, passport, driving licence, Ejari, bank accounts, employer records. Fees, timelines, and what happens with children\'s names.';

const hreflang = {
  en: 'https://divorceu.ae/en/name-change-after-divorce-uae/',
  ar: 'https://divorceu.ae/ar/الطلاق-للمغتربين-في-الامارات/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'Name Change After Divorce UAE', url: 'https://divorceu.ae/en/name-change-after-divorce-uae/' },
];

const faqSchema = {
