---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'Selling Property During Divorce UAE: Your Full Legal Guide';
const description =
  'Can your spouse sell your Dubai home without you? How do you force a sale if they refuse? Complete guide covering DLD freeze orders, the pre-divorce transfer strategy, forced partition, mortgage consent, and DLD fees.';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-property-sale-uae/',
  ar: 'https://divorceu.ae/ar/الطلاق-وتأشيرة-الإقامة-في-الامارات/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'Divorce Property Sale UAE', url: 'https://divorceu.ae/en/divorce-property-sale-uae/' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can my spouse sell our Dubai property without my consent?',
