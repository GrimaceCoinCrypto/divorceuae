import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'Absent Husband Divorce UAE: How to Divorce When He Has Disappeared or Is Abroad';
const description =
  'Your husband abandoned you, disappeared, or refuses to cooperate from abroad. UAE law gives you a path to divorce, without his cooperation. Complete guide to Article 79 absence divorce, financial abandonment, service of process abroad, and your rights.';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-absent-husband-uae/',
  ar: 'https://divorceu.ae/ar/الطلاق-بسبب-غياب-الزوج-الامارات/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'Divorce Absent Husband UAE', url: 'https://divorceu.ae/en/divorce-absent-husband-uae/' },
];

const faqSchema = {
