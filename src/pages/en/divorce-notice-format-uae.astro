const petitionContents = [
  { no: '1', item: 'Full legal name of both parties', detail: 'As appearing on Emirates IDs or passports. Must match court records.' },
  { no: '2', item: 'Emirates ID numbers of both parties', detail: 'Required for both petitioner and respondent. If respondent is non-resident, passport number.' },
  { no: '3', item: 'Marriage certificate details', detail: 'Date of marriage, place, registration number, issuing authority.' },
  { no: '4', item: 'Current residential addresses', detail: 'Both parties\' current addresses in UAE or abroad.' },
  { no: '5', item: 'Children\'s details', detail: 'Full name, date of birth, nationality, and passport number of each child.' },
  { no: '6', item: 'Brief summary of property and assets', detail: 'Only required where financial claims are included in the petition.' },
  { no: '7', item: 'Relief sought', detail: 'Divorce decree, custody arrangement, maintenance, mahr, property orders -- specify each.' },
  { no: '8', item: 'Legal basis for divorce', detail: 'Talaq (husband\'s pronouncement), khula (wife\'s redemption divorce), no-fault (non-Muslim track), or tatliq (judicial divorce).' },
