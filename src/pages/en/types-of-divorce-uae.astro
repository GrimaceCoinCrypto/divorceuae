---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'Types of Divorce in UAE 2026: Islamic Law and UAE Personal Status Code';
const description =
  'UAE recognises six types of divorce: revocable, irrevocable (minor and major), khul\'a, judicial separation, and bid\'i divorce. Learn what each means for your rights, remarriage, and the divorce process.';

const hreflang = {
  en: 'https://divorceu.ae/en/types-of-divorce-uae/',
  ar: 'https://divorceu.ae/ar/انواع-الطلاق/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'Types of Divorce UAE' },
];

const divorceTypes = [
  {
    name: 'Revocable Divorce (Talaq Raj\'i)',
    arabic: 'الطلاق الرجعي',
    tag: 'First or second pronouncement',
    desc: 'The husband pronounces divorce once or twice in a marriage where intercourse or valid seclusion took place. During the waiting period (iddah: three periods of purity, or three lunar months for a woman who does not menstruate), he retains the right to take his wife back without a new contract or the wife’s consent.',
    keyPoints: [
      'The marriage contract continues until the iddah expires',
      'Husband can take her back by an explicit spoken or written statement, or by action',
      'If iddah ends without a take back, it converts to Minor Irrevocable Divorce',
      'Wife is entitled to maintenance and to live in the marital home throughout the iddah',
    ],
    uaeLaw: 'Federal Decree-Law No. 41 of 2024 (which replaced Law No. 28 of 2005), Articles 59 to 62 and 101: a first or second divorce after intercourse or seclusion is revocable; a divorce before intercourse or seclusion is minor irrevocable (Article 60).',
  },
  {
    name: 'Minor Irrevocable Divorce (Ba\'in Sughra)',
    arabic: 'الطلاق البائن بينونة صغرى',
    tag: 'After iddah expires, or khul\'a',
    desc: 'A revocable divorce whose iddah expired without the husband taking his wife back, a divorce before intercourse or valid seclusion, or a divorce obtained through khul\'a (wife-initiated). The parties may remarry with a new marriage contract and new mahr.',
    keyPoints: [
      'Requires a new marriage contract and mahr to remarry',
      'Covers the first and second pronouncements after iddah ends',
      'Includes divorce before intercourse or valid seclusion (no iddah in this case, and half the named dowry)',
      'Includes khul\'a (the wife gives a consideration, often the mahr, in exchange for release)',
    ],
    uaeLaw: 'Articles 59(2)(a), 60(2) and 65 of Federal Decree-Law No. 41 of 2024: a first or second divorce not followed by a take back during the iddah, a divorce before intercourse or seclusion, and khul\'a are minor irrevocable. No iddah applies after a divorce before intercourse or seclusion (Article 82), and the wife takes half the named dowry (Article 47(3)).',
  },
  {
    name: 'Major Irrevocable Divorce (Ba\'in Kubra)',
    arabic: 'الطلاق البائن بينونة كبرى',
    tag: 'Third pronouncement, final',
    desc: 'The divorce that completes three. The wife is forbidden from remarrying her former husband until she has married another man in a valid marriage, that marriage has been consummated, it has ended, and her iddah from him has finished.',
    keyPoints: [
      'Absolutely final, no revocation or remarriage without intervening marriage',
      'A pre-arranged \'tahlil\' marriage made only to permit remarriage is widely condemned by Islamic scholars',
      'Three pronouncements in a single sitting count as ONE under Article 57',
      'Deferred mahr falls due and she may live in the marital home during the iddah; iddah maintenance is due only if she is pregnant, until birth',
    ],
    uaeLaw: 'Article 59(2)(b) of Federal Decree-Law No. 41 of 2024: the divorce that completes three is major irrevocable. Article 57: a repeated divorce, or a divorce coupled with a number, verbally, in writing or by signal, counts as one. Articles 46 and 101 govern the dowry and iddah maintenance.',
  },
  {
    name: "Khul'a (Wife-Initiated Divorce)",
    arabic: 'الخلع',
    tag: 'Wife\'s right',
    desc: 'A wife may request a divorce in exchange for a consideration, most often the mahr (dower). If the husband stubbornly refuses, the Personal Status Court can order the khul\'a for an appropriate consideration.',
    keyPoints: [
      'The consideration can be any property; where it is the mahr, returning what she received is enough and the rest is dropped',
      'Court-ordered khul\'a is available if the husband stubbornly refuses',
      'Counts as Ba\'in Sughra, new contract required to remarry',
      'The normal iddah rules apply; there is no iddah maintenance after khul\'a, but she may live in the marital home during the iddah',
    ],
    uaeLaw: 'Articles 65 to 68 of Federal Decree-Law No. 41 of 2024 govern khul\'a. It cannot waive the children\'s rights, maintenance or custody (Article 66), and the spouses must document it at court within 15 days (Article 68). Iddah maintenance: Article 101.',
  },
  {
    name: 'Judicial Separation (Faskh / Tatliq)',
    arabic: 'التفريق القضائي',
    tag: 'Court-ordered',
    desc: 'A judge dissolves the marriage on application when specific legal grounds are met: harm, desertion, failure to provide maintenance, absence or imprisonment, addiction, or a serious defect or disease.',
    keyPoints: [
      'Wife can petition on grounds of harm, desertion, non-maintenance, absence, imprisonment or addiction',
      'Either spouse can ask for revocation for a serious defect or disease (Article 69)',
      'Court investigates the claim before granting the separation',
      'Treated as Ba\'in Sughra, a new contract is required to remarry',
    ],
    uaeLaw: 'Articles 69 to 80 of Federal Decree-Law No. 41 of 2024 list the grounds for revocation and judicial separation. In contested discord cases the court can appoint arbitrators (Articles 72 to 74).',
  },
  {
    name: "Bid'i Divorce (Forbidden Innovation)",
    arabic: 'الطلاق البدعي',
    tag: 'Prohibited, but valid in UAE',
    desc: 'A divorce pronounced in a way that violates Islamic law, most commonly: divorce during menstruation or postnatal bleeding, or three pronouncements in a single session. It is sinful but takes legal effect under most classical and UAE law interpretations.',
    keyPoints: [
      'Divorce during menstruation: sinful, but it is not among the cases in Article 56 where a divorce does not occur',
      'Three pronouncements in one session: sinful, but Article 57 treats this as a single divorce',
      'By contrast, a divorce does not occur at all under duress, in anger so intense it prevents control of one\'s words, or when insane or intoxicated (Article 56)',
      'If in doubt whether your divorce falls into this category, consult a UAE personal status lawyer immediately',
    ],
    uaeLaw: 'Article 57 of Federal Decree-Law No. 41 of 2024: three-in-one counts as one divorce. The classical majority of the four Sunni schools counted three as three; the one-count view is associated with Ibn Taymiyya and Ibn al-Qayyim.',
  },
];

const faqItems = [
  {
    question: 'What type of divorce is most common in UAE for expats?',
    answer: 'Most expat divorces in the UAE proceed as either mutual consent divorce (which ends as a Ba\'in Sughra after the judge ratifies the agreement) or as contested divorce through the Personal Status Court. Non-Muslim expats may apply their home country\'s law in some circumstances, particularly for property and financial matters. A UAE divorce lawyer can advise on which route applies to your situation.',
  },
  {
    question: 'Does UAE law recognise three divorces in one session as final?',
    answer: 'No. Article 57 of Federal Decree-Law No. 41 of 2024 counts a repeated divorce, or a divorce coupled with a number, verbally, in writing or by signal, as a single divorce. So "You are divorced three times" counts as one divorce, which is revocable if it is the first or second in a marriage where intercourse or valid seclusion took place. This is a significant departure from the classical majority view and is one of the most practically important distinctions in UAE divorce law.',
  },
  {
    question: 'Can a wife initiate divorce in the UAE?',
    answer: 'Yes. A wife has two main routes. First, khul\'a: she requests divorce in exchange for returning the mahr, the husband may agree or the court can order it over his refusal. Second, judicial separation (tatliq / faskh): she petitions the court on specific grounds such as harm, desertion, failure to maintain, or the husband\'s long absence. Both routes are well-established in UAE law.',
  },
  {
    question: 'What is the difference between khul\'a and tatliq (judicial separation)?',
    answer: 'Khul\'a is a wife-initiated divorce involving financial compensation (return of mahr). The wife does not need to prove fault, she simply needs to establish that she cannot continue the marriage. Tatliq (judicial separation) is fault-based: the wife must prove a specific legal ground (harm, desertion, non-maintenance, etc.) to the court. Khul\'a is generally faster; tatliq allows the wife to retain the mahr if the court finds the husband at fault.',
  },
  {
    question: 'How many divorces are allowed before the marriage is permanently over?',
    answer: 'A husband has three divorces. After a first or second talaq he can take his wife back during the iddah (Article 61), and that talaq still counts towards the three; once the iddah has ended without a take back, they can reunite only with a new contract and a new dowry (Article 59). The divorce that completes three is the Ba\'in Kubra, final unless the wife marries another man in a valid marriage, that marriage is consummated, it ends, and her iddah from him has finished. Under Article 57, three pronouncements in one session count as only one divorce, so the count builds only across separate divorces.',
  },
  {
    question: 'Does UAE divorce type affect alimony and mahr rights?',
    answer: 'Yes, significantly. Under Article 101 of Federal Decree-Law No. 41 of 2024: in a revocable divorce the wife is entitled to maintenance during the iddah. After an irrevocable divorce, whether Ba\'in Sughra or Ba\'in Kubra, iddah maintenance is due only if she is pregnant, until the birth. After khul\'a there is no iddah maintenance. In every case she may live in the marital home during the iddah. The dowry falls due on irrevocable separation (Article 46); in khul\'a it is usually the consideration she gives up. In judicial separation for the husband\'s fault: the wife retains the full mahr. Always get specific advice on the financial implications for your type of divorce.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical="https://divorceu.ae/en/types-of-divorce-uae/"
  lang="en"
  hreflang={hreflang}
>
  <Breadcrumb items={breadcrumbs} />

  <section class="hero-section">
    <div class="container">
      <p class="overline">UAE Divorce Law Guide · 2025</p>
      <h1>Types of Divorce in UAE, Islamic Law and the Personal Status Code</h1>
      <p class="hero-sub">UAE divorce law recognises six distinct types of divorce, each with different rules for revocation, remarriage, and financial rights. Knowing which type applies to your situation determines your rights from day one.</p>
      <div class="hero-meta">
        <span>Updated: October 2026</span>
        <span class="sep">·</span>
        <span>By Aleksi Suon, UAE Expat &amp; Legal Consultant</span>
      </div>
    </div>
  </section>

  <main class="main-content">
    <div class="container">

      <div class="key-point">
        <h2>The Single Most Important UAE Rule</h2>
        <p>Under Article 57 of the <strong>UAE Personal Status Law</strong> (Federal Decree-Law No. 41 of 2024), pronouncing divorce three times in one session counts as only <strong>one divorce</strong>, not three, and a first or second divorce after consummation can be taken back during the iddah. This departs from the classical majority Islamic opinion and is one of the most practically significant rules in UAE personal status law. Many couples do not realise this until it is too late to act on it correctly.</p>
        <p>For a full breakdown of how the 2024 law changed the Islamic divorce framework for Muslims in UAE, see our guide on <a href="/en/sharia-divorce-uae/">Sharia divorce in UAE</a>. For the specific rules on talaq, including registration deadlines and digital/WhatsApp validity, see our dedicated <a href="/en/talaq-uae/">talaq in UAE guide</a> and the closely related question of whether a <a href="/en/whatsapp-divorce-uae/">WhatsApp divorce</a> is legally recognised.</p>
      </div>

      <section class="content-section">
        <h2>The Six Types of Divorce Explained</h2>

        {divorceTypes.map((type, i) => (
          <div class="type-card">
            <div class="type-header">
              <div class="type-num">{i + 1}</div>
              <div class="type-titles">
                <h3>{type.name}</h3>
                <span class="type-arabic">{type.arabic}</span>
              </div>
              <span class="type-tag">{type.tag}</span>
            </div>
            <p class="type-desc">{type.desc}</p>
            <ul class="type-points">
              {type.keyPoints.map(pt => (
                <li>{pt}</li>
              ))}
            </ul>
            <div class="type-law">
              <span class="law-label">UAE Law:</span> {type.uaeLaw}
            </div>
          </div>
        ))}
      </section>

      <section class="content-section">
        <h2>Quick Comparison Table</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Type</th>
                <th>Who initiates</th>
                <th>Revocable?</th>
                <th>New contract to remarry?</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Revocable (1st or 2nd)</td><td>Husband</td><td>Yes, during iddah</td><td>No</td></tr>
              <tr><td>Ba'in Sughra (after iddah, or before consummation)</td><td>Husband</td><td>No, new contract needed</td><td>Yes</td></tr>
              <tr><td>Ba'in Kubra (3rd divorce)</td><td>Husband</td><td>No, until intervening marriage</td><td>Yes (after 2nd marriage)</td></tr>
              <tr><td>Khul'a</td><td>Wife / Court</td><td>No</td><td>Yes</td></tr>
              <tr><td>Judicial Separation</td><td>Court</td><td>No</td><td>Yes</td></tr>
              <tr><td>Bid'i Divorce</td><td>Husband (prohibited)</td><td>Treated per actual count</td><td>Per actual count</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="content-section">
        <h2>Frequently Asked Questions</h2>
        <FAQSection items={faqItems} />
      </section>

      <div class="cta-box">
        <h2>Not Sure Which Type Applies to Your Situation?</h2>
        <p>The type of divorce affects your alimony rights, mahr entitlements, custody standing, and visa status. Get a clear answer from a UAE personal status lawyer before any step is taken.</p>
        <LeadForm source="types-of-divorce-uae" />
      </div>

      <section class="related-section">
        <h2>Related Guides</h2>
        <div class="related-grid">
          <a href="/en/annulment-vs-divorce-uae/" class="related-card">
            <strong>Annulment vs Divorce in UAE</strong>
            <span>When a marriage can be annulled instead</span>
          </a>
          <a href="/en/legal-separation-uae/" class="related-card">
            <strong>Legal Separation in UAE</strong>
            <span>Is separation without divorce possible here</span>
          </a>
          {[
            { title: 'New UAE Personal Status Law 2025', href: '/en/new-uae-personal-status-law-2025/', desc: 'What Federal Decree-Law 41 of 2024 changed for divorce, custody and maintenance.' },
            { title: 'UAE Divorce Law', href: '/en/uae-divorce-law/', desc: 'Full overview of the 2024 Personal Status Law and the 2022 civil law.' },
            { title: "Khul'a Divorce UAE", href: '/en/khula-divorce-uae/', desc: "Complete guide to wife-initiated divorce and mahr return." },
            { title: 'Divorce for Harm UAE', href: '/en/divorce-for-harm-uae/', desc: 'Grounds, evidence, and process for tatliq lil-darar.' },
            { title: 'Iddah Waiting Period UAE', href: '/en/iddah-waiting-period-uae/', desc: 'Duration, rights, and obligations during the waiting period.' },
            { title: 'Alimony in UAE', href: '/en/alimony-uae/', desc: 'All six types of spousal support and how they are calculated.' },
            { title: 'Talaq in UAE', href: '/en/talaq-uae/', desc: 'How UAE courts register, revoke, and enforce talaq.' },
            { title: 'Sharia Divorce UAE', href: '/en/sharia-divorce-uae/', desc: 'Federal Decree-Law No. 41 of 2024 explained in full.' },
            { title: 'WhatsApp Divorce UAE', href: '/en/whatsapp-divorce-uae/', desc: 'Is a talaq sent by message legally valid in the UAE?' },
          ].map(link => (
            <a href={link.href} class="related-card">
              <span class="related-title">{link.title} →</span>
              <span class="related-desc">{link.desc}</span>
            </a>
          ))}
        </div>
      </section>

    </div>
  </main>
</BaseLayout>

<style>
  .hero-section {
    background: linear-gradient(rgba(10,22,40,0.82), rgba(10,22,40,0.82)), url('/images/hero-dubai-office.webp') center/cover no-repeat;
    color: #fff;
    padding: 3.5rem 1.5rem;
  }
  .hero-section .container { max-width: 56rem; margin: 0 auto; }
  .overline { color: #c9a84c; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem; }
  h1 { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 800; line-height: 1.25; margin-bottom: 1rem; }
  .hero-sub { color: #b0bec5; font-size: 1.05rem; line-height: 1.7; }
  .hero-meta { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.85rem; color: #7a8fa6; }
  .sep { opacity: 0.4; }

  .main-content { padding: 3rem 1.5rem; }
  .container { max-width: 56rem; margin: 0 auto; }
  .content-section { margin-bottom: 3.5rem; }
  .content-section h2 { font-size: 1.5rem; font-weight: 800; color: #0a1628; margin-bottom: 1rem; }
  .content-section p { color: #445; line-height: 1.75; margin-bottom: 1rem; }

  .key-point { background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 0.875rem; padding: 1.4rem; margin-bottom: 3rem; }
  .key-point h2 { font-size: 1.05rem; font-weight: 800; color: #064e3b; margin-bottom: 0.6rem; }
  .key-point p { font-size: 0.9rem; color: #1a4d30; line-height: 1.75; margin-bottom: 0; }
  .key-point strong { color: #064e3b; }

  /* Type cards */
  .type-card { background: #f8f9fa; border: 1px solid #e0e4ea; border-radius: 0.875rem; padding: 1.4rem; margin-bottom: 1.25rem; }
  .type-header { display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 0.875rem; flex-wrap: wrap; }
  .type-num { width: 36px; height: 36px; min-width: 36px; background: #0a1628; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1rem; flex-shrink: 0; }
  .type-titles { flex: 1; }
  .type-titles h3 { font-size: 1.05rem; font-weight: 800; color: #0a1628; margin: 0 0 3px; }
  .type-arabic { font-size: 0.85rem; color: #667; }
  .type-tag { font-size: 0.7rem; font-weight: 700; background: #c9a84c; color: #fff; padding: 3px 10px; border-radius: 999px; white-space: nowrap; align-self: flex-start; }
  .type-desc { font-size: 0.9rem; color: #334; line-height: 1.75; margin-bottom: 0.75rem; }
  .type-points { list-style: none; padding: 0; margin: 0 0 0.875rem; display: flex; flex-direction: column; gap: 5px; }
  .type-points li { font-size: 0.84rem; color: #445; padding-left: 1rem; position: relative; line-height: 1.6; }
  .type-points li::before { content: '•'; position: absolute; left: 0; color: #c9a84c; font-weight: 700; }
  .type-law { font-size: 0.8rem; color: #556; background: #eef4ff; border-radius: 6px; padding: 8px 12px; line-height: 1.6; }
  .law-label { font-weight: 700; color: #0a1628; margin-left: 4px; }

  /* Table */
  .table-wrap { overflow-x: auto; margin-top: 1rem; }
  .table-wrap table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .table-wrap th { background: #0a1628; color: #fff; padding: 10px 14px; text-align: left; }
  .table-wrap td { padding: 9px 14px; border-bottom: 1px solid #e5e7eb; color: #334; }
  .table-wrap tr:nth-child(even) td { background: #f8f9fa; }

  .cta-box { background: #0a1628; color: #fff; border-radius: 1rem; padding: 2rem; margin-bottom: 3rem; }
  .cta-box h2 { font-size: 1.3rem; font-weight: 800; margin-bottom: 0.5rem; }
  .cta-box p { color: #b0bec5; font-size: 0.92rem; line-height: 1.65; margin-bottom: 1.5rem; }

  .related-section h2 { font-size: 1.3rem; font-weight: 800; color: #0a1628; margin-bottom: 1rem; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.875rem; }
  .related-card { display: flex; flex-direction: column; gap: 0.35rem; background: #f8f9fa; border: 1px solid #e0e4ea; border-radius: 0.75rem; padding: 1rem 1.25rem; text-decoration: none; transition: border-color 0.2s; }
  .related-card:hover { border-color: #c9a84c; }
  .related-title { font-weight: 700; color: #0a1628; font-size: 0.9rem; }
  .related-desc { font-size: 0.8rem; color: #778; }

  @media (max-width: 640px) {
    .type-header { flex-wrap: wrap; }
    .type-tag { align-self: auto; }
  }
</style>
