---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LeadForm from '../../components/ui/LeadForm.astro';
import FAQSection from '../../components/ui/FAQSection.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';

const title = 'UAE Divorce Certificate Attestation: How to Get and Legalise Your Divorce Document';
const description =
  'The UAE does not issue apostilles. A UAE divorce judgment is used abroad through attestation: a certified copy from the issuing court, MOFA attestation, embassy legalisation where the destination country requires it, and a certified translation. Includes UK, India and Pakistan notes and the reverse chain for foreign documents used in the UAE.';

const hreflang = {
  en: 'https://divorceu.ae/en/divorce-certificate-attestation-uae/',
  ar: 'https://divorceu.ae/ar/تصديق-وثيقة-الطلاق-في-الامارات/',
};

const breadcrumbs = [
  { name: 'Home', url: 'https://divorceu.ae/en/' },
  { name: 'UAE Divorce Certificate Attestation', url: 'https://divorceu.ae/en/divorce-certificate-attestation-uae/' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How do I get my UAE divorce certificate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The official divorce document in the UAE is the court judgment (hukm) or the divorce certificate issued by the court. Obtain a certified copy from the registry of the court that issued it: in Dubai, the Dubai Courts Personal Status Court; in Abu Dhabi, the Abu Dhabi Judicial Department (ADJD); in the northern emirates, the relevant federal court. Bring your passport, Emirates ID if you have one, and the case number. The registry fee and waiting time are small (indicative: AED 50 to 100 and 1 to 3 working days) but vary by court. This certified copy is the starting point for attestation.',
      },
    },
    {
      '@type': 'Question',
      name: 'How long does attestation take in the UAE?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The court copy usually takes a few working days. For the Ministry of Foreign Affairs (MOFA) step, MOFA states that digital attestation of an original digital document is completed within hours during working hours, and the courier route takes 1 to 3 business days depending on the courier option. If the destination country also wants its embassy or consulate in the UAE to legalise the document, add that mission’s own processing time, which varies widely. Treat all timings as indicative and check current figures before you plan around a deadline.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I get an apostille on my UAE divorce certificate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The UAE is not a party to the Hague Apostille Convention, so no UAE authority issues apostilles. A UAE divorce document is instead attested by the UAE Ministry of Foreign Affairs (MOFA) and, where the destination country requires it, legalised by that country’s embassy or consulate in the UAE. This applies even if the destination country is itself an apostille country, such as the UK, India or Pakistan, because an apostille only works when both the issuing and the receiving country are parties to the Convention.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I use my UAE divorce certificate in the UK?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Get a certified copy of the judgment from the UAE court, have it attested by MOFA, and obtain a certified English translation. Each UK body decides what it accepts, so ask it first. If you want to remarry in England or Wales, the register office checks overseas divorce documents when you give notice and may refer them to the General Register Office, which carries a fee. Whether the UAE divorce is legally recognised in the UK is a separate question under Part II of the Family Law Act 1986.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I use my UAE divorce certificate in India?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'India is a party to the Apostille Convention, but that does not help with a UAE document because the UAE is not. The usual route is a certified court copy, MOFA attestation, an English translation if the judgment is in Arabic, and, where the Indian authority asks for it, attestation by the Embassy of India in Abu Dhabi or the Consulate General of India in Dubai. Registrars and banks in India differ, so confirm with the office that will receive the document before you start.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I use my UAE divorce certificate in Pakistan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The usual route is a certified court copy, MOFA attestation, then attestation by the Embassy of Pakistan in Abu Dhabi or the Consulate General of Pakistan in Dubai. You then take the attested document to NADRA to update your record; some offices also ask for an Urdu or English translation. Pakistan joined the Apostille Convention in 2023, but that does not change the route for UAE documents because the UAE is not a party. Check the mission’s current appointment system and fees before you go.',
      },
    },
    {
      '@type': 'Question',
      name: 'What if I did not go to court, can I still get a divorce document for a talaq?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A talaq pronounced outside court has no attestable document until it is documented by the court. Under the 2024 Personal Status Law (Federal Decree-Law No. 41 of 2024), the husband must document the talaq before the competent court within 15 days, and the wife can also bring a claim to prove the divorce. Once the court has documented it, the court record can be certified and attested through the normal chain. Without court documentation, no attestable document exists.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where do I get a certified translation of my UAE divorce certificate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Inside the UAE, use a legal translator licensed by the UAE Ministry of Justice; the ministry publishes a directory of licensed translators. Some destination countries instead require a sworn or certified translator in that country (Germany is an example), so ask the receiving authority which it accepts before paying for a translation. Legal translation prices in the UAE vary by language and length (indicative: AED 150 to 400 per page).',
      },
    },
    {
      '@type': 'Question',
      name: 'What if my spouse has the original UAE divorce documents and will not share them?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You do not need the original. The UAE court registry holds the original judgment and issues certified copies to any party to the proceedings. Attend the court registry with your passport and Emirates ID (or a valid ID), provide the case number (or your full name and the approximate year of divorce), and request a certified copy. Both parties to a divorce are entitled to obtain certified copies from the court registry independently.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use the MOFA website for attestation?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. The UAE Ministry of Foreign Affairs (MOFA, formerly MOFAIC) runs its attestation service online at mofa.gov.ae and through its app. You sign in with UAE PASS, choose the attestation service and either upload an original digital document issued by the competent authority or send the paper document through an approved courier. MOFA publishes a fee of AED 150 for personal documents, plus a courier fee if you use that route; check the current figure when you apply. The attested document is returned digitally or by courier.',
      },
    },
    {
      '@type': 'Question',
      name: 'I need to use a UK or other foreign document in a UAE divorce. Does an apostille make it valid in the UAE?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No, not on its own. A foreign document such as a UK marriage certificate must first be authenticated in the country that issued it (for UK documents this is the FCDO legalisation, issued as an apostille certificate), then legalised by the UAE Embassy or consulate for that country, then attested by MOFA in the UAE, then translated into Arabic by a UAE-licensed legal translator. The UAE Embassy step is now largely digital; for UK documents, the UAE Embassy in London’s digital service covers the Embassy and MOFA attestation in one application.',
      },
    },
  ],
};

const faqItems = faqSchema.mainEntity.map((q) => ({
  question: q.name,
  answer: q.acceptedAnswer.text,
}));

const attestationChain = [
  {
    step: '01',
    title: 'Certified copy from the issuing court',
    where: 'Personal Status Court registry that issued the judgment (Dubai Courts, ADJD or the federal courts)',
    cost: 'Registry fee (indicative: AED 50 to 100)',
    time: 'Indicative: 1 to 3 working days',
    notes: 'The divorce judgment (hukm) or court divorce certificate. Either spouse can request it. MOFA only attests documents already certified by the UAE authority that issued them.',
  },
  {
    step: '02',
    title: 'MOFA attestation',
    where: 'UAE Ministry of Foreign Affairs, online at mofa.gov.ae or the MOFA app (UAE PASS login)',
    cost: 'AED 150 per personal document (MOFA published fee), plus courier fee if used',
    time: 'Digital route: within hours; courier route: 1 to 3 business days (MOFA figures)',
    notes: 'Confirms the court seal and signature. Some receiving authorities accept the document at this point; others want step 03 as well.',
  },
  {
    step: '03',
    title: 'Destination country embassy or consulate legalisation (if required)',
    where: 'The destination country’s embassy or consulate in the UAE',
    cost: 'Set by the embassy or consulate',
    time: 'Varies by mission',
    notes: 'Commonly asked for by Indian and Pakistani authorities, among others. UK authorities do not usually ask for it. Confirm with the receiving authority first.',
  },
  {
    step: '04',
    title: 'Certified translation',
    where: 'UAE Ministry of Justice-licensed legal translator, or a sworn translator in the destination country if its rules require one',
    cost: 'Indicative: AED 150 to 400 per page',
    time: 'Indicative: 1 to 2 working days',
    notes: 'Most UAE judgments are in Arabic. Some authorities want the translation attested too, in which case it goes through the chain alongside the judgment.',
  },
];

const countryGuide = [
  { country: 'United Kingdom', steps: 'Certified court copy + MOFA attestation + certified English translation', embassy: 'Not usually asked for; check with the UK body', note: 'The register office checks overseas divorce documents before you can remarry and may refer them to the General Register Office' },
  { country: 'India', steps: 'Certified court copy + MOFA attestation + English translation', embassy: 'Indian Embassy (Abu Dhabi) or Consulate General (Dubai) attestation often required', note: 'Check with the marriage registrar or other office that will receive it' },
  { country: 'Pakistan', steps: 'Certified court copy + MOFA attestation + Pakistan mission attestation', embassy: 'Embassy of Pakistan (Abu Dhabi) or Consulate General (Dubai)', note: 'Then update your record with NADRA' },
  { country: 'Philippines', steps: 'Certified court copy + MOFA attestation + English translation', embassy: 'Philippine Embassy or Consulate step may be asked for; check', note: 'Check PSA requirements' },
  { country: 'Russia', steps: 'Certified court copy + MOFA attestation + Russian translation', embassy: 'Russian consular legalisation may be asked for; check', note: 'Take the attested document to ZAGS for the civil registry update' },
  { country: 'USA', steps: 'Certified court copy + MOFA attestation + English translation', embassy: 'Not usually asked for; check with the agency', note: 'Record updates are handled by each state and agency' },
  { country: 'Australia', steps: 'Certified court copy + MOFA attestation + English translation', embassy: 'Not usually asked for; check with the agency', note: 'Check with the state or territory Births, Deaths and Marriages registry or the relevant agency' },
  { country: 'Germany', steps: 'Certified court copy + MOFA attestation + German translation by a sworn translator', embassy: 'German mission legalisation may be asked for; check with the Standesamt', note: 'Submit to the Standesamt for the civil registry update' },
];

const inboundChain = [
  {
    step: 'A',
    title: 'Authenticate the document in the issuing country',
    notes: 'Get a certified copy from the issuing authority, then the home-country authentication. For UK documents this is FCDO legalisation, which the FCDO issues as an apostille certificate; some documents need a UK solicitor or notary certification first. In other countries it is usually the foreign ministry’s legalisation.',
  },
  {
    step: 'B',
    title: 'UAE Embassy or consulate legalisation',
    notes: 'The UAE mission for the issuing country legalises the authenticated document. This is now largely digital: you apply through MOFA’s website with UAE PASS, choose the issuing country, and a courier collects and returns the original.',
  },
  {
    step: 'C',
    title: 'MOFA attestation in the UAE',
    notes: 'MOFA attests the document for use in the UAE. For UK documents, the UAE Embassy in London’s digital service returns a copy attested by both the Embassy and MOFA in one application, so no separate MOFA visit is needed.',
  },
  {
    step: 'D',
    title: 'Arabic legal translation',
    notes: 'UAE courts work in Arabic, so the attested document is translated into Arabic by a UAE Ministry of Justice-licensed legal translator.',
  },
];
---

<BaseLayout
  {title}
  {description}
  canonical="https://divorceu.ae/en/divorce-certificate-attestation-uae/"
  {hreflang}
  lang="en"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <Breadcrumb items={breadcrumbs} />
  </div>

  <!-- Hero -->
  <section class="hero-section">
    <div class="hero-inner">
      <p class="hero-tag">Divorce Certificate, UAE 2026</p>
      <h1>UAE Divorce Certificate Attestation: How to Get and Legalise Your Divorce Document</h1>
      <p class="hero-desc">
        You have a UAE divorce decree. Now you need to use it abroad, to remarry, update your passport, access a pension, or transfer property in your home country. The UAE is not an apostille country: its documents are used abroad through attestation by the Ministry of Foreign Affairs and, where the destination country requires it, legalisation by that country's embassy. Follow the chain in order, or foreign authorities may reject the document.
      </p>
      <p class="hero-author">By <strong>Aleksi Suon</strong>, UAE Expat &amp; Legal Consultant &middot; Updated September 2026</p>
    </div>
  </section>

  <div class="page-layout">
    <main class="main-content">

      <!-- Key facts box -->
      <div class="answer-box">
        <h2>What you need to know from the start</h2>
        <ul class="key-facts">
          <li><strong>The UAE is not a party to the Hague Apostille Convention.</strong> No UAE authority issues apostilles; UAE documents are attested by the Ministry of Foreign Affairs (MOFA) instead.</li>
          <li><strong>The chain is: certified court copy, MOFA attestation, destination embassy legalisation if required, certified translation.</strong> The receiving authority decides which of these it needs.</li>
          <li><strong>The divorce document is the court judgment or the court's divorce certificate.</strong> It is issued by the court, not by a separate civil registry.</li>
          <li><strong>Both parties can get a certified copy independently.</strong> You do not need your ex-spouse's cooperation to obtain the court registry copy.</li>
          <li><strong>A talaq pronounced outside court has no attestable document until the court documents it.</strong></li>
          <li><strong>Foreign documents coming into the UAE follow the reverse chain,</strong> and an apostille alone is not enough.</li>
        </ul>
      </div>

      <!-- Section 1: Why You Need It -->
      <section class="content-section">
        <h2>Why You Need an Attested UAE Divorce Certificate</h2>
        <p>
          An attested UAE divorce certificate is required in several common situations:
        </p>
        <ul>
          <li><strong>Remarriage abroad:</strong> Most countries require proof that a previous marriage has legally ended before a new marriage can be registered. A UAE divorce decree needs to be authenticated to be accepted by foreign civil registries and religious authorities. See also <a href="/en/remarriage-after-divorce-uae/">remarriage after divorce in the UAE</a>.</li>
          <li><strong>Passport and nationality updates:</strong> Changing your marital status in your home country's passport or national registry requires documented proof of the divorce.</li>
          <li><strong>Pension and benefits access:</strong> UK pensions, US Social Security survivor benefits, and similar schemes require proof of divorce to determine eligibility or access to former spouse benefits.</li>
          <li><strong>Inheritance proceedings:</strong> In some countries, a surviving former spouse has rights in an estate unless a divorce has been legally recognised. An attested UAE decree clarifies your status.</li>
          <li><strong>Property transfer abroad:</strong> If you hold property in your home country in joint names and are using a UAE divorce to establish sole ownership, the divorce decree must be legalised for the relevant land registry.</li>
          <li><strong>Banking and financial accounts:</strong> Some banks in other countries require proof of divorce to update joint account arrangements or beneficiary designations.</li>
        </ul>
      </section>

      <!-- Section 2: Step 1, Getting the Court Copy -->
      <section class="content-section">
        <h2>Step 1: Obtaining the Certified Court Copy</h2>
        <p>
          The official UAE divorce document is the court-issued judgment (hukm) or the divorce certificate the court issues when it documents a divorce. It is not a separate certificate from a government registry. You need a certified copy from the court registry.
        </p>

        <h3>What to bring to the court registry</h3>
        <ul>
          <li>Your passport (original)</li>
          <li>Emirates ID (if still valid)</li>
          <li>The case number from your divorce proceedings (on any previous court correspondence)</li>
          <li>The registry fee (indicative: AED 50 to 100)</li>
        </ul>
        <p>
          If you do not have the case number, provide your full name, the ex-spouse's name, and the approximate year of divorce. The registry can locate the file. Processing usually takes a few working days (indicative: 1 to 3).
        </p>
        <p>
          Each emirate's Personal Status Court maintains its own registry. If your divorce was handled by the Abu Dhabi Judicial Department, go to Abu Dhabi. If Dubai, the Dubai Courts Personal Status Court. If your case was in Sharjah, the Sharjah Personal Status Court.
        </p>

        <div class="info-box info-box--info">
          <h3>If you are outside the UAE</h3>
          <p>If you have already left the UAE, you can instruct a registered UAE law firm to obtain the certified copy on your behalf with a notarised power of attorney. Alternatively, you can appoint any UAE-based trusted person with a notarised POA to collect it from the court registry. The POA must specify the authority to collect court documents and the specific case details. A POA signed outside the UAE must itself be attested for UAE use through the reverse chain described below.</p>
        </div>
      </section>

      <!-- Section 3: The Attestation Chain -->
      <section class="content-section">
        <h2>The Full Attestation Chain for Using a UAE Divorce Abroad</h2>
        <p>
          UAE document attestation follows a fixed order. Each step authenticates the previous step's signature or seal, so you cannot skip ahead. The chain for a UAE divorce document is:
        </p>

        <div class="steps-list">
          {attestationChain.map((s) => (
            <div class="step-card">
              <div class="step-num">{s.step}</div>
              <div class="step-body">
                <h3>{s.title}</h3>
                <div class="step-meta">
                  <span class="meta-label">Where:</span> {s.where}<br />
                  <span class="meta-label">Cost:</span> {s.cost}<br />
                  <span class="meta-label">Time:</span> {s.time}
                </div>
                <p>{s.notes}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="note-text">Steps 01 and 02 apply in every case. Step 03 applies only where the destination country requires embassy legalisation. Step 04 applies wherever the receiving authority does not work in Arabic. Fees and timings are indicative and change; check the current figures with the court, MOFA and the embassy before you rely on them.</p>
      </section>

      <!-- Section 4: Why no apostille -->
      <section class="content-section">
        <h2>Why There Is No Apostille for UAE Documents</h2>
        <p>
          The Hague Apostille Convention is an international treaty under which a single certificate, the apostille, issued by the country where a document was issued, is enough for the document to be accepted in another member country without embassy legalisation. It only works when both countries are parties to the Convention.
        </p>
        <p>
          <strong>The UAE is not a party to the Apostille Convention</strong> (you can check the current list on the Hague Conference's status table at hcch.net). Neighbours differ: Saudi Arabia, Bahrain and Oman have joined; Qatar and Kuwait have not. So the UAE cannot issue an apostille, and UAE authorities do not accept a foreign apostille as the only authentication. Documents moving in either direction go through attestation, also called consular legalisation, instead.
        </p>
        <p>
          This is true even when the destination country is an apostille country. The UK, India, Pakistan, the USA, Australia and the EU states are all parties, but because the UAE is not, their authorities will usually look for MOFA attestation on a UAE document, not an apostille.
        </p>

        <div class="callout-box callout-box--gold">
          <h3>Ask the receiving authority two questions first</h3>
          <p class="callout-body">1. Is MOFA attestation enough, or do you also need legalisation by your country's embassy or consulate in the UAE? 2. Who must do the translation, and must the translation itself be attested? The answers decide whether you need step 03 and where step 04 happens.</p>
        </div>

        <div class="callout-box callout-box--blue">
          <h3>Documents coming the other way</h3>
          <p class="callout-body">If you need a foreign document (a marriage certificate, a foreign divorce decree, a power of attorney) accepted by a UAE court, it goes through the reverse chain: authentication at home, UAE Embassy legalisation, MOFA attestation and Arabic translation. See the section on foreign documents below.</p>
        </div>
      </section>

      <!-- Section 5: Country Guide -->
      <section class="content-section">
        <h2>Country-Specific Requirements</h2>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Country</th>
                <th>Usual route from the UAE</th>
                <th>Embassy step?</th>
                <th>Where it is used</th>
              </tr>
            </thead>
            <tbody>
              {countryGuide.map((row, i) => (
                <tr class={i % 2 === 0 ? '' : 'row-alt'}>
                  <td class="td-bold">{row.country}</td>
                  <td class="td-light">{row.steps}</td>
                  <td class="td-light">{row.embassy}</td>
                  <td class="td-light">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note-text">Requirements change and differ between offices in the same country. Verify with the receiving authority, the relevant embassy and MOFA before submitting.</p>

        <h3>UK in detail</h3>
        <p>
          The UAE cannot issue an apostille, so a UAE judgment goes to the UK as a MOFA-attested certified copy with a certified English translation. UK bodies set their own document rules, so ask the one you are dealing with:
        </p>
        <ul>
          <li>Register offices in England and Wales check overseas divorce documents when you give notice to remarry, and may refer them to the General Register Office for a decision (a fee applies)</li>
          <li>HMRC, DWP and pension schemes, for benefits and pension records</li>
          <li>UK courts, if the UAE divorce is being relied upon in UK proceedings</li>
        </ul>
        <p>
          Having the right paperwork is different from legal recognition. Under Part II of the Family Law Act 1986, a divorce obtained overseas by judicial or other proceedings is recognised in the UK if it is effective under the law of the country where it was obtained and, when the proceedings began, either spouse was habitually resident in, domiciled in, or a national of that country (section 46(1)). A divorce obtained without proceedings, such as a bare talaq, must meet the stricter test in section 46(2). See <a href="/en/uae-divorce-recognised-uk/">whether a UAE divorce is recognised in the UK</a> and the <a href="/en/british-expat-divorce-uae/">guide for British expats</a>.
        </p>

        <h3>India in detail</h3>
        <p>
          India has been a party to the Apostille Convention since 2005, but that does not help with a UAE document, because the UAE is not a party. The usual route is the certified court copy, MOFA attestation and an English translation. Many Indian authorities, particularly state marriage registrars, some courts and banks, also ask for attestation by the Embassy of India in Abu Dhabi or the Consulate General of India in Dubai.
        </p>
        <p>
          To avoid a second trip, ask the receiving office whether it needs the Indian mission's attestation. If it does, take the MOFA-attested document to the mission after step 02. The mission sets its own fee and processing time; check its website. More on Indian nationals: <a href="/en/indian-national-divorce-uae/">divorce for Indian nationals in the UAE</a>.
        </p>

        <h3>Pakistan in detail</h3>
        <p>
          Pakistan joined the Apostille Convention in 2023, but because the UAE is not a party, UAE documents still need the attestation route: the certified court copy, MOFA attestation, then attestation by the Embassy of Pakistan in Abu Dhabi or the Consulate General of Pakistan in Dubai.
        </p>
        <p>
          Current fees and appointment booking are on the missions' websites, and processing times vary. After returning to Pakistan, take the attested document to NADRA for the civil status update. See also <a href="/en/pakistani-divorce-uae/">divorce for Pakistani nationals in the UAE</a>.
        </p>
        <p>
          An Urdu translation may also be required at the NADRA stage, depending on the registration office. Bring the original Arabic court judgment, its certified English translation, and any Urdu translation the office asks for.
        </p>
      </section>

      <!-- Section 6: MOFA Online -->
      <section class="content-section">
        <h2>Using the MOFA Online Attestation Service</h2>
        <p>
          The UAE Ministry of Foreign Affairs (MOFA, known until recently as MOFAIC) runs its attestation service online at <strong>mofa.gov.ae</strong> and through its app. This is now the main route; in-person counters have largely given way to digital and courier-based attestation.
        </p>

        <div class="steps-list">
          <div class="step-card">
            <div class="step-num">01</div>
            <div class="step-body">
              <h3>Sign in with UAE PASS</h3>
              <p>MOFA requires UAE PASS to sign in. Non-residents can create a UAE PASS account at uaepass.ae. Choose the attestation service and enter the document type and destination country.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">02</div>
            <div class="step-body">
              <h3>Choose digital or courier attestation</h3>
              <p>If the court issued an original digital document (for example a PDF with a QR code), you can upload it for digital attestation. Otherwise, an approved courier collects the paper document, which must already carry the issuing court's certification and must not be laminated.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">03</div>
            <div class="step-body">
              <h3>Pay the fee and track status</h3>
              <p>MOFA publishes a fee of AED 150 for personal documents, plus a courier fee if you use that route. MOFA's stated processing time is within hours for digital attestation and 1 to 3 business days for the courier route. Check the current fee and timing when you apply.</p>
            </div>
          </div>
          <div class="step-card">
            <div class="step-num">04</div>
            <div class="step-body">
              <h3>Receive the attested document</h3>
              <p>You receive the attested document digitally or by courier. If you have already left the UAE, a trusted person or law firm holding a suitable power of attorney can handle collection, or you can use courier delivery.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 7: Reverse chain -->
      <section class="content-section">
        <h2>Foreign Documents Used in a UAE Divorce: The Reverse Chain</h2>
        <p>
          UAE courts often need foreign documents: a marriage certificate from your home country, a foreign divorce decree you want recognised, or a power of attorney signed abroad. These go through the chain in the opposite direction. An apostille on its own does not make a foreign document usable in the UAE.
        </p>

        <div class="steps-list">
          {inboundChain.map((s) => (
            <div class="step-card">
              <div class="step-num">{s.step}</div>
              <div class="step-body">
                <h3>{s.title}</h3>
                <p>{s.notes}</p>
              </div>
            </div>
          ))}
        </div>

        <p>
          For UK documents in practice: certified copy, FCDO legalisation (the apostille certificate), then the UAE Embassy in London's digital attestation, applied for through MOFA's website, which returns a copy attested by the Embassy and MOFA, then Arabic translation in the UAE. Other countries follow the same pattern through their own foreign ministry and the local UAE mission. For the full list of what a UAE court asks for, see <a href="/en/documents-for-divorce-uae/">documents for divorce in the UAE</a> and <a href="/en/divorce-for-expats-in-uae/">UAE divorce for expats</a>.
        </p>
      </section>

      <!-- Section 8: Talaq Registration -->
      <section class="content-section">
        <h2>Talaq Without a Court Proceeding: Getting an Official Document</h2>
        <p>
          Many Muslim divorces in the UAE begin with a talaq pronounced outside formal court proceedings, at home or in writing. Under UAE personal status law a talaq can take effect when pronounced, provided the legal conditions are met. However, a verbal or informally recorded talaq has no standalone attestable document.
        </p>

        <h3>Why court documentation is essential</h3>
        <p>
          Federal Decree-Law No. 41 of 2024 requires the husband to document a talaq before the competent court within 15 days, and the court can order compensation where he fails to do so without an acceptable excuse. The wife can also bring a claim to prove the divorce. Documentation creates the official court record, and that record is what can be certified and attested.
        </p>
        <p>
          Without court documentation, the only "document" you have is whatever informal record exists of the pronouncement. Foreign civil registries, embassies and government bodies generally will not accept an undocumented talaq, and UK recognition of a divorce obtained without proceedings is subject to the stricter rules in section 46(2) of the Family Law Act 1986.
        </p>

        <h3>How to get a talaq documented</h3>
        <p>
          Apply to the Personal Status Court with the evidence of the pronouncement; both spouses attending makes it simpler. The court verifies the talaq, notes the iddah period, and records the divorce. Once documented, the court record can be certified and attested through the chain described above.
        </p>
        <p>
          If the talaq was pronounced some time ago and was not documented in time, it can still be documented or proved through the court, but this may require a court case and more evidence. A UAE family lawyer can advise on the specific requirements.
        </p>
      </section>

      <!-- Section 9: Translators -->
      <section class="content-section">
        <h2>Getting a Certified Translation</h2>
        <p>
          Most destination countries require a translation of the Arabic court judgment. Who may translate depends on the receiving authority: some accept a UAE Ministry of Justice-licensed legal translator, others require a sworn or certified translator in their own country.
        </p>

        <h3>Finding a licensed legal translator in the UAE</h3>
        <p>
          The Ministry of Justice (moj.gov.ae) publishes a directory of licensed legal translators, organised by language. The translator's stamp and licence details appear on the translated document.
        </p>
        <p>
          Indicative translation prices in the UAE (they vary by translator, length and urgency):
        </p>
        <ul>
          <li>Arabic to English: AED 150-300 per page</li>
          <li>Arabic to Urdu: AED 200-350 per page</li>
          <li>Arabic to Hindi: AED 200-350 per page</li>
          <li>Arabic to Russian: AED 250-400 per page</li>
          <li>Arabic to French/German/Spanish: AED 300-500 per page</li>
        </ul>
        <p>
          A UAE divorce judgment is often a few pages long. Allow a working day or two for translation (indicative).
        </p>

        <div class="info-box info-box--warning">
          <h3>Check whether the translation must be attested too</h3>
          <p>For the strongest package, attest the certified Arabic court judgment through the chain and attach the certified translation to it. Some authorities want the translation itself to carry its own attestation. That means the translation goes through the attestation chain as well, adding some cost and time. Check what the receiving authority in your destination country requires before starting.</p>
        </div>
      </section>

