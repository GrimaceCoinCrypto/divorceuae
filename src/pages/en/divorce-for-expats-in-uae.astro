              </div>
            </li>
          ))}
        </ol>

        <h3>Abu Dhabi vs Dubai: the practical difference</h3>
        <div class="compare-table">
          <div class="compare-header">
            <div>Feature</div>
            <div>Abu Dhabi Civil Family Court</div>
            <div>Dubai Personal Status Court</div>
          </div>
          {[
            { feature: 'Uncontested timeline', adh: 'Under 1 month from filing', dxb: '~3 months from filing' },
            { feature: 'Court facility', adh: 'Dedicated non-Muslim court with non-Muslim judges', dxb: 'Civil division of Personal Status Court' },
            { feature: 'Civil marriage', adh: 'Can register and dissolve civil marriage in same court', dxb: 'Does not register civil marriages' },
            { feature: 'Financial orders', adh: 'Post-divorce financial order filed separately after divorce judgment', dxb: 'Can be included in divorce petition' },
            { feature: 'Civil family regime', adh: 'Dedicated Abu Dhabi Civil Family Court (Law 14/2021), English-language', dxb: 'Onshore family court applying Federal Decree-Law 41/2022. Note: DIFC Courts do not grant divorces' },
            { feature: 'Typing centre', adh: 'Required for initial application submission', dxb: 'Direct court filing through lawyer' },
          ].map((row, i) => (
            <div class={`compare-row${i % 2 === 1 ? ' alt' : ''}`}>
