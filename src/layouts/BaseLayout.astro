---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { SOURCES, pickSources } from '../data/sources';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  lang?: 'en' | 'ar';
  dir?: 'ltr' | 'rtl';
  pageType?: 'money' | 'info' | 'home';
  schema?: object | object[];
  hreflang?: {
    en?: string;
    ar?: string;
  };
  noindex?: boolean;
  ogImage?: string;
  lastmod?: string;
}

const {
  title,
  description,
  canonical,
  lang = 'en',
  dir = lang === 'ar' ? 'rtl' : 'ltr',
  schema,
  hreflang,
  noindex = false,
  ogImage = '/images/og-default.jpg',
  lastmod,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;
const SITE = 'https://divorceu.ae';

// Sitewide entity schema: the site is an information and referral service, not a
// law firm, so it is described as an Organization (not LegalService).
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE}/#organization`,
  name: 'Divorce UAE',
  alternateName: 'DivorceU.AE',
  url: SITE,
  description:
    'Independent legal information and lawyer referral service for divorce in the UAE. Not a law firm.',
  areaServed: { '@type': 'Country', name: 'United Arab Emirates' },
  knowsLanguage: ['English', 'Arabic'],
  founder: { '@type': 'Person', name: 'Aleksi Suon', url: `${SITE}/en/author/aleksi-suon/` },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  name: 'Divorce UAE',
  url: SITE,
  inLanguage: ['en-AE', 'ar-AE'],
  publisher: { '@id': `${SITE}/#organization` },
};

const typesOf = (s) => [].concat((s && s['@type']) || []);
const isFaqSchema = (s) => typesOf(s).includes('FAQPage');

// Normalise schema to array. Page-level WebSite/Organization objects are dropped
// because the sitewide ones above already describe the same entities.
const schemas = (schema ? (Array.isArray(schema) ? schema : [schema]) : []).filter(
  (s) => !typesOf(s).some((t) => t === 'WebSite' || t === 'Organization')
);

// Render the page body first so its JSON-LD can be validated and its FAQ markup
// merged. Any JSON-LD block that fails to parse fails the build.
const rawBody = await Astro.slots.render('default');
const LD_JSON_RE = /<script type="application\/ld\+json"[^>]*>([\s\S]*?)<\/script>/g;
const faqCandidates = [];
const bodyHtml = rawBody.replace(LD_JSON_RE, (block, json) => {
  let parsed;
  try {
    parsed = JSON.parse(json);
  } catch (err) {
    throw new Error(`Invalid JSON-LD on ${Astro.url.pathname}: ${err.message}`);
  }
  if (isFaqSchema(parsed)) {
    faqCandidates.push(parsed);
    return '';
  }
  return block;
});
faqCandidates.push(...schemas.filter(isFaqSchema));

// One FAQPage per page, containing only questions AND answers that are visible on
// the page. Pages often carry a hand-written FAQ block next to the FAQSection
// component; where both answer the same question, the visible answer wins.
const normText = (t) =>
  String(t)
    .toLowerCase()
    .replace(/<[^>]+>/g, ' ')
    .replace(/&[a-z#0-9]+;/gi, ' ')
    .replace(/[^\p{L}\p{N}]+/gu, ' ')
    .replace(/\s+/g, ' ')
    .trim();
const visibleText = normText(
  bodyHtml.replace(/<script[\s\S]*?<\/script>/g, ' ').replace(/<style[\s\S]*?<\/style>/g, ' ')
);
const faqByQuestion = new Map();
for (const block of faqCandidates) {
  for (const q of [].concat(block.mainEntity || [])) {
    if (!q || !q.name) continue;
    const key = normText(q.name);
    if (!faqByQuestion.has(key)) faqByQuestion.set(key, []);
    faqByQuestion.get(key).push(q);
  }
}
const faqEntities = [];
for (const [key, candidates] of faqByQuestion) {
  if (!visibleText.includes(key) && !visibleText.includes(key.slice(0, 50))) continue;
  const visible = candidates.find((q) =>
    visibleText.includes(normText((q.acceptedAnswer && q.acceptedAnswer.text) || '').slice(0, 60))
  );
  if (visible) faqEntities.push(visible);
}
const faqSchema = faqEntities.length
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntities }
  : null;

// Auto-add an Article schema to content pages that do not already declare one.
// Skips the homepage, the About/author pages, and legal/utility pages.
const path = Astro.url.pathname;
const isContentPage =
  /^\/(en|ar)\/.+/.test(path) &&
  !/(\/thank-you|\/disclaimer|\/privacy|\/about\/?$|\/author\/)/.test(path);
const hasArticle = schemas.some((s) => {
  const t = s && s['@type'];
  return t === 'Article' || t === 'NewsArticle' || t === 'BlogPosting' ||
    (Array.isArray(t) && t.includes('Article'));
});
const autoArticleSchema = isContentPage && !hasArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      inLanguage: lang === 'ar' ? 'ar-AE' : 'en-AE',
      author: {
        '@type': 'Person',
        name: 'Aleksi Suon',
        url: 'https://divorceu.ae/en/author/aleksi-suon/',
      },
      publisher: {
        '@type': 'Organization',
        '@id': `${SITE}/#organization`,
        name: 'Divorce UAE',
        url: SITE,
      },
      mainEntityOfPage: canonicalURL,
      ...(lastmod ? { dateModified: lastmod } : {}),
    }
  : null;

const allSchemas = [
  organizationSchema,
  websiteSchema,
  ...schemas.filter((s) => !isFaqSchema(s)),
  ...(autoArticleSchema ? [autoArticleSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
];

// Official sources: attached to content pages by the trigger rules in
// src/data/sources.ts (a page lists the laws and official pages it names).
const sourceKeys = isContentPage ? pickSources(visibleText) : [];
const escapeHtml = (s) =>
  String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const sourcesHtml = sourceKeys.length
  ? `<section class="site-sources" aria-labelledby="site-sources-heading"><h2 id="site-sources-heading">${
      lang === 'ar' ? 'المصادر الرسمية والنصوص القانونية' : 'Sources and official references'
    }</h2><ol>${sourceKeys
      .map((key) => {
        const s = SOURCES[key];
        const title = lang === 'ar' && s.titleAr ? s.titleAr : s.title;
        const publisher = lang === 'ar' && s.publisherAr ? s.publisherAr : s.publisher;
        const url = lang === 'ar' && s.urlAr ? s.urlAr : s.url;
        return `<li><a href="${escapeHtml(url)}" target="_blank" rel="noopener">${escapeHtml(title)}</a>${
          lang === 'ar' ? '، ' : ', '
        }${escapeHtml(publisher)}</li>`;
      })
      .join('')}</ol></section>`
  : '';
const pageHtml =
  sourcesHtml && bodyHtml.includes('</main>')
    ? bodyHtml.replace(/<\/main>(?![\s\S]*<\/main>)/, `${sourcesHtml}</main>`)
    : bodyHtml;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Q144FGC7KR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Q144FGC7KR');
    </script>

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang -->
    {hreflang?.en && (
      <link rel="alternate" hreflang="en-AE" href={hreflang.en} />
    )}
    {hreflang?.ar && (
      <link rel="alternate" hreflang="ar-AE" href={hreflang.ar} />
    )}
    {hreflang?.en && (
      <link rel="alternate" hreflang="x-default" href={hreflang.en} />
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AE' : 'en_AE'} />
    <meta property="og:site_name" content="Divorce UAE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: preconnect first, then load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {lang === 'ar' ? (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap"
      />
    ) : (
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      />
    )}

    <!-- Critical inline CSS -->
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: var(--font-body, 'Inter', sans-serif);
        line-height: 1.6;
        color: #1a1a2e;
        background: #fff;
      }
      [dir="rtl"] body { font-family: 'Cairo', sans-serif; }
      .sr-only {
        position: absolute; width: 1px; height: 1px;
        padding: 0; margin: -1px; overflow: hidden;
        clip: rect(0,0,0,0); white-space: nowrap; border: 0;
      }
    </style>

    <!-- Schema markup -->
    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>

  <body>
    <Header lang={lang} hreflang={hreflang} />

    <!-- Sticky WhatsApp CTA (visible without scrolling) -->
    <a
      href="https://wa.me/971557344876?text=Hello%2C%20I%20need%20divorce%20legal%20advice%20in%20UAE"
      class="whatsapp-sticky"
      aria-label={lang === 'ar' ? 'تواصل عبر واتساب' : 'Chat on WhatsApp'}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="28" height="28" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      {lang === 'ar' ? 'واتساب' : 'WhatsApp'}
    </a>

    <Fragment set:html={pageHtml} />

    <Footer lang={lang} />

    <style is:global>
      .site-sources {
        max-width: 1200px;
        margin: 8px auto 56px;
        padding: 24px;
        border-top: 1px solid #e5e7eb;
      }
      .site-sources h2 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1e3a5f;
        margin-bottom: 12px;
      }
      .site-sources ol {
        padding-inline-start: 22px;
        display: grid;
        gap: 6px;
        font-size: 0.875rem;
        line-height: 1.6;
        color: #4b5563;
      }
      .site-sources a { color: #2563eb; text-decoration: underline; }
    </style>

    <style>
      .whatsapp-sticky {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 8px;
        background: #25d366;
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 12px 20px;
        border-radius: 50px;
        text-decoration: none;
        box-shadow: 0 4px 20px rgba(37,211,102,0.4);
        transition: transform 0.2s, box-shadow 0.2s;
      }
      [dir="rtl"] .whatsapp-sticky {
        right: auto;
        left: 24px;
      }
      .whatsapp-sticky:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(37,211,102,0.5);
      }
    </style>
  </body>
</html>
