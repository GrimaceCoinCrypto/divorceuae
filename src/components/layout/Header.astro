---
export interface Props {
  lang?: 'en' | 'ar';
  hreflang?: { en?: string; ar?: string };
}

const { lang = 'en', hreflang } = Astro.props;

const altLangUrl = lang === 'en' ? hreflang?.ar : hreflang?.en;
const altLangLabel = lang === 'en' ? 'عربي' : 'EN';

const nav = lang === 'en'
  ? [
      { label: 'Divorce Law', href: '/en/uae-divorce-law/' },
      { label: 'Cost', href: '/en/divorce-cost-uae/' },
      { label: 'Timeline', href: '/en/divorce-timeline-uae/' },
      { label: 'Alimony', href: '/en/alimony-uae/' },
      { label: 'Child Custody', href: '/en/child-custody-uae/' },
      { label: 'Lawyers', href: '/en/divorce-lawyer-dubai/' },
    ]
  : [
      { label: 'قانون الطلاق', href: '/ar/قانون-الطلاق-في-الامارات/' },
      { label: 'التكلفة', href: '/ar/تكلفة-الطلاق-في-الامارات/' },
      { label: 'المدة', href: '/ar/مدة-الطلاق-في-الامارات/' },
      { label: 'النفقة', href: '/ar/نفقة-بعد-الطلاق-الامارات/' },
      { label: 'الحضانة', href: '/ar/حضانة-الاطفال-الامارات/' },
      { label: 'المحامون', href: '/ar/محامي-طلاق-دبي/' },
    ];

const homeHref = lang === 'en' ? '/en/' : '/ar/';
const ctaLabel = lang === 'en' ? 'Free Advice' : 'استشارة مجانية';
const ctaHref = '#contact';
---

<header class="site-header" id="siteHeader">
  <div class="header-inner">

    <!-- Logo -->
    <a href={homeHref} class="header-logo" aria-label="DivorceU.AE - Home">
      <span class="logo-mark">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6l9-4 9 4v6c0 5.25-3.75 10.15-9 11.5C6.75 22.15 3 17.25 3 12V6z"/>
        </svg>
      </span>
      <span class="logo-text">DivorceU<span class="logo-tld">.AE</span></span>
    </a>

    <!-- Desktop nav -->
    <nav class="header-nav" aria-label={lang === 'en' ? 'Main navigation' : 'التنقل الرئيسي'}>
      {nav.map(item => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
    </nav>

    <!-- Right side: lang + CTA + hamburger -->
    <div class="header-actions">
      {altLangUrl && (
        <a href={altLangUrl} class="lang-switch" aria-label="Switch language">
          {altLangLabel}
        </a>
      )}
      <a href={ctaHref} class="header-cta">{ctaLabel}</a>
      <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile menu -->
<div class="mobile-overlay" id="mobileOverlay" aria-hidden="true"></div>
<nav class="mobile-menu" id="mobileMenu" aria-label={lang === 'en' ? 'Mobile navigation' : 'قائمة التنقل'} aria-hidden="true">
  <div class="mobile-menu-header">
    <span class="logo-text" style="color:#0a1628;font-size:1.1rem;font-weight:800;">DivorceU<span class="logo-tld">.AE</span></span>
    <button class="mobile-close" id="mobileClose" aria-label="Close menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="mobile-nav-links">
    {nav.map(item => (
      <a href={item.href} class="mobile-nav-link">{item.label}</a>
    ))}
  </div>
  <div class="mobile-menu-footer">
    {altLangUrl && (
      <a href={altLangUrl} class="mobile-lang">{altLangLabel}</a>
    )}
    <a href={ctaHref} class="mobile-cta">{ctaLabel}</a>
  </div>
</nav>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileOverlay = document.getElementById('mobileOverlay');
  const mobileClose = document.getElementById('mobileClose');

  function openMenu() {
    mobileMenu?.classList.add('is-open');
    mobileOverlay?.classList.add('is-open');
    hamburger?.setAttribute('aria-expanded', 'true');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    mobileMenu?.classList.remove('is-open');
    mobileOverlay?.classList.remove('is-open');
    hamburger?.setAttribute('aria-expanded', 'false');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', openMenu);
  mobileClose?.addEventListener('click', closeMenu);
  mobileOverlay?.addEventListener('click', closeMenu);

  // Close on nav link click
  document.querySelectorAll('.mobile-nav-link, .mobile-cta, .mobile-lang').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Sticky shadow on scroll
  const header = document.getElementById('siteHeader');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  }, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #fff;
    border-bottom: 1px solid #e8eaed;
    transition: box-shadow 0.2s;
  }
  .site-header.is-scrolled {
    box-shadow: 0 2px 12px rgba(10,22,40,0.08);
  }
  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.25rem;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Logo */
  .header-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-mark {
    width: 32px;
    height: 32px;
    background: #0a1628;
    color: #c9a84c;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .logo-text {
    font-size: 1.15rem;
    font-weight: 800;
    color: #0a1628;
    letter-spacing: -0.02em;
  }
  .logo-tld { color: #c9a84c; }

  /* Desktop nav */
  .header-nav {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    flex: 1;
  }
  .nav-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: #445;
    text-decoration: none;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: #0a1628;
    background: #f4f5f7;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .lang-switch {
    font-size: 0.78rem;
    font-weight: 700;
    color: #556;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid #dde;
    border-radius: 6px;
    transition: border-color 0.15s, color 0.15s;
  }
  .lang-switch:hover { border-color: #0a1628; color: #0a1628; }
  .header-cta {
    font-size: 0.82rem;
    font-weight: 700;
    color: #fff;
    background: #c9a84c;
    text-decoration: none;
    padding: 0.45rem 1rem;
    border-radius: 6px;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .header-cta:hover { background: #b8942d; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: none;
    border: 1px solid #e0e4ea;
    border-radius: 7px;
    cursor: pointer;
    padding: 0 8px;
  }
  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: #0a1628;
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Mobile overlay */
  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10,22,40,0.45);
    z-index: 200;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .mobile-overlay.is-open {
    display: block;
    opacity: 1;
  }

  /* Mobile menu drawer */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background: #fff;
    z-index: 300;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.4,0,0.2,1);
    box-shadow: -4px 0 24px rgba(10,22,40,0.12);
  }
  [dir="rtl"] .mobile-menu {
    right: auto;
    left: 0;
    transform: translateX(-100%);
  }
  .mobile-menu.is-open {
    transform: translateX(0);
  }
  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #eee;
  }
  .mobile-close {
    background: none;
    border: none;
    color: #445;
    cursor: pointer;
    padding: 4px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mobile-close:hover { color: #0a1628; background: #f4f5f7; }
  .mobile-nav-links {
    flex: 1;
    overflow-y: auto;
    padding: 0.75rem 0;
  }
  .mobile-nav-link {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: #0a1628;
    text-decoration: none;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.15s, color 0.15s;
  }
  .mobile-nav-link:hover { background: #f9f4e8; color: #c9a84c; }
  .mobile-menu-footer {
    padding: 1rem 1.25rem;
    border-top: 1px solid #eee;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .mobile-cta {
    display: block;
    text-align: center;
    background: #c9a84c;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    padding: 0.9rem;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .mobile-cta:hover { background: #b8942d; }
  .mobile-lang {
    display: block;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: #556;
    text-decoration: none;
    padding: 0.5rem;
    border: 1px solid #dde;
    border-radius: 7px;
    transition: border-color 0.15s;
  }
  .mobile-lang:hover { border-color: #0a1628; color: #0a1628; }

  @media (max-width: 900px) {
    .header-nav { display: none; }
    .header-cta { display: none; }
    .hamburger { display: flex; }
  }
  @media (max-width: 480px) {
    .lang-switch { display: none; }
  }
</style>
