---
export interface Props {
  lang?: 'en' | 'ar';
}
const { lang = 'en' } = Astro.props;

const year = new Date().getFullYear();

const links = lang === 'en'
  ? {
      divorce: [
        { label: 'UAE Divorce Law', href: '/en/uae-divorce-law/' },
        { label: 'Divorce Cost', href: '/en/divorce-cost-uae/' },
        { label: 'Divorce Timeline', href: '/en/divorce-timeline-uae/' },
        { label: 'Types of Divorce', href: '/en/types-of-divorce-uae/' },
        { label: 'Mutual Consent', href: '/en/mutual-consent-divorce-uae/' },
        { label: 'Contested Divorce', href: '/en/contested-vs-uncontested-divorce-uae/' },
      ],
      rights: [
        { label: 'Alimony in UAE', href: '/en/alimony-uae/' },
        { label: 'Child Custody', href: '/en/child-custody-uae/' },
        { label: 'Visa After Divorce', href: '/en/visa-after-divorce-uae/' },
        { label: 'Non-Muslim Divorce', href: '/en/non-muslim-divorce-uae/' },
        { label: 'Documents Needed', href: '/en/documents-for-divorce-uae/' },
        { label: 'Wife Rights After Divorce', href: '/en/wife-rights-after-divorce-uae/' },
      ],
      lawyers: [
        { label: 'Divorce Lawyer Dubai', href: '/en/divorce-lawyer-dubai/' },
        { label: 'Divorce Lawyer Abu Dhabi', href: '/en/divorce-lawyer-abu-dhabi/' },
        { label: 'Divorce Lawyer Sharjah', href: '/en/divorce-lawyer-sharjah/' },
        { label: 'Divorce Lawyer Ajman', href: '/en/divorce-lawyer-ajman/' },
        { label: 'How to File in Dubai', href: '/en/how-to-file-for-divorce-in-dubai/' },
      ],
    }
  : {
      divorce: [
        { label: 'قانون الطلاق في الإمارات', href: '/ar/قانون-الطلاق-في-الامارات/' },
        { label: 'تكلفة الطلاق', href: '/ar/تكلفة-الطلاق-في-الامارات/' },
        { label: 'مدة الطلاق', href: '/ar/مدة-الطلاق-في-الامارات/' },
        { label: 'أنواع الطلاق', href: '/ar/انواع-الطلاق/' },
        { label: 'الطلاق بالتراضي', href: '/ar/الطلاق-بالتراضي-الامارات/' },
      ],
      rights: [
        { label: 'النفقة بعد الطلاق', href: '/ar/نفقة-بعد-الطلاق-الامارات/' },
        { label: 'حضانة الأطفال', href: '/ar/حضانة-الاطفال-الامارات/' },
        { label: 'تأشيرة بعد الطلاق', href: '/ar/تأشيرة-بعد-الطلاق-الامارات/' },
        { label: 'الخلع في الإمارات', href: '/ar/الخلع-في-الامارات/' },
        { label: 'وثائق الطلاق', href: '/ar/وثائق-الطلاق-في-الامارات/' },
      ],
      lawyers: [
        { label: 'محامي طلاق دبي', href: '/ar/محامي-طلاق-دبي/' },
        { label: 'محامي طلاق أبوظبي', href: '/ar/محامي-طلاق-ابوظبي/' },
        { label: 'محامي طلاق', href: '/ar/محامي-طلاق/' },
      ],
    };

const colTitles = lang === 'en'
  ? { divorce: 'Divorce Guides', rights: 'Rights & Resources', lawyers: 'Find a Lawyer' }
  : { divorce: 'أدلة الطلاق', rights: 'الحقوق والموارد', lawyers: 'ابحث عن محامٍ' };

const legalLinks = lang === 'en'
  ? [
      { label: 'Privacy Policy', href: '/en/privacy-policy/' },
      { label: 'Disclaimer', href: '/en/disclaimer/' },
    ]
  : [
      { label: 'سياسة الخصوصية', href: '/ar/سياسة-الخصوصية/' },
      { label: 'إخلاء المسؤولية', href: '/ar/إخلاء-المسؤولية/' },
    ];

const tagline = lang === 'en'
  ? 'Clear, practical divorce guidance for UAE residents and expats.'
  : 'إرشادات طلاق واضحة وعملية لسكان وأجانب الإمارات.';

const copyright = lang === 'en'
  ? `© ${year} DivorceU.AE — For informational purposes only. Not legal advice.`
  : `© ${year} DivorceU.AE — للأغراض الإعلامية فقط. ليس استشارة قانونية.`;
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-brand">
      <div class="footer-logo">
        <span class="footer-logo-mark">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6l9-4 9 4v6c0 5.25-3.75 10.15-9 11.5C6.75 22.15 3 17.25 3 12V6z"/>
          </svg>
        </span>
        <span class="footer-logo-text">DivorceU<span class="footer-tld">.AE</span></span>
      </div>
      <p class="footer-tagline">{tagline}</p>
      <a
        href="https://wa.me/971557344876"
        class="footer-wa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {lang === 'en' ? 'WhatsApp us' : 'واتساب'}
      </a>
    </div>

    <div class="footer-col">
      <h3 class="footer-col-title">{colTitles.divorce}</h3>
      <ul class="footer-links">
        {links.divorce.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-col-title">{colTitles.rights}</h3>
      <ul class="footer-links">
        {links.rights.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-col-title">{colTitles.lawyers}</h3>
      <ul class="footer-links">
        {links.lawyers.map(l => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <p class="footer-copyright">{copyright}</p>
    <div class="footer-legal">
      {legalLinks.map(l => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0a1628;
    color: #b0bec5;
    margin-top: 4rem;
  }
  .footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }

  /* Brand column */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .footer-logo-mark {
    width: 28px;
    height: 28px;
    background: rgba(201,168,76,0.15);
    border: 1px solid rgba(201,168,76,0.3);
    color: #c9a84c;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .footer-logo-text {
    font-size: 1rem;
    font-weight: 800;
    color: #fff;
  }
  .footer-tld { color: #c9a84c; }
  .footer-tagline {
    font-size: 0.83rem;
    line-height: 1.6;
    color: #7a8fa6;
    margin-bottom: 1.1rem;
  }
  .footer-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #25d366;
    text-decoration: none;
    border: 1px solid rgba(37,211,102,0.25);
    padding: 0.4rem 0.875rem;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .footer-wa:hover { background: rgba(37,211,102,0.08); }

  /* Link columns */
  .footer-col-title {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #fff;
    margin-bottom: 0.875rem;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .footer-links a {
    font-size: 0.82rem;
    color: #7a8fa6;
    text-decoration: none;
    transition: color 0.15s;
    line-height: 1.4;
  }
  .footer-links a:hover { color: #c9a84c; }

  /* Bottom bar */
  .footer-bottom {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.07);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .footer-copyright {
    font-size: 0.75rem;
    color: #4a5568;
  }
  .footer-legal {
    display: flex;
    gap: 1.25rem;
  }
  .footer-legal a {
    font-size: 0.75rem;
    color: #4a5568;
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-legal a:hover { color: #7a8fa6; }

  @media (max-width: 900px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 500px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }
</style>
